// Define a recursive list type
'list<'t> = Nil | Cons['t, ^]

// Compute the sum of a list using tail recursion
sum_ = #['list<'int>, 'int] {
  | =[Nil, acc] => acc
  | =[Cons[head, tail], acc] => %num.add [head, acc] ~> ^ [tail, ~]
}

sum = #'list<'int> { sum_ [~, 0] }

#{ %list{ 1, 2, 3 } ~> sum }
