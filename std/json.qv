// A JSON dialect: `%json{ { "a": 1, "b": [2, x], "c": ~ } }` parses the brace content at
// compile time into a `'%json` value. In value position, a bare identifier that isn't a
// JSON keyword (`x` above) and `~` are caller escapes: their spans are spliced as host
// code (`Unquote`), evaluated in the caller's scope — `~` is the value flowing into the
// dialect term. Both must evaluate to `'%json`-shaped values.
//
// The grammar is built from `%parse` combinators, tying the value↔array/object recursion
// with the concrete-knot idiom from `%parse`'s header; expression trees are built with
// the `%meta` constructors.
//
// Notes:
//   - A JSON number is an exact `'%num.coeff` (an `'int`, or a `'rational` for a non-integer):
//     `3.14` parses to exactly `157/50`, with no float rounding. The `%json{…}` dialect is
//     still integer-only (its literal grammar predates this); only the runtime `parse` reads
//     decimals/exponents. `stringify` emits a whole `'int` as digits, a terminating rational
//     as its exact decimal, and a non-terminating one (e.g. `1/3`) rounded to 12 fractional
//     digits — so JSON-originated data round-trips exactly, and only computed fractions round.
//   - String escapes: `\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\t`, `\r` (no `\u`).
//   - A trailing comma before `]`/`}` is tolerated.

' = Null | True | False | '%num.coeff | '%str | Array['%list<^>] | Object['%list<['%str, ^]>]

// A JSON value that may be absent: what `parse` and every query answers, and what the
// query/update functions accept in their JSON-valued operands, so failures chain through.
'opt = ' | []

'expr = '%meta.expr

// A byte token with leading whitespace skipped.
tok = #[(b): 'int, (what): '%str] { %parse.right [%parse.ws, %parse.byte [$b, $what]] }

// `~`: the value flowing into the dialect term, spliced as its own 1-byte host span.
ripple_p = #'%parse {
  =st
  tilde = %parse.byte [126, "'~'"]
  tilde st ~> =[_, st2]
  [Unquote[offset: st.pos, length: 1], st2]
}

// An identifier: the `null`/`true`/`false` keywords, or a caller escape — any other
// identifier's span is spliced as host code (a caller-scope variable).
word_p = #'%parse {
  =st
  %parse.ident st ~> =[w, st2]
  w ~> {
    | ="null" => [Tuple[name: "Null", fields: Nil], st2]
    | ="true" => [Tuple[name: "True", fields: Nil], st2]
    | ="false" => [Tuple[name: "False", fields: Nil], st2]
    | [
      Unquote[offset: st.pos, length: __integer_subtract__ [st2.pos, st.pos]],
      st2,
    ]
  }
}

// The value grammar, self-passed to tie the value↔array/object recursion.
value_step = #[(self): ^, (st): '%parse] -> (['expr, '%parse] | []) {
  value = #'%parse { $$self [$$self, $] }

  comma = tok [44, "','"]

  elems = %parse.sep_end_by [value, comma]

  a1 = %parse.right [%parse.byte [91, "'['"], elems]

  a2 = %parse.left [a1, tok [93, "']'"]]

  array = %parse.map [a2, #{ Tuple[name: "Array", fields: Cons[%meta.list_expr $, Nil]] }]

  key = %parse.right [%parse.ws, %parse.quoted]
  k1 = %parse.left [key, tok [58, "':'"]]

  pair = %parse.map [%parse.then [k1, value], #{ %meta.pair2 [$0, $1] }]

  pairs = %parse.sep_end_by [pair, comma]

  o1 = %parse.right [%parse.byte [123, "'\{'"], pairs]

  o2 = %parse.left [o1, tok [125, "'}'"]]

  object = %parse.map [o2, #{ Tuple[name: "Object", fields: Cons[%meta.list_expr $, Nil]] }]

  composite = %parse.alt4 [array, object, %parse.quoted, %parse.int]

  leaf = %parse.alt2 [ripple_p, word_p]
  core = %parse.alt2 [composite, leaf]
  core_ws = %parse.right [%parse.ws, core]

  core_ws $st
}

value = #'%parse { value_step [value_step, $] }

// The dialect entry point: the compiler calls this with the dialect context record; the
// grammar needs only the content (escape spans come from its own positions).
json = #(content: '%str) { full = %parse.left [value, %parse.ws]; %parse.run [$content, full] }

// === Runtime codec ======================================================================
// `parse`/`stringify` read and write JSON at runtime, over `'%str`. They share the
// `%parse` combinators with the dialect but not its grammar: the dialect builds `%meta`
// code to splice into the caller, whereas these build `'%json` values directly — so the
// codec has no unquoting and `null`/`true`/`false` are the only bare words it accepts.

// `10^k` for `k >= 0`. Shared by the number parser (scaling) and the rational formatter.
pow10 = #[(acc): 'int, (k): 'int] {
  | $k ~> =0 => $acc
  | ^ [__integer_multiply__ [$acc, 10], __integer_subtract__ [$k, 1]]
}

// A canonical rational with denominator 1 is an integer; hand back the plain `'int`. Keeps
// whole-valued JSON numbers (`42`, `42.0`, `1e2`) as ints rather than `Rational[_, 1]`.
lower_num = #'%num.coeff { =Rational[n, 1] => n | =x => x }

// A digit byte (for `take_while`): the byte itself when it is `0`–`9`, else nil.
digit? = #'int {
  __integer_compare__ [$, 48] ~> =(0 | 1); __integer_compare__ [$, 57] ~> =(-1 | 0); $
}

digits = %parse.take_while digit?

// The byte at the parse state's position, or nil at end of input.
peek_at = #'%parse { %num.lt? [$pos, $len]; %bin.get_byte [$data, $pos] }

// Assemble a JSON number from its scanned parts: `sign` (±1), the integer- and fractional-
// part digit bytes, and the exponent. Exact: the value is `sign · M · 10^(exp − |frac|)`,
// where `M` is the integer- and fractional-part digits read as one integer — an `'int` when
// that power is non-negative (a whole number), otherwise a reduced `'rational`.
build_number = #[(sign): 'int, (int_b): 'bin, (frac_b): 'bin, (exp): 'int] {
  // The digits were scanned as a non-empty run of digits, so they always parse.
  mag = %bin.concat [$int_b, $frac_b] ~> %str.parse_int Str[~] ~> {
    | =('int & n) => n
    | __panic__ "scanned number digits did not parse"
  }

  m = __integer_multiply__ [$sign, mag]
  total_exp = __integer_subtract__ [$exp, %bin.length $frac_b]
  {
    | __integer_compare__ [total_exp, 0] ~> =(0 | 1) => __integer_multiply__ [
        m,
        pow10 [1, total_exp],
      ]
    | {
      den = pow10 [1, __integer_subtract__ [0, total_exp]]

      // `den` is a positive power of ten, so the division is always a rational.
      %num.div [m, den] ~> {
        | =('%num.coeff & r) => lower_num r
        | __panic__ "dividing by a power of ten failed"
      }
    }
  }
}

// A JSON number: `-? int-digits (. frac-digits)? ([eE] [+-]? exp-digits)?`, as a `'%num.coeff`.
number = #'%parse {
  =st0
  neg? = { peek_at st0 ~> =45 => Ok | [] }
  st1 = {
    | neg? => st0[..., pos: %num.add [st0.pos, 1]]
    | st0
  }
  sign = { neg? => -1 | 1 }

  digits st1 ~> =[ib, st2]
  {
    | %bin.length ib ~> =0 => %parse.fail_in [st0, "a number"]
    | Ok
  }

  frac = {
    | peek_at st2 ~> =46 => {
      digits st2[..., pos: %num.add [st2.pos, 1]] ~> =[fbb, st3a]

      {
        | %bin.length fbb ~> =0 => %parse.fail_in [st2, "digits after '.'"]
        | [bytes: fbb, st: st3a]
      }
    }
    | [bytes: <>, st: st2]
  }
  frac ~> =[bytes: fb, st: st3]

  ex = {
    | peek_at st3 ~> =(101 | 69) => {
      est = st3[..., pos: %num.add [st3.pos, 1]]
      esign = { peek_at est ~> =45 => -1 | 1 }
      est2 = {
        | peek_at est ~> =(43 | 45) => est[..., pos: %num.add [est.pos, 1]]
        | est
      }
      digits est2 ~> =[ebb, st4a]
      {
        | %bin.length ebb ~> =0 => %parse.fail_in [st3, "digits in the exponent"]
        | {
          emag = ebb ~> %str.parse_int Str[~] ~> {
            | =('int & n) => n
            | __panic__ "scanned exponent digits did not parse"
          }
          [exponent: __integer_multiply__ [esign, emag], st: st4a]
        }
      }
    }
    | [exponent: 0, st: st3]
  }
  ex ~> =[exponent: expv, st: st4]

  val = build_number [sign: sign, int_b: ib, frac_b: fb, exp: expv]

  [val, st4]
}

// The runtime value grammar, its recursion tied with `%parse.rec`. `%parse.quoted` already
// yields the `'%str` leaf verbatim; `number` yields the `'%num.coeff` leaf; only the
// composite and keyword actions build the rest of `'%json`.
parse_value = #['%parse.p<'>, '%parse] {
  =[value_p, st]

  comma = tok [44, "','"]

  elems = %parse.sep_end_by [value_p, comma]

  a1 = %parse.right [%parse.byte [91, "'['"], elems]

  a2 = %parse.left [a1, tok [93, "']'"]]
  array = %parse.map [a2, #{ Array[$] }]

  key = %parse.right [%parse.ws, %parse.quoted]
  k1 = %parse.left [key, tok [58, "':'"]]
  pair = %parse.then [k1, value_p]
  pairs = %parse.sep_end_by [pair, comma]

  o1 = %parse.right [%parse.byte [123, "'\{'"], pairs]

  o2 = %parse.left [o1, tok [125, "'}'"]]
  object = %parse.map [o2, #{ Object[$] }]

  keyword = #'%parse {
    =kst
    %parse.ident kst ~> =[w, kst2]
    w ~> {
      | ="null" => [Null, kst2]
      | ="true" => [True, kst2]
      | ="false" => [False, kst2]
      | %parse.fail_in [kst, "null, true, or false"]
    }
  }

  composite = %parse.alt4 [array, object, %parse.quoted, number]

  core = %parse.alt2 [composite, keyword]
  core_ws = %parse.right [%parse.ws, core]

  core_ws st
}

parse_p = %parse.rec parse_value

parse = #'%str {
  :doc "Parses a JSON string into a '%json value, or nil with a positioned :error on malformed input."
  full = %parse.left [parse_p, %parse.ws]; %parse.run [$, full]
}

// Escape a string's interior bytes. Only the escapes the parser understands are emitted
// (`\" \\ \b \f \n \r \t`); every other byte passes through verbatim (no `\uXXXX`).
esc_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
  | {
    b = %bin.get_byte [$data, $pos]
    acc2 = b ~> {
      | =34 => %bin.concat [$acc, <5c22>]
      | =92 => %bin.concat [$acc, <5c5c>]
      | =8 => %bin.concat [$acc, <5c62>]
      | =12 => %bin.concat [$acc, <5c66>]
      | =10 => %bin.concat [$acc, <5c6e>]
      | =13 => %bin.concat [$acc, <5c72>]
      | =9 => %bin.concat [$acc, <5c74>]
      | %bin.append [$acc, b, 1]
    }
    ^ [$data, %num.add [$pos, 1], $len, acc2]
  }
}

// A JSON string literal: the bytes escaped and wrapped in double quotes.
escape_str = #'%str {
  =Str[bytes]
  inner = esc_loop [bytes, 0, %bin.length bytes, <>]
  %bin.concat [<22>, inner] ~> %bin.concat [~, <22>] ~> Str[~]
}

// Concatenate a list's elements — each rendered to a string by `render` — separated by
// commas.
join_strs = #<'x>[(items): '%list<'x>, (render): #'x -> '%str] {
  %list.iter $items ~> %iter.map [~, $render] ~> %str.join [~, ","]
}

// A binary of `n` copies of byte `b`.
repeat_byte = #[(acc): 'bin, (b): 'int, (n): 'int] {
  | $n ~> =0 => $acc
  | ^ [%bin.append [$acc, $b, 1], $b, __integer_subtract__ [$n, 1]]
}

// Drop trailing `<30>` (`'0'`) bytes from a binary.
strip_zeros = #'bin {
  =b
  len = %bin.length b
  {
    | len ~> =0 => b
    | %bin.get_byte [b, __integer_subtract__ [len, 1]] ~> =48 => %bin.slice [
        b,
        0,
        __integer_subtract__ [len, 1],
      ]
      ~> ^
    | b
  }
}

// The `width`-digit, zero-padded decimal of `fracpart` (which is `< 10^width`), with trailing
// zeros stripped — the digits that follow the decimal point.
frac_bytes = #[(fracpart): 'int, (width): 'int] {
  ds = %str.from_int $fracpart ~> .0
  pad = __integer_subtract__ [$width, %bin.length ds]

  %bin.concat [repeat_byte [<>, 48, pad], ds] ~> strip_zeros
}

// Format a canonical rational `n/d` (`d > 0`, gcd 1) as a JSON decimal: the exact finite
// decimal when it terminates within 12 fractional places, else rounded (half away from zero)
// to 12 places. `scaled` is `round(|n|·10^12 / d)` via the exact integer identity
// `(2·|n|·10^12 + d) / (2d)`; trailing zeros are then stripped.
format_rational = #[(n): 'int, (d): 'int] {
  neg? = { __integer_compare__ [$n, 0] ~> =-1 }
  mag = {
    | neg? => __integer_subtract__ [0, $n]
    | $n
  }
  p10 = pow10 [1, 12]

  scaled = __integer_divide__ [
    __integer_add__ [__integer_multiply__ [2, __integer_multiply__ [mag, p10]], $d],
    __integer_multiply__ [2, $d],
  ]

  {
    | scaled ~> =0 => "0"
    | {
      intpart = __integer_divide__ [scaled, p10]
      fracpart = __integer_modulo__ [scaled, p10]
      ib = %str.from_int intpart ~> .0
      full = {
        | fracpart ~> =0 => ib
        | %bin.concat [ib, %bin.concat [<2e>, frac_bytes [fracpart, 12]]]
      }
      {
        | neg? => %bin.concat [<2d>, full] ~> Str[~]
        | full ~> Str[~]
      }
    }
  }
}

// Serialize a `'%json` value to its compact string form, self-passed to recurse.
str_step = #[(self): ^, (v): '] -> '%str {
  go = #' { $$self [$$self, $] }
  $v ~> {
    | =Null => "null"
    | =True => "true"
    | =False => "false"
    | =('int & n) => %str.from_int n
    | =Rational[n, d] => format_rational [n, d]
    | =Str[bytes] => escape_str Str[bytes]
    | =Array[items] => {
      body = join_strs [items, go]

      %str.concat ["[", body] ~> %str.concat [~, "]"]
    }
    | =Object[pairs] => {
      render = #['%str, '] { %str.concat [escape_str $0, ":"] ~> %str.concat [~, go $1] }
      body = join_strs [pairs, render]

      %str.concat ["\{", body] ~> %str.concat [~, "}"]
    }
  }
}

stringify = #' {
  :doc "Serializes a '%json value to its compact JSON string form."
  str_step [str_step, $]
}

// === Query and update ===================================================================
// The document-model API: query and edit `'%json` values generically. Every function
// accepts `'opt` in its JSON-valued operands and answers nil for a failed lookup or a
// mismatched kind (an object key applied to an array, say), so deep access reads as one
// pipeline — within a chain nil flows onward, a later step over it answers nil again, and
// the provenance stamp on the first miss survives to the end.
//
// A key is an object key (`'%str`), a 0-based array index (`'int`), or a path — a list of
// either, applied outermost-first. The empty path names the value itself, so `get` with
// `%list{}` is identity and `set` with it replaces the whole value.
//
// Duplicate object keys (which only `parse` can introduce) are handled coherently:
// `get` answers the last binding, matching what mainstream parsers keep; `set` rewrites
// the first occurrence in place and drops the rest; `delete` removes every occurrence.

'key = '%str | 'int | '%list<('%str | 'int)>
'pairs = '%list<['%str, ']>

// The last value bound to `key` in an object's pair list, or nil.
obj_get = #[(pairs): 'pairs, (key): '%str, (found): 'opt] {
  $pairs ~> {
    | =Nil => $found
    | =Cons[[^$key, v], rest] => ^ [rest, $key, v]
    | =Cons[_, rest] => ^ [rest, $key, $found]
  }
}

// One key applied to one value: an object key or an array index. The `=(' & v)` narrow
// comes first: destructuring `'opt` directly would re-root the payload's recursion at
// the nil-bearing union, poisoning the element types.
get1 = #[(value): 'opt, (key): ('%str | 'int)] -> 'opt {
  $value ~> =(' & v)
  $key ~> {
    | =('%str & k) => v ~> =Object[~] ~> obj_get [~, k, []]
    | =('int & i) => v ~> =Array[~] ~> %list.nth [~, i]
  }
}

// A path applied step by step, outermost key first. Nil short-circuits via `get1`.
get_path = #[(value): 'opt, (path): '%list<('%str | 'int)>] -> 'opt {
  | $path ~> =Nil => $value
  | $path ~> =Cons[k, rest] => ^ [get1 [$value, k], rest]
}

get = #[(value): 'opt, (key): 'key] -> 'opt {
  :doc "The value at a key — an object key, a 0-based array index, or a path list of either. Nil when absent or the kind mismatches."
  $key ~> {
    | =(('%str | 'int) & k) => get1 [$value, k]
    | =('%list<('%str | 'int)> & path) => get_path [$value, path]
  }
}

// Rebuild a pair list with `key` bound to `new`: the first occurrence is rewritten in
// place, later duplicates are dropped, and an absent key is appended at the end.
obj_set = #[(rest): 'pairs, (key): '%str, (new): ', (acc): 'pairs, (seen?): (Ok | [])] -> 'pairs {
  $rest ~> {
    | =Nil => {
      | $seen? => %list.reverse $acc
      | %list.reverse Cons[[$key, $new], $acc]
    }
    | =Cons[[^$key, _], tail] => {
      | $seen? => ^ [tail, $key, $new, $acc, Ok]
      | ^ [tail, $key, $new, Cons[[$key, $new], $acc], Ok]
    }
    | =Cons[pair, tail] => ^ [tail, $key, $new, Cons[pair, $acc], $seen?]
  }
}

// Rebuild an item list with the element at `index` replaced. Out of range → nil.
arr_set = #[(rest): '%list<'>, (index): 'int, (new): ', (acc): '%list<'>] -> ('%list<'> | []) {
  $rest ~> {
    | =Nil => []
    | =Cons[x, tail] => {
      | $index ~> =0 => %list.chain [%list.reverse $acc, Cons[$new, tail]]
      | ^ [tail, %num.sub [$index, 1], $new, Cons[x, $acc]]
    }
  }
}

// One key set on one value.
set1 = #[(value): 'opt, (key): ('%str | 'int), (new): '] -> 'opt {
  $value ~> =(' & v)
  $key ~> {
    | =('%str & k) => v ~> =Object[~] ~> obj_set [~, k, $new, Nil, []] ~> Object[~]
    | =('int & i) => v ~> =Array[~] ~> Array[arr_set [~, i, $new, Nil] ~> ='%list<'>]
  }
}

// A path set: recurse to the leaf, then rebuild each level on the way back out. A missing
// intermediate makes the inner set nil, which propagates. Self-passed to recurse.
set_step = #[(self): ^, (value): 'opt, (path): '%list<('%str | 'int)>, (new): '] -> 'opt {
  $path ~> {
    | =Nil => $new
    | =Cons[k, Nil] => set1 [$value, k, $new]
    | =Cons[k, rest] => set1 [$value, k, $self [$self, get1 [$value, k], rest, $new] ~> =']
  }
}

set = #[(value): 'opt, (key): 'key, (new): 'opt] -> 'opt {
  :doc "The value with `new` at a key or path: replaced in place when present, appended when an object key is absent. Nil when a container along the path is missing, the kind mismatches, or an index is out of range."
  $new ~> =(' & j)
  $key ~> {
    | =(('%str | 'int) & k) => set1 [$value, k, j]
    | =('%list<('%str | 'int)> & path) => set_step [set_step, $value, path, j]
  }
}

update = #[(value): 'opt, (key): 'key, (f): #' -> 'opt] -> 'opt {
  :doc "The value with `f` applied to what a key or path names. Nil when the target is absent, or when `f` answers nil."
  set [$value, $key, get [$value, $key] ~> =' ~> $f]
}

// Remove every binding of `key` from a pair list.
obj_delete = #[(rest): 'pairs, (key): '%str, (acc): 'pairs] -> 'pairs {
  $rest ~> {
    | =Nil => %list.reverse $acc
    | =Cons[[^$key, _], tail] => ^ [tail, $key, $acc]
    | =Cons[pair, tail] => ^ [tail, $key, Cons[pair, $acc]]
  }
}

// Remove the element at `index`, shifting the rest down. Out of range → unchanged.
arr_delete = #[(rest): '%list<'>, (index): 'int, (acc): '%list<'>] -> '%list<'> {
  $rest ~> {
    | =Nil => %list.reverse $acc
    | =Cons[x, tail] => {
      | $index ~> =0 => %list.chain [%list.reverse $acc, tail]
      | ^ [tail, %num.sub [$index, 1], Cons[x, $acc]]
    }
  }
}

// One key deleted from one value. Deletion is idempotent: an absent key or index answers
// the value unchanged; only a kind mismatch is nil.
delete1 = #[(value): 'opt, (key): ('%str | 'int)] -> 'opt {
  $value ~> =(' & v)
  $key ~> {
    | =('%str & k) => v ~> =Object[~] ~> obj_delete [~, k, Nil] ~> Object[~]
    | =('int & i) => v ~> =Array[~] ~> arr_delete [~, i, Nil] ~> Array[~]
  }
}

// A path delete: a missing intermediate means the target is already absent, so the value
// answers unchanged. Self-passed to recurse.
delete_step = #[(self): ^, (value): 'opt, (path): '%list<('%str | 'int)>] -> 'opt {
  $path ~> {
    | =Nil => []
    | =Cons[k, Nil] => delete1 [$value, k]
    | =Cons[k, rest] => get1 [$value, k] ~> {
      | =(' & child) => set1 [$value, k, $self [$self, child, rest] ~> =']
      | $value
    }
  }
}

delete = #[(value): 'opt, (key): 'key] -> 'opt {
  :doc "The value without what a key or path names; unchanged when already absent (the empty path deletes the whole value: nil). Nil when the kind mismatches."
  $key ~> {
    | =(('%str | 'int) & k) => delete1 [$value, k]
    | =('%list<('%str | 'int)> & path) => delete_step [delete_step, $value, path]
  }
}

merge = #[(value): 'opt, (with): 'opt] -> 'opt {
  :doc "A shallow merge of two objects: the first's pairs in their order with the second's values winning per key, then the second's remaining pairs in its order. Nil unless both are objects."
  $value ~> =' ~> =Object[a]
  $with ~> =' ~> =Object[b]
  merged = %list.map [a, #{ obj_get [b, $0, []] ~> { =(' & bv) => [$0, bv] | [$0, $1] } }]
  extra = %list.filter [b, #{ obj_get [a, $0, []] ~> =[]; $ }]
  %list.chain [merged, extra] ~> Object[~]
}

to_dict = #'opt {
  :doc "An object's pairs as a %dict (later duplicates win, matching `get`); order is not preserved. Nil for anything but an object."
  =' ~> =Object[~] ~> %dict.from
}

object = #('%dict<'%str, '> | 'pairs) -> ' {
  :doc "An Object from a %dict or a [key, value] pair list. A dict's entries arrive in its own (hash) order."
  | =('pairs & pairs) => Object[pairs]
  | =('%dict<'%str, '> & d) => Object[%dict.entries d]
}

array = #'%list<'> -> ' {
  :doc "An Array from a list of JSON values."
  Array[$]
}

// === Typed boundary =====================================================================
// `decode<'t>`/`encode<'t>` convert between the document model and ordinary typed
// values, driven by an explicit type argument (type-consuming, like `%data.decode`).
// Objects map to tuples with labelled fields (keys matched by label, order-free, extra
// keys ignored), arrays to `%list`, `true`/`false` to `True`/`False`, and a field type
// admitting nil makes its key optional: absent or `null` decode as nil, and a nil field
// is omitted on encode. A `'%json`-typed part passes the raw subtree through verbatim.

decode = __json_decode__ ~> {
  :doc "Decodes a '%json value (or nil, which passes through) as the explicitly-given expected type: `%json.decode<'user> doc` answers `'user | []` — nil for any mismatch. Unions decode by ordered choice, like %data.decode. The expected type must be concrete at the naming site; `parse ~> decode<'t>` covers text."
}

encode = __json_encode__ ~> {
  :doc "Encodes a value of the explicitly-given type as a '%json document: `%json.encode<'user> u ~> %json.stringify` — the inverse of `decode`. Values with no JSON form (functions, processes, refs, resources, binaries, dicts, unlabelled tuples) are a runtime error."
}

{
  :dialect json
  (parse, stringify, get, set, update, delete, merge, to_dict, object, array, decode, encode)
}
