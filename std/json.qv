// A JSON dialect: `%json{ { "a": 1, "b": [2, x], "c": ~ } }` parses the brace content at
// compile time into a `'%json` value. In value position, a bare identifier that isn't a
// JSON keyword (`x` above) and `~` are caller escapes: their spans are spliced as host
// code (`Unquote`), evaluated in the caller's scope — `~` is the value flowing into the
// dialect term. Both must evaluate to `'%json`-shaped values.
//
// The grammar is built from `%parse` combinators, tying the value↔array/object recursion
// with the concrete-knot idiom from `%parse`'s header; expression trees are built with
// the `%meta` constructors.
//
// Notes:
//   - A JSON number is an exact `'%num.coeff` (an `'int`, or a `'rational` for a non-integer):
//     `3.14` parses to exactly `157/50`, with no float rounding. The `%json{…}` dialect is
//     still integer-only (its literal grammar predates this); only the runtime `parse` reads
//     decimals/exponents. `stringify` emits a whole `'int` as digits, a terminating rational
//     as its exact decimal, and a non-terminating one (e.g. `1/3`) rounded to 12 fractional
//     digits — so JSON-originated data round-trips exactly, and only computed fractions round.
//   - String escapes: `\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\t`, `\r` (no `\u`).
//   - A trailing comma before `]`/`}` is tolerated.

' =
  | Null
  | True
  | False
  | '%num.coeff
  | Str['bin]
  | Array[(Nil | Cons[^, ^1])]
  | Object[(Nil | Cons[[Str['bin], ^], ^1])]

'expr = '%meta.expr

// A byte token with leading whitespace skipped.
tok = #['int, Str['bin]] { [&%parse.ws, [$0, $1] %parse.byte] %parse.right }

// `~`: the value flowing into the dialect term, spliced as its own 1-byte host span.
ripple_p = #'%parse {
  =st
  tilde = [126, "'~'"] %parse.byte
  st tilde
  =[_, st2]
  [Unquote[offset: st.pos, length: 1], st2]
}

// An identifier: the `null`/`true`/`false` keywords, or a caller escape — any other
// identifier's span is spliced as host code (a caller-scope variable).
word_p = #'%parse {
  =st
  st %parse.ident
  =[w, st2]
  w {
    | ="null" => [Tuple[name: "Null", fields: Nil], st2]
    | ="true" => [Tuple[name: "True", fields: Nil], st2]
    | ="false" => [Tuple[name: "False", fields: Nil], st2]
    | [
      Unquote[offset: st.pos, length: [st2.pos, st.pos] __integer_subtract__],
      st2,
    ]
  }
}

// The value grammar, self-passed to tie the value↔array/object recursion.
value_step = #[#^ -> (['expr, '%parse] | []), '%parse] {
  =[self, st]
  value = #'%parse { [&self, $] self }

  comma = [44, "','"] tok

  elems = [&value, &comma] %parse.sep_end_by
  a1 = [[91, "'['"] %parse.byte, &elems] %parse.right
  a2 = [&a1, [93, "']'"] tok] %parse.left

  array =
    [
      &a2,
      #{
        Tuple[name: "Array", fields: Cons[$ %meta.list_expr, Nil]]
      },
    ] %parse.map

  key = [&%parse.ws, &%parse.quoted] %parse.right
  k1 = [&key, [58, "':'"] tok] %parse.left

  pair =
    [[&k1, &value] %parse.then, #{ [$0, $1] %meta.pair2 }] %parse.map

  pairs = [&pair, &comma] %parse.sep_end_by
  o1 = [[123, "'\{'"] %parse.byte, &pairs] %parse.right
  o2 = [&o1, [125, "'}'"] tok] %parse.left

  object =
    [
      &o2,
      #{
        Tuple[name: "Object", fields: Cons[$ %meta.list_expr, Nil]]
      },
    ] %parse.map

  composite =
    [&array, &object, &%parse.quoted, &%parse.int] %parse.alt4

  leaf = [&ripple_p, &word_p] %parse.alt2
  core = [&composite, &leaf] %parse.alt2
  core_ws = [&%parse.ws, &core] %parse.right

  st core_ws
}

value = #'%parse { [&value_step, $] value_step }

// The dialect entry point: the compiler calls this with the dialect context record; the
// grammar needs only the content (escape spans come from its own positions).
json = #(content: Str['bin]) {
  full = [&value, &%parse.ws] %parse.left, [$content, &full] %parse.run
}

// === Runtime codec ======================================================================
// `parse`/`stringify` read and write JSON at runtime, over `Str['bin]`. They share the
// `%parse` combinators with the dialect but not its grammar: the dialect builds `%meta`
// code to splice into the caller, whereas these build `'%json` values directly — so the
// codec has no unquoting and `null`/`true`/`false` are the only bare words it accepts.

// `10^k` for `k >= 0`. Shared by the number parser (scaling) and the rational formatter.
pow10 = #['int, 'int] {
  =[acc, k]
  {
    | k =0 => acc
    | {
      [[acc, 10] __integer_multiply__, [k, 1] __integer_subtract__] ^
    }
  }
}

// A canonical rational with denominator 1 is an integer; hand back the plain `'int`. Keeps
// whole-valued JSON numbers (`42`, `42.0`, `1e2`) as ints rather than `Rational[_, 1]`.
lower_num = #'%num.coeff { =Rational[n, 1] => n | =x => x }

// A digit byte (for `take_while`): the byte itself when it is `0`–`9`, else nil.
digit? = #'int { [$, 48] __integer_compare__ =(0 | 1), [$, 57] __integer_compare__ =(-1 | 0), $ }

digits = &digit? %parse.take_while

// The byte at the parse state's position, or nil at end of input.
peek_at = #'%parse { [$pos, $len] %num.lt?, [$data, $pos] %bin.get_byte }

// Assemble a JSON number from its scanned parts: `sign` (±1), the integer- and fractional-
// part digit bytes, and the exponent. Exact: the value is `sign · M · 10^(exp − |frac|)`,
// where `M` is the integer- and fractional-part digits read as one integer — an `'int` when
// that power is non-negative (a whole number), otherwise a reduced `'rational`.
build_number = #[sign: 'int, int_b: 'bin, frac_b: 'bin, exp: 'int] {
  =[sign: s, int_b: ib, frac_b: fb, exp: e]

  [ib, fb] %bin.concat
  ~> Str[~] %str.parse_int
  ~> =('int)mag

  m = [s, mag] __integer_multiply__
  total_exp = [e, fb %bin.length] __integer_subtract__
  {
    | [total_exp, 0] __integer_compare__ =(0 | 1) => [m, [1, total_exp] pow10] __integer_multiply__
    | {
      den = [1, [0, total_exp] __integer_subtract__] pow10
      [m, den] %num.div =('%num.coeff)r
      r lower_num
    }
  }
}

// A JSON number: `-? int-digits (. frac-digits)? ([eE] [+-]? exp-digits)?`, as a `'%num.coeff`.
number = #'%parse {
  =st0
  neg? = { st0 peek_at =45 => Ok | [] }
  st1 = {
    | neg? => st0 ~[..., pos: [st0.pos, 1] %num.add]
    | st0
  }
  sign = { neg? => -1 | 1 }

  st1 digits =[ib, st2]
  {
    | ib %bin.length =0 => [st0, "a number"] %parse.fail_in
    | Ok
  }

  frac = {
    | st2 peek_at =46 => {
      st2
      ~> ~[..., pos: [st2.pos, 1] %num.add] digits
      ~> =[fbb, st3a]

      {
        | fbb %bin.length =0 => [st2, "digits after '.'"] %parse.fail_in
        | [fbb, st3a]
      }
    }
    | [0x, st2]
  }
  frac =[fb, st3]

  ex = {
    | st3 peek_at =(101 | 69) => {
      est = st3 ~[..., pos: [st3.pos, 1] %num.add]
      esign = { est peek_at =45 => -1 | 1 }
      est2 = {
        | est peek_at =(43 | 45) => est ~[..., pos: [est.pos, 1] %num.add]
        | est
      }
      est2 digits =[ebb, st4a]
      {
        | ebb %bin.length =0 => [st3, "digits in the exponent"] %parse.fail_in
        | ebb Str[~] %str.parse_int =('int)emag, [[esign, emag] __integer_multiply__, st4a]
      }
    }
    | [0, st3]
  }
  ex =[expv, st4]

  val =
    [sign: sign, int_b: ib, frac_b: fb, exp: expv] build_number

  [val, st4]
}

// The runtime value grammar, its recursion tied with `%parse.rec`. `%parse.quoted` already
// yields the `Str['bin]` leaf verbatim; `number` yields the `'%num.coeff` leaf; only the
// composite and keyword actions build the rest of `'%json`.
parse_value = #['%parse.p<'>, '%parse] {
  =[value_p, st]

  comma = [44, "','"] tok

  elems = [&value_p, &comma] %parse.sep_end_by
  a1 = [[91, "'['"] %parse.byte, &elems] %parse.right
  a2 = [&a1, [93, "']'"] tok] %parse.left
  array = [&a2, #{ Array[$] }] %parse.map

  key = [&%parse.ws, &%parse.quoted] %parse.right
  k1 = [&key, [58, "':'"] tok] %parse.left
  pair = [&k1, &value_p] %parse.then
  pairs = [&pair, &comma] %parse.sep_end_by
  o1 = [[123, "'\{'"] %parse.byte, &pairs] %parse.right
  o2 = [&o1, [125, "'}'"] tok] %parse.left
  object = [&o2, #{ Object[$] }] %parse.map

  keyword = #'%parse {
    =kst
    kst %parse.ident
    =[w, kst2]
    w {
      | ="null" => [Null, kst2]
      | ="true" => [True, kst2]
      | ="false" => [False, kst2]
      | [kst, "null, true, or false"] %parse.fail_in
    }
  }

  composite =
    [&array, &object, &%parse.quoted, &number] %parse.alt4

  core = [&composite, &keyword] %parse.alt2
  core_ws = [&%parse.ws, &core] %parse.right

  st core_ws
}

parse_p = &parse_value %parse.rec

parse = #Str['bin] {
  :doc "Parses a JSON string into a '%json value, or nil with a positioned :error on malformed input."
  full = [&parse_p, &%parse.ws] %parse.left, [$, &full] %parse.run
}

// Escape a string's interior bytes. Only the escapes the parser understands are emitted
// (`\" \\ \b \f \n \r \t`); every other byte passes through verbatim (no `\uXXXX`).
esc_loop = #['bin, 'int, 'int, 'bin] {
  =[data, pos, len, acc]
  {
    | [pos, len] __integer_compare__ =(0 | 1) => acc
    | {
      b = [data, pos] %bin.get_byte
      acc2 = b {
        | =34 => [acc, 0x5c22] %bin.concat
        | =92 => [acc, 0x5c5c] %bin.concat
        | =8 => [acc, 0x5c62] %bin.concat
        | =12 => [acc, 0x5c66] %bin.concat
        | =10 => [acc, 0x5c6e] %bin.concat
        | =13 => [acc, 0x5c72] %bin.concat
        | =9 => [acc, 0x5c74] %bin.concat
        | [acc, b, 1] %bin.append
      }
      [data, [pos, 1] %num.add, len, acc2] ^
    }
  }
}

// A JSON string literal: the bytes escaped and wrapped in double quotes.
escape_str = #Str['bin] {
  =Str[bytes]
  inner = [bytes, 0, bytes %bin.length, 0x] esc_loop
  [0x22, inner] %bin.concat [~, 0x22] %bin.concat Str[~]
}

// Concatenate a `Nil`/`Cons` list's elements — each rendered to a string by `render` —
// separated by commas. `first?` is 1 until the first element has been emitted.
join_strs = #<'x>[(Nil | Cons['x, ^]), #'x -> Str['bin], Str['bin], 'int] {
  =[items, render, acc, first]
  items {
    | =Nil => acc
    | =Cons[h, t] => {
      piece = h render
      acc2 = {
        | first =1 => [acc, piece] %str.concat
        | [acc, ","] %str.concat [~, piece] %str.concat
      }
      [t, &render, acc2, 0] ^
    }
  }
}

// A binary of `n` copies of byte `b`.
repeat_byte = #['bin, 'int, 'int] {
  =[acc, b, n]
  {
    | n =0 => acc
    | {
      [[acc, b, 1] %bin.append, b, [n, 1] __integer_subtract__] ^
    }
  }
}

// Drop trailing `0x30` (`'0'`) bytes from a binary.
strip_zeros = #'bin {
  =b
  len = b %bin.length
  {
    | len =0 => b
    | [b, [len, 1] __integer_subtract__] %bin.get_byte
      ~> =48 => [b, 0, [len, 1] __integer_subtract__] %bin.slice ^
    | b
  }
}

// The `width`-digit, zero-padded decimal of `fracpart` (which is `< 10^width`), with trailing
// zeros stripped — the digits that follow the decimal point.
frac_bytes = #['int, 'int] {
  =[fracpart, width]
  ds = fracpart %str.from_int .0
  pad = [width, ds %bin.length] __integer_subtract__

  [[0x, 48, pad] repeat_byte, ds] %bin.concat
  ~> strip_zeros
}

// Format a canonical rational `n/d` (`d > 0`, gcd 1) as a JSON decimal: the exact finite
// decimal when it terminates within 12 fractional places, else rounded (half away from zero)
// to 12 places. `scaled` is `round(|n|·10^12 / d)` via the exact integer identity
// `(2·|n|·10^12 + d) / (2d)`; trailing zeros are then stripped.
format_rational = #['int, 'int] {
  =[n, d]
  neg? = [n, 0] __integer_compare__ =-1
  mag = { neg? => [0, n] __integer_subtract__ | n }
  p10 = [1, 12] pow10

  scaled =
    [
      [
        [2, [mag, p10] __integer_multiply__] __integer_multiply__,
        d,
      ] __integer_add__,
      [2, d] __integer_multiply__,
    ] __integer_divide__

  {
    | scaled =0 => "0"
    | {
      intpart = [scaled, p10] __integer_divide__
      fracpart = [scaled, p10] __integer_modulo__
      ib = intpart %str.from_int .0
      full = {
        | fracpart =0 => ib
        | {
          [ib, [0x2e, [fracpart, 12] frac_bytes] %bin.concat] %bin.concat
        }
      }
      {
        | neg? => [0x2d, full] %bin.concat Str[~]
        | full Str[~]
      }
    }
  }
}

// Serialize a `'%json` value to its compact string form, self-passed to recurse.
str_step = #[#^ -> Str['bin], '] -> Str['bin] {
  =[self, v]
  go = #' { [&self, $] self }
  v {
    | =Null => "null"
    | =True => "true"
    | =False => "false"
    | =('int)n => n %str.from_int
    | =Rational[n, d] => [n, d] format_rational
    | =Str[bytes] => Str[bytes] escape_str
    | =Array[items] => {
      body = [items, &go, "", 1] join_strs, ["[", body] %str.concat [~, "]"] %str.concat
    }
    | =Object[pairs] => {
      render = #[Str['bin], '] {
        [$0 escape_str, ":"] %str.concat
        ~> [~, $1 go] %str.concat
      }
      body = [pairs, &render, "", 1] join_strs
      ["\{", body] %str.concat [~, "}"] %str.concat
    }
  }
}

stringify = #' {
  :doc "Serializes a '%json value to its compact JSON string form."
  [&str_step, $] str_step
}

{
  :dialect &json
  [parse: &parse, stringify: &stringify]
}
