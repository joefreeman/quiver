// Cryptographic hashing, pure Quiver over the integer/binary builtins (no imports).
// SHA-256 (FIPS 180-4) and HMAC-SHA256 (RFC 2104) — the signing primitive for
// `%http/session`'s cookies — plus SHA-1 (legacy, for protocol compatibility such as
// the WebSocket handshake; not for new designs).
//
// Representation notes: the round constants, initial state, and message schedule are
// *binaries* — `__binary_get__` reads 32-bit big-endian words directly, so no array
// type is needed. All word arithmetic is masked to 32 bits.

// Masked 32-bit add.
madd = #['int, 'int] {
  __integer_and__ [__integer_add__ [$0, $1], 4294967295]
}

// Rotate a 32-bit word right by n.
rotr = #[(x): 'int, (n): 'int] {
  __integer_or__ [
    __integer_shift__ [$x, __integer_subtract__ [0, $n]],
    __integer_shift__ [$x, __integer_subtract__ [32, $n]],
  ] ~> __integer_and__ [~, 4294967295]
}

// Logical right shift.
shr = #['int, 'int] {
  __integer_shift__ [$0, __integer_subtract__ [0, $1]]
}

// The 32-bit word at index i of a binary of big-endian words.
w_at = #['bin, 'int] {
  __binary_get__ [$0, __integer_multiply__ [$1, 4], 0, 32]
}

ssig0 = #'int {
  __integer_xor__ [__integer_xor__ [rotr [$, 7], rotr [$, 18]], shr [$, 3]]
}
ssig1 = #'int {
  __integer_xor__ [__integer_xor__ [rotr [$, 17], rotr [$, 19]], shr [$, 10]]
}
bsig0 = #'int {
  __integer_xor__ [__integer_xor__ [rotr [$, 2], rotr [$, 13]], rotr [$, 22]]
}
bsig1 = #'int {
  __integer_xor__ [__integer_xor__ [rotr [$, 6], rotr [$, 11]], rotr [$, 25]]
}

// The SHA-256 round constants (64 words) and initial state (8 words).
k256 = 
h256 = 0x6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19

// Extend a block's 16 words to the full 64-word schedule.
extend = #[(w): 'bin, (t): 'int] {
  | $t ~> =64 => $w
  | {
    wt = madd [w_at [$w, __integer_subtract__ [$t, 2]] ~> ssig1, w_at [$w, __integer_subtract__ [$t, 7]]] ~> madd [~, w_at [$w, __integer_subtract__ [$t, 15]] ~> ssig0] ~> madd [
      ~,
      w_at [$w, __integer_subtract__ [$t, 16]],
    ]

    ^ [__binary_append__ [$w, wt, 4], __integer_add__ [$t, 1]]
  }
}

'state = ['int, 'int, 'int, 'int, 'int, 'int, 'int, 'int]

// The 64 compression rounds over one schedule.
rounds = #[(w): 'bin, (t): 'int, (state): 'state] {
  | $t ~> =64 => $state
  | {
    $state ~> =[a, b, c, d, e, f, g, h]
    ch = __integer_xor__ [
      __integer_and__ [e, f],
      __integer_and__ [__integer_xor__ [e, 4294967295], g],
    ]

    temp1 = madd [h, bsig1 e] ~> madd [~, ch] ~> madd [~, w_at [k256, $t]] ~> madd [
      ~,
      w_at [$w, $t],
    ]

    maj = __integer_xor__ [
      __integer_xor__ [__integer_and__ [a, b], __integer_and__ [a, c]],
      __integer_and__ [b, c],
    ]

    temp2 = madd [bsig0 a, maj]
    ^ [
      $w,
      __integer_add__ [$t, 1],
      [madd [temp1, temp2], a, b, c, madd [d, temp1], e, f, g],
    ]
  }
}

// Fold each 64-byte block of the padded message into the state.
blocks = #[(data): 'bin, (off): 'int, (st): 'state] {
  | __integer_compare__ [$off, __binary_length__ $data] ~> =(0 | 1) => $st
  | {
    w = extend [
      __binary_slice__ [$data, $off, __integer_add__ [$off, 64]],
      16,
    ]

    $st ~> =[a0, b0, c0, d0, e0, f0, g0, h0]
    rounds [w, 0, $st]
    =[a, b, c, d, e, f, g, h]
    st2 = [
      madd [a0, a],
      madd [b0, b],
      madd [c0, c],
      madd [d0, d],
      madd [e0, e],
      madd [f0, f],
      madd [g0, g],
      madd [h0, h],
    ]
    ^ [$data, __integer_add__ [$off, 64], st2]
  }
}

// The message padded to a whole number of blocks: 0x80, zeros, 8-byte bit length.
pad = #'bin {
  =msg
  len = __binary_length__ msg
  after = __integer_add__ [len, 1]

  zeros = __integer_subtract__ [56, __integer_modulo__ [after, 64]] ~> __integer_add__ [~, 64] ~> __integer_modulo__ [
    ~,
    64,
  ]

  __binary_append__ [msg, 128, 1] ~> __binary_concat__ [~, __binary_new__ zeros] ~> __binary_append__ [
    ~,
    __integer_multiply__ [len, 8],
    8,
  ]
}

digest = #'state {
  =[a, b, c, d, e, f, g, h]

  __binary_append__ [0x, a, 4] ~> __binary_append__ [~, b, 4] ~> __binary_append__ [~, c, 4] ~> __binary_append__ [~, d, 4] ~> __binary_append__ [~, e, 4] ~> __binary_append__ [~, f, 4] ~> __binary_append__ [~, g, 4] ~> __binary_append__ [
    ~,
    h,
    4,
  ]
}

sha256 = #'bin {
  :doc "The SHA-256 digest of the bytes, as a 32-byte binary."
  init = [
    w_at [h256, 0],
    w_at [h256, 1],
    w_at [h256, 2],
    w_at [h256, 3],
    w_at [h256, 4],
    w_at [h256, 5],
    w_at [h256, 6],
    w_at [h256, 7],
  ]
  blocks [pad $, 0, init] ~> digest
}

// --- SHA-1 (FIPS 180-4) ---
// Shares `pad` (identical padding) and the word helpers. Rotate-left n is
// rotate-right (32 - n).

// The SHA-1 initial state (5 words).
h1 = 0x67452301efcdab8998badcfe10325476c3d2e1f0

// Extend a block's 16 words to the full 80-word SHA-1 schedule:
// w[t] = rotl1(w[t-3] ^ w[t-8] ^ w[t-14] ^ w[t-16]).
extend1 = #[(w): 'bin, (t): 'int] {
  | $t ~> =80 => $w
  | {
    x = __integer_xor__ [
      __integer_xor__ [
        w_at [$w, __integer_subtract__ [$t, 3]],
        w_at [$w, __integer_subtract__ [$t, 8]],
      ],
      __integer_xor__ [
        w_at [$w, __integer_subtract__ [$t, 14]],
        w_at [$w, __integer_subtract__ [$t, 16]],
      ],
    ]

    ^ [__binary_append__ [$w, rotr [x, 31], 4], __integer_add__ [$t, 1]]
  }
}

'state1 = ['int, 'int, 'int, 'int, 'int]

// The round function and constant for round t: choose / parity / majority / parity
// by 20-round band.
fk1 = #[(t): 'int, (b): 'int, (c): 'int, (d): 'int] {
  | __integer_compare__ [$t, 20] ~> =-1 => [
    f: __integer_or__ [
      __integer_and__ [$b, $c],
      __integer_and__ [__integer_xor__ [$b, 4294967295], $d],
    ],
    constant: 1518500249,
  ]
  | __integer_compare__ [$t, 40] ~> =-1 => [
    f: __integer_xor__ [__integer_xor__ [$b, $c], $d],
    constant: 1859775393,
  ]
  | __integer_compare__ [$t, 60] ~> =-1 => [
    f: __integer_or__ [
      __integer_or__ [__integer_and__ [$b, $c], __integer_and__ [$b, $d]],
      __integer_and__ [$c, $d],
    ],
    constant: 2400959708,
  ]
  | [f: __integer_xor__ [__integer_xor__ [$b, $c], $d], constant: 3395469782]
}

// The 80 compression rounds over one schedule.
rounds1 = #[(w): 'bin, (t): 'int, (state): 'state1] {
  | $t ~> =80 => $state
  | {
    $state ~> =[a, b, c, d, e]
    fk1 [$t, b, c, d] ~> =(f, constant)

    temp = madd [rotr [a, 27], f] ~> madd [~, e] ~> madd [~, constant] ~> madd [~, w_at [$w, $t]]

    ^ [$w, __integer_add__ [$t, 1], [temp, a, rotr [b, 2], c, d]]
  }
}

// Fold each 64-byte block of the padded message into the SHA-1 state.
blocks1 = #[(data): 'bin, (off): 'int, (st): 'state1] {
  | __integer_compare__ [$off, __binary_length__ $data] ~> =(0 | 1) => $st
  | {
    w = extend1 [
      __binary_slice__ [$data, $off, __integer_add__ [$off, 64]],
      16,
    ]

    $st ~> =[a0, b0, c0, d0, e0]
    rounds1 [w, 0, $st] ~> =[a, b, c, d, e]
    st2 = [madd [a0, a], madd [b0, b], madd [c0, c], madd [d0, d], madd [e0, e]]
    ^ [$data, __integer_add__ [$off, 64], st2]
  }
}

sha1 = #'bin {
  :doc "The SHA-1 digest of the bytes, as a 20-byte binary. Legacy — for protocol compatibility (e.g. the WebSocket handshake), not new designs."
  init = [w_at [h1, 0], w_at [h1, 1], w_at [h1, 2], w_at [h1, 3], w_at [h1, 4]]
  blocks1 [pad $, 0, init] ~> =[a, b, c, d, e]

  __binary_append__ [0x, a, 4] ~> __binary_append__ [~, b, 4] ~> __binary_append__ [~, c, 4] ~> __binary_append__ [~, d, 4] ~> __binary_append__ [
    ~,
    e,
    4,
  ]
}

ipad = 0x36363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636
opad = 0x5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c

hmac_sha256 = #[(key): 'bin, (msg): 'bin] {
  :doc "The HMAC-SHA256 of the message under the key, as a 32-byte binary."
  k1 = {
    | __integer_compare__ [__binary_length__ $key, 64] ~> =1 => sha256 $key
    | $key
  }

  kp = __binary_concat__ [
    k1,
    __integer_subtract__ [64, __binary_length__ k1] ~> __binary_new__,
  ]

  inner =
    __binary_concat__ [__binary_xor__ [kp, ipad], $msg] ~> sha256

  __binary_concat__ [__binary_xor__ [kp, opad], inner] ~> sha256
}

[sha256: &sha256, hmac_sha256: &hmac_sha256, sha1: &sha1]
