// A persistent hash map (HAMT) keyed by data values.
//
// Keys are any data value — integers, binaries, and tuples (strings included), nested
// freely; values are any type. A key is hashed by encoding it as %data notation and
// hashing the text, and stored entries keep the original key value (compared with
// structural equality), so keys never need decoding. Anything %data cannot encode —
// functions, processes, refs, resources — is a runtime error when used as a key. The map
// is an immutable, structurally-shared 32-way hash-array-mapped trie. Each internal
// `Node` carries a 32-bit `bitmap` recording which of its 32 slots are occupied, plus its
// children in slot order; a 5-bit slice of a key's 32-bit hash selects a slot at each
// level, and `popcount(bitmap & (bit - 1))` gives the child's position in the compact
// child list. Keys whose full hashes collide land in a `Collision` node holding a bucket
// of [key, value] entries.
//
// `get` returns the stored value or nil (`[]`), so a dict cannot usefully store nil as a
// value.
//
// Non-tail tree operations (`put`, `remove`) recurse with the self-passing idiom `f [f, ...]`,
// since `^` is tail-only and a binding isn't in scope in its own body. A `Node`'s children
// are `'list<^>` — the list alias instantiated with the dict's own recursion reference.

'list<'t> = Nil | Cons['t, ^]

'<'k, 'v> = Empty | Leaf['int, 'k, 'v] | Collision['int, 'list<['k, 'v]>] | Node['int, 'list<^>]

// --- key hashing -------------------------------------------------------------
hash = #_ { __data_encode__ ~ ~> __binary_hash32__ }

// 5-bit hash fragment at `shift` bits, and the compact child index for a slot bit.
fragment = #[(hash): 'int, (shift): 'int] {
  %num.sub [0, $shift] ~> %int.shift [$hash, ~] ~> %int.and [~, 31]
}

slot_index = #[(bitmap): 'int, (bit): 'int] {
  %num.sub [$bit, 1] ~> %int.and [$bitmap, ~] ~> %int.popcount
}

// --- generic list helpers (tail-recursive, à la %list) -----------------------
revcat = #<'t>[(acc): 'list<'t>, (rest): 'list<'t>] {
  $acc ~> {
    | =Nil => $rest
    | =Cons[h, t] => Cons[h, $rest] ~> ^ [t, ~]
  }
}

length = #[(list): 'list<_>, (n): 'int] {
  $list ~> {
    | =Nil => $n
    | =Cons[_, t] => ^ [t, %num.add [$n, 1]]
  }
}

map = #<'t, 'u>[(list): 'list<'t>, (f): #'t -> 'u, (acc): 'list<'u>] {
  $list ~> {
    | =Nil => revcat [$acc, Nil]
    | =Cons[h, t] => Cons[$f h, $acc] ~> ^ [t, $f, ~]
  }
}

// child at a compact index; `Empty` past the end (never reached for a set slot). Returning a
// node — total, rather than failing to nil on `Nil` — keeps `[]` out of the tree-op result types.
child_at = #<'k, 'v>[(children): 'list<'<'k, 'v>>, (index): 'int] {
  $children ~> {
    | =Nil => Empty
    | =Cons[h, t] => {
      | $index ~> =0 => h
      | %num.sub [$index, 1] ~> ^ [t, ~]
    }
  }
}

insert_at = #<'t>[(list): 'list<'t>, (index): 'int, (value): 't, (acc): 'list<'t>] {
  | $index ~> =0 => Cons[$value, $list] ~> revcat [$acc, ~]
  | $list ~> {
    | =Nil => Cons[$value, Nil] ~> revcat [$acc, ~]
    | =Cons[h, t] => %num.sub [$index, 1] ~> ^ [t, ~, $value, Cons[h, $acc]]
  }
}

update_at = #<'t>[(list): 'list<'t>, (index): 'int, (value): 't, (acc): 'list<'t>] {
  $list ~> {
    | =Nil => revcat [$acc, Nil]
    | =Cons[h, t] => {
      | $index ~> =0 => revcat [$acc, Cons[$value, t]]
      | %num.sub [$index, 1] ~> ^ [t, ~, $value, Cons[h, $acc]]
    }
  }
}

remove_at = #<'t>[(list): 'list<'t>, (index): 'int, (acc): 'list<'t>] {
  $list ~> {
    | =Nil => revcat [$acc, Nil]
    | =Cons[h, t] => {
      | $index ~> =0 => revcat [$acc, t]
      | %num.sub [$index, 1] ~> ^ [t, ~, Cons[h, $acc]]
    }
  }
}

// --- collision buckets -------------------------------------------------------
bucket_get = #<'k, 'v>[(entries): 'list<['k, 'v]>, (key): 'k] {
  $entries ~> {
    | =Nil => []
    | =Cons[[k, v], t] => { $key ~> =^k => v | ^ [t, $key] }
  }
}

bucket_put = #<'k, 'v>[(entries): 'list<['k, 'v]>, (key): 'k, (value): 'v, (acc): 'list<['k, 'v]>] {
  $entries ~> {
    | =Nil => Cons[[$key, $value], Nil] ~> revcat [$acc, ~]
    | =Cons[[k, v], t] => {
      | $key ~> =^k => Cons[[$key, $value], t] ~> revcat [$acc, ~]
      | Cons[[k, v], $acc] ~> ^ [t, $key, $value, ~]
    }
  }
}

bucket_remove = #<'k, 'v>[(entries): 'list<['k, 'v]>, (key): 'k, (acc): 'list<['k, 'v]>] {
  $entries ~> {
    | =Nil => revcat [$acc, Nil]
    | =Cons[[k, v], t] => {
      | $key ~> =^k => revcat [$acc, t]
      | Cons[[k, v], $acc] ~> ^ [t, $key, ~]
    }
  }
}

// --- tree operations ---------------------------------------------------------
get = #<'k, 'v>[(node): '<'k, 'v>, (key): 'k, (hash): 'int, (shift): 'int] {
  $node ~> {
    | =Empty => []
    | =Leaf[_, k, v] => { $key ~> =^k => v | [] }
    | =Collision[_, entries] => bucket_get [entries, $key]
    | =Node[bitmap, children] => {
      bit = fragment [$hash, $shift] ~> %int.shift [1, ~]

      {
        | %int.and [bitmap, bit] ~> =0 => []
        | {
          child = slot_index [bitmap, bit] ~> child_at [children, ~]

          %num.add [$shift, 5] ~> ^ [child, $key, $hash, ~]
        }
      }
    }
  }
}

// split two single entries (differing keys) into a fresh subtree at `shift`.
split_pair = #<'k, 'v>[
  (self): ^,
  (h1): 'int,
  (k1): 'k,
  (v1): 'v,
  (h2): 'int,
  (k2): 'k,
  (v2): 'v,
  (shift): 'int,
] -> '<'k, 'v> {
  // A pattern `&` can only reference a variable, not a parameter field, so bind the
  // second hash locally for the equality check.
  h2 = $h2
  {
    | $h1 ~> =^h2 => bucket_put [Nil, $k1, $v1, Nil] ~> bucket_put [~, $k2, $v2, Nil] ~> Collision[
        $h1,
        ~,
      ]
    | f1 = fragment [$h1, $shift]
      f2 = fragment [$h2, $shift]
      {
        | f1 ~> =^f2 => {
          children =
            %num.add [$shift, 5]
            ~> $self [$self, $h1, $k1, $v1, $h2, $k2, $v2, ~]
            ~> Cons[~, Nil]

          %int.shift [1, f1] ~> Node[~, children]
        }
        | {
          bitmap = %int.or [%int.shift [1, f1], %int.shift [1, f2]]

          {
            | %num.lt? [f1, f2] => Node[
                bitmap,
                Cons[Leaf[$h1, $k1, $v1], Cons[Leaf[$h2, $k2, $v2], Nil]],
              ]
            | Node[bitmap, Cons[Leaf[$h2, $k2, $v2], Cons[Leaf[$h1, $k1, $v1], Nil]]]
          }
        }
      }
  }
}

// split an existing node (a collision) against a new entry whose hash differs from it.
split_node = #<'k, 'v>[
  (self): ^,
  (cnode): '<'k, 'v>,
  (chash): 'int,
  (hash): 'int,
  (key): 'k,
  (value): 'v,
  (shift): 'int,
] -> '<'k, 'v> {
  fc = fragment [$chash, $shift]
  fh = fragment [$hash, $shift]
  {
    | fc ~> =^fh => Node[
        %int.shift [1, fc],
        Cons[
          $self [$self, $cnode, $chash, $hash, $key, $value, %num.add [$shift, 5]],
          Nil,
        ],
      ]
    | bitmap = %int.or [%int.shift [1, fc], %int.shift [1, fh]]

      {
        | %num.lt? [fc, fh] => Node[bitmap, Cons[$cnode, Cons[Leaf[$hash, $key, $value], Nil]]]
        | Node[bitmap, Cons[Leaf[$hash, $key, $value], Cons[$cnode, Nil]]]
      }
  }
}

put = #<'k, 'v>[
  (self): ^,
  (node): '<'k, 'v>,
  (key): 'k,
  (value): 'v,
  (hash): 'int,
  (shift): 'int,
] -> '<'k, 'v> {
  $node ~> {
    | =Empty => Leaf[$hash, $key, $value]
    | =Leaf[lhash, lkey, lvalue] => {
      | $key ~> =^lkey => Leaf[$hash, $key, $value]
      | split_pair [split_pair, lhash, lkey, lvalue, $hash, $key, $value, $shift]
    }
    | =Collision[chash, entries] => {
      | $hash ~> =^chash => Collision[chash, bucket_put [entries, $key, $value, Nil]]
      | split_node [split_node, $node, chash, $hash, $key, $value, $shift]
    }
    | =Node[bitmap, children] => {
      bit = fragment [$hash, $shift] ~> %int.shift [1, ~]
      idx = slot_index [bitmap, bit]
      {
        | %int.and [bitmap, bit] ~> =0 => Node[
            %int.or [bitmap, bit],
            insert_at [children, idx, Leaf[$hash, $key, $value], Nil],
          ]
        | child = child_at [children, idx]

          new_child = $self [$self, child, $key, $value, $hash, %num.add [$shift, 5]]

          Node[bitmap, update_at [children, idx, new_child, Nil]]
      }
    }
  }
}

// Canonicalize a node from its bitmap + children after a removal, so a dict's shape depends only
// on its contents (not on insertion/removal order): no children left collapses to `Empty`, and a
// lone child that is a `Leaf`/`Collision` is hoisted up — insertion never builds a single-`Leaf`
// node, so leaving one would be non-canonical. A lone `Node` child is a real shared-hash-prefix
// level and is kept.
collapse_node = #<'k, 'v>[(bitmap): 'int, (children): 'list<'<'k, 'v>>] {
  | $children ~> =Nil => Empty
  | $children ~> =Cons[only, Nil] => only ~> {
    | =Node[_, _] => Node[$bitmap, $children]
    | =leaf => leaf
  }
  | Node[$bitmap, $children]
}

// Drop the slot for `bit` (its child became `Empty`), then canonicalize. Non-recursive so the
// generic `remove_at` call sits outside `remove`'s self-passing recursion — where (a quirk of
// the type inferencer) it would otherwise leak its function type into the result type.
remove_slot = #<'k, 'v>[(bitmap): 'int, (bit): 'int, (children): 'list<'<'k, 'v>>, (index): 'int] {
  collapse_node [%int.and [$bitmap, %int.not $bit], remove_at [$children, $index, Nil]]
}

remove = #<'k, 'v>[
  (self): ^,
  (node): '<'k, 'v>,
  (key): 'k,
  (hash): 'int,
  (shift): 'int,
] -> '<'k, 'v> {
  $node ~> {
    | =Empty => Empty
    | =Leaf[lhash, k, v] => {
      | $key ~> =^k => Empty
      | Leaf[lhash, k, v]
    }
    | =Collision[chash, entries] => {
      kept = bucket_remove [entries, $key, Nil]
      {
        | kept ~> =Nil => Empty
        | kept ~> =Cons[[k, v], Nil] => Leaf[chash, k, v]
        | Collision[chash, kept]
      }
    }
    | =Node[bitmap, children] => {
      bit = fragment [$hash, $shift] ~> %int.shift [1, ~]
      {
        | %int.and [bitmap, bit] ~> =0 => Node[bitmap, children]
        | idx = slot_index [bitmap, bit]
          child = child_at [children, idx]
          $self [$self, child, $key, $hash, %num.add [$shift, 5]] ~> {
            | =Empty => remove_slot [bitmap, bit, children, idx]
            | =new => collapse_node [bitmap, update_at [children, idx, new, Nil]]
          }
      }
    }
  }
}

// collect every entry by walking a worklist of pending nodes (order is unspecified).
entries = #<'k, 'v>[(worklist): 'list<'<'k, 'v>>, (acc): 'list<['k, 'v]>] {
  $worklist ~> {
    | =Nil => $acc
    | =Cons[node, rest] => node ~> {
      | =Empty => ^ [rest, $acc]
      | =Leaf[_, k, v] => ^ [rest, Cons[[k, v], $acc]]
      | =Collision[_, ents] => ^ [rest, revcat [ents, $acc]]
      | =Node[_, children] => ^ [revcat [children, rest], $acc]
    }
  }
}

from = #<'k, 'v>[(self): ^, (d): '<'k, 'v>, (pairs): 'list<['k, 'v]>] -> '<'k, 'v> {
  $pairs ~> {
    | =Nil => $d
    | =Cons[[k, val], t] => put [put, $d, k, val, hash k, 0] ~> $self [$self, ~, t]
  }
}

// The iterable/collectable pair, shared by the exported `iter`/`collect` and the eager
// sequence functions below (which compose them around the lazy `%iter` operations).
to_iter = #<'k, 'v>'<'k, 'v> {
  Cons[~, Nil] ~> entries [~, Nil] ~> %iter.unfold [
    ~,
    #<'k, 'v>'list<['k, 'v]> { =Cons[e, t] => [e, t] | =Nil => [] },
  ]
}

from_iter = #<'k, 'v>'%iter<['k, 'v]> {
  %iter.fold [
    ~,
    Empty,
    #<'k, 'v>['<'k, 'v>, ['k, 'v]] { put [put, $0, $1.0, $1.1, hash $1.0, 0] },
  ]
}

// --- the `%dict{ … }` dialect --------------------------------------------------------
// `%dict{ "a" => 1, Point[2, 3] => x, n => 7 }` builds a dict at compile time from
// `key => value` entries: key and value are each an ordinary host expression (one
// chain), located by the host's `chain` prefix-parser and spliced as an `Unquote` —
// evaluated in the caller's scope with the dialect term's flowing value as input, so
// variables, `~`, function names, tuples, and full call chains all work. Chain parsing stops
// before `,` and `=>`, so the dialect keeps both. Expands to a `from` call over the
// entry list. Built from `%parse` combinators and the `%meta` constructors.

d_arrow = %parse.right [%parse.ws, %parse.literal ["=>", "'=>'"]]

d_comma = %parse.right [%parse.ws, %parse.byte [44, "','"]]

// One expression (a key or a value): skip whitespace, then hand the host prefix-parser
// the exact start of the expression and splice the span it reports.
d_expr = #'%meta.cb {
  =cb
  #'%parse {
    =st
    cb [st.data, st.pos] ~> {
      | =('int & end) => [
          Unquote[offset: st.pos, length: __integer_subtract__ [end, st.pos]],
          st[..., pos: end],
        ]
      | %parse.fail [st.pos, "an expression"]
    }
  }
}

dict_dialect = #(content: '%str, chain: '%meta.cb) {
  $ ~> =(content, chain: cb)
  expr = d_expr cb
  expr_ws = %parse.right [%parse.ws, expr]
  k = %parse.left [expr_ws, d_arrow]

  entry = %parse.map [%parse.then [k, expr_ws], #{ %meta.pair2 [$0, $1] }]

  entries = %parse.sep_by [entry, d_comma]
  e2 = %parse.left [entries, %parse.opt d_comma]
  e3 = %parse.left [e2, %parse.ws]

  full = %parse.map [e3, #{ Call[member: "from", arg: %meta.list_expr $] }]

  %parse.run [content, full]
}

[
  new: #[] {
    :doc "Creates an empty dict."
    Empty
  },

  get: #<'k, 'v>[(dict): '<'k, 'v>, (key): 'k] {
    :doc "The value stored for the key, or nil when the key is absent."
    get [$dict, $key, hash $key, 0]
  },

  put: #<'k, 'v>[(dict): '<'k, 'v>, (key): 'k, (value): 'v] {
    :doc "A dict with the key mapped to the value, replacing any existing mapping. Keys are data values (integers, binaries, tuples); a non-data key is a runtime error."
    put [put, $dict, $key, $value, hash $key, 0]
  },

  remove: #<'k, 'v>[(dict): '<'k, 'v>, (key): 'k] {
    :doc "A dict with the key removed, or the dict unchanged when the key is absent."
    remove [remove, $dict, $key, hash $key, 0]
  },

  has?: #<'k>[(dict): '<'k, _>, (key): 'k] {
    :doc "Whether the dict contains the key."
    get [$dict, $key, hash $key, 0]; Ok
  },

  count: #'<_, _> {
    :doc "The number of entries in the dict."
    Cons[~, Nil] ~> entries [~, Nil] ~> length [~, 0]
  },

  entries: #<'k, 'v>'<'k, 'v> {
    :doc "All entries as a list of [key, value] pairs, in unspecified order."
    Cons[~, Nil] ~> entries [~, Nil]
  },

  keys: #<'k, 'v>'<'k, 'v> {
    :doc "All keys in the dict as a list, in unspecified order."
    Cons[~, Nil] ~> entries [~, Nil] ~> map [~, #{ $0 }, Nil]
  },
  values: #<'k, 'v>'<'k, 'v> {
    :doc "All values in the dict as a list, in unspecified order."
    Cons[~, Nil] ~> entries [~, Nil] ~> map [~, #{ $1 }, Nil]
  },

  iter: #<'k, 'v>'<'k, 'v> {
    :doc "An iterator over the dict's [key, value] entries, in unspecified order."
    to_iter ~
  },

  collect: #<'k, 'v>'%iter<['k, 'v]> {
    :doc "Builds a dict from an iterator of [key, value] pairs; later pairs win on duplicate keys."
    from_iter ~
  },

  map: #<'k, 'v, 'j, 'u>[(dict): '<'k, 'v>, (f): #['k, 'v] -> ['j, 'u]] {
    :doc "A dict rebuilt with each [key, value] entry transformed; duplicate result keys collapse."
    to_iter $dict ~> %iter.map [~, $f] ~> from_iter
  },

  filter: #<'k, 'v>[(dict): '<'k, 'v>, (pred): #['k, 'v] -> _] {
    :doc "A dict keeping only the entries for which the predicate is non-nil."
    to_iter $dict ~> %iter.filter [~, $pred] ~> from_iter
  },

  fold: #<'k, 'v, 'acc>[(dict): '<'k, 'v>, (init): 'acc, (f): #['acc, ['k, 'v]] -> 'acc] {
    :doc "Reduces a dict by folding each [key, value] entry into an accumulator, in unspecified order."
    to_iter $dict ~> %iter.fold [~, $init, $f]
  },

  find: #<'k, 'v>[(dict): '<'k, 'v>, (pred): #['k, 'v] -> _] {
    :doc "An entry for which the predicate is non-nil, or nil when none matches (unspecified order)."
    to_iter $dict ~> %iter.find [~, $pred]
  },

  any?: #<'k, 'v>[(dict): '<'k, 'v>, (pred): #['k, 'v] -> _] {
    :doc "Whether any [key, value] entry satisfies the predicate."
    to_iter $dict ~> %iter.any? [~, $pred]
  },

  all?: #<'k, 'v>[(dict): '<'k, 'v>, (pred): #['k, 'v] -> _] {
    :doc "Whether every [key, value] entry satisfies the predicate."
    to_iter $dict ~> %iter.all? [~, $pred]
  },

  from: #<'k, 'v>'list<['k, 'v]> {
    :doc "Builds a dict from a list of [key, value] pairs; later pairs win on duplicate keys."
    from [from, Empty, ~]
  },

  merge: #<'k, 'v>[(dict): '<'k, 'v>, (with): '<'k, 'v>] {
    :doc "A dict with every entry of the second dict added; the second's values win on conflict."
    Cons[$with, Nil] ~> entries [~, Nil] ~> from [from, $dict, ~]
  },
]
~> { :dialect dict_dialect }
