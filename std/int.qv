// Integer-only operations. Arithmetic with a rational analogue lives in `%num`; this module
// is the home for operations defined only over the integers: integer (truncating) quotient
// and modulo, integer square root, and the bitwise primitives.
[
  div: #['int, 'int] {
    :doc "The integer quotient, truncating toward zero, or nil when the divisor is zero."
    // Division identity: nil exactly for a zero divisor, and otherwise a quotient whose
    // remainder `r = a - q·b` is smaller in magnitude than the divisor *and* takes the
    // dividend's sign (`a·r ≥ 0`) — the second guard pins `q` to the toward-zero
    // truncation (without it, `q` off by one toward the opposite sign also fits `|r| < |b|`).
    :post #{
      $ ~> =[in: [a, b], out: o]
      o ~> {
        | =[] => b ~> =0
        | =q => {
          rem = __integer_subtract__ [a, __integer_multiply__ [q, b]]

          __integer_compare__ [__integer_abs__ rem, __integer_abs__ b] ~> =-1

          __integer_multiply__ [a, rem] ~> __integer_compare__ [~, 0] ~> =\-1
        }
      }
    }
    | =[_, 0] => []
    | __integer_divide__ ~
  },

  mod: #['int, 'int] {
    :doc "The integer modulo, or nil when the divisor is zero."
    // Remainder invariant: nil exactly for a zero divisor, and otherwise `|r| < |b|` with
    // `r` taking the sign of the dividend (truncating division), so `a·r ≥ 0`.
    :post #{
      $ ~> =[in: [a, b], out: o]
      o ~> {
        | =[] => b ~> =0
        | =r => {
          __integer_compare__ [__integer_abs__ r, __integer_abs__ b] ~> =-1

          __integer_multiply__ [a, r] ~> __integer_compare__ [~, 0] ~> =\-1
        }
      }
    }
    | =[_, 0] => []
    | __integer_modulo__ ~
  },

  sqrt: #'int {
    :doc "The integer square root, rounded down, or nil when the input is negative."
    // The floor-sqrt invariant: nil exactly for a negative input, and otherwise the
    // unique r ≥ 0 with r² ≤ n < (r+1)².
    :post #{
      $ ~> =[in: n, out: o]
      o ~> {
        | =[] => __integer_compare__ [n, 0] ~> =-1
        | =r => {
          | __integer_compare__ [__integer_multiply__ [r, r], n] ~> =1 => []
          | s = __integer_add__ [r, 1]

            __integer_compare__ [n, __integer_multiply__ [s, s]] ~> =-1
        }
      }
    }
    | __integer_compare__ [$, 0] ~> =-1 => []
    | __integer_sqrt__ ~
  },

  and: __integer_and__ ~> { :doc "The bitwise AND of two integers." },
  or: __integer_or__ ~> { :doc "The bitwise OR of two integers." },
  xor: __integer_xor__ ~> { :doc "The bitwise XOR of two integers." },
  not: __integer_not__ ~> { :doc "The bitwise complement of an integer." },
  shift: __integer_shift__ ~> {
    :doc "The integer shifted by a number of bits — left when positive, right when negative."
  },

  popcount: __integer_popcount__ ~> { :doc "The number of set bits (population count)." },
]
