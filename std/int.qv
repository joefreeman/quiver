// Integer-only operations. Arithmetic with a rational analogue lives in `%num`; this module
// is the home for operations defined only over the integers: integer (truncating) quotient
// and modulo, integer square root, and the bitwise primitives.
[
  div: #['int, 'int] {
    :doc "The integer quotient, truncating toward zero, or nil when the divisor is zero."
    | =[_, 0] => []
    | __integer_divide__
  },

  mod: #['int, 'int] {
    :doc "The integer modulo, or nil when the divisor is zero."
    | =[_, 0] => []
    | __integer_modulo__
  },

  sqrt: #'int {
    :doc "The integer square root, rounded down, or nil when the input is negative."
    | [$, 0] __integer_compare__ =-1 => []
    | __integer_sqrt__
  },

  and: &__integer_and__ { :doc "The bitwise AND of two integers." },
  or: &__integer_or__ { :doc "The bitwise OR of two integers." },
  xor: &__integer_xor__ { :doc "The bitwise XOR of two integers." },
  not: &__integer_not__ { :doc "The bitwise complement of an integer." },
  shift: &__integer_shift__ {
    :doc "The integer shifted by a number of bits — left when positive, right when negative."
  },

  popcount: &__integer_popcount__ { :doc "The number of set bits (population count)." },
]
