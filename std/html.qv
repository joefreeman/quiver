// An HTML dialect and renderer: `%html{ <div class="x">Hello, {~.name}!</div> }` parses
// the brace content at compile time into a `'%html` node tree.
//
// This module owns *syntax and mechanism*; a dialect layered on it owns *vocabulary*.
// `parse` answers the parse tree, `rewrite_attrs` applies an attribute policy to it, and
// `expand` emits the tree expression — so another module's dialect (`%html/live`) reuses
// this grammar and emitter while deciding for itself what attribute names mean. The
// policy seam is the parse tree: a policy may rename an attribute, drop it, replace it
// with several, or give it an arbitrary value expression (`Expr`), and it fails with a
// positioned `%parse.fail`, like any parse error.
//
// Holes: a `{ … }` in child or attribute-value position is a host block, located by the
// context's `term` prefix-parser and spliced as an `Unquote` — so branches, `=>` guards,
// and multi-step sequences all work, `~` is the value flowing into the dialect term, and
// a hole evaluating to nil renders nothing (child) or omits the attribute. Hole values
// are normalized through `child`/`attr_value`, so their types are checked in place.
//
// The trust split: static template text is author-written and emitted verbatim (`Raw` —
// entities like `&amp;` pass through untouched); hole values are data, HTML-escaped at
// render (`Text`). Unescaped dynamic markup is the explicit opt-in `raw`.
//
// Provenance: every expansion also attaches a `:template` annotation to its tree —
// `[statics: …, holes: …]`, the pre-rendered static byte runs interleaving with the
// normalized hole values (statics has exactly one more entry than holes). The statics
// are instrumented for live updates: child holes are delimited by `<!--q:i-->`/
// `<!--/q:i-->` comment markers, and an element owning attribute holes carries a
// `data-q="j"` anchor (the `data-q*` attribute namespace is reserved). An attribute
// hole's run cut excludes the whole attribute — its rendered form (` name="v"`, bare
// ` name`, or nothing) is the hole's to produce. The annotation is invisible to
// matching, equality, and `render`; the statics list doubles as the template's
// identity (two expansions with equal statics are the same template). Hole values are
// shared with the tree (spans bind once), so attaching costs no extra evaluation.
//
// Notes:
//   - `{` always opens a hole; a literal brace in text is an entity (`&#123;`/`&#125;`).
//   - Attribute values: `name` (boolean), `name="literal"` (verbatim bytes), or
//     `name={ … }` (a hole; nil omits the attribute, `Ok` renders it bare).
//   - An attribute name may carry a glued `[ … ]` **modifier bracket**, delimited by the
//     host term parser and recorded as a span. It has no meaning here (a policy that
//     doesn't consume it rejects it); a layered dialect compiles it as a call argument.
//   - A `Data[value]` attribute value carries a *typed* value, rendered as the value's
//     %data notation — how a dialect echoes typed data into markup for a client to send
//     back. The marker is the tree's; what the notation says is the value's, so a layer
//     that wants an envelope around it (live's `Ev`) puts one there itself.
//   - Void elements (`br`, `img`, …) take no close tag; `<div/>` self-closes any element.
//   - Comments (`<!-- … -->`) are skipped. The doctype comes from `page`, not the template.
//   - Inline `<script>`/`<style>` bodies are not supported (v1); link external assets.

'expr = '%meta.expr

// The tree is parameterized by the type of the *typed data* its attributes carry: `'d`
// is the union of the values the tree's `Data` attributes hold. A data-free tree is
// generic in `'d` and embeds anywhere; a layer above pins `'d` to its own union (the
// live layer, to its event union) so a stray value is a compile error.
'attr_val<'d> = '%str | Ok | [] | Data['d]

'node<'d> =
  | Raw['%str]
  | Text['%str]
  | Element[tag: '%str, attrs: (Nil | Cons[['%str, 'attr_val<'d>], ^1]), children: (Nil | Cons[^, ^1])]
  | Fragment[(Nil | Cons[^, ^1])]

'<'d> = 'node<'d>

'nodes<'d> = '%list<'node<'d>>
'attrs<'d> = '%list<['%str, 'attr_val<'d>]>

// Template provenance: the instrumented static runs and the normalized hole values they
// interleave with, in document order. A `Child` hole is a node in child position; an
// `Attr` hole is one attribute's value, with its owning element's `data-q` anchor and
// the attribute name carried statically.
'statics = '%list<'%str>
'hole<'d> = Child['node<'d>] | Attr[elem: 'int, name: '%str, value: 'attr_val<'d>]
'holes<'d> = '%list<'hole<'d>>
'tmpl<'d> = [statics: 'statics, holes: 'holes<'d>]

// The dialect's parse tree — the seam a layered dialect works against. Static text runs,
// holes as content spans, and elements; emission (the tree expression, and the
// instrumented statics/holes) walks it separately. An `Expr` attribute value is one a
// policy supplied outright, spliced as written and treated as a hole throughout.
'span = [offset: 'int, length: 'int]
'pattr_val = Lit['%str] | Flag | AHole['span] | Expr['expr]
// An attribute as written: its name, the offset of that name (for policy failures), the
// span of its `[ … ]` modifier bracket if it has one, and its value.
'pattr = [name: '%str, pos: 'int, mods: ('span | []), value: 'pattr_val]
'pattrs = '%list<'pattr>
// An attribute policy: what one written attribute becomes — no attributes, one, or
// several. Nil is a failure (carrying its `%parse.fail` payload), which fails expansion.
'apolicy = #'pattr -> ('pattrs | [])
'pnode =
  | PText['bin]
  | PHole[offset: 'int, length: 'int]
  | PElem[tag: '%str, attrs: 'pattrs, children: (Nil | Cons[^, ^1])]
'pnodes = '%list<'pnode>

// Root-level parsed nodes carry a whitespace-only flag (computed at construction), so
// the root can trim whitespace-only text at its edges.
'pfx = ['pnode, (Ok | [])]
'pfxs = '%list<'pfx>

'xs = '%list<'expr>
'bins = '%list<'bin>

// === Escaping ===========================================================================

// Append text bytes onto `acc`, escaping `&`, `<`, `>`.
esc_text = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
    | {
      b = %bin.get_byte [$data, $pos]
      acc2 = b ~> {
        | =38 => %bin.concat [$acc, "&amp;" ~> .0]
        | =60 => %bin.concat [$acc, "&lt;" ~> .0]
        | =62 => %bin.concat [$acc, "&gt;" ~> .0]
        | %bin.append [$acc, b, 1]
      }
      ^ [$data, __integer_add__ [$pos, 1], $len, acc2]
    }
  }
}

// Append attribute-value bytes onto `acc`, escaping `&` and `"`.
esc_attr = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
    | {
      b = %bin.get_byte [$data, $pos]
      acc2 = b ~> {
        | =38 => %bin.concat [$acc, "&amp;" ~> .0]
        | =34 => %bin.concat [$acc, "&quot;" ~> .0]
        | %bin.append [$acc, b, 1]
      }
      ^ [$data, __integer_add__ [$pos, 1], $len, acc2]
    }
  }
}

// === The dialect grammar ================================================================

// The byte at the parse state's position / one past it, or nil at end of input.
peek_at = #'%parse { __integer_compare__ [$pos, $len] ~> =-1; %bin.get_byte [$data, $pos] }
peek_at2 = #'%parse {
  p = __integer_add__ [$pos, 1]; __integer_compare__ [p, $len] ~> =-1; %bin.get_byte [$data, p]
}

lower? = #'int {
  __integer_compare__ [$, 97] ~> =(0 | 1); __integer_compare__ [$, 122] ~> =(-1 | 0); $
}

digit? = #'int {
  __integer_compare__ [$, 48] ~> =(0 | 1); __integer_compare__ [$, 57] ~> =(-1 | 0); $
}

letter? = #'int {
  | __integer_compare__ [$, 65] ~> =(0 | 1); __integer_compare__ [$, 90] ~> =(-1 | 0) => $
  | lower? $
}

// Tag names: lowercase letters, digits, `-` (custom elements included).
tag_char? = #'int {
  | lower? $ => $
  | digit? $ => $
  | $ ~> =45 => $
}

// Attribute names: letters, digits, `-`, `:`, `_`.
attr_char? = #'int {
  | letter? $ => $
  | digit? $ => $
  | $ ~> =(45 | 58 | 95) => $
}

tag_rest = %parse.take_while &tag_char?
attr_rest = %parse.take_while &attr_char?

// The end of a text run: the next `<` or `{`, or end of input.
text_end = #[(data): 'bin, (pos): 'int, (len): 'int] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $pos
    | %bin.get_byte [$data, $pos] ~> =(60 | 123) => $pos
    | ^ [$data, __integer_add__ [$pos, 1], $len]
  }
}

// The index of the closing `"` of an attribute literal (verbatim bytes; no escapes), or nil.
lit_end = #[(data): 'bin, (pos): 'int, (len): 'int] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => []
    | %bin.get_byte [$data, $pos] ~> =34 => $pos
    | ^ [$data, __integer_add__ [$pos, 1], $len]
  }
}

// The position just past `-->` at or after `pos`, or nil when unterminated.
comment_end = #[(data): 'bin, (pos): 'int, (len): 'int] {
  {
    | __integer_compare__ [__integer_add__ [$pos, 3], $len] ~> =1 => []
    | %bin.get_byte [$data, $pos] ~> =45

      %bin.get_byte [$data, __integer_add__ [$pos, 1]] ~> =45

      %bin.get_byte [$data, __integer_add__ [$pos, 2]] ~> =62 => __integer_add__ [$pos, 3]
    | ^ [$data, __integer_add__ [$pos, 1], $len]
  }
}

// Whether the state sits at `<!--` (the `<` and `!` already checked by the caller).
at_comment? = #'%parse {
  __integer_compare__ [__integer_add__ [$pos, 4], $len] ~> =(-1 | 0)

  %bin.get_byte [$data, __integer_add__ [$pos, 2]] ~> =45

  %bin.get_byte [$data, __integer_add__ [$pos, 3]] ~> =45

  Ok
}

ws_only_from = #[(data): 'bin, (pos): 'int] {
  {
    | __integer_compare__ [$pos, %bin.length $data] ~> =(0 | 1) => Ok
    | %bin.get_byte [$data, $pos] ~> =(32 | 9 | 10 | 13) => ^ [$data, __integer_add__ [$pos, 1]]
  }
}

tag_name = #'%parse {
  =st
  {
    | peek_at st ~> =('int)b; lower? b => { tag_rest st ~> =[bytes, st2]; [Str[bytes], st2] }
    | peek_at st ~> =('int)b; __integer_compare__ [b, 65] ~> =(0 | 1); __integer_compare__ [b, 90] ~> =(-1 | 0) => %parse.fail_in [
      st,
      "a lowercase tag name (capitalized tags are reserved for components)",
    ]
    | %parse.fail_in [st, "a tag name"]
  }
}

// Whether an attribute name already occurs in the accumulated list.
seen? = #[(attrs): 'pattrs, (name): '%str] {
  // The pin below needs a variable, so bind the field locally.
  name = $name
  %list.any? [$attrs, #{ =(name: n); n ~> =&name; $ }]
}

// Whether an attribute name starts with `data-q` — reserved for template instrumentation.
reserved? = #'%str {
  =Str[b]
  __integer_compare__ [%bin.length b, 6] ~> =(0 | 1)
  Str[%bin.slice [b, 0, 6]] ~> ="data-q"
}

// An attribute value after its `=`: a `"…"` literal (verbatim bytes) or a `{ … }` hole
// (recorded as its content span).
attr_value_p = #[(cb): '%meta.cb, (state): '%parse] {
  %parse.ws $state ~> =[_, st]
  {
    | peek_at st ~> =34 => {
      qstart = __integer_add__ [st.pos, 1]
      {
        | lit_end [st.data, qstart, st.len] ~> =('int)endq => [
          Lit[Str[%bin.slice [st.data, qstart, endq]]],
          st[..., pos: __integer_add__ [endq, 1]],
        ]
        | %parse.fail_in [st, "'\"' (unterminated attribute value)"]
      }
    }
    | peek_at st ~> =123 => $cb [st.data, st.pos] ~> {
      | =('int)end => [
        AHole[
          [offset: st.pos, length: __integer_subtract__ [end, st.pos]],
        ],
        st[..., pos: end],
      ]
      | %parse.fail [st.pos, "an expression"]
    }
    | %parse.fail_in [st, "'\"' or '\{' after '='"]
  }
}

// A glued `[ … ]` modifier bracket after an attribute name, delimited by the host term
// parser: its span and the state past it, or the state unchanged when there is none.
// The bracket must be glued — a space starts the next attribute.
attr_mods_p = #[(cb): '%meta.cb, (state): '%parse] {
  | peek_at $state ~> =91 => $cb [$state.data, $state.pos] ~> {
    | =('int)end => [
      [offset: $state.pos, length: __integer_subtract__ [end, $state.pos]],
      $state[..., pos: end],
    ]
    | %parse.fail [$state.pos, "an attribute modifier tuple"]
  }
  | [[], $state]
}

// Zero or more attributes, in source order: `name`, `name="literal"`, `name={ … }`, each
// optionally carrying a glued `name[ … ]` modifier bracket. Names are stored as written —
// what they *mean* is the policy layer's business (see `rewrite_attrs`).
attrs_loop = #[(cb): '%meta.cb, (state): '%parse, (acc): 'pattrs] {
  %parse.ws $state ~> =[_, st]
  {
    | peek_at st ~> =('int)b; letter? b => {
      attr_rest st ~> =[nb, st2]
      name = Str[nb]
      {
        | seen? [$acc, name] => %parse.fail [st.pos, "a unique attribute name"]
        | reserved? name => %parse.fail [
          st.pos,
          "an attribute name ('data-q' is reserved for template instrumentation)",
        ]
        | Ok
      }
      attr_mods_p [&$cb, st2] ~> =[mods, st3]
      %parse.ws st3 ~> =[_, st4]
      {
        | peek_at st4 ~> =61 => {
          attr_value_p [&$cb, st4[..., pos: __integer_add__ [st4.pos, 1]]] ~> =[v, st5]
          ^ [
            &$cb,
            st5,
            Cons[[name: name, pos: st.pos, mods: mods, value: v], $acc],
          ]
        }
        | ^ [
          &$cb,
          st4,
          Cons[[name: name, pos: st.pos, mods: mods, value: Flag], $acc],
        ]
      }
    }
    | [%list.reverse $acc, st]
  }
}

void? = #'%str {
  | ="area" => Ok
  | ="base" => Ok
  | ="br" => Ok
  | ="col" => Ok
  | ="embed" => Ok
  | ="hr" => Ok
  | ="img" => Ok
  | ="input" => Ok
  | ="link" => Ok
  | ="meta" => Ok
  | ="source" => Ok
  | ="track" => Ok
  | ="wbr" => Ok
}

// Drop leading whitespace-only text nodes.
drop_ws = #'pfxs { %list.drop_while [~, #{ =[_, Ok]; $ }] }

// Trim whitespace-only text nodes from both ends of the root node list.
trim_root = #'pfxs {
  drop_ws
  ~> %list.reverse
  ~> drop_ws
  ~> %list.reverse
}

// The nodes of a flagged node list, in order.
strip = #'pfxs { %list.map [~, #{ $0 }] }

// The node-list loop: elements, holes, and text runs, in source order, stopping before a
// close tag (`</`) or end of input. Self-passed to tie the element↔children recursion.
nodes_loop = #[(self): #^ -> (['pfxs, '%parse] | []), (cb): '%meta.cb, (state): '%parse, (acc): 'pfxs] {
  {
    | peek_at $state ~> =('int)b => {
      | b ~> =60 => {
        | peek_at2 $state ~> =47 => [%list.reverse $acc, $state]
        | peek_at2 $state ~> =33 => {
          | at_comment? $state => comment_end [$state.data, __integer_add__ [$state.pos, 4], $state.len] ~> {
            | =('int)after => ^ [&$self, &$cb, $state[..., pos: after], $acc]
            | %parse.fail [$state.pos, "'-->'"]
          }
          | %parse.fail [
            $state.pos,
            "a comment ('<!--'; the doctype comes from html.page)",
          ]
        }
        | {
          // An element: `<` tag attrs (`/>` | `>` children `</` tag `>`).
          st1 = $state[..., pos: __integer_add__ [$state.pos, 1]]
          tag_name st1 ~> =[tag, st2]
          {
            | tag ~> =("script" | "style") => %parse.fail [
              st1.pos,
              "a supported tag (inline script/style is not supported)",
            ]
            | Ok
          }
          attrs_loop [&$cb, st2, Nil] ~> =[alist, st3]
          {
            | peek_at st3 ~> =47 => {
              | peek_at2 st3 ~> =62 => [
                PElem[tag: tag, attrs: alist, children: Nil],
                st3[..., pos: __integer_add__ [st3.pos, 2]],
              ]
              | %parse.fail_in [st3, "'/>'"]
            }
            | peek_at st3 ~> =62 => {
              st4 = st3[..., pos: __integer_add__ [st3.pos, 1]]
              {
                | void? tag => [PElem[tag: tag, attrs: alist, children: Nil], st4]
                | {
                  $self [&$self, &$cb, st4, Nil] ~> =[fkids, st5]
                  kids = fkids ~> strip
                  {
                    | peek_at st5 ~> =60; peek_at2 st5 ~> =47 => {
                      st6 = st5[..., pos: __integer_add__ [st5.pos, 2]]
                      tag_name st6 ~> =[ctag, st7]
                      {
                        | ctag ~> =&tag => Ok
                        | {
                          msg = %str.concat ["'</", tag] ~> %str.concat [~, ">'"]

                          %parse.fail [st6.pos, msg]
                        }
                      }
                      %parse.ws st7 ~> =[_, st8]
                      {
                        | peek_at st8 ~> =62 => [
                          PElem[tag: tag, attrs: alist, children: kids],
                          st8[..., pos: __integer_add__ [st8.pos, 1]],
                        ]
                        | %parse.fail_in [st8, "'>'"]
                      }
                    }
                    | {
                      msg = %str.concat ["'</", tag] ~> %str.concat [~, ">'"]

                      %parse.fail_in [st5, msg]
                    }
                  }
                }
              }
            }
            | %parse.fail_in [st3, "'>'"]
          } ~> =[node, stn]
          ^ [&$self, &$cb, stn, Cons[[node, []], $acc]]
        }
      }
      | b ~> =123 => $cb [$state.data, $state.pos] ~> {
        | =('int)end => {
          hole = PHole[offset: $state.pos, length: __integer_subtract__ [end, $state.pos]]
          ^ [&$self, &$cb, $state[..., pos: end], Cons[[hole, []], $acc]]
        }
        | %parse.fail [$state.pos, "an expression"]
      }
      | {
        end = text_end [$state.data, $state.pos, $state.len]
        bytes = %bin.slice [$state.data, $state.pos, end]
        ws = ws_only_from [bytes, 0]
        ^ [&$self, &$cb, $state[..., pos: end], Cons[[PText[bytes], ws], $acc]]
      }
    }
    | [%list.reverse $acc, $state]
  }
}

// === Emission ===========================================================================

// A hole's span applied to one of this module's normalizers. Emitted `Call`s name their
// module explicitly, so the IR stays valid when a dialect in *another* module returns it.
emit_hole = #[(member): Str['bin], (span): 'span] {
  Call[
    module: "html",
    member: $member,
    arg: Unquote[offset: $span.offset, length: $span.length],
  ]
}

// An attribute value's construction expression.
emit_attr_val = #'pattr_val {
  | =Lit[s] => s
  | =Flag => Tuple[name: "Ok", fields: Nil]
  | =AHole[sp] => emit_hole ["attr_value", sp]
  | =Expr[e] => e
}

// Attribute pairs as a list of `[name, value]` tuple expressions.
emit_attrs = #'pattrs {
  %list.map [
    ~,
    #{ =(name: n, value: v); %meta.pair2 [n, emit_attr_val v] },
  ]
}

// Node-list expressions, in order; self-passed to recurse into element children.
emit_list = #[(self): #^ -> 'xs, (items): 'pnodes, (acc): 'xs] {
  $items ~> {
    | =Nil => %list.reverse $acc
    | =Cons[node, rest] => {
      e = node ~> {
        | =PText[b] => Tuple[name: "Raw", fields: Cons[Str[b], Nil]]
        | =PHole[offset: o, length: l] => emit_hole ["child", [offset: o, length: l]]
        | =PElem[tag: t, attrs: alist, children: kids] => Tuple[
          name: "Element",
          fields: Cons[
            Labeled[label: "tag", value: t],
            Cons[
              Labeled[label: "attrs", value: emit_attrs alist ~> %meta.list_expr],
              Cons[
                Labeled[label: "children", value: $self [&$self, kids, Nil] ~> %meta.list_expr],
                Nil,
              ],
            ],
          ],
        ]
        // Unreachable: the arms above cover every variant, but exhaustiveness can't see
        // through the inner recursive union (see render_list).
        | Tuple[name: Nil, fields: Nil]
      }
      ^ [&$self, rest, Cons[e, $acc]]
    }
  }
}

// A single root splices bare; zero or several splice as a `Fragment`.
root_expr = #'xs {
  | =Cons[e, Nil] => e
  | =items => Tuple[name: "Fragment", fields: Cons[%meta.list_expr items, Nil]]
}

// === Instrumentation ====================================================================
// The statics/holes walk mirrors `render` over the static parts, cutting a run at every
// hole: child holes leave `<!--q:i-->`/`<!--/q:i-->` markers in the surrounding runs, and
// an attribute hole's cut excludes the whole attribute. An element owning attribute holes
// gets a `data-q="j"` anchor. `i` is the hole's index among ALL the template's holes in
// document order — attribute holes consume an index without leaving a marker — so a
// marker's number equals the hole's position in the `:template` holes list (a live
// patch path's slot index). Hole entries re-splice the same spans the tree uses, so
// each hole still evaluates once (spans bind once, deduplicated).

// Whether any attribute value is a hole — a parsed `{ … }` or a policy-supplied
// expression, which are equally the hole's to produce at render.
hole? = #'pattr_val { =AHole[_] => Ok | =Expr[_] => Ok }
has_hole? = #'pattrs { %list.any? [~, #{ =(value: v); hole? v }] }

// The walk state: the current run's bytes, completed runs (reversed), hole entry
// expressions (reversed), and the hole / element counters.
'ist = [cur: 'bin, runs: 'bins, holes: 'xs, ci: 'int, ei: 'int]

// Instrument one element's attributes: statics append ` name` / ` name="escaped"`; a
// hole cuts the run and records an `Attr[elem, name, value]` entry.
instrument_attrs = #[(items): 'pattrs, (ist): 'ist, (elem): 'int] {
  $items ~> {
    | =Nil => $ist
    | =Cons[(name: Str[n], value: v), rest] => {
      ist2 = v ~> {
        | =Lit[Str[lv]] => $ist[
          ...,
          cur: %bin.concat [%bin.append [$ist.cur, 32, 1], n] ~> %bin.concat [~, 0x3d22] ~> esc_attr [lv, 0, %bin.length lv, ~] ~> %bin.append [
            ~,
            34,
            1,
          ],
        ]
        | =Flag => $ist[..., cur: %bin.concat [%bin.append [$ist.cur, 32, 1], n]]
        // A hole's rendered form — ` name="v"`, bare ` name`, or nothing — is its own to
        // produce, so its cut excludes the whole attribute. The entry reuses the tree's
        // value expression: same span, same member, so it is the same (bind-once) hole.
        | {
          entry = Tuple[
            name: "Attr",
            fields: Cons[
              Labeled[label: "elem", value: $elem],
              Cons[
                Labeled[label: "name", value: Str[n]],
                Cons[Labeled[label: "value", value: emit_attr_val v], Nil],
              ],
            ],
          ]
          $ist[
            ...,
            cur: 0x,
            runs: Cons[$ist.cur, $ist.runs],
            holes: Cons[entry, $ist.holes],
            ci: __integer_add__ [$ist.ci, 1],
          ]
        }
      }
      ^ [rest, ist2, $elem]
    }
  }
}

// Instrument a node list; self-passed to recurse into element children.
instrument_list = #[(self): #^ -> 'ist, (items): 'pnodes, (ist): 'ist] {
  $items ~> {
    | =Nil => $ist
    | =Cons[node, rest] => {
      ist2 = node ~> {
        | =PText[b] => $ist[..., cur: %bin.concat [$ist.cur, b]]
        | =PHole[offset: o, length: l] => {
          i = %str.from_int $ist.ci ~> .0
          opened = %bin.concat [$ist.cur, "<!--q:" ~> .0] ~> %bin.concat [~, i] ~> %bin.concat [
            ~,
            "-->" ~> .0,
          ]
          entry = Tuple[
            name: "Child",
            fields: Cons[emit_hole ["child", [offset: o, length: l]], Nil],
          ]
          $ist[
            ...,
            cur: %bin.concat ["<!--/q:" ~> .0, i] ~> %bin.concat [~, "-->" ~> .0],
            runs: Cons[opened, $ist.runs],
            holes: Cons[entry, $ist.holes],
            ci: __integer_add__ [$ist.ci, 1],
          ]
        }
        | =PElem[tag: Str[t], attrs: alist, children: kids] => {
          e_ix = $ist.ei
          open0 = %bin.concat [%bin.append [$ist.cur, 60, 1], t]
          opened = {
            | has_hole? alist => %bin.concat [open0, " data-q=\"" ~> .0] ~> %bin.concat [~, %str.from_int e_ix ~> .0] ~> %bin.append [
              ~,
              34,
              1,
            ]
            | open0
          }
          ist1 = instrument_attrs [
            alist,
            $ist[..., cur: opened, ei: __integer_add__ [e_ix, 1]],
            e_ix,
          ]
          ist2 = ist1[..., cur: %bin.append [ist1.cur, 62, 1]]
          {
            | void? Str[t] => ist2
            | {
              ist3 = $self [&$self, kids, ist2]
              ist3[
                ...,
                cur: %bin.concat [ist3.cur, 0x3c2f] ~> %bin.concat [~, t] ~> %bin.append [~, 62, 1],
              ]
            }
          }
        }
        // Unreachable: the arms above cover every variant (see render_list).
        | $ist
      }
      ^ [&$self, rest, ist2]
    }
  }
}

// Completed static runs arrive reversed; emit them as `Str` expressions in order.
statics_exprs = #'bins { %list.reverse ~> %list.map [~, #{ Str[~] }] }

// === The policy seam ====================================================================
// Between parsing and emission a dialect decides what the attributes it parsed *mean*.
// Names are stored as written, so a policy renames (`on:click` to `data-q-click`), drops,
// splits, or re-values them; anything it doesn't claim passes through.

// Apply `f` to one element's attributes, concatenating what it answers, in document
// order. A nil from `f` is a policy failure: it is the step's own value, so the step
// boundary short-circuits on it and the failure — `:error` payload and all — propagates
// out of the whole walk, exactly as a parse failure does.
rewrite_attr_list = #[(items): 'pattrs, (f): 'apolicy, (acc): 'pattrs] {
  $items ~> {
    | =Nil => %list.reverse $acc
    | =Cons[attr, rest] => {
      $f attr ~> =('pattrs)as
      ^ [rest, &$f, %list.fold [as, $acc, #{ Cons[$1, $0] }]]
    }
  }
}

// Apply an attribute policy to every element of a node list; self-passed to recurse into
// children.
rewrite_list = #[(self): #^ -> ('pnodes | []), (items): 'pnodes, (f): 'apolicy, (acc): 'pnodes] {
  $items ~> {
    | =Nil => %list.reverse $acc
    | =Cons[node, rest] => {
      node
      ~> {
        | =PElem[tag: t, attrs: alist, children: kids] => {
          rewrite_attr_list [alist, &$f, Nil] ~> =('pattrs)alist2
          $self [&$self, kids, &$f, Nil] ~> =('pnodes)kids2
          PElem[tag: t, attrs: alist2, children: kids2]
        }
        | node
      } ~> =('pnode)node2

      ^ [&$self, rest, &$f, Cons[node2, $acc]]
    }
  }
}

rewrite_attrs = #[(nodes): 'pnodes, (policy): 'apolicy] {
  :doc "Applies an attribute policy to a parse tree: every attribute of every element becomes the attributes `policy` answers for it (none, one, or several), children included. Answers the rewritten tree, or the policy's own nil — a `%parse.fail` value, which fails the expansion at the position it names. This is how a dialect layered on %html gives attribute names meaning without %html knowing them."
  rewrite_list [&rewrite_list, $nodes, &$policy, Nil]
}

// The plain policy: %html itself claims no attribute names. A modifier bracket has no
// meaning without a policy to read it, so it is rejected rather than ignored.
plain_policy = #'pattr {
  | $mods ~> =[] => Cons[$, Nil]
  | %parse.fail [
    $pos,
    "an attribute without a '[ … ]' modifier (they have meaning only in a dialect that reads them)",
  ]
}

parse = #[(content): '%str, (term): '%meta.cb] {
  :doc "Parses HTML dialect content into its node tree, with the host `term` callback locating `\{ … }` holes and `[ … ]` modifier brackets. Answers the root nodes (whitespace-only text trimmed at the edges), or nil with a positioned `:error` payload — the dialect failure contract, so a dialect can return it as-is."
  cb = &$term
  full = #'%parse {
    nodes_loop [&nodes_loop, &cb, $, Nil] ~> =[items, st]
    {
      | __integer_compare__ [st.pos, st.len] ~> =(0 | 1) => [trim_root items ~> strip, st]
      | %parse.fail_in [st, "end of input (unmatched close tag?)"]
    }
  }
  %parse.run [$content, &full]
}

expand = #'pnodes {
  :doc "Emits a parse tree as the expression a dialect returns: the node-tree construction, with the template provenance (instrumented statics and hole values) attached. Emitted calls name %html explicitly, so the expression stays valid returned from another module's dialect."
  roots = $
  ist = instrument_list [&instrument_list, roots, [cur: 0x, runs: Nil, holes: Nil, ci: 0, ei: 0]]
  Call[
    module: "html",
    member: "with_template",
    arg: Tuple[
      name: Nil,
      fields: Cons[
        emit_list [&emit_list, roots, Nil] ~> root_expr,
        Cons[
          Cons[ist.cur, ist.runs] ~> statics_exprs
          ~> %meta.list_expr,
          Cons[%list.reverse ist.holes ~> %meta.list_expr, Nil],
        ],
      ],
    ],
  ]
}

// The dialect entry point: the compiler calls this with the dialect context record. Each
// stage is its own step, so a failure is the step's value and short-circuits carrying its
// own `:error` payload — which is what positions the compile error.
html_dialect = #(content: '%str, term: '%meta.cb) {
  parse [$content, &$term] ~> =('pnodes)nodes
  rewrite_attrs [nodes, &plain_policy] ~> =('pnodes)rewritten
  expand rewritten
}

// === Rendering ==========================================================================

// Append rendered attributes onto `acc`: ` name`, ` name="escaped value"`; nil omits.
// A `Data` value renders as its %data notation — the attribute text a client echoes back.
render_attrs = #<'d>[(items): 'attrs<'d>, (acc): 'bin] {
  $items ~> {
    | =Nil => $acc
    | =Cons[[Str[n], v], rest] => {
      acc2 = v ~> {
        | =[] => $acc
        | =Ok => %bin.concat [%bin.append [$acc, 32, 1], n]
        | =Str[vb] => %bin.concat [%bin.append [$acc, 32, 1], n] ~> %bin.concat [~, 0x3d22] ~> esc_attr [vb, 0, %bin.length vb, ~] ~> %bin.append [
          ~,
          34,
          1,
        ]
        | =Data[payload] => {
          %data.encode payload ~> =Str[eb]
          %bin.concat [%bin.append [$acc, 32, 1], n] ~> %bin.concat [~, 0x3d22] ~> esc_attr [eb, 0, %bin.length eb, ~] ~> %bin.append [
            ~,
            34,
            1,
          ]
        }
      }
      ^ [rest, acc2]
    }
  }
}

// Render a list of nodes onto `acc`, self-passed to recurse into children.
render_list = #<'e>[(self): #^ -> 'bin, (items): 'nodes<'e>, (acc): 'bin] {
  $items ~> {
    | =Nil => $acc
    | =Cons[node, rest] => {
      acc2 = node ~> {
        | =Raw[Str[b]] => %bin.concat [$acc, b]
        | =Text[Str[b]] => esc_text [b, 0, %bin.length b, $acc]
        | =Fragment[kids] => $self [&$self, kids, $acc]
        | =Element[tag: Str[t], attrs: attrs, children: kids] => {
            opened = %bin.concat [%bin.append [$acc, 60, 1], t] ~> render_attrs [attrs, ~]

            {
              | void? Str[t] => %bin.append [opened, 62, 1]
              | {
                inner = $self [&$self, kids, %bin.append [opened, 62, 1]]

                %bin.concat [inner, 0x3c2f] ~> %bin.concat [~, t] ~> %bin.append [~, 62, 1]
              }
            }
          }
        // Unreachable: the arms above cover every node variant, but exhaustiveness
        // can't see through the inner recursive union, so a catch-all keeps the
        // dispatch infallible (and the accumulator typed 'bin).
        | $acc
      }
      ^ [&$self, rest, acc2]
    }
  }
}

render = #<'e>'<'e> {
  :doc "Renders a node tree to its HTML string: Text nodes and attribute values are escaped, Raw nodes are emitted verbatim, nil-valued attributes are omitted, Ok-valued attributes render bare, and event values render as their %data notation."
  render_list [&render_list, Cons[$, Nil], 0x] ~> Str[~]
}

page = #<'e>'<'e> {
  :doc "Renders a node tree as a whole page: the doctype followed by the rendered tree."
  %str.concat ["<!doctype html>", render $]
}

raw = #'%str {
  :doc "A trusted-markup node, rendered verbatim — the explicit opt-out from escaping."
  Raw[$]
}

text = #'%str {
  :doc "A text node, HTML-escaped at render."
  Text[$]
}

// Normalizes a child hole's value to a node: a node splices as itself, a Str becomes
// escaped text, an int renders as digits, a list of nodes becomes a Fragment, and nil
// renders nothing.
child = #<'e>('node<'e> | '%str | 'int | 'nodes<'e> | []) {
  | =Str[b] => Text[Str[b]]
  | =('int)i => %str.from_int i ~> Text[~]
  | =[] => Fragment[Nil]
  | =('nodes<'e>)items => Fragment[items]
  | =('node<'e>)n => n
}

// Normalizes an attribute hole's value: a Str renders as the attribute's value, an int as
// its digits, Ok renders the attribute bare, and nil omits it.
attr_value = #('%str | 'int | Ok | []) {
  | =Str[b] => Str[b]
  | =('int)i => %str.from_int i
  | =Ok => Ok
  | =[] => []
}

// Normalizes a typed value into an attribute value: any data value, wrapped in the
// `Data` envelope — the typed value the tree carries, and the value's entry in the
// tree's data parameter. Encoding to %data notation happens where the attribute leaves
// the data plane: `render` (the emitted attribute text) and the live layer's frame
// derivation. A client echoing the attribute text back sends *typed* data, which the
// sender decodes with `%data.decode`.
data_value = #<'t>'t { Data[$] }

// Attaches the template provenance to an expansion's tree (dialect plumbing): the
// instrumented statics and the normalized hole values, as the `:template` annotation.
// Identity on the tree; the annotation is invisible to matching, equality, and render.
with_template = #<'d>[(tree): 'node<'d>, (statics): 'statics, (holes): 'holes<'d>] {
  $tree ~> { :template ($statics, $holes) }
}

escape_text = #'%str {
  :doc "Escapes a string for HTML text content: `&`, `<`, `>`."
  =Str[b]; esc_text [b, 0, %bin.length b, 0x] ~> Str[~]
}

escape_attr = #'%str {
  :doc "Escapes a string for a double-quoted attribute value: `&` and the quote."
  =Str[b]; esc_attr [b, 0, %bin.length b, 0x] ~> Str[~]
}

{
  :dialect &html_dialect
  (
    render,
    page,
    raw,
    text,
    child,
    attr_value,
    data_value,
    with_template,
    escape_text,
    escape_attr,
    parse,
    rewrite_attrs,
    expand,
  )
}
