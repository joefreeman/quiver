byte_bit = #'int { [__integer_divide__ [$, 8], __integer_modulo__ [$, 8]] }

// A nibble as a lowercase hex character code.
hex_digit = #'int {
  | __integer_compare__ [$, 10] ~> =-1 => __integer_add__ [$, 48]
  | __integer_add__ [$, 87]
}

// The numeric value of an ASCII hex digit, or nil.
hex_val = #'int {
  | __integer_compare__ [$, 48] ~> =(0 | 1)
    __integer_compare__ [$, 57] ~> =(-1 | 0) => __integer_subtract__ [$, 48]
  | __integer_compare__ [$, 97] ~> =(0 | 1)
    __integer_compare__ [$, 102] ~> =(-1 | 0) => __integer_add__ [__integer_subtract__ [$, 97], 10]
  | __integer_compare__ [$, 65] ~> =(0 | 1)
    __integer_compare__ [$, 70] ~> =(-1 | 0) => __integer_add__ [__integer_subtract__ [$, 65], 10]
}

to_hex_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
  | {
    b = __binary_get__ [$data, $pos, 0, 8]

    acc2 =
      __binary_append__ [$acc, __integer_divide__ [b, 16] ~> hex_digit, 1]
      ~> __binary_append__ [~, __integer_modulo__ [b, 16] ~> hex_digit, 1]

    ^ [$data, __integer_add__ [$pos, 1], $len, acc2]
  }
}

to_hex = #'bin {
  :doc "The binary as lowercase hex text, two characters per byte."
  to_hex_loop [$, 0, __binary_length__ $, <>] ~> Str[~]
}

from_hex_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
  | __binary_get__ [$data, $pos, 0, 8] ~> hex_val ~> =('int & hi)

    __binary_get__ [$data, __integer_add__ [$pos, 1], 0, 8]
    ~> hex_val
    ~> =('int & lo) => ^ [
      $data,
      __integer_add__ [$pos, 2],
      $len,
      __binary_append__ [$acc, __integer_add__ [__integer_multiply__ [hi, 16], lo], 1],
    ]
}

from_hex = #Str['bin] {
  :doc "The bytes of a hex string (case-insensitive), or nil when it is odd-length or has a non-hex character."
  =Str[data]

  __integer_compare__ [__integer_modulo__ [__binary_length__ data, 2], 0]
  ~> =0

  from_hex_loop [data, 0, __binary_length__ data, <>]
}

// A 6-bit value as a base64 character code (RFC 4648 standard alphabet).
b64_digit = #'int {
  | __integer_compare__ [$, 26] ~> =-1 => __integer_add__ [$, 65]
  | __integer_compare__ [$, 52] ~> =-1 => __integer_add__ [$, 71]
  | __integer_compare__ [$, 62] ~> =-1 => __integer_subtract__ [$, 4]
  | $ ~> =62 => 43
  | 47
}

// The 6-bit value of a base64 character code, or nil.
b64_val = #'int {
  | __integer_compare__ [$, 65] ~> =(0 | 1)
    __integer_compare__ [$, 90] ~> =(-1 | 0) => __integer_subtract__ [$, 65]
  | __integer_compare__ [$, 97] ~> =(0 | 1)
    __integer_compare__ [$, 122] ~> =(-1 | 0) => __integer_subtract__ [$, 71]
  | __integer_compare__ [$, 48] ~> =(0 | 1)
    __integer_compare__ [$, 57] ~> =(-1 | 0) => __integer_add__ [$, 4]
  | $ ~> =43 => 62
  | $ ~> =47 => 63
}

to_base64_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  rem = __integer_subtract__ [$len, $pos]
  {
    | rem ~> =0 => $acc
    | rem ~> =1 => {
      b0 = __binary_get__ [$data, $pos, 0, 8]

      $acc
      ~> __binary_append__ [~, __integer_divide__ [b0, 4] ~> b64_digit, 1]
      ~> __binary_append__ [
        ~,
        __integer_modulo__ [b0, 4]
        ~> __integer_multiply__ [~, 16]
        ~> b64_digit,
        1,
      ]
      ~> __binary_concat__ [~, <3d3d>]
    }
    | rem ~> =2 => {
      b0 = __binary_get__ [$data, $pos, 0, 8]
      b1 = __binary_get__ [$data, __integer_add__ [$pos, 1], 0, 8]

      $acc
      ~> __binary_append__ [~, __integer_divide__ [b0, 4] ~> b64_digit, 1]
      ~> __binary_append__ [
        ~,
        __integer_add__ [
          __integer_modulo__ [b0, 4] ~> __integer_multiply__ [~, 16],
          __integer_divide__ [b1, 16],
        ]
        ~> b64_digit,
        1,
      ]
      ~> __binary_append__ [
        ~,
        __integer_modulo__ [b1, 16]
        ~> __integer_multiply__ [~, 4]
        ~> b64_digit,
        1,
      ]
      ~> __binary_concat__ [~, <3d>]
    }
    | {
      b0 = __binary_get__ [$data, $pos, 0, 8]
      b1 = __binary_get__ [$data, __integer_add__ [$pos, 1], 0, 8]
      b2 = __binary_get__ [$data, __integer_add__ [$pos, 2], 0, 8]

      acc2 =
        $acc
        ~> __binary_append__ [~, __integer_divide__ [b0, 4] ~> b64_digit, 1]
        ~> __binary_append__ [
          ~,
          __integer_add__ [
            __integer_modulo__ [b0, 4] ~> __integer_multiply__ [~, 16],
            __integer_divide__ [b1, 16],
          ]
          ~> b64_digit,
          1,
        ]
        ~> __binary_append__ [
          ~,
          __integer_add__ [
            __integer_modulo__ [b1, 16] ~> __integer_multiply__ [~, 4],
            __integer_divide__ [b2, 64],
          ]
          ~> b64_digit,
          1,
        ]
        ~> __binary_append__ [~, __integer_modulo__ [b2, 64] ~> b64_digit, 1]

      ^ [$data, __integer_add__ [$pos, 3], $len, acc2]
    }
  }
}

to_base64 = #'bin {
  :doc "The binary as base64 text (RFC 4648 standard alphabet, padded)."
  to_base64_loop [$, 0, __binary_length__ $, <>] ~> Str[~]
}

// Decode one 4-character quantum at pos; the last may carry one or two `=` pads.
from_base64_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
  | {
    c0 = __binary_get__ [$data, $pos, 0, 8]
    c1 = __binary_get__ [$data, __integer_add__ [$pos, 1], 0, 8]
    c2 = __binary_get__ [$data, __integer_add__ [$pos, 2], 0, 8]
    c3 = __binary_get__ [$data, __integer_add__ [$pos, 3], 0, 8]
    last? = __integer_compare__ [__integer_add__ [$pos, 4], $len] ~> { =(0 | 1) => Ok | [] }
    b64_val c0 ~> =('int & v0)
    b64_val c1 ~> =('int & v1)
    {
      // "xx==" — one output byte; only legal in the final quantum.
      | [c2, c3] ~> =[61, 61] => {
        last?
        __binary_append__ [
          $acc,
          __integer_add__ [__integer_multiply__ [v0, 4], __integer_divide__ [v1, 16]],
          1,
        ]
      }
      // "xxx=" — two output bytes; only legal in the final quantum.
      | c3 ~> =61 => {
        last?
        b64_val c2 ~> =('int & v2)

        __binary_append__ [
          $acc,
          __integer_add__ [__integer_multiply__ [v0, 4], __integer_divide__ [v1, 16]],
          1,
        ]
        ~> __binary_append__ [
          ~,
          __integer_add__ [
            __integer_modulo__ [v1, 16] ~> __integer_multiply__ [~, 16],
            __integer_divide__ [v2, 4],
          ],
          1,
        ]
      }
      | {
        b64_val c2 ~> =('int & v2)
        b64_val c3 ~> =('int & v3)

        acc2 =
          __binary_append__ [
            $acc,
            __integer_add__ [__integer_multiply__ [v0, 4], __integer_divide__ [v1, 16]],
            1,
          ]
          ~> __binary_append__ [
            ~,
            __integer_add__ [
              __integer_modulo__ [v1, 16] ~> __integer_multiply__ [~, 16],
              __integer_divide__ [v2, 4],
            ],
            1,
          ]
          ~> __binary_append__ [
            ~,
            __integer_add__ [__integer_modulo__ [v2, 4] ~> __integer_multiply__ [~, 64], v3],
            1,
          ]

        ^ [$data, __integer_add__ [$pos, 4], $len, acc2]
      }
    }
  }
}

from_base64 = #Str['bin] {
  :doc "The bytes of a base64 string (RFC 4648 standard alphabet, padding required), or nil when malformed."
  =Str[data]
  len = __binary_length__ data
  {
    | len ~> =0 => <>
    | {
      __integer_compare__ [__integer_modulo__ [len, 4], 0] ~> =0
      from_base64_loop [data, 0, len, <>]
    }
  }
}

[
  new: __binary_new__ ~> { :doc "A zero-filled binary of the given length in bytes." },

  length: __binary_length__ ~> { :doc "The length of a binary in bytes." },

  concat: __binary_concat__ ~> { :doc "The concatenation of two binaries." },

  append: __binary_append__ ~> {
    :doc "The binary with a non-negative integer appended as the given number of big-endian bytes (1 to 8)."
  },

  and: __binary_and__ ~> {
    :doc "The bytewise AND of two binaries, truncated to the shorter length."
  },

  or: __binary_or__ ~> {
    :doc "The bytewise OR of two binaries, zero-padded to the longer length."
  },

  xor: __binary_xor__ ~> {
    :doc "The bytewise XOR of two binaries, zero-padded to the longer length."
  },

  not: __binary_not__ ~> { :doc "The bitwise complement of a binary." },

  shift: __binary_shift__ ~> {
    :doc "The binary shifted by a number of bits — left when positive, right when negative — with zeros shifted in; the length is preserved."
  },

  slice: __binary_slice__ ~> {
    :doc "The bytes from a start index (inclusive) to an end index (exclusive)."
  },

  index: __binary_index__ ~> {
    :doc "The index of the first occurrence of a byte at or after the given offset, or nil when absent."
  },

  get_byte: #[(bin): 'bin, (index): 'int] {
    :doc "The byte at the given index, as an integer 0 to 255."
    __binary_get__ [$bin, $index, 0, 8]
  },

  get_bit: #[(bin): 'bin, (index): 'int] {
    :doc "The bit at the given index (most significant first), as 0 or 1."
    byte_bit $index ~> __binary_get__ [$bin, ..., 1]
  },

  set_byte: #[(bin): 'bin, (index): 'int, (value): 'int] {
    :doc "The binary with the byte at the given index replaced by an integer 0 to 255."
    __binary_set__ [$bin, $index, 0, $value, 8]
  },

  set_bit: #[(bin): 'bin, (index): 'int, (value): 'int] {
    :doc "The binary with the bit at the given index (most significant first) set to 0 or 1."
    byte_bit $index ~> __binary_set__ [$bin, ..., $value, 1]
  },

  to_hex: to_hex,
  from_hex: from_hex,
  to_base64: to_base64,
  from_base64: from_base64,
]
