// The expression IR a dialect function returns: `%mod{ …content… }` hands the raw brace
// content (a `Str['bin]`) to the function the module's `:dialect` annotation carries, at
// compile time, and splices the `'expr` tree it returns in place of the invocation —
// type-checked there like handwritten code.
//
// Plain data splices as itself: an integer, a binary, a `Str`, or `Nil` in expression
// position is the corresponding literal. `Var` is a variable resolved in the *caller's*
// scope; `Ripple` is the value flowing into the dialect term (the invocation site's `~`); `Call` applies a
// dialect-module export to an argument; `Tup` constructs a tuple — the only way to build
// one, so the wrapper names stay unambiguous (a data tuple named `Var` is spliced as
// `Tup["Var", …]`), and it covers names and labels that come from parsed text. Its
// fields are bare expressions (positional) unless wrapped in `Labeled`, which is only
// meaningful directly inside `fields`. A true nil literal, if ever needed, is
// `Tup[name: Nil, fields: Nil]`.
//
// Hygiene is by construction: the tree has no bare identifiers except `Var` (the
// intentional escape hatch), and `Call` resolves only against the dialect module's own
// exports. `Var`/`Ripple` splice as references (`&x` semantics): an expansion never
// implicitly calls a caller value; application is expressed via `Call`.
//
// A dialect signals a parse failure with nil carrying an `:error` payload; an
// `Expected[offset: 'int, message: Str['bin]]`-shaped payload has its offset mapped back
// to a source position in the compile error.
//
// The compiler recognizes this shape structurally (by tuple names); this module is its
// canonical definition, for dialect return types: `#Str['bin] -> '%meta.expr`.

'expr =
  | 'int
  | 'bin
  | Str['bin]
  | Nil
  | Var[Str['bin]]
  | Ripple
  | Call[member: Str['bin], arg: ^]
  | Labeled[label: Str['bin], value: ^]
  | Tup[name: (Nil | Str['bin]), fields: (Nil | Cons[^, ^1])]

'elist = Nil | Cons['expr, ^]

rev = #['elist, 'elist] {
  =[items, acc]
  items {
    | =Nil => acc
    | =Cons[h, t] => [t, Cons[h, acc]] ^
  }
}

build_rev = #['elist, 'expr] {
  =[items, acc]
  items {
    | =Nil => acc
    | =Cons[h, t] => {
      [t, Tup[name: "Cons", fields: Cons[h, Cons[acc, Nil]]]] ^
    }
  }
}

pair2 = #['expr, 'expr] {
  :doc "An unnamed 2-tuple expression: `[a, b]`."
  Tup[name: Nil, fields: Cons[$0, Cons[$1, Nil]]]
}

call2 = #[Str['bin], 'expr, 'expr] {
  :doc "A dialect-module member applied to a 2-tuple: `[a, b] member`."
  Call[member: $0, arg: Tup[name: Nil, fields: Cons[$1, Cons[$2, Nil]]]]
}

list_expr = #'elist {
  :doc "An in-order list of element expressions as a nested Cons/Nil list expression."
  [[~, Nil] rev, Nil] build_rev
}

[pair2: &pair2, call2: &call2, list_expr: &list_expr]
