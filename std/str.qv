' = Str['bin]

is_continuation = #['bin, 'int] {
  $0
  ~> [~, $1] ~> %bin.get_byte
  ~> [~, 192] ~> %int.and
  ~> =128
}

skip_continuation = #['bin, 'int, 'int] {
  =[data, byte_pos, data_len]
  {
    | byte_pos ~> [~, data_len] ~> %num.ge? => byte_pos
    | [data, byte_pos] ~> is_continuation => {
      byte_pos
      ~> [~, 1] ~> %num.add
      ~> [data, ~, data_len] ~> ^
    }
    | byte_pos
  }
}

find_index = #['bin, 'bin, 'int, 'int] {
  =[haystack, needle, offset, end]
  [offset, end] ~> %num.le?
  {
    | needle
      ~> %bin.length
      ~> [offset, ~] ~> %num.add
      ~> [haystack, offset, ~] ~> %bin.slice
      ~> =&needle => offset
    | {
      offset
      ~> [~, 1] ~> %num.add
      ~> [haystack, needle, ~, end] ~> ^
    }
  }
}

// Convert byte position to character index by counting non-continuation bytes from start
byte_pos_to_char_idx = #['bin, 'int, 'int, 'int] {
  =[data, current_pos, target_pos, char_idx]
  {
    | [current_pos, target_pos] ~> %num.ge? => char_idx
    | [data, current_pos] ~> is_continuation => {
      current_pos
      ~> [~, 1] ~> %num.add
      ~> [data, ~, target_pos, char_idx] ~> ^
    }
    | {
      // Start of character - count it
      new_char_idx = [char_idx, 1] ~> %num.add

      current_pos
      ~> [~, 1] ~> %num.add
      ~> [data, ~, target_pos, new_char_idx] ~> ^
    }
  }
}

// Iterator over the Unicode codepoints (as ints) of a binary. The state is the
// byte position; each step skips any continuation bytes, then decodes the char.
chars = #'bin {
  =data
  data_len = data ~> %bin.length
  [
    0,
    #'int {
      =byte_pos
      byte_pos = [data, byte_pos, data_len] ~> skip_continuation
      {
        | [byte_pos, data_len] ~> %num.ge? => []
        | {
          char_end =
            byte_pos
            ~> [~, 1] ~> %num.add
            ~> [data, ~, data_len] ~> skip_continuation

          char =
            char_end
            ~> [~, byte_pos] ~> %num.sub
            ~> [~, 8] ~> %num.mul
            ~> [data, byte_pos, 0, ~] ~> __binary_get__

          [char, char_end]
        }
      }
    },
  ] ~> %iter.unfold
}

// Reassemble a Str from an iterator of codepoints, encoding each as UTF-8.
from_chars = #'%iter<'int> {
  [
    ~,
    0x,
    #['bin, 'int] {
      =[acc, char_int]
      byte_count = char_int ~> {
        | [~, 127] ~> %num.le? => 1
        | [~, 57279] ~> %num.le? => 2
        | [~, 15712191] ~> %num.le? => 3
        | 4
      }
      [acc, char_int, byte_count] ~> %bin.append
    },
  ] ~> %iter.fold
  ~> Str[~]
}

// Decimal digits from byte pos, accumulating onto acc: [value, end-pos]. Zero or more.
int_digits = #['bin, 'int, 'int, 'int] {
  =[data, pos, len, acc]
  {
    | [pos, len] ~> %num.lt?; [data, pos] ~> %bin.get_byte ~> =('int)b; [b, 48] ~> %num.ge?; [b, 57] ~> %num.le? => {
      [[acc, 10] ~> %num.mul, [b, 48] ~> %num.sub] ~> %num.add
      ~> [data, [pos, 1] ~> %num.add, len, ~] ~> ^
    }
    | [acc, pos]
  }
}

// The decimal digit bytes of a positive integer, prepended (lowest digit first) onto acc.
// The raw division builtins (rather than `%int.div`/`%int.mod`) keep this total: the divisor
// is the constant 10, so the zero-divisor nil the stdlib wrappers add can never arise.
int_bytes = #['int, 'bin] {
  =[n, acc]
  {
    | n ~> =0 => acc
    | {
      d = [n, 10] ~> __integer_modulo__
      q = [n, 10] ~> __integer_divide__
      digit = [0x, [d, 48] ~> %num.add, 1] ~> %bin.append
      [q, [digit, acc] ~> %bin.concat] ~> ^
    }
  }
}

[
  bytes: #' {
    :doc "The underlying UTF-8 bytes of a string."
    .0
  },

  parse_int: #' {
    :doc "Parses a string as an optionally signed decimal integer; nil unless the whole string is one."
    =Str[data]
    len = data ~> %bin.length
    start = {
      | [len, 0] ~> %num.gt?; [data, 0] ~> %bin.get_byte ~> =45; 1
      | 0
    }
    [start, len] ~> %num.lt?
    [data, start, len, 0] ~> int_digits
    =[n, end]
    end ~> =&len
    { start ~> =1 => [0, n] ~> %num.sub | n }
  },

  from_int: #'int {
    :doc "The decimal representation of an integer."
    {
      | $ ~> =0 => "0"
      | [$, 0] ~> %num.lt? => [0, $] ~> %num.sub ~> [~, 0x] ~> int_bytes ~> [0x2d, ~] ~> %bin.concat ~> Str[
        ~,
      ]
      | [$, 0x] ~> int_bytes ~> Str[~]
    }
  },

  empty?: #' {
    :doc "Whether a string is empty."
    .0 ~> %bin.length ~> =0; Ok
  },

  concat: #[', '] {
    :doc "Concatenates two strings."
    =[Str[a], Str[b]]; [a, b] ~> %bin.concat ~> Str[~]
  },

  starts_with?: #[', '] {
    :doc "Whether a string starts with a prefix."
    =[Str[target], Str[prefix]]
    prefix_len = prefix ~> %bin.length
    target_len = target ~> %bin.length
    [prefix_len, target_len] ~> %num.le?

    target
    ~> [~, 0, prefix_len] ~> %bin.slice
    ~> =&prefix

    Ok
  },

  ends_with?: #[', '] {
    :doc "Whether a string ends with a suffix."
    =[Str[target], Str[suffix]]
    suffix_len = suffix ~> %bin.length
    target_len = target ~> %bin.length
    [suffix_len, target_len] ~> %num.le?

    target_len
    ~> [~, suffix_len] ~> %num.sub
    ~> [target, ~, target_len] ~> %bin.slice
    ~> =&suffix

    Ok
  },

  contains?: #[', '] {
    :doc "Whether a string contains a substring."
    =[Str[haystack], Str[needle]]
    needle_len = needle ~> %bin.length
    haystack_len = haystack ~> %bin.length
    {
      | needle_len ~> =0 => Ok
      | [needle_len, haystack_len] ~> %num.gt? => []
      | haystack_len
        ~> [~, needle_len] ~> %num.sub
        ~> [haystack, needle, 0, ~] ~> find_index => Ok
    }
  },

  split: #[', '] {
    :doc "Splits a string on a delimiter, yielding an iterator of the pieces."
    =[Str[haystack], Str[delim]]
    haystack_len = haystack ~> %bin.length
    delim_len = delim ~> %bin.length
    end = [haystack_len, delim_len] ~> %num.sub
    [
      0,
      #'int {
        =start
        {
          | start ~> [~, haystack_len] ~> %num.gt? => []
          | [haystack, delim, start, end] ~> find_index
            ~> =('int)index => [
              haystack ~> [~, start, index] ~> %bin.slice ~> Str[~],
              [index, delim_len] ~> %num.add,
            ]
          | [
            haystack ~> [~, start, haystack_len] ~> %bin.slice ~> Str[~],
            [haystack_len, 1] ~> %num.add,
          ]
        }
      },
    ] ~> %iter.unfold
  },

  length: #' {
    :doc "The number of Unicode characters in a string."
    .0 ~> chars ~> %iter.count
  },

  slice: #[', 'int, 'int] {
    :doc "The substring from start (inclusive) to end (exclusive), in character indices."
    =[Str[data], start, end]

    data
    ~> chars
    ~> [~, start] ~> %iter.drop
    ~> [~, [end, start] ~> %num.sub] ~> %iter.take
    ~> from_chars
  },

  index_of: #[', '] {
    :doc "The character index of the first occurrence of a substring, or nil when absent."
    =[Str[haystack], Str[needle]]
    needle_len = needle ~> %bin.length
    haystack_len = haystack ~> %bin.length
    {
      | needle_len ~> =0 => {
        0 // Empty string is at index 0
      }
      | [needle_len, haystack_len] ~> %num.gt? => {
        [] // Needle longer than haystack
      }
      | {
        haystack_len
        ~> [~, needle_len] ~> %num.sub
        ~> [haystack, needle, 0, ~] ~> find_index
        ~> =('int)byte_pos

        [haystack, 0, byte_pos, 0] ~> byte_pos_to_char_idx
      }
    }
  },

  iter: #' {
    :doc "An iterator over the Unicode codepoints of a string, as integers."
    $0 ~> chars
  },

  collect: #'%iter<'int> {
    :doc "Builds a string from an iterator of Unicode codepoints."
    from_chars
  },

  join: #['%iter<'>, '] {
    :doc "Joins an iterator of strings with a separator between each."
    =[it, Str[sep]]
    it ~> [~, #' { .0 }] ~> %iter.map ~> [~, sep] ~> %iter.intersperse ~> [~, 0x, &%bin.concat] ~> %iter.fold ~> Str[
      ~,
    ]
  },
]
