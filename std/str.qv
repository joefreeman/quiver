' = Str['bin]

is_continuation = #['bin, 'int] {
  $0
  ~> %bin.get_byte [~, $1] ~> %int.and [~, 192] ~> =128
}

skip_continuation = #[(data): 'bin, (byte_pos): 'int, (data_len): 'int] {
  | $byte_pos ~> %num.ge? [~, $data_len] => $byte_pos
  | is_continuation [$data, $byte_pos] => $byte_pos ~> %num.add [~, 1] ~> ^ [$data, ~, $data_len]
  | $byte_pos
}

// The byte index in [offset, end] where `needle` first occurs, or nil. Rather than
// slice-and-compare at every position, jump straight to each occurrence of the needle's
// first byte (a native rope scan) and verify the rest there — so a scan skips the runs
// between candidates instead of stepping a byte at a time.
find_index = #[(haystack): 'bin, (needle): 'bin, (offset): 'int, (end): 'int] {
  // The verification pins the needle (`=&needle`), and a pin checks a variable, so bind
  // the field locally.
  needle = $needle
  {
    | %bin.length needle ~> =0 => $offset
    | %bin.index [$haystack, %bin.get_byte [needle, 0], $offset] ~> =('int)pos
      %num.le? [pos, $end] => {
      | %bin.length needle ~> %num.add [pos, ~] ~> %bin.slice [$haystack, pos, ~] ~> =&needle => pos
      | %num.add [pos, 1] ~> ^ [$haystack, needle, ~, $end]
    }
    | []
  }
}

// Convert byte position to character index by counting non-continuation bytes from start
byte_pos_to_char_idx = #[(data): 'bin, (current_pos): 'int, (target_pos): 'int, (char_idx): 'int] {
  | %num.ge? [$current_pos, $target_pos] => $char_idx
  | is_continuation [$data, $current_pos] => $current_pos ~> %num.add [~, 1] ~> ^ [
    $data,
    ~,
    $target_pos,
    $char_idx,
  ]
  | {
    // Start of character - count it
    new_char_idx = %num.add [$char_idx, 1]

    $current_pos ~> %num.add [~, 1] ~> ^ [$data, ~, $target_pos, new_char_idx]
  }
}

// Iterator over the Unicode codepoints (as ints) of a binary. The state is the
// byte position; each step skips any continuation bytes, then decodes the char.
chars = #'bin {
  =data
  data_len = %bin.length data
  %iter.unfold [
    0,
    #'int {
      =byte_pos
      byte_pos = skip_continuation [data, byte_pos, data_len]
      {
        | %num.ge? [byte_pos, data_len] => []
        | {
          char_end = byte_pos ~> %num.add [~, 1] ~> skip_continuation [data, ~, data_len]

          char = char_end ~> %num.sub [~, byte_pos] ~> %num.mul [~, 8] ~> __binary_get__ [
            data,
            byte_pos,
            0,
            ~,
          ]

          [char, char_end]
        }
      }
    },
  ]
}

// Reassemble a Str from an iterator of codepoints, encoding each as UTF-8.
from_chars = #'%iter<'int> {
  %iter.fold [
    ~,
    <>,
    #['bin, 'int] {
      =[acc, char_int]
      byte_count = char_int ~> {
        | %num.le? [~, 127] => 1
        | %num.le? [~, 57279] => 2
        | %num.le? [~, 15712191] => 3
        | 4
      }
      %bin.append [acc, char_int, byte_count]
    },
  ] ~> Str[~]
}

// Decimal digits from byte pos, accumulating onto acc: [n: value, end: pos]. Zero or more.
int_digits = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'int] {
  | %num.lt? [$pos, $len]; %bin.get_byte [$data, $pos] ~> =('int)b; %num.ge? [b, 48]; %num.le? [b, 57] => %num.add [%num.mul [$acc, 10], %num.sub [b, 48]] ~> ^ [
    $data,
    %num.add [$pos, 1],
    $len,
    ~,
  ]
  | [n: $acc, end: $pos]
}

// The decimal digit bytes of a positive integer, prepended (lowest digit first) onto acc.
// The raw division builtins (rather than `%int.div`/`%int.mod`) keep this total: the divisor
// is the constant 10, so the zero-divisor nil the stdlib wrappers add can never arise.
int_bytes = #[(n): 'int, (acc): 'bin] {
  | $n ~> =0 => $acc
  | {
    d = __integer_modulo__ [$n, 10]
    q = __integer_divide__ [$n, 10]
    digit = %bin.append [<>, %num.add [d, 48], 1]
    ^ [q, %bin.concat [digit, $acc]]
  }
}

[
  bytes: #' {
    :doc "The underlying UTF-8 bytes of a string."
    .0
  },

  parse_int: #' {
    :doc "Parses a string as an optionally signed decimal integer; nil unless the whole string is one."
    =Str[data]
    len = %bin.length data
    start = {
      | %num.gt? [len, 0]; %bin.get_byte [data, 0] ~> =45; 1
      | 0
    }
    %num.lt? [start, len]
    int_digits [data, start, len, 0] ~> =(n, end)
    end ~> =&len
    { start ~> =1 => %num.sub [0, n] | n }
  },

  from_int: #'int {
    :doc "The decimal representation of an integer."
    {
      | $ ~> =0 => "0"
      | %num.lt? [$, 0] => %num.sub [0, $] ~> int_bytes [~, <>] ~> %bin.concat [<2d>, ~] ~> Str[~]
      | int_bytes [$, <>] ~> Str[~]
    }
  },

  empty?: #' {
    :doc "Whether a string is empty."
    .0 ~> %bin.length ~ ~> =0; Ok
  },

  concat: #[', '] {
    :doc "Concatenates two strings."
    =[Str[a], Str[b]]; %bin.concat [a, b] ~> Str[~]
  },

  starts_with?: #[(str): ', (prefix): '] {
    :doc "Whether a string starts with a prefix."
    Str[target] = $str
    Str[prefix] = $prefix
    prefix_len = %bin.length prefix
    target_len = %bin.length target
    %num.le? [prefix_len, target_len]

    target
    ~> %bin.slice [~, 0, prefix_len] ~> =&prefix

    Ok
  },

  ends_with?: #[(str): ', (suffix): '] {
    :doc "Whether a string ends with a suffix."
    Str[target] = $str
    Str[suffix] = $suffix
    suffix_len = %bin.length suffix
    target_len = %bin.length target
    %num.le? [suffix_len, target_len]

    target_len
    ~> %num.sub [~, suffix_len] ~> %bin.slice [target, ~, target_len] ~> =&suffix

    Ok
  },

  contains?: #[(str): ', (needle): '] {
    :doc "Whether a string contains a substring."
    Str[haystack] = $str
    Str[needle] = $needle
    needle_len = %bin.length needle
    haystack_len = %bin.length haystack
    {
      | needle_len ~> =0 => Ok
      | %num.gt? [needle_len, haystack_len] => []
      | haystack_len ~> %num.sub [~, needle_len] ~> find_index [haystack, needle, 0, ~] => Ok
    }
  },

  split: #[(str): ', (sep): '] {
    :doc "Splits a string on a delimiter, yielding an iterator of the pieces."
    Str[haystack] = $str
    Str[delim] = $sep
    haystack_len = %bin.length haystack
    delim_len = %bin.length delim
    end = %num.sub [haystack_len, delim_len]
    %iter.unfold [
      0,
      #'int {
        =start
        {
          | start ~> %num.gt? [~, haystack_len] => []
          | find_index [
              haystack,
              delim,
              start,
              end,
            ] ~> =('int)index => [
              haystack ~> %bin.slice [~, start, index] ~> Str[~],
              %num.add [index, delim_len],
            ]
          | [haystack ~> %bin.slice [~, start, haystack_len] ~> Str[~], %num.add [haystack_len, 1]]
        }
      },
    ]
  },

  length: #' {
    :doc "The number of Unicode characters in a string."
    .0 ~> chars ~ ~> %iter.count ~
  },

  slice: #[(str): ', (start): 'int, (end): 'int] {
    :doc "The substring from start (inclusive) to end (exclusive), in character indices."
    Str[data] = $str

    chars data ~> %iter.drop [~, $start] ~> %iter.take [~, %num.sub [$end, $start]] ~> from_chars ~
  },

  index_of: #[(str): ', (needle): '] {
    :doc "The character index of the first occurrence of a substring, or nil when absent."
    Str[haystack] = $str
    Str[needle] = $needle
    needle_len = %bin.length needle
    haystack_len = %bin.length haystack
    {
      | needle_len ~> =0 => {
        0 // Empty string is at index 0
      }
      | %num.gt? [needle_len, haystack_len] => {
        [] // Needle longer than haystack
      }
      | {
        haystack_len
        ~> %num.sub [~, needle_len] ~> find_index [haystack, needle, 0, ~] ~> =('int)byte_pos

        byte_pos_to_char_idx [haystack, 0, byte_pos, 0]
      }
    }
  },

  iter: #' {
    :doc "An iterator over the Unicode codepoints of a string, as integers."
    chars $0
  },

  collect: #'%iter<'int> {
    :doc "Builds a string from an iterator of Unicode codepoints."
    from_chars ~
  },

  join: #[(strs): '%iter<'>, (sep): '] {
    :doc "Joins an iterator of strings with a separator between each."
    Str[sep] = $sep
    $strs ~> %iter.map [~, #' { .0 }] ~> %iter.intersperse [~, sep] ~> %iter.fold [~, <>, %bin.concat] ~> Str[
      ~,
    ]
  },
]
