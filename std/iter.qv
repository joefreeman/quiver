// An iterator is a lazy sequence: an `Iter[...]` tuple wrapping a thunk that
// yields `[value, next]` (the continuation) or `[]` when exhausted. Wrapping it
// as a value (rather than a bare callable) means a bound iterator flows through a
// chain without being invoked. The thunk type is private to this module - other
// modules build iterators with `unfold` and consume them with `fold`/`count`/etc.,
// so they never need to name the thunk type themselves.
'thunk<'t> = #[] -> (['t, ^] | [])
'<'t> = Iter['thunk<'t>]

// Build an iterator from a seed state and a step function that maps the state to
// `[value, next_state]`, or to `[]` to terminate.
unfold = #<'s, 't>[#^ -> 'thunk<'t>, 's, #'s -> (['t, 's] | [])] {
  =[self, state, step]
  #{ state step =[value, next_state], [value, [&self, next_state, &step] self] }
}

map = #<'t, 'u>[#^ -> 'thunk<'t>, 'thunk<'t>, #'t -> 'u] {
  =[self, it, f]
  #{ it =[value, next], value f [~, [&self, &next, &f] self] }
}

filter = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, #'t -> ('t | [])] {
  =[self, it, pred]
  #{
    it =[value, next]
    {
      | value pred => [&self, &next, &pred] self [value, ~]
      | [&self, &next, &pred] self ^~
    }
  }
}

take = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, 'int] {
  =[self, it, n]
  #{
    | n =0 => []
    | { it =[value, next], n [~, 1] %num.sub [&self, &next, ~] self [value, ~] }
  }
}

drop = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, 'int] {
  =[self, it, n]
  #{
    | n =0 => it
    | { it =[_, next], n [~, 1] %num.sub [&self, &next, ~] self ^~ }
  }
}

take_while = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, #'t -> ('t | [])] {
  =[self, it, pred]
  #{ it =[value, next], value pred, [&self, &next, &pred] self [value, ~] }
}

drop_while = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, #'t -> ('t | [])] {
  =[self, it, pred]
  #{
    it =[value, next]
    {
      | value pred => [&self, &next, &pred] self ^~
      | [value, &next]
    }
  }
}

flat_map = #<'t, 'u>[#^ -> 'thunk<'u>, 'thunk<'t>, #'t -> '<'u>, 'thunk<'u>] {
  =[self, source, f, current]
  #{
    | { current =[value, next], [value, [&self, &source, &f, &next] self] }
    | { source =[value, next], value f =Iter[fc], [&self, &next, &f, &fc] self ^~ }
  }
}

chain = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, 'thunk<'t>] {
  =[self, first, second]
  #{
    first {
      | =[value, next] => [value, [&self, &next, &second] self]
      | =[] => second
    }
  }
}

zip = #<'t, 'u>[#^ -> 'thunk<['t, 'u]>, 'thunk<'t>, 'thunk<'u>] {
  =[self, it1, it2]
  #{ it1 =[v1, next1], it2 =[v2, next2], [[v1, v2], [&self, &next1, &next2] self] }
}

enumerate = #<'t>[#^ -> 'thunk<['int, 't]>, 'thunk<'t>, 'int] {
  =[self, it, index]
  #{ it =[value, next], index [~, 1] %num.add [&self, &next, ~] self [[index, value], ~] }
}

cycle = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, 'thunk<'t>] {
  =[self, original, current]
  #{
    current {
      | =[value, next] => [value, [&self, &original, &next] self]
      | [&self, &original, &original] self ^~
    }
  }
}

repeat = #<'t>[#^ -> 'thunk<'t>, 't] { =[self, value], #{ [value, [&self, value] self] } }

fold = #<'t, 'acc>['thunk<'t>, 'acc, #['acc, 't] -> 'acc] {
  =[it, acc, f]
  it {
    | =[value, next] => [acc, value] f [&next, ~, &f] ^
    | acc
  }
}

find = #<'t>['thunk<'t>, #'t -> ('t | [])] {
  =[it, pred], it =[value, next], { value pred => value | [&next, &pred] ^ }
}

find_index = #<'t>['thunk<'t>, #'t -> ('t | []), 'int] {
  =[it, pred, index]
  it =[value, next]
  {
    | value pred => index
    | index [~, 1] %num.add [&next, &pred, ~] ^
  }
}

any = #<'t>['thunk<'t>, #'t -> ('t | [])] {
  =[it, pred], it =[value, next], { value pred => Ok | [&next, &pred] ^ }
}

all = #<'t>['thunk<'t>, #'t -> ('t | [])] {
  =[it, pred]
  it {
    | =[] => Ok
    | =[value, next], value pred => [&next, &pred] ^
    | []
  }
}

nth = #<'t>['thunk<'t>, 'int] {
  | =[it, 0] => { it =[value, _], value }
  | =[it, n] => { it =[_, next], n [~, 1] %num.sub [&next, ~] ^ }
}

intersperse = #<'t>[#^ -> 'thunk<'t>, 'thunk<'t>, 't] {
  =[self, it, sep]
  #{ it =[value, next], [sep, #{ [value, [&self, &next, sep] self] }] }
}

[
  unfold: #<'s, 't>['s, #'s -> (['t, 's] | [])] {
    :doc "An iterator built from a seed state and a step function; ends when the step yields nil."
    =[state, step], [&unfold, state, &step] unfold Iter[~]
  },

  map: #<'t, 'u>['<'t>, #'t -> 'u] {
    :doc "Transforms each element of an iterator with a function, lazily."
    =[Iter[r], f], [&map, &r, &f] map Iter[~]
  },

  filter: #<'t>['<'t>, #'t -> ('t | [])] {
    :doc "Keeps only the elements for which the predicate is non-nil, lazily."
    =[Iter[r], pred], [&filter, &r, &pred] filter Iter[~]
  },

  take: #<'t>['<'t>, 'int] {
    :doc "An iterator over at most the first n elements."
    =[Iter[r], n], [&take, &r, n] take Iter[~]
  },

  drop: #<'t>['<'t>, 'int] {
    :doc "An iterator that skips the first n elements."
    =[Iter[r], n], [&drop, &r, n] drop Iter[~]
  },

  take_while: #<'t>['<'t>, #'t -> ('t | [])] {
    :doc "Yields elements while the predicate is non-nil, then ends."
    =[Iter[r], pred], [&take_while, &r, &pred] take_while Iter[~]
  },

  drop_while: #<'t>['<'t>, #'t -> ('t | [])] {
    :doc "Skips elements while the predicate is non-nil, yielding the rest."
    =[Iter[r], pred], [&drop_while, &r, &pred] drop_while Iter[~]
  },

  flat_map: #<'t, 'u>['<'t>, #'t -> '<'u>] {
    :doc "Maps each element to an iterator and concatenates the results, lazily."
    =[Iter[r], f], [&flat_map, &r, &f, #{ [] }] flat_map Iter[~]
  },

  chain: #<'t>['<'t>, '<'t>] {
    :doc "An iterator over the first iterator's elements followed by the second's."
    =[Iter[r1], Iter[r2]], [&chain, &r1, &r2] chain Iter[~]
  },

  zip: #<'t, 'u>['<'t>, '<'u>] {
    :doc "Pairs up elements from two iterators, ending when either is exhausted."
    =[Iter[r1], Iter[r2]], [&zip, &r1, &r2] zip Iter[~]
  },

  enumerate: #<'t>'<'t> {
    :doc "Pairs each element with its zero-based index."
    =Iter[r], [&enumerate, &r, 0] enumerate Iter[~]
  },

  cycle: #<'t>'<'t> {
    :doc "An iterator that repeats the elements endlessly."
    =Iter[r], [&cycle, &r, &r] cycle Iter[~]
  },

  repeat: #<'t>'t {
    :doc "An endless iterator that yields the given value."
    [&repeat, ~] repeat Iter[~]
  },

  fold: #<'t, 'acc>['<'t>, 'acc, #['acc, 't] -> 'acc] {
    :doc "Reduces an iterator by folding each element into an accumulator."
    =[Iter[r], acc, f], [&r, acc, &f] fold
  },

  find: #<'t>['<'t>, #'t -> ('t | [])] {
    :doc "The first element for which the predicate is non-nil, or nil when none matches."
    =[Iter[r], pred], [&r, &pred] find
  },

  find_index: #<'t>['<'t>, #'t -> ('t | [])] {
    :doc "The zero-based index of the first matching element, or nil when none matches."
    =[Iter[r], pred], [&r, &pred, 0] find_index
  },

  any?: #<'t>['<'t>, #'t -> ('t | [])] {
    :doc "Whether any element satisfies the predicate."
    =[Iter[r], pred], [&r, &pred] any
  },

  all?: #<'t>['<'t>, #'t -> ('t | [])] {
    :doc "Whether every element satisfies the predicate."
    =[Iter[r], pred], [&r, &pred] all
  },

  count: #<'t>'<'t> {
    :doc "The number of elements in the iterator."
    =Iter[r], [&r, 0, #['int, 'int] { [$0, 1] %num.add }] fold
  },

  nth: #<'t>['<'t>, 'int] {
    :doc "The element at the given zero-based index, or nil when the iterator is too short."
    =[Iter[r], n], [&r, n] nth
  },

  intersperse: #<'t>['<'t>, 't] {
    :doc "An iterator with the separator inserted between consecutive elements."
    =[Iter[r], sep], #{ r =[first, rest], [first, [&intersperse, &rest, sep] intersperse] } Iter[~]
  },
]
