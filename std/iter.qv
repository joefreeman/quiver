// An iterator is a lazy sequence: an `Iter[...]` tuple wrapping a thunk that
// yields `[value, next]` (the continuation) or `[]` when exhausted. Wrapping it
// as a value (rather than a bare callable) means a bound iterator flows through a
// chain without being invoked. The thunk type is private to this module - other
// modules build iterators with `unfold` and consume them with `fold`/`count`/etc.,
// so they never need to name the thunk type themselves.
'thunk<'t> = #[] -> (['t, ^1] | [])
'<'t> = Iter['thunk<'t>]

// Build an iterator from a seed state and a step function that maps the state to
// `[value, next_state]`, or to `[]` to terminate.
unfold = #<'s, 't>[(self): ^, (state): 's, (step): #'s -> (['t, 's] | [])] -> 'thunk<'t> {
  self = $self
  state = $state
  step = $step
  #[] { step state ~> =[value, next_state]; [value, self [self, next_state, step]] }
}

map = #<'t, 'u>[(self): ^, (it): 'thunk<'t>, (f): #'t -> 'u] -> 'thunk<'u> {
  self = $self
  it = $it
  f = $f
  #[] { it [] ~> =[value, next]; f value ~> [~, self [self, next, f]] }
}

filter = #<'t>[(self): ^, (it): 'thunk<'t>, (pred): #'t -> _] -> 'thunk<'t> {
  self = $self
  it = $it
  pred = $pred
  #[] {
    it [] ~> =[value, next]
    {
      | pred value => self [self, next, pred] ~> [value, ~]
      | self [self, next, pred] ~> ^~ []
    }
  }
}

take = #<'t>[(self): ^, (it): 'thunk<'t>, (n): 'int] -> 'thunk<'t> {
  self = $self
  it = $it
  n = $n
  #[] {
    | n ~> =0 => []
    | { it [] ~> =[value, next]; n ~> %num.sub [~, 1] ~> self [self, next, ~] ~> [value, ~] }
  }
}

drop = #<'t>[(self): ^, (it): 'thunk<'t>, (n): 'int] -> 'thunk<'t> {
  self = $self
  it = $it
  n = $n
  #[] {
    | n ~> =0 => it []
    | {
      it [] ~> =[_, next]

      n ~> %num.sub [~, 1] ~> self [self, next, ~] ~> ^~ []
    }
  }
}

take_while = #<'t>[(self): ^, (it): 'thunk<'t>, (pred): #'t -> _] -> 'thunk<'t> {
  self = $self
  it = $it
  pred = $pred
  #[] { it [] ~> =[value, next]; pred value; self [self, next, pred] ~> [value, ~] }
}

drop_while = #<'t>[(self): ^, (it): 'thunk<'t>, (pred): #'t -> _] -> 'thunk<'t> {
  self = $self
  it = $it
  pred = $pred
  #[] {
    it [] ~> =[value, next]
    {
      | pred value => self [self, next, pred] ~> ^~ []
      | [value, next]
    }
  }
}

flat_map = #<'t, 'u>[
  (self): ^,
  (source): 'thunk<'t>,
  (f): #'t -> '<'u>,
  (current): 'thunk<'u>,
] -> 'thunk<'u> {
  self = $self
  source = $source
  f = $f
  current = $current
  #[] {
    | { current [] ~> =[value, next]; [value, self [self, source, f, next]] }
    | { source [] ~> =[value, next]; f value ~> =Iter[fc]; self [self, next, f, fc] ~> ^~ [] }
  }
}

chain = #<'t>[(self): ^, (first): 'thunk<'t>, (second): 'thunk<'t>] -> 'thunk<'t> {
  self = $self
  first = $first
  second = $second
  #[] {
    first [] ~> {
      | =[value, next] => [value, self [self, next, second]]
      | =[] => second []
    }
  }
}

zip = #<'t, 'u>[(self): ^, (it1): 'thunk<'t>, (it2): 'thunk<'u>] -> 'thunk<['t, 'u]> {
  self = $self
  it1 = $it1
  it2 = $it2
  #[] { it1 [] ~> =[v1, next1]; it2 [] ~> =[v2, next2]; [[v1, v2], self [self, next1, next2]] }
}

enumerate = #<'t>[(self): ^, (it): 'thunk<'t>, (index): 'int] -> 'thunk<['int, 't]> {
  self = $self
  it = $it
  index = $index
  #[] {
    it [] ~> =[value, next]; index ~> %num.add [~, 1] ~> self [self, next, ~] ~> [[index, value], ~]
  }
}

cycle = #<'t>[(self): ^, (original): 'thunk<'t>, (current): 'thunk<'t>] -> 'thunk<'t> {
  self = $self
  original = $original
  current = $current
  #[] {
    current [] ~> {
      | =[value, next] => [value, self [self, original, next]]
      | self [self, original, original] ~> ^~ []
    }
  }
}

repeat = #<'t>[(self): ^, (value): 't] -> 'thunk<'t> {
  self = $self; value = $value; #[] { [value, self [self, value]] }
}

fold = #<'t, 'acc>[(it): 'thunk<'t>, (acc): 'acc, (f): #['acc, 't] -> 'acc] {
  $it [] ~> {
    | =[value, next] => $f [$acc, value] ~> ^ [next, ~, $f]
    | $acc
  }
}

// A step ends with a nil, which for a source backed by io means *either* exhaustion or a
// failure — the latter carrying an `:error` payload. `fold` cannot tell them apart, because
// recovering to the accumulator is how it terminates at all, so a failed walk reads as a
// completed one. `try_fold` checks before recovering and propagates the failure nil instead,
// payload intact. Pure sources (`%list`, `%range`, `%dict`) can never produce one, which is
// why this is a sibling rather than a change to `fold`: their folds stay exactly `'acc`.
try_fold = #<'t, 'acc>[(it): 'thunk<'t>, (acc): 'acc, (f): #['acc, 't] -> 'acc] {
  $it [] ~> {
    | =[value, next] => $f [$acc, value] ~> ^ [next, ~, $f]
    // A consequence starts from its condition's value, so the condition ends with a match on
    // the failed nil itself (a plain `~` step would fail on it), which propagates it intact.
    | :error<()>; =_ => ~
    | $acc
  }
}

find = #<'t>[(it): 'thunk<'t>, (pred): #'t -> _] {
  $it [] ~> =[value, next]; { $pred value => value | ^ [next, $pred] }
}

find_index = #<'t>[(it): 'thunk<'t>, (pred): #'t -> _, (index): 'int] {
  $it [] ~> =[value, next]
  {
    | $pred value => $index
    | $index ~> %num.add [~, 1] ~> ^ [next, $pred, ~]
  }
}

any = #<'t>[(it): 'thunk<'t>, (pred): #'t -> _] {
  $it [] ~> =[value, next]; { $pred value => Ok | ^ [next, $pred] }
}

all = #<'t>[(it): 'thunk<'t>, (pred): #'t -> _] {
  $it [] ~> {
    | =[] => Ok
    | =[value, next]; $pred value => ^ [next, $pred]
    | []
  }
}

nth = #<'t>[(it): 'thunk<'t>, (n): 'int] {
  | $n ~> =0 => { $it [] ~> =[value, _]; value }
  | { $it [] ~> =[_, next]; $n ~> %num.sub [~, 1] ~> ^ [next, ~] }
}

intersperse = #<'t>[(self): ^, (it): 'thunk<'t>, (sep): 't] -> 'thunk<'t> {
  self = $self
  it = $it
  sep = $sep
  #[] { it [] ~> =[value, next]; [sep, #[] { [value, self [self, next, sep]] }] }
}

[
  unfold: #<'s, 't>[(seed): 's, (f): #'s -> (['t, 's] | [])] {
    :doc "An iterator built from a seed state and a step function; ends when the step yields nil."
    unfold [unfold, $seed, $f] ~> Iter[~]
  },

  map: #<'t, 'u>[(iter): '<'t>, (f): #'t -> 'u] {
    :doc "Transforms each element of an iterator with a function, lazily."
    $iter ~> =Iter[~] ~> map [map, ~, $f] ~> Iter[~]
  },

  filter: #<'t>[(iter): '<'t>, (pred): #'t -> _] {
    :doc "Keeps only the elements for which the predicate is non-nil, lazily."
    $iter ~> =Iter[~] ~> filter [filter, ~, $pred] ~> Iter[~]
  },

  take: #<'t>[(iter): '<'t>, (n): 'int] {
    :doc "An iterator over at most the first n elements."
    $iter ~> =Iter[~] ~> take [take, ~, $n] ~> Iter[~]
  },

  drop: #<'t>[(iter): '<'t>, (n): 'int] {
    :doc "An iterator that skips the first n elements."
    $iter ~> =Iter[~] ~> drop [drop, ~, $n] ~> Iter[~]
  },

  take_while: #<'t>[(iter): '<'t>, (pred): #'t -> _] {
    :doc "Yields elements while the predicate is non-nil, then ends."
    $iter ~> =Iter[~] ~> take_while [take_while, ~, $pred] ~> Iter[~]
  },

  drop_while: #<'t>[(iter): '<'t>, (pred): #'t -> _] {
    :doc "Skips elements while the predicate is non-nil, yielding the rest."
    $iter ~> =Iter[~] ~> drop_while [drop_while, ~, $pred] ~> Iter[~]
  },

  flat_map: #<'t, 'u>[(iter): '<'t>, (f): #'t -> '<'u>] {
    :doc "Maps each element to an iterator and concatenates the results, lazily."
    $iter ~> =Iter[~] ~> flat_map [flat_map, ~, $f, #{ [] }] ~> Iter[~]
  },

  chain: #<'t>[(iter): '<'t>, (with): '<'t>] {
    :doc "An iterator over the first iterator's elements followed by the second's."
    $iter ~> =Iter[r1]; $with ~> =Iter[r2]; chain [chain, r1, r2] ~> Iter[~]
  },

  zip: #<'t, 'u>[(iter): '<'t>, (with): '<'u>] {
    :doc "Pairs up elements from two iterators, ending when either is exhausted."
    $iter ~> =Iter[r1]; $with ~> =Iter[r2]; zip [zip, r1, r2] ~> Iter[~]
  },

  enumerate: #<'t>'<'t> {
    :doc "Pairs each element with its zero-based index."
    =Iter[~] ~> enumerate [enumerate, ~, 0] ~> Iter[~]
  },

  cycle: #<'t>'<'t> {
    :doc "An iterator that repeats the elements endlessly."
    =Iter[~] ~> cycle [cycle, ~, ~] ~> Iter[~]
  },

  repeat: #<'t>'t {
    :doc "An endless iterator that yields the given value."
    repeat [repeat, ~] ~> Iter[~]
  },

  fold: #<'t, 'acc>[(iter): '<'t>, (init): 'acc, (f): #['acc, 't] -> 'acc] {
    :doc "Reduces an iterator by folding each element into an accumulator."
    $iter ~> =Iter[~] ~> fold [~, $init, $f]
  },

  try_fold: #<'t, 'acc>[(iter): '<'t>, (init): 'acc, (f): #['acc, 't] -> 'acc] {
    :doc "Folds an iterator that may fail (one backed by io), answering the accumulator on exhaustion and nil — carrying the failure's :error — if the source broke part-way."
    $iter ~> =Iter[~] ~> try_fold [~, $init, $f]
  },

  find: #<'t>[(iter): '<'t>, (pred): #'t -> _] {
    :doc "The first element for which the predicate is non-nil, or nil when none matches."
    $iter ~> =Iter[~] ~> find [~, $pred]
  },

  find_index: #<'t>[(iter): '<'t>, (pred): #'t -> _] {
    :doc "The zero-based index of the first matching element, or nil when none matches."
    $iter ~> =Iter[~] ~> find_index [~, $pred, 0]
  },

  any?: #<'t>[(iter): '<'t>, (pred): #'t -> _] {
    :doc "Whether any element satisfies the predicate."
    $iter ~> =Iter[~] ~> any [~, $pred]
  },

  all?: #<'t>[(iter): '<'t>, (pred): #'t -> _] {
    :doc "Whether every element satisfies the predicate."
    $iter ~> =Iter[~] ~> all [~, $pred]
  },

  count: #'<_> {
    :doc "The number of elements in the iterator."
    =Iter[~] ~> fold [~, 0, #['int, _] { %num.add [$0, 1] }]
  },

  nth: #<'t>[(iter): '<'t>, (n): 'int] {
    :doc "The element at the given zero-based index, or nil when the iterator is too short."
    $iter ~> =Iter[~] ~> nth [~, $n]
  },

  intersperse: #<'t>[(iter): '<'t>, (sep): 't] {
    :doc "An iterator with the separator inserted between consecutive elements."
    // The nested literal closes over `sep` (an inner `$` would be its own parameter),
    // so bind the field locally.
    $iter ~> =Iter[r]
    sep = $sep

    #[] { r [] ~> =[first, rest]; [first, intersperse [intersperse, rest, sep]] }
    ~> Iter[~]
  },
]
