// Supervision: restart strategies as ordinary library code
// on the step-2 primitives. A supervisor is a state loop whose table maps child ids
// to pids and restart recipes; every child gets a *watcher* — a tiny process that
// awaits it (never-lethal `!`), classifies the outcome, and reports
// `Down[id, pid, outcome]` to the supervisor's mailbox. The mailbox multiplexes, so
// the child set is dynamic: `add` puts a child under a running supervisor and
// `drop` kills one (its id may be reused). Identity comes from the
// watcher's creation-time knowledge, never from the await — the pid in the report
// is what makes a late report for a reused id harmless (the supervisor pin-compares
// it against the row before acting, the message-passing analogue of a monitor ref).
//
// Ownership does the rest: children and watchers are spawned in the supervisor's
// process, so stopping the supervisor — or its own crash, e.g. giving up past the
// restart-intensity limit — tears the whole subtree down. A parent supervisor's
// watcher sees that crash as an ordinary Down: escalation is just crashing.
//
//   spec = [id: "worker", restart: Permanent, start: &start_worker]
//   sup = [children: %list{ spec }, max_restarts: 3, window: 5000] ~> %sup.start
//
// A start closure spawns the child, wires its watcher, and answers the (widened)
// pid — note the reference idiom, `&w`, wherever a pid sits in argument position:
//
//   start_worker = #['%str, (@'%sup.down)] {
//     =[id, sup]
//     w = @worker
//     %sup.watch [id, &w, &sup]
//     &w
//   }

'restart = Permanent | Transient | Temporary
'outcome = Done | Crashed['%proc.crash]
'down = Down[id: '%str, pid: @, outcome: 'outcome]

'start = #['%str, @'down] -> @
'spec = [id: '%str, restart: 'restart, start: 'start]
// A dynamic start's verdict: the child's pid (widened to an inert `(@)`), or a
// rejection for an id the table already holds.
'started = Started[@] | Duplicate

// What a supervisor receives: watcher reports, and the dynamic-children requests.
'msg = 'down | Add['spec, @'started] | Drop['%str]
'specs = '%list<'spec>

'stamps = '%list<'int>
'row = [id: '%str, pid: @, spec: 'spec, restarts: 'stamps]
'table = '%dict<'%str, 'row>
'state = [table: 'table, max: 'int, window: 'int]

watch = #<'r>[(id): '%str, (child): (@-> 'r), (sup): @'down] {
  :doc "Spawns a watcher for a child: awaits it, classifies the outcome (Done, or Crashed with the '%proc.crash payload), and reports Down[id, pid, outcome] to the supervisor — the pid identifies WHICH incarnation went down, so a late report for a reused id is harmless. Call from a start closure, passing the child and supervisor by reference."
  // The spawned watcher closes over these (an inner `$` would be its own
  // parameter), so bind the fields locally — the pids by reference, as bare
  // pid terms would send.
  id = $id
  child = &$child
  sup = &$sup
  @{
    r = !child
    o = {
      | r:('%proc.crash)crash ~> =('%proc.crash)e => Crashed[e]
      | Done
    }
    Down[id: id, pid: &child, outcome: o] ~> sup
  }
  Ok
}

// One table row per child: spawn via the spec's start closure (which wires the
// watcher) and record the pid.
start_row = #[(spec): 'spec, (sup): @'down] {
  p = $spec ~> ~.start [$spec.id, &$sup]
  [id: $spec.id, pid: &p, spec: $spec, restarts: Nil]
}

seed = #[(specs): 'specs, (sup): @'down] {
  // The fold's closure closes over the supervisor pid — by reference, as a bare
  // pid term would send.
  sup = &$sup
  %list.fold [$specs, %dict.new, #{ %dict.put [$0, $1.id, start_row [$1, &sup]] }]
}

'verdict = Allowed['stamps] | Exceeded

// The sliding-window restart policy: stamp `now`, keep only stamps newer than the
// cutoff (the sliding intensity window), and allow while at most `max` remain.
// `Allowed` carries the pruned stamps to store back. (Internal; exportable if an
// embedded supervisor — a live-view boundary, say — ever wants to share the policy.)
allow? = #[stamps: 'stamps, now: 'int, max: 'int, window: 'int] -> 'verdict {
  =[stamps: ts, now: now, max: m, window: w]
  cutoff = __integer_subtract__ [now, w]
  recent = Cons[
    now,
    %list.filter [ts, #{ __integer_compare__ [~, cutoff] ~> =1; $ }],
  ]
  {
    | __integer_compare__ [%list.count recent, m] ~> =1 => Exceeded
    | Allowed[recent]
  }
}

// Whether the child's restart type wants a restart for this outcome: Permanent
// always, Temporary never, Transient only after a crash.
restart? = #[(r): 'row, (o): 'outcome] {
  $r.spec.restart ~> {
    | =Permanent => Ok
    | =Temporary => []
    | $o ~> =Crashed[_] => Ok
    | []
  }
}

loop = #'state {
  =[table: t, max: m, window: w]
  !'msg ~> {
    | =Down[id: i, pid: dp, outcome: o] => {
      // The row must hold the SAME incarnation the watcher awaited — a late report
      // for a reused id (drop, then add again) pin-fails and is dropped.
      | %dict.get [t, i] ~> =('row)r; r ~> =(pid: &dp) => {
        | restart? [r, o] => {
          now = %time.monotonic
          allow? [stamps: r.restarts, now: now, max: m, window: w] ~> {
            | =Allowed[recent] => {
              p = r.spec ~> ~.start [i, &.]
              ^ [
                table: %dict.put [t, i, [id: i, pid: &p, spec: r.spec, restarts: recent]],
                max: m,
                window: w,
              ]
            }
            | "%sup: restart intensity exceeded" ~> __panic__
          }
        }
        // No restart wanted: the child is done — drop its row.
        | ^ [table: %dict.remove [t, i], max: m, window: w]
      }
      // A Down for an id no longer in the table (e.g. a deliberately dropped
      // child's watcher reporting the kill), or for a previous incarnation of a
      // reused id, is silently dropped.
      | ^ [table: t, max: m, window: w]
    }
    | =Add[s, reply] => {
      | %dict.has? [t, s.id] => { Duplicate ~> reply; ^ [table: t, max: m, window: w] }
      | {
        row = start_row [s, &.]
        row ~> =(pid: p)
        Started[&p] ~> reply
        ^ [table: %dict.put [t, s.id, row], max: m, window: w]
      }
    }
    | =Drop[i] => {
      // Remove the row BEFORE the kill, so the watcher's report finds nothing.
      | %dict.get [t, i] ~> =('row)r => {
        t2 = %dict.remove [t, i]; r ~> =(pid: p); %proc.kill &p; ^ [table: t2, max: m, window: w]
      }
      | ^ [table: t, max: m, window: w]
    }
  }
}

run = #[specs: 'specs, max: 'int, window: 'int] {
  =[specs: ss, max: m, window: w]; ^loop [table: seed [ss, &.], max: m, window: w]
}

start = #[children: 'specs, max_restarts: 'int = 3, window: 'int = 5000] {
  :doc "Starts a supervisor over the child specs (one_for_one): each child is restarted per its spec's restart type, at most max_restarts times (default 3) within window ms (default 5000) — beyond that the supervisor gives up and crashes, tearing down its subtree. The child set is dynamic: `add` a child, `drop` one. Answers the supervisor's pid, owned by the caller."
  =[children: ss, max_restarts: m, window: w]; [specs: ss, max: m, window: w] ~> @run
}

add = #[(sup): @'msg, (spec): 'spec] {
  :doc "Adds a child to a running supervisor and awaits the verdict: Started[pid] (widened to an inert `(@)`), or Duplicate for an id the table already holds. The child is spawned in the supervisor's process — owned by it, supervised like any startup spec."
  Add[$spec, &.] ~> $sup; !'started
}

drop = #[(sup): @'msg, (id): '%str] {
  :doc "Drops a supervised child: kills it (tearing down its owned subtree) and forgets its row — its watcher's report is disregarded, and the id may be supervised again. Asynchronous: the supervisor applies it in mailbox order."
  Drop[$id] ~> $sup; Ok
}

[start: &start, add: &add, drop: &drop, watch: &watch]
