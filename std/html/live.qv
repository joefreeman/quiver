// Live views: the `%html/live{ … }` markup dialect, and the frames and patches that keep
// a browser in step with it, over `%html` template provenance.
//
// A **frame** is the diffable shape of one render: derived from a node tree by reading
// the `:template` annotation `%html{ … }` and `%html/live{ … }` expansions attach. A template instance becomes
// `Tmpl` (its statics list doubles as its identity — equal statics, same template); its
// hole values become child slots. A `Text` node in a child slot is a `Leaf` (compared by
// value, patched as text); an attribute hole is an `ALeaf` (its element anchor and name
// carried statically); anything without provenance — `raw` markup, hand-built trees,
// node lists — is `Opaque`: rendered whole, compared whole, replaced whole.
//
// `diff [prev, next]` walks two frames depth-first and answers the patches that turn one
// into the other, most-enclosing first. A changed slot subsumes its descendants: same
// statics recurse slot-by-slot; anything else — a differing leaf, a switched template, a
// kind change — emits one patch at that slot's path and stops. A `path` is the hole
// indices from the root; `Nil` addresses the root itself.
//
// `render` serializes a frame to *instrumented* HTML — statics interleaved with slot
// values, so child-hole markers (`<!--q:i-->`/`<!--/q:i-->`) and `data-q` element
// anchors are included: the form a patch applier needs for `SetHtml` payloads and the
// initial region render. (`%html.render` on the tree stays clean of instrumentation.)

// The frame-side attribute value: the tree's `'%html.attr_val<'e>` with events already
// encoded to their %data notation — frames (and the wire) are event-type-erased.
'attr_val = '%str | Ok | []
'statics = '%html.statics

// === Client event metadata ==============================================================
// What the browser knows about an event that its payload cannot carry: a click's
// coordinates, a submit's form fields, an input's current value. A payload is rendered
// on the server, so it has no room for a value only the client has — the two halves
// travel side by side on the wire and are joined *after* the payload decodes, as the
// `:event` annotation on the decoded event. Like every runtime-attached annotation the
// entry is invisible to the rows, so an `update` that ignores it pays nothing, and one
// that wants it reads it back with a checked retrieval:
//
//   update = #[(state): 'state, (event): 'ev] {
//     $event:('%html/live.event)event ~> =Submit(fields: f)
//     ...
//   }
//
// *When* a binding fires is the client's business, not the event type's: it is configured
// on the binding itself, in its `[ … ]` bracket, and never reaches `update`.
// `<input on:input[300]={Filter}>` sends one event when typing stops rather than one per
// keystroke, and `<input on:keydown["Enter"]={Commit}>` sends nothing at all for the
// other keys (see "The markup dialect" below).
'mods = [alt?: (Ok | []), ctrl?: (Ok | []), shift?: (Ok | []), meta?: (Ok | [])]

// What a mouse event reports. `x`/`y` are relative to the **bound element's** box (the one
// carrying the `on:*`), rounded to whole pixels — the frame a view actually reasons in, so
// a drawing surface reads coordinates in its own space without knowing where it sits on
// the page. `button` is 0 for the primary button, and is meaningless for `mousemove`.
'pointer = [x: 'int, y: 'int, button: 'int, mods: 'mods]

// What a form control reports about itself. `checked?` is nil for anything that isn't a
// checkbox or radio, and `value` is the control's own value — for a checkbox that is its
// `value` attribute (or "on"), so `checked?` is what says whether it is ticked.
'field = [value: '%str, checked?: (Ok | [])]

'event =
  | Click[...'pointer]
  | MouseDown[...'pointer]
  | MouseUp[...'pointer]
  | MouseMove[...'pointer]
  | Submit[fields: '%http.pairs]
  | Input[...'field]
  | Change[...'field]
  | KeyDown[key: '%str, mods: 'mods]

// === The markup dialect =================================================================
// `%html/live{ … }` is `%html`'s grammar with the live vocabulary layered on top: this
// module decides what `on:*` and `nav` mean, and `%html` knows neither. The parse tree is
// the seam — `%html.parse` reads the markup, the policy below rewrites the attributes
// this layer claims, and `%html.expand` emits the tree.
//
//   on:NAME={payload}        a binding: the payload is typed data, echoed by the client
//   on:NAME[opts]={payload}  ... with client-side options — see "Binding options"
//   nav                      a link the client follows without a full page load
//
// Both compile to the `data-q-*` attributes the client reads. Markup with no binding
// needs none of this and stays plain `%html{ … }`.

// The DOM events a binding may name, and which option shape each takes: a key event takes
// a `keys` filter as well as rate limits. An unknown name is a compile error, rather than
// markup that silently never fires.
opts_member? = #'%str {
  | ="keydown" => "key_opts"
  | =("click" | "mousedown" | "mouseup" | "mousemove" | "submit" | "input" | "change") => "rate_opts"
}

// The event an `on:NAME` attribute names, or nil for any other attribute.
event_name? = #'%str {
  =Str[b]
  __integer_compare__ [%bin.length b, 4] ~> =(0 | 1)
  Str[%bin.slice [b, 0, 3]] ~> ="on:"
  Str[%bin.slice [b, 3, %bin.length b]]
}

// An `on:NAME` binding: the `data-q-NAME` attribute carrying the payload the client
// echoes back, plus — when the binding carries a bracket — the `data-q-NAME-opts`
// attribute saying when it may fire. The bracket is spliced as the *argument* of the
// event's option function, so its labels, defaults and types are checked there.
binding = #[(attr): '%html.pattr, (event): '%str] {
  $attr ~> =(pos: pos, mods: mods, value: value)

  {
    | opts_member? $event ~> =Str[m] => Str[m]
    | %parse.fail [pos, "a supported event name (click, submit, input, change, keydown)"]
  }
  ~> =('%str)member

  {
    | value ~> =AHole[sp] => Expr[
        Call[module: "html/live", member: "event_value", arg: Unquote(sp.offset, sp.length)],
      ]
    | %parse.fail [pos, "'\{ … }' (a binding's payload is a hole)"]
  }
  ~> =('%html.pattr_val)payload

  name = %str.concat ["data-q-", $event]
  bound = [name: name, pos: pos, mods: [], value: payload]
  mods ~> {
    | =[] => Cons[bound, Nil]
    | =(offset: o, length: l) => Cons[
        bound,
        Cons[
          [
            name: %str.concat [name, "-opts"],
            pos: pos,
            mods: [],
            value: Expr[
              Call[module: "html/live", member: member, arg: Unquote[offset: o, length: l]],
            ],
          ],
          Nil,
        ],
      ]
  }
}

// What one written attribute means here. Anything this layer doesn't claim passes through
// untouched — including its value, which %html normalizes as usual.
live_policy = #'%html.pattr {
  | event_name? $name ~> =Str[eb] => binding [$, Str[eb]]
  | $name ~> ="nav" => {
    | $mods ~> =[]; $value ~> =Flag => Cons[$[..., name: "data-q-nav"], Nil]
    | %parse.fail [$pos, "a bare 'nav' (it takes no value and no modifiers)"]
  }
  | $mods ~> =[] => Cons[$, Nil]
  | %parse.fail [
    $pos,
    "an attribute without a '[ … ]' modifier (only 'on:*' bindings take one)",
  ]
}

// Normalizes an `on:NAME={ … }` payload: the value in the `Ev` envelope, marked as the
// tree's typed data. The envelope is what the client echoes and `decode` reads back, so
// it discriminates a decoded event from a dropped one; the `Data` marker is the tree's
// and never reaches the wire.
event_value = #<'t>'t { Ev[$] ~> %html.data_value ~ }

// A live view's markup: an `%html` tree whose data attributes carry `'e` events. Spell a
// view's own type with these rather than `'%html<…>`, which would have to name the wire
// envelope the bindings ride in.
'<'e> = '%html<Ev['e]>
'nodes<'e> = '%html.nodes<Ev['e]>

live_dialect = #(content: '%str, term: '%meta.cb) {
  %html.parse [$content, $term] ~> =('%html.pnodes)nodes
  %html.rewrite_attrs [nodes, live_policy] ~> =('%html.pnodes)rewritten
  %html.expand rewritten
}

// === Binding options ====================================================================
// A binding's bracket is compiled as the argument of one of these functions, so its
// labels, defaults and types are the compiler's to check: `on:click["Enter"]` is a type
// error, and a misspelled option names no field. What they answer is the attribute text
// the client reads: `[debounce, throttle, keys]` as JSON, where 0 means "no limit" and an
// empty key list "any key". Adding an option later is one defaulted field here, one line
// in the client, and no change to any existing markup.

// A key filter: one key, or a list of them (`on:keydown[%list{ "Enter", "Escape" }]`). A
// bare string is one whole key, never split, so every key the browser can report —
// including `" "` — is expressible.
'keys = '%str | '%list<'%str>

key_list = #('keys | []) {
  | =[] => Nil
  | =Str[b] => Cons[Str[b], Nil]
  | $
}

// The keys as a JSON array body: each key stringified, so any key survives verbatim.
keys_text = #[(items): '%list<'%str>, (acc): '%str] {
  $items ~> {
    | =Nil => $acc
    | =Cons[k, rest] => {
      sep = { $acc ~> ="" => "" | "," }
      ^ [rest, %str.concat [$acc, sep] ~> %str.concat [~, %json.stringify k]]
    }
  }
}

ms_text = #('int | []) { =('int)n => %str.from_int n | "0" }

opts_text = #[(debounce): ('int | []), (throttle): ('int | []), (keys): ('keys | [])] {
  keys = key_list $keys ~> keys_text [~, ""]
  rates = %str.concat ["[", ms_text $debounce] ~> %str.concat [~, ","]
  head = %str.concat [rates, ms_text $throttle] ~> %str.concat [~, ",["]
  %str.concat [head, keys] ~> %str.concat [~, "]]"]
}

rate_opts = #[(debounce): ('int | []) = [], (throttle): ('int | []) = []] {
  :doc "The options an ordinary binding takes, as `on:click[…]`'s bracket: `debounce` (ms — fire once the events stop) and `throttle` (ms — fire the first of each window, drop the rest). Both are omittable and positional-first, so `on:input[300]` debounces by 300ms. Rate limiting is per binding and per element, and the server never sees it."
  opts_text [debounce: $debounce, throttle: $throttle, keys: []]
}

key_opts = #[
  (keys): ('keys | []) = [],
  (debounce): ('int | []) = [],
  (throttle): ('int | []) = [],
] {
  :doc "The options a key binding takes, as `on:keydown[…]`'s bracket: `keys` (one key, or a list — only these reach the server, matched against the browser's key name) plus `rate_opts`' `debounce` and `throttle`. Positional-first, so `on:keydown[\"Enter\"]` sends only Enter, and `on:keydown[%list\{ \"Enter\", \"Escape\" }]` those two."
  opts_text ($debounce, $throttle, $keys)
}

// === Session messages ===================================================================
// Declared up front: boundary frames carry a view-spawning thunk typed against them.

// What a view receives: a client event (already unpacked from the wire envelope by
// the app), a URL change (`Nav`, carrying the request the app synthesized for the new
// target — the root view re-derives via `nav`), park/wake control, and the reactive
// wakeups its renders subscribe it to. `Park` stops rendering (wakeups are absorbed —
// the app's buffer, not the view, is what keeps late frames correct); `Wake` drains and
// re-renders once against the held frame, so a warm attach diffs to silence.
'view_msg = Event['%str, 'event] | Nav['%http] | Park | Wake | '%sup.down | '%proc.changed

// What the app receives: the socket from a successful claim, encoded frame messages
// from its views, and route (dis)registrations as views spawn and kill children.
'app_msg =
  | Attach['%http/websocket]
  | Frame['%str]
  | Region['%str]
  | Route['%str, @'view_msg]
  | Unroute['%str]

// How a freshly mounted view announces itself: `Reply` sends the settled region
// HTML to the app as a `Region` (the GET path — the app composes the dead render
// from it and the children's first frames, then parks); `Replace` sends the app
// one root-replacing frame (the cold join path, and every placed view's first
// frame). Every boot settles first: after mount + render + reconcile, the view
// drains `Changed` on a quiet-window/deadline loop and re-renders, so the
// announcement never ships an unresolved state (a `Loading` a sampled fetcher is
// about to step past, say).
'vboot = Reply[@'app_msg] | Replace

// A boundary's closure-packed spawn: called with the view's assigned vid, the app
// to send frames to, and the boot mode — by the placing view's loop at boundary
// reconcile (`Replace`), or by the app itself for the root (never inside a tracked
// render); answers the spawned view. The heterogeneous component (its
// init/state/event types) hides inside the closure — every view handle is the same
// declared process type, and the app consumes the root through the same door. The
// handle grants await too, so the placer's watcher can observe a crash; it narrows
// to the send-only `@'view_msg` everywhere else.
'vstart = #['%str, @'app_msg, 'vboot] -> (@'view_msg ![])

// A placement argument: what a placeable component is called with.
'place<'i> = [init: 'i, key: '%str]

// The `:boundary` annotation a placeable component attaches (to an empty Fragment).
'bnd = [key: '%str, start: 'vstart]

'frame =
  | Leaf['%str]
  | ALeaf[elem: 'int, name: '%str, value: 'attr_val]
  | Opaque['%str]
  | Tmpl[statics: 'statics, slots: (Nil | Cons[^1, ^])]
  | Many[(Nil | Cons[[key: ('%str | []), row: ^1], ^])]
  | Boundary[key: '%str, vid: ('%str | []), start: 'vstart]

'frames = '%list<'frame>

// A Many's rows: each an optional identity (the item node's `:key` annotation — unused
// by the positional diff, carried for the keyed one) and the row's own frame.
'rows = '%list<[key: ('%str | []), row: 'frame]>

'path = '%list<'int>

'patch =
  | SetText[path: 'path, value: '%str]
  | SetAttr[path: 'path, elem: 'int, name: '%str, value: 'attr_val]
  | SetHtml[path: 'path, html: '%str]
  | InsRow[path: 'path, at: 'int, html: '%str]
  | DelRow[path: 'path, at: 'int]
  | MovRow[path: 'path, from: 'int, to: 'int]

'patches = '%list<'patch>

// Encode an attribute value for its frame slot: an event becomes its %data notation —
// the string the client echoes back — and literal values pass through.
enc_attr = #'%html.attr_val<_> {
  | =Str[b] => Str[b]
  | =Ok => Ok
  | =Data[payload] => %data.encode payload
  | []
}

// A node's frame; self-passed to recurse into template slots.
frame_of = #[(self): ^, (node): '%html<_>] -> 'frame {
  | $node:('bnd)boundary ~> =(key: k, start: st) => Boundary[key: k, vid: [], start: st]
  | $node:('%html.tmpl<_>)template ~> =(statics: s, holes: h) => {
    slots = %list.map [
      h,
      #{
        | =Child[n] => $$self [$$self, n]
        | =Attr[elem: e, name: nm, value: v] => ALeaf[elem: e, name: nm, value: enc_attr v]
      },
    ]
    Tmpl[statics: s, slots: slots]
  }
  | $node ~> =Text[str] => Leaf[str]
  | $node ~> =Fragment[items] => {
    // An un-annotated Fragment in a child slot is a node list: a Many of per-item
    // frames (chat items being their own templates diff granularly), each carrying
    // its optional `:key`.
    Many[
      %list.map [items, #{ k = $:('%str)key; [key: k, row: $$self [$$self, $]] }],
    ]
  }
  | Opaque[%html.render $node]
}

frame = #'%html<_> {
  :doc "Derives a node tree's frame — the diffable shape of one render — from the :template provenance %html expansions attach. Un-annotated subtrees become Opaque (compared and replaced whole); event attribute values are encoded to their %data notation, so frames are event-type-erased."
  frame_of [frame_of, $]
}

// Render a frame onto `acc`; self-passed to recurse into template slots.
render_of = #[(self): ^, (f): 'frame, (acc): 'bin] -> 'bin {
  $f ~> {
    | =Leaf[s] => { et = %html.escape_text s ~> .0; %bin.concat [$acc, et] }
    | =ALeaf[elem: _, name: Str[n], value: v] => v ~> {
      | =[] => $acc
      | =Ok => %bin.concat [%bin.append [$acc, 32, 1], n]
      | =Str[vb] => {
        ev = %html.escape_attr Str[vb] ~> .0

        %bin.concat [%bin.append [$acc, 32, 1], n]
        ~> %bin.concat [~, <3d22>]
        ~> %bin.concat [~, ev]
        ~> %bin.append [~, 34, 1]
      }
    }
    | =Opaque[Str[h]] => %bin.concat [$acc, h]
    | =Tmpl[statics: ss, slots: sl] => {
      weave = #[(statics): 'statics, (slots): 'frames, (a): 'bin] {
        $statics ~> {
          | =Cons[Str[st], srest] => {
            a2 = %bin.concat [$a, st]
            $slots ~> {
              | =Cons[fr, frest] => ^ [srest, frest, $$self [$$self, fr, a2]]
              | a2
            }
          }
          | $a
        }
      }
      weave [ss, sl, $acc]
    }
    | =Many[rows] => {
      // Each row is delimited by anonymous `<!--r-->`/`<!--/r-->` markers — the client
      // indexes rows positionally at apply time, so the markers carry no numbers and
      // never need renumbering.
      render_rows = #[(rows): 'rows, (a): 'bin] {
        $rows ~> {
          | =Nil => $a
          | =Cons[[key: _, row: r], t] => {
            a2 = %bin.concat [$a, "<!--r-->" ~> .0]
            a3 = $$self [$$self, r, a2]
            ^ [t, %bin.concat [a3, "<!--/r-->" ~> .0]]
          }
        }
      }
      render_rows [rows, $acc]
    }
    // A boundary renders as its empty vid markers — the child's own first frame
    // message fills the interior. An unresolved boundary (nil vid — a frame that
    // never went through reconcile, e.g. under the sim) renders nothing.
    | =Boundary[key: _, vid: v, start: _] => v ~> {
      | =Str[vb] => {
        %bin.concat [$acc, "<!--v:" ~> .0]
        ~> %bin.concat [~, vb]
        ~> %bin.concat [~, "--><!--/v:" ~> .0]
        ~> %bin.concat [~, vb]
        ~> %bin.concat [~, "-->" ~> .0]
      }
      | $acc
    }
    // Unreachable: the arms above cover every variant, but exhaustiveness can't see
    // through the inner recursive union.
    | $acc
  }
}

render = #'frame {
  :doc "Renders a frame to instrumented HTML — statics interleaved with slot values, child-hole markers and data-q anchors included — for the initial region render and SetHtml patch payloads."
  render_of [render_of, $, <>] ~> Str[~]
}

// An inserted row's payload: the row rendered inside its own markers.
render_row = #'frame { "<!--r-->" ~> %str.concat [~, render $] ~> %str.concat [~, "<!--/r-->"] }

// === Keyed rows =========================================================================
// When every row on BOTH sides carries a `:key`, the diff matches rows by identity
// instead of position: a middle removal is one DelRow, a middle insertion one InsRow,
// and a reorder a MovRow — the moved DOM nodes are reused, preserving their state.
// Keys are a server-side hint only; the wire ops stay positional and the markers
// anonymous. Any unkeyed row drops the whole list to the positional diff. Duplicate
// keys are safe but suboptimal (first match wins; content still converges).

// Whether every row carries a key.
keyed_rows? = #'rows { %list.all? [~, #{ =(key: Str[_]); $ }] }

key_in? = #[(rs): 'rows, (k): '%str] {
  // The pin below needs a variable, so bind the field locally.
  k = $k
  %list.any? [$rs, #{ =(key: rk); rk ~> =&k; $ }]
}

// The first list's elements (which arrive reversed) onto the front of the second.
cat_rows = #[(a): 'rows, (b): 'rows] { %list.chain [%list.reverse $a, $b] }

'taken = RHit[[key: ('%str | []), row: 'frame], 'int] | RMiss

// Remove the first row keyed `k`, answering it with its absolute index:
// [RHit[row, index] | RMiss, the remaining rows]. `j` is the first row's index.
take_row = #[(rs): 'rows, (k): '%str, (acc): 'rows, (j): 'int] -> ['taken, 'rows] {
  // The pin below needs a variable, so bind the field locally.
  k = $k
  $rs ~> {
    | =Nil => [RMiss, %list.reverse $acc]
    | =Cons[r, t] => {
      r ~> =(key: rk)
      {
        | rk ~> =&k => [RHit[r, $j], cat_rows [$acc, t]]
        | ^ [t, k, Cons[r, $acc], __integer_add__ [$j, 1]]
      }
    }
  }
}

// Phase A of the keyed diff: every old key absent from the new list is removed at its
// survivor-relative index (the count of kept rows before it — each applied removal
// shifts the rest down, so the indices are sequential-apply-correct). Answers
// [the survivors in order, the patch accumulator].
prune_rows = #[
  (old): 'rows,
  (new): 'rows,
  (index): 'int,
  (keep): 'rows,
  (acc): 'patches,
  (rpath): 'path,
] -> ['rows, 'patches] {
  $old ~> {
    | =Nil => [%list.reverse $keep, $acc]
    | =Cons[r, t] => {
      r ~> =(key: rk)
      {
        | rk ~> =Str[kb]; key_in? [$new, Str[kb]] => ^ [
            t,
            $new,
            __integer_add__ [$index, 1],
            Cons[r, $keep],
            $acc,
            $rpath,
          ]
        | ^ [
          t,
          $new,
          $index,
          $keep,
          Cons[DelRow[path: %list.reverse $rpath, at: $index], $acc],
          $rpath,
        ]
      }
    }
  }
}

// The patches turning `prev` into `next` at one slot, prepended (reversed) onto `acc`.
// `rpath` is the reversed path to the slot. Self-passed to recurse into template slots.
diff_of = #[
  (self): ^,
  (prev): 'frame,
  (next): 'frame,
  (rpath): 'path,
  (acc): 'patches,
] -> 'patches {
  // The nested literals close over `self` and `rpath` (an inner `$` would be their
  // own parameter), so bind the fields locally — `self` by reference, as a bare
  // `$self` term would call it.
  [$prev, $next] ~> {
    | =[Leaf[a], Leaf[b]] => {
      | a ~> =&b => $acc
      | Cons[SetText[path: %list.reverse $rpath, value: b], $acc]
    }
    | =[ALeaf[elem: e, name: n, value: a], ALeaf[elem: _, name: _, value: b]] => {
        | a ~> =&b => $acc
        | Cons[SetAttr[path: %list.reverse $rpath, elem: e, name: n, value: b], $acc]
      }
    | =[Opaque[a], Opaque[b]] => {
      | a ~> =&b => $acc
      | Cons[SetHtml[path: %list.reverse $rpath, html: b], $acc]
    }
    // Matching statics recurse slot-by-slot; mismatched statics fall through to the
    // final replacement arm. The statics test is a guard *step* (`;`): a chain never
    // short-circuits on a failed match, so a `~>`-joined guard would run
    // unconditionally, reading nil-filled bindings.
    | =[Tmpl[statics: s1, slots: sl1], Tmpl[statics: s2, slots: sl2]]
      s2 ~> =&s1 => {
        walk = #[(prev): 'frames, (next): 'frames, (i): 'int, (a): 'patches] {
          [$prev, $next] ~> {
            | =[Cons[p, pt], Cons[nx, nt]] => ^ [
                pt,
                nt,
                __integer_add__ [$i, 1],
                $$self [$$self, p, nx, Cons[$i, $$rpath], $a],
              ]
            | $a
          }
        }
        walk [sl1, sl2, 0, $acc]
      }
    | =[Many[pr], Many[nr]] => {
      // Positional row diff: pairwise recursion over the shared prefix, then the tail
      // is pure structure. Inserts advance the index (each lands after the previous);
      // deletions DON'T — removing row i shifts the rest down, so "delete the tail"
      // is `DelRow[at: i]` repeated. In-row patches use pre-structural indices, which
      // stay valid because all structural ops are at the tail.
      walk_rows = #[(prev): 'rows, (next): 'rows, (i): 'int, (a): 'patches] {
        [$prev, $next] ~> {
          | =[Cons[[key: _, row: p], pt], Cons[[key: _, row: nx], nt]] => ^ [
              pt,
              nt,
              __integer_add__ [$i, 1],
              $$self [$$self, p, nx, Cons[$i, $$rpath], $a],
            ]
          | =[Nil, Cons[[key: _, row: nx], nt]] => ^ [
              Nil,
              nt,
              __integer_add__ [$i, 1],
              Cons[InsRow[path: %list.reverse $$rpath, at: $i, html: render_row nx], $a],
            ]
          | =[Cons[_, pt], Nil] => ^ [
              pt,
              Nil,
              $i,
              Cons[DelRow[path: %list.reverse $$rpath, at: $i], $a],
            ]
          | $a
        }
      }
      // Phase B of the keyed diff: walk the new rows with the surviving old rows as
      // the working list (mirroring the client's DOM after phase A). In place →
      // recurse; found later → move it here (backward moves only, so `to` is stable
      // across the extraction) and recurse; absent → insert. Leftover working rows
      // (duplicate keys) are removed at the fixed index.
      keyed_walk = #[(working): 'rows, (new): 'rows, (i): 'int, (a): 'patches] {
        $new ~> {
          | =Nil => $working ~> {
            | =Nil => $a
            | =Cons[_, wt] => ^ [wt, Nil, $i, Cons[DelRow[path: %list.reverse $$rpath, at: $i], $a]]
          }
          | =Cons[nr, nt] => {
            nr ~> =(key: nk, row: nf)
            nkb = nk ~> { =Str[b] => Str[b] | "" }
            $working ~> {
              | =Cons[wr, wt] => {
                wr ~> =(key: wk, row: wf)
                {
                  | wk ~> =&nk => {
                    a2 = $$self [$$self, wf, nf, Cons[$i, $$rpath], $a]
                    ^ [wt, nt, __integer_add__ [$i, 1], a2]
                  }
                  | {
                    tw = take_row [wt, nkb, Nil, __integer_add__ [$i, 1]]
                    wrest = tw.1
                    tw.0 ~> {
                      | =RHit[mr, j] => {
                        mr ~> =(row: mf)
                        a2 = Cons[MovRow[path: %list.reverse $$rpath, from: j, to: $i], $a]
                        a3 = $$self [$$self, mf, nf, Cons[$i, $$rpath], a2]
                        ^ [Cons[wr, wrest], nt, __integer_add__ [$i, 1], a3]
                      }
                      | {
                        a2 = Cons[
                          InsRow[path: %list.reverse $$rpath, at: $i, html: render_row nf],
                          $a,
                        ]
                        ^ [Cons[wr, wt], nt, __integer_add__ [$i, 1], a2]
                      }
                    }
                  }
                }
              }
              | =Nil => {
                a2 = Cons[InsRow[path: %list.reverse $$rpath, at: $i, html: render_row nf], $a]
                ^ [Nil, nt, __integer_add__ [$i, 1], a2]
              }
            }
          }
        }
      }
      {
        | keyed_rows? pr; keyed_rows? nr => {
          // Field access rather than destructuring: a tuple-shape pattern types
          // fallibly, and diff_of's self-type requires a nil-free 'patches result.
          pruned = prune_rows [pr, nr, 0, Nil, $acc, $rpath]
          keyed_walk [pruned.0, nr, 0, pruned.1]
        }
        | walk_rows [pr, nr, 0, $acc]
      }
    }
    // Boundaries compare by key and the differ NEVER descends: the interior is the
    // child view's own. A changed key falls through to the replacement arm — the
    // parent re-renders fresh (empty) markers and the new child's first frame fills
    // them.
    | =[Boundary(key: k1), Boundary(key: k2)]; k2 ~> =&k1 => $acc
    // A differing kind, a switched template (statics mismatch), or an Opaque next to
    // anything else: one replacement patch, subsuming the slot's descendants.
    | Cons[SetHtml[path: %list.reverse $rpath, html: render $next], $acc]
  }
}

diff = #[(prev): 'frame, (next): 'frame] {
  :doc "The patch list turning the first frame into the second, in document order: recursing where statics match, and emitting one subsuming patch where a slot's kind, template, or opaque content changed. Equal frames answer Nil. A Nil path addresses the root."
  diff_of [diff_of, $prev, $next, Nil, Nil] ~> %list.reverse ~
}

// === The wire ===========================================================================
// A frame message is JSON text: `[1, vid, [patch, …]]` — a protocol version, the view
// id the patches belong to (the root view is vid 0; ids are app-assigned), and the
// patches of one render, applied as one batch. Patches: `["t", path, text]` (replace a
// child slot's contents with text), `["h", path, html]` (replace with parsed markup),
// `["a", path, elem, name, value]` (set/remove an attribute; the client resolves the
// *parent* of an attr slot's path — attr holes have no markers of their own — then finds
// the `data-q` anchor), `["r+", path, i, html]` (insert a row at index i of the Many at
// `path`), and `["r-", path, i]` (remove row i). `value` is a string, `true` (bare), or
// `null` (removed). Path segments are plain indices: the client tells row steps from
// slot steps by which markers it finds in the range (`r` vs `q:`) — the two never mix
// at one level. Upstream, a client event is the envelope `[vid, payload, metadata]` —
// the vid of the nearest enclosing view boundary (0 until boundaries land), the event
// payload, and the browser metadata for the event that fired (a tagged array, one shape
// per event name; see `'event`).

'jsons = '%list<'%json>

enc_path = #'path { Array[~] }

enc_attr_val = #'attr_val {
  | =Str[b] => Str[b]
  | =Ok => True
  | =[] => Null
}

enc_patch = #'patch {
  | =SetText[path: p, value: v] => Array[Cons["t", Cons[enc_path p, Cons[v, Nil]]]]
  | =SetHtml[path: p, html: h] => Array[Cons["h", Cons[enc_path p, Cons[h, Nil]]]]
  | =SetAttr[path: p, elem: e, name: n, value: v] => Array[
      Cons["a", Cons[enc_path p, Cons[e, Cons[n, Cons[enc_attr_val v, Nil]]]]],
    ]
  | =InsRow[path: p, at: i, html: h] => Array[Cons["r+", Cons[enc_path p, Cons[i, Cons[h, Nil]]]]]
  | =DelRow[path: p, at: i] => Array[Cons["r-", Cons[enc_path p, Cons[i, Nil]]]]
  | =MovRow[path: p, from: f, to: t] => Array[Cons["r>", Cons[enc_path p, Cons[f, Cons[t, Nil]]]]]
}

enc_patches = #'patches { %list.map [~, enc_patch] }

encode = #[(vid): '%str, (ps): 'patches] {
  :doc "A frame message: one view's patches for one render as JSON text, `[1, vid, [patch, …]]`. Vids are hierarchical strings — the root view is \"0\", its children \"0.1\", \"0.2\", … — minted locally by each view, so no allocation is coordinated."
  Array[Cons[1, Cons[$vid, Cons[Array[enc_patches $ps], Nil]]]]
  ~> %json.stringify ~
}

// === The session ========================================================================
// A live session is an **app** process and (until boundaries land, exactly one)
// **view** process. The app owns the connection-facing half: the socket, the parking
// token, the buffer of frames that arrive while parked, and the wire — it forwards
// `[vid, payload, event]` envelopes to the view and the view's frame messages to the
// socket, and it renders and decodes nothing. The view owns the component half:
// mount/decode/update/view run in it, its tracked renders subscribe it to the stores
// the view samples, and its spawns (fetchers) are its owned children. Events land on
// `update` and nowhere else; stores are reached by ordinary sends inside it, and
// propagation back out rides the dependency graph (an empty diff sends nothing).

// A view definition. `'i` is the mount init: the root view mounts from the HTTP
// request; a child view mounts from whatever its parent's `child [comp, init, key]`
// passes. `'e` is the event union — the `on:*` payloads the view's markup carries, which
// the client echoes back and `update` folds. `decode` turns that echo back into a typed
// event: the payload arrives as %data notation in the `Ev` envelope, exactly as `on:*`
// holes encode it, so the field is the instantiated codec itself,
// `decode: %data.decode<Ev['ev]>`. Every member of `'e` must be a tuple — it is what
// the browser metadata is stamped onto, and named payloads (`Inc`, `Del[id]`) are the
// natural spelling anyway. It stays a field (rather than moving inside) because
// `%data.decode` is type-consuming — it needs the concrete event type, which only the
// component's own site knows — and it is the session's trust boundary: the payload is
// client-supplied text, and nothing that fails to decode ever reaches `update`. `nav`
// re-derives state from a new URL without remounting — the root view's live-navigation
// hook, receiving the raw request the app synthesized for the target; a component that
// doesn't navigate omits it (the `_base` record) and gets an identity `nav`.
'component<'i, 's, 'e> = [
  mount: #'i -> 's,
  update: #[(state): 's, (event): 'e] -> 's,
  view: #'s -> '<'e>,
  decode: #'%str -> (Ev['e] | []),
  nav: #[(state): 's, (request): '%http] -> 's,
]
'component_base<'i, 's, 'e> = [
  mount: #'i -> 's,
  update: #[(state): 's, (event): 'e] -> 's,
  view: #'s -> '<'e>,
  decode: #'%str -> (Ev['e] | []),
]

// Fill in a default (identity) `nav` when the record omits it, so most components —
// which never navigate — stay four fields. Both the `component` constructor and the
// `sim` harness normalize through this, so a `_base` record is accepted everywhere a
// full one is.
with_nav = #<'i, 's, 'e>('component_base<'i, 's, 'e> | 'component<'i, 's, 'e>) {
  c = $
  {
    | c ~> =(mount: m, update: u, view: v, decode: d, nav: n) => [
        mount: m,
        update: u,
        view: v,
        decode: d,
        nav: n,
      ]
    | {
      c ~> =(mount: m, update: u, view: v, decode: d)
      [
        mount: m,
        update: u,
        view: v,
        decode: d,
        nav: #<'s>[(state): 's, (request): '%http] { $state },
      ]
    }
  }
}

// Render inside a tracked region: the process re-subscribes to exactly the stores the
// view sampled, and their next state change delivers a `Changed` wakeup.
render_view = #<'i, 's, 'e>[(state): 's, (comp): 'component<'i, 's, 'e>] {
  %proc.track #{ $$state ~> $$comp.view ~ } ~> frame ~
}

// Re-root a value bound out of a '%json recursive position at the union's root: the
// matcher cannot unfold a pattern against the inner recursive reference, but a
// declared-parameter boundary restores the full type. (An identity function.)
jval = #'%json

// A form field from its wire pair `[name, value]`; nil (skipped) for anything else.
pair_of = #'%json { =Array[Cons[Str[n], Cons[Str[v], Nil]]]; [Str[n], Str[v]] }

pairs_of = #'jsons {
  %list.fold [
    ~,
    Nil,
    #{
      | pair_of $1 ~> =[n, v] => Cons[[n, v], $0]
      | $0
    },
  ]
  ~> %list.reverse ~
}

// A JSON boolean as Quiver's truthiness convention; anything else reads false.
flag_of = #'%json { =True => Ok | [] }

// A modifier-key quartet from its wire form, `[alt, ctrl, shift, meta]`; a malformed
// one reads as no modifiers held rather than failing the whole event.
mods_of = #'%json {
  | =Array[Cons[a, Cons[c, Cons[s, Cons[m, Nil]]]]] => [
      alt?: a ~> jval ~ ~> flag_of ~,
      ctrl?: c ~> jval ~ ~> flag_of ~,
      shift?: s ~> jval ~ ~> flag_of ~,
      meta?: m ~> jval ~ ~> flag_of ~,
    ]
  | [alt?: [], ctrl?: [], shift?: [], meta?: []]
}

// Each metadata shape, from the arguments following its tag. Nil for a malformed one,
// which drops the whole event.
// The mouse events all report the same thing, so they share a reader and differ only in
// their tag.
pointer_of = #'jsons {
  =Cons[xj, Cons[yj, Cons[bj, Cons[mj, Nil]]]]
  xj ~> jval ~ ~> =('int)x
  yj ~> jval ~ ~> =('int)y
  bj ~> jval ~ ~> =('int)b
  [x: x, y: y, button: b, mods: mj ~> jval ~ ~> mods_of ~]
}

submit_of = #'jsons { =Cons[fj, Nil]; fj ~> jval ~ ~> =Array[fs]; Submit[fields: pairs_of fs] }

// `input` and `change` report the same thing — the control's value and, for a checkbox or
// radio, whether it is ticked — so they share a reader and differ only in their tag.
field_of = #'jsons {
  =Cons[vj, Cons[cj, Nil]]
  vj ~> jval ~ ~> =Str[vb]
  [value: Str[vb], checked?: cj ~> jval ~ ~> flag_of ~]
}

keydown_of = #'jsons {
  =Cons[kj, Cons[mj, Nil]]
  kj ~> jval ~ ~> =Str[kb]
  KeyDown[key: Str[kb], mods: mj ~> jval ~ ~> mods_of ~]
}

// The browser metadata beside a payload, from its wire form — a tagged JSON array, one
// shape per event name: `["click" | "mousedown" | "mouseup" | "mousemove", x, y, button,
// [alt, ctrl, shift, meta]]`, `["submit", [[name, value], …]]`, `["input", value,
// checked]`, `["change", value, checked]`, `["keydown", key, [alt, ctrl, shift, meta]]`.
// Answers nil for anything else, or for a malformed shape (each reader's nil ends its arm,
// rather than spreading into a bare tag), which drops the whole envelope: metadata the
// server cannot read is an event it cannot faithfully fold.
event_of = #'%json {
  =Array[Cons[tagj, rest]]
  tagj ~> jval ~ ~> =Str[tb]
  Str[tb] ~> {
    | ="click" => { pointer_of rest ~> =('pointer)m; Click[...m] }
    | ="mousedown" => { pointer_of rest ~> =('pointer)m; MouseDown[...m] }
    | ="mouseup" => { pointer_of rest ~> =('pointer)m; MouseUp[...m] }
    | ="mousemove" => { pointer_of rest ~> =('pointer)m; MouseMove[...m] }
    | ="submit" => submit_of rest
    | ="input" => { field_of rest ~> =('field)m; Input[...m] }
    | ="change" => { field_of rest ~> =('field)m; Change[...m] }
    | ="keydown" => keydown_of rest
  }
}

// A wire event is the envelope `[vid, payload, metadata]` — the target view's id, the
// payload (a JSON *string* carrying the echoed attribute's %data notation), and the
// browser metadata for the event that fired. Answers `[vid, payload, event]`, or nil
// for anything malformed.
env_of = #'%str {
  %json.parse $ ~> =('%json)env
  env ~> =Array[es]
  es ~> =Cons[vidj, r1]
  vidj ~> jval ~ ~> =Str[vb]
  r1 ~> =Cons[payloadj, r2]
  payloadj ~> jval ~ ~> =Str[pb]
  r2 ~> =Cons[evj, Nil]
  evj ~> jval ~ ~> event_of ~ ~> =('event)ev
  [Str[vb], Str[pb], ev]
}

// A live-navigation message is `["nav", "/path?query"]` — the two-element shape the
// client sends for a live link or a back/forward step. Answers the target string, or
// nil for anything else (a three-element event envelope naturally fails to match).
nav_of = #'%str {
  %json.parse $ ~> =('%json)env
  env ~> =Array[es]
  es ~> =Cons[tagj, r1]
  tagj ~> jval ~ ~> ="nav"
  r1 ~> =Cons[targetj, Nil]
  targetj ~> jval ~ ~> =Str[tb]
  Str[tb]
}

// Decode and fold one client event through `update`: a decode answering nil drops
// the event (stale or forged — `update` never sees it) and answers the state
// unchanged. The browser metadata joins the decoded event here, as the `:event`
// annotation — the last point where both halves are in hand, and the only one that
// works for every component, since the event's type is a variable to this code.
fold_event = #<'i, 's, 'e>[
  (state): 's,
  (comp): 'component<'i, 's, 'e>,
  (payload): '%str,
  (event): 'event,
] {
  | $comp.decode $payload ~> =Ev[ev] => $comp.update [state: $state, event: ev ~> { :event $event }]
  | $state
}

// Server-initiated navigation: `update` marks the state it returns, and the view emits
// the URL-sync frame below. The mark is invisible to the data plane — the state's value,
// matching, and equality are all unchanged — so `redirect` is an identity function that
// happens to leave a note for the loop.
redirect = #<'s>[(state): 's, (to): '%str] {
  :doc "Marks the state an `update` is returning to ask the client to move its address bar to `to` — server-initiated navigation, patched and synced with no page reload. Set the page for that URL in the same `update`, so view and address bar move together. The mark rides the state's value invisibly (it survives being returned through `update`'s declared type, and matching and equality ignore it), and is emitted once per change: re-asserting the same path after an unmarked state redirects again, but an update that merely answers a still-marked state unchanged does not."
  $state ~> { :redirect $to }
}

// The wire frame for a URL sync: `[2, "/path"]` (the client `pushState`s to it).
url_sync = #'%str { "[2," ~> %str.concat [~, %json.stringify $] ~> %str.concat [~, "]"] }

// Emit the URL-sync frame for a step's `redirect` mark, deduplicated: annotations ride
// the value, so a later update that answers the state unchanged still carries the old
// mark — and a kept mark is indistinguishable from a re-asserted one. The tracker
// (`synced`, the path last emitted) resolves it: only a mark that CHANGED since the
// last sync emits, and an absent mark resets the tracker so a later redirect to the
// same path fires again. Answers the new tracker.
sync_redirect = #<'s>[(state): 's, (synced): ('%str | []), (app): @'app_msg] {
  // The pin below needs a variable, and the pid is taken by reference (a bare
  // access would send), so bind the fields locally.
  synced = $synced
  app = $app
  m = $state:('%str)redirect
  {
    | m ~> =&synced => synced
    | m ~> =Str[p] => { %proc.send [app, Frame[url_sync Str[p]]]; Str[p] }
    | []
  }
}

// Absorb any further queued wakeups before re-rendering, so a burst of store steps
// costs one render.
drain_changed = #[] { ![#'%proc.changed, 0] ~> { ='%proc.changed => ^ [] | Ok } }

// === Views ==============================================================================

'vmode = Live | Idle

// === Boundary reconcile =================================================================
// After each render, the view matches its frame's boundary keys against its live
// children: a kept key keeps its vid and child untouched; a new key mints the next
// hierarchical vid and spawns; a dropped key kills its child and announces
// `Unroute`. Spawns and kills execute strictly AFTER the view's own frame message is
// sent, so a child's first frame can never precede the boundary markers it fills.
//
// Each placed view runs under its own `%sup` supervisor (spawned by and owned by
// the placing view; the child is spawned inside the supervisor's process, so the
// ownership cascade is view → supervisor → child). The spec's start closure does
// spawn + watch + `Route`-announce, so a crash within the intensity budget restarts
// IN PLACE — same vid, re-routed, the fresh instance's first frame replacing the
// boundary interior — without the placing view hearing about it at all. Past the
// budget the supervisor gives up (its panic is `%sup`'s escalation), which the view
// observes through its own watcher on the supervisor: it renders the crash fallback
// into the boundary and keeps the kids entry pointing at the corpse, so reconcile
// won't quietly respawn a repeat offender (drop and re-add the key to reset).

// `pid` is the child's SUPERVISOR — never sent to (events route to the child
// itself via the app), only killed on drop — so it stays an inert handle.
'kid = [key: '%str, vid: '%str, pid: @]
'kids = '%list<'kid>
'bounds = '%list<[key: '%str, start: 'vstart]>
'assign = AOld[key: '%str, vid: '%str, pid: @] | ANew[key: '%str, vid: '%str, start: 'vstart]
'assigns = '%list<'assign>

// The per-child intensity budget: this many restarts within the window, then the
// supervisor gives up and the boundary falls back. A slow trickle of crashes never
// exhausts it; a crash loop does.
restart_budget = 3
restart_window = 30000

crash_html = "<em>view crashed</em>"

// Settle-wait: before announcing, a booting view drains `Changed` in quiet-window
// steps (re-rendering after each burst) so sampled stores that are about to step —
// a fetcher's `Loading` — resolve into the announced HTML; the deadline bounds a
// store that never settles. Applied on every boot (constants for now; an app-level
// knob when the config next grows).
settle_quiet = 100
settle_deadline = 3000

// The boundaries of a frame; self-passed to recurse into slots and rows.
collect_of = #[(self): ^, (f): 'frame, (acc): 'bounds] -> 'bounds {
  // The nested literals close over `self` (an inner `$` would be their own parameter),
  // so bind the field locally — by reference, as a bare `$self` term would call it.
  self = $self
  $f ~> {
    | =Boundary[key: k, vid: _, start: st] => Cons[[key: k, start: st], $acc]
    | =Tmpl[statics: _, slots: sl] => %list.fold [sl, $acc, #{ self [self, $1, $0] }]
    | =Many[rows] => %list.fold [rows, $acc, #{ $1 ~> =(row: r); self [self, r, $0] }]
    | $acc
  }
}

// Whether a key is already assigned (duplicate keys: first wins; the duplicate
// boundary shares the vid, which the client resolves to the first marker).
key_assigned? = #[(items): 'assigns, (k): '%str] {
  // The pin below needs a variable, so bind the field locally.
  k = $k
  %list.any? [$items, #{ =(key: ak); ak ~> =&k; $ }]
}

'kid_hit = KFound['kid] | KMissing

// A kid by key (reconcile) or by vid (crash reports).
kid_of = #[(items): 'kids, (k): '%str] -> 'kid_hit {
  // The pin below needs a variable, so bind the field locally.
  k = $k
  {
    | %list.find [$items, #{ =(key: kk); kk ~> =&k; $ }] ~> =('kid)kd => KFound[kd]
    | KMissing
  }
}

kid_by_vid = #[(items): 'kids, (v): '%str] -> 'kid_hit {
  // The pin below needs a variable, so bind the field locally.
  v = $v
  {
    | %list.find [$items, #{ =(vid: kv); kv ~> =&v; $ }] ~> =('kid)kd => KFound[kd]
    | KMissing
  }
}

// Assign a vid to every distinct boundary key. Answers [assigns, next-ordinal].
assign_bounds = #[(bs): 'bounds, (kids): 'kids, (vid): '%str, (n): 'int, (acc): 'assigns] -> [
  'assigns,
  'int,
] {
  $bs ~> {
    | =Nil => [$acc, $n]
    | =Cons[b, t] => {
      b ~> =(key: k, start: st)
      {
        | key_assigned? [$acc, k] => ^ [t, $kids, $vid, $n, $acc]
        | kid_of [$kids, k] ~> =KFound[kd] => {
          kd ~> =(vid: v, pid: p); ^ [t, $kids, $vid, $n, Cons[AOld[key: k, vid: v, pid: p], $acc]]
        }
        | {
          v = %str.concat [$vid, %str.concat [".", %str.from_int $n]]
          ^ [t, $kids, $vid, __integer_add__ [$n, 1], Cons[ANew[key: k, vid: v, start: st], $acc]]
        }
      }
    }
  }
}

// The assigned vid for a key. Every boundary key was assigned from this same frame, so a miss
// is a broken invariant.
assigned_vid = #[(items): 'assigns, (k): '%str] {
  // The pin below needs a variable, so bind the field locally.
  k = $k
  %list.find [$items, #{ =(key: ak); ak ~> =&k; $ }] ~> {
    | =(vid: av) => Str[av ~> .0]
    | __panic__ "boundary key missing from its assignment"
  }
}

// Rebuild a frame with its boundary vids assigned; other nodes pass through.
resolve_of = #[(self): ^, (f): 'frame, (assigns): 'assigns] -> 'frame {
  // The nested literals close over `self` and `assigns` (an inner `$` would be their
  // own parameter), so bind the fields locally — `self` by reference, as a bare
  // `$self` term would call it.
  self = $self
  assigns = $assigns
  $f ~> {
    | =Boundary[key: k, vid: _, start: st] => Boundary[
        key: k,
        vid: assigned_vid [assigns, k],
        start: st,
      ]
    | =Tmpl[statics: ss, slots: sl] => Tmpl[
        statics: ss,
        slots: %list.map [sl, #{ self [self, $, assigns] }],
      ]
    | =Many[rows] => Many[
        %list.map [rows, #{ =(key: rk, row: r); [key: rk, row: self [self, r, assigns]] }],
      ]
    | $f
  }
}

// The previous kids whose keys the new render dropped.
dropped_kids = #[(kids): 'kids, (assigns): 'assigns] {
  assigns = $assigns
  %list.filter [$kids, #{ =(key: k); { key_assigned? [assigns, k] => [] | $ } }]
}

// Execute a reconcile: kill dropped children's supervisors (ownership tears down
// supervisor and child alike; the entry is removed BEFORE the kill, so the
// watcher's report finds no kid and is ignored) and start new ones — each under
// its own `%sup` supervisor whose start closure does spawn + watch + `Route`, so
// restarts within the intensity budget re-route and refill the boundary without
// this view's involvement. The view watches the SUPERVISOR: its death is the
// budget giving up (or a bug), and the only crash signal the view handles.
// Answers the new kids list (each pid the child's supervisor).
exec_bounds = #[
  (assigns): 'assigns,
  (drops): 'kids,
  (app): @'app_msg,
  (me): @'view_msg,
  (acc): 'kids,
] -> 'kids {
  // The start closure closes over `app`, and the pids are taken by reference (a
  // bare access would send), so bind them locally.
  app = $app
  me = $me
  $drops ~> {
    | =Cons[kd, t] => {
      kd ~> =(vid: v, pid: p)
      %proc.kill p
      %proc.send [app, Unroute[Str[v ~> .0]]]
      ^ [$assigns, t, app, me, $acc]
    }
    | $assigns ~> {
      | =Nil => $acc
      | =Cons[AOld[key: k, vid: v, pid: p], t] => ^ [
          t,
          Nil,
          app,
          me,
          Cons[[key: k, vid: v, pid: p], $acc],
        ]
      | =Cons[ANew[key: k, vid: v, start: st], t] => {
        cs = #['%str, @'%sup.down] {
          =[id, supref]
          p = st [v, app, Replace]
          %sup.watch [id, p, supref]
          %proc.send [app, Route[Str[v ~> .0], p]]
          p
        }

        csup =
          [
            children: Cons[[id: Str[v ~> .0], restart: Permanent, start: cs], Nil],
            max_restarts: restart_budget,
            window: restart_window,
          ]
          ~> %sup.start ~

        %sup.watch [Str[v ~> .0], csup, me]
        ^ [t, Nil, app, me, Cons[[key: k, vid: v, pid: csup], $acc]]
      }
    }
  }
}

// Re-root a rebuilt frame at the union's root: `resolve_of` reconstructs Tmpl/Many
// nodes, so its result infers as the frame union unrolled one level; a declared
// parameter restores the rolled type. (An identity function.)
as_frame = #'frame

// One render step of a view: render, assign boundary vids, diff against the frame
// the client holds, send the delta (an empty diff sends nothing), then execute the
// reconcile. Answers [the new frame, the new kids, the next child ordinal].
step_view = #<'i, 's, 'e>[
  (state): 's,
  (prev): 'frame,
  (comp): 'component<'i, 's, 'e>,
  (vid): '%str,
  (app): @'app_msg,
  (me): @'view_msg,
  (kids): 'kids,
  (n): 'int,
] {
  // The loop closes over these, so bind them locally.
  app = $app
  me = $me
  f2 = render_view [$state, $comp]
  ar = assign_bounds [collect_of [collect_of, f2, Nil], $kids, $vid, $n, Nil]
  rf = resolve_of [resolve_of, f2, ar.0] ~> as_frame ~
  diff [$prev, rf] ~> {
    | =Nil => Ok
    | =ps => { %proc.send [app, Frame[encode [$vid, ps]]]; Ok }
  }
  kids2 = exec_bounds [ar.0, dropped_kids [$kids, ar.0], app, me, Nil]
  [rf, kids2, ar.1]
}

// The view's whole life: fold events, re-render on wakeups (unless parked), send
// deltas up, reconcile children, and supervise them. `f` is the frame the client's
// DOM shows; `kids` the live children; `n` the next child ordinal (monotonic —
// vids never reused); `synced` the redirect path last synced to the address bar.
// Restarts within the budget happen inside each child's `%sup` supervisor,
// invisibly; a supervisor's death IS the budget exhausting — the
// boundary renders the crash fallback, and the kids entry stays pointing at the
// corpse so reconcile won't quietly respawn a repeat offender. (A deliberate
// kill's Down finds no tracked vid — the entry is removed before the kill — and
// is dropped.)
vlife = #<'i, 's, 'e>[
  (mode): 'vmode,
  (state): 's,
  (f): 'frame,
  (comp): 'component<'i, 's, 'e>,
  (vid): '%str,
  (app): @'app_msg,
  (kids): 'kids,
  (n): 'int,
  (synced): ('%str | []),
] {
  // The spawned view closes over these, so bind them locally.
  app = $app
  me = @
  !'view_msg ~> {
    | =Event[payload, ev] => {
      s2 = fold_event [$state, $comp, payload, ev]
      // A `redirect` mark on the update result moves the client's address bar to match
      // the page this same update set — server-initiated navigation.
      sy2 = sync_redirect [s2, $synced, app]
      r = step_view [s2, $f, $comp, $vid, app, me, $kids, $n]
      ^ [$mode, s2, r.0, $comp, $vid, app, r.1, r.2, sy2]
    }
    // A URL change: re-derive state from the new request (no remount — local state
    // survives), then re-render and patch like any other step. A `nav` may itself mark
    // its result with `:redirect` (URL canonicalization) — synced like an update's.
    | =Nav[req] => {
      s2 = $comp.nav [state: $state, request: req]
      sy2 = sync_redirect [s2, $synced, app]
      r = step_view [s2, $f, $comp, $vid, app, me, $kids, $n]
      ^ [$mode, s2, r.0, $comp, $vid, app, r.1, r.2, sy2]
    }
    | =Park => ^ [Idle, $state, $f, $comp, $vid, app, $kids, $n, $synced]
    | =Wake => {
      drain_changed []
      r = step_view [$state, $f, $comp, $vid, app, me, $kids, $n]
      ^ [Live, $state, r.0, $comp, $vid, app, r.1, r.2, $synced]
    }
    | =Down(id: dv) => kid_by_vid [$kids, dv] ~> {
      | =KFound[_] => {
        %proc.send [app, Frame[encode [dv, Cons[SetHtml[path: Nil, html: crash_html], Nil]]]]
        %proc.send [app, Unroute[dv]]
        ^ [$mode, $state, $f, $comp, $vid, app, $kids, $n, $synced]
      }
      | ^ [$mode, $state, $f, $comp, $vid, app, $kids, $n, $synced]
    }
    | ='%proc.changed => $mode ~> {
      | =Live => {
        drain_changed []
        r = step_view [$state, $f, $comp, $vid, app, me, $kids, $n]
        ^ [Live, $state, r.0, $comp, $vid, app, r.1, r.2, $synced]
      }
      | ^ [Idle, $state, $f, $comp, $vid, app, $kids, $n, $synced]
    }
  }
}

// Settle: drain `Changed` in quiet-window steps, re-rendering after each burst,
// until a window passes silently (or the deadline lapses). Answers the settled
// frame. `left` is the remaining deadline budget.
settle = #<'i, 's, 'e>[(state): 's, (f): 'frame, (comp): 'component<'i, 's, 'e>, (left): 'int] {
  {
    | %num.lt? [0, $left] => ![#'%proc.changed, settle_quiet] ~> {
      | ='%proc.changed => {
        drain_changed []
        ^ [$state, render_view [$state, $comp], $comp, %num.sub [$left, settle_quiet]]
      }
      | $f
    }
    | $f
  }
}

// A view: mount (once — its spawns become this process's owned children), render
// frame 0, settle, reconcile its boundaries, announce per the boot mode, and loop.
// `'i` is the mount init — the request for the root view, the parent-supplied init
// for a child. Children spawn strictly after the announcement, so their first
// frames arrive behind the markup that holds their markers (or, at a dead render,
// splice into it at the app).
view_run = #<'i, 's, 'e>['i, 'component<'i, 's, 'e>, '%str, @'app_msg, 'vboot] {
  =[init, comp, vid, app, boot]
  // `.` before any receiving call: taken later, its inferred send would be the
  // partially-widened receive (just the settle drain's `Changed`), which no longer
  // narrows into `@'view_msg` params. Taken here it is still the unknown-send
  // handle, which does.
  me = @
  state = comp.mount init
  f = settle [state, render_view [state, comp], comp, settle_deadline]
  ar = assign_bounds [collect_of [collect_of, f, Nil], Nil, vid, 1, Nil]
  rf = resolve_of [resolve_of, f, ar.0] ~> as_frame ~
  boot ~> {
    | =Reply[reply] => { %proc.send [reply, Region[render rf]]; Ok }
    | =Replace => {
      %proc.send [app, Frame[encode [vid, Cons[SetHtml[path: Nil, html: render rf], Nil]]]]
      Ok
    }
  }
  kids = exec_bounds [ar.0, Nil, app, me, Nil]
  mode = boot ~> { =Reply[_] => Idle | Live }
  // The sync tracker starts at the mount state's own mark, if any: the page was served
  // for the URL that produced this state, so only a mark that changes needs syncing.
  vlife [mode, state, rf, comp, vid, app, kids, ar.1, state:('%str)redirect]
}

// Define a component from its record: answers the **placeable component** — a
// function called `[init: …, key: …]` in markup to place the view as a boundary
// node the differ never descends into. The placed view mounts from `init` in its
// own process — spawned by the placing view's loop at reconcile, owned by it,
// decoding its own events — and patches its own interior under its own vid. `key`
// is the boundary's identity across renders: a stable key keeps the view (and all
// its state); a dropped key kills it. The app's root is the same shape — the app
// runs it against the HTTP request instead of placing it. (The inner literal
// re-declares `<'i>`: a nested signature reaches the enclosing type parameters by
// re-declaration — suffix inheritance makes it the same variable.)
component = #<'e, 'i, 's>('component_base<'i, 's, 'e> | 'component<'i, 's, 'e>) {
  :doc "Defines a component from its `[mount, update, view, decode]` record — `decode` reads the `on:*` payload the client echoes back, %data notation in the `Ev` envelope, so the field is the instantiated codec itself, `decode: %data.decode<Ev['ev]>` (add a `nav: #[(state): 's, (request): '%http] -> 's` field to re-derive state on live navigation — root only: URL changes are only ever sent to the root view): answers the placeable component, a function called `[init: …, key: …]` in markup. Pin the event type — `component<'ev> [...]` — to compile-check the view's `on:*` payloads against it (unpinned, a stray payload widens the inferred union and is only dropped at decode). What the browser knows and the payload cannot carry — a click's coordinates, a submit's fields, an input's value — rides the event as the `:event` annotation, read in `update` with a checked retrieval (`e:(Submit(fields: '%http.pairs))event`). The placed view mounts from `init` in its own process, spawned and owned by the placing view; its events decode with its OWN decode, and it patches its own interior. A stable `key` keeps the view across renders; a dropped key kills it (and its owned processes). The app's root is the same shape."
  comp = with_nav $
  #<'i>'place<'i> {
    i = $init
    k = $key
    st = #['%str, @'app_msg, 'vboot] { =[v, a, boot]; [i, comp, v, a, boot] ~> @view_run ~ }
    Fragment[Nil] ~> { :boundary [key: k, start: st] }
  }
}

// === Parking ============================================================================
// An **app** — the server side of one page load — is a detached process that
// alternates between *attached* (holds the socket) and *parked* (no socket, awaiting
// a claim by token, on a timeout). The dead render and the upgrade remain two
// separate requests; what crosses between them is the socket, sent to the app as an
// ordinary resource transfer. A TCP drop re-registers the token and parks — a
// reconnecting client re-attaches with all state intact — while a clean client Close
// (navigation, tab close) terminates the app. An app nobody claims dies with its
// park timeout, and containment reaps its view (and the view's fetchers). While
// parked, frames from the view are buffered in arrival order and flushed on attach —
// each diffs against the frame the client still holds, so late delivery stays
// correct; the view is also told to `Park` (stop rendering) as an economy, and its
// `Wake` re-render usually diffs to silence — no join flash.

'app_pid = @'app_msg
'claim = Found['app_pid] | Missing
'reg_entry = [token: '%str, pid: 'app_pid, at: 'int]
'reg_entries = '%list<'reg_entry>
'reg_msg = Register['%str, 'app_pid] | Claim['%str, @'claim]

// The registry prune horizon is deliberately SHORTER than the park timeout: a stale
// token then answers `Missing` (a clean cold join) while its app is still alive,
// rather than `Found` a tombstone — sending the socket to a dead app would drop
// and close it, costing the client a retry. The window where that can still happen is
// an app *crashing* while parked.
park_ms = 60000
prune_ms = 45000

// The entries younger than the cutoff (order irrelevant).
prune_entries = #[(items): 'reg_entries, (cutoff): 'int] {
  cutoff = $cutoff
  %list.filter [$items, #{ __integer_compare__ [$at, cutoff] ~> =(0 | 1); $ }]
}

// Remove and answer a token's entry: `[found: Found[pid] | Missing, rest: …]`.
// The pid is extracted by *pattern* and passed by reference — a pid reached through
// an access in flow position, or bare in a field, would be *sent* the flowing value.
take_entry = #[(items): 'reg_entries, (token): '%str, (acc): 'reg_entries] {
  // The pin below needs a variable, so bind the field locally.
  token = $token
  $items ~> {
    | =Nil => [found: Missing, rest: $acc]
    | =Cons[e, t] => {
      | e.token ~> =&token => [found: Found[e.pid], rest: %list.chain [%list.reverse $acc, t]]
      | ^ [t, token, Cons[e, $acc]]
    }
  }
}

// The registry store: token → parked app. Claims are one-shot (an attached app is
// unclaimable until it re-registers), and stale entries are pruned on every message,
// so unclaimed tokens cannot accumulate.
registry_loop = #'reg_entries {
  !'reg_msg ~> =msg
  now = %time.monotonic []
  live = __integer_subtract__ [now, prune_ms] ~> prune_entries [$, ~]
  msg ~> {
    | =Register[t, p] => ^ Cons[[token: t, pid: p, at: now], live]
    | =Claim[t, reply] => {
      (found, rest) = take_entry [live, t, Nil]; %proc.send [reply, found]; ^ rest
    }
  }
}

// The app registry: token → parked app, one-shot claims, stale entries pruned.
registry = #[] { Nil ~> @registry_loop ~ }

// The root the app machinery runs: a placeable component whose init is the HTTP
// request. The constructor below composes every accepted config into this shape —
// the app consumes it through the boundary door (call it, take the spawn thunk off
// the node, run it with the `Reply` boot), so components are one uniform currency,
// root included, and the app record needs no type parameters.
'root_view = #'place<'%http> -> '%html<[]>

// An app: the server side of one page load. Further views are placed in view
// markup, never declared here. The record carries the app's own registry (spawned
// by the constructor, owned by its caller); future app-level knobs (routes, settle
// window, park timeout) land here.
'app = [root: 'root_view, reg: @'reg_msg]

// The two accepted configs: a request-free root (it mounts from nil — the common
// case), or a root plus an `init` mapping deriving its mount init from the request
// (the door to per-request state: the session cookie, query params, the path —
// `init: #'%http { $ }` passes the request itself).
'root_free = [root: #'place<[]> -> '%html<[]>]
'root_mapped<'i> = [root: #'place<'i> -> '%html<[]>, init: #'%http -> 'i]

app = #<'i>('root_free | 'root_mapped<'i>) {
  :doc "Declares an app — the unit `handle` serves. `[root: comp]` names the root view (a placeable component from `component`), which mounts from nil; add `init: #'%http -> 'i` to derive the root's mount init from the request instead (`init: #'%http \{ $ }` passes the request itself). Further views are placed in view markup, not declared here. Spawns the app's parking registry, so create once at startup — the calling process owns it — and share the record with every `handle` call."
  | =(init: f, root: r) => {
    rooted = #'place<'%http> { k = $key; r [init: f $init, key: k] }
    [root: rooted, reg: registry []]
  }
  | {
    =(root: r)
    rooted = #'place<'%http> { k = $key; r [init: [], key: k] }
    [root: rooted, reg: registry []]
  }
}

// === The app ============================================================================

'amode = Parked | Attached['%http/websocket]

'strs = '%list<'%str>

// Send a list of encoded frame messages down the socket, in order.
flush_frames = #[(items): 'strs, (conn): '%http/websocket] {
  $items ~> {
    | =Nil => Ok
    | =Cons[s, t] => { %http/websocket.send_text [$conn, s]; ^ [t, $conn] }
  }
}

// The app's routing map: vid → view. The root registers at spawn as "0"; views
// announce their children with `Route`/`Unroute` as they reconcile.
'routes = '%list<[vid: '%str, pid: @'view_msg]>

'route_hit = RFound[@'view_msg] | RMissing

route_of = #[(rs): 'routes, (v): '%str] -> 'route_hit {
  // The pin below needs a variable, so bind the field locally. The route's pid is
  // extracted by *pattern* and passed by reference — a pid reached through an access
  // in flow position, or bare in a field, would be *sent* the flowing value.
  v = $v
  {
    | %list.find [$rs, #{ =(vid: rv); rv ~> =&v; $ }] ~> =(pid: rp) => RFound[rp]
    | RMissing
  }
}

del_route = #[(rs): 'routes, (v): '%str] {
  // The pin below needs a variable, so bind the field locally.
  v = $v
  %list.filter [$rs, #{ =(vid: rv); { rv ~> =&v => [] | $ } }]
}

// Fan a park/wake signal out to every routed view.
tell_views = #[(routes): 'routes, (m): (Park | Wake)] {
  $routes ~> {
    | =Nil => Ok
    | =Cons[r, t] => { r ~> =(pid: p); %proc.send [p, $m]; ^ [t, $m] }
  }
}

// Unpack a batch of socket messages and forward each event to its vid's view; an
// unknown vid (a just-killed child; a forged id) or a malformed envelope is dropped.
// A ws Close answers `Halt` (the app terminates, and ownership tears the views down).
route_events = #[(req): '%http, (messages): '%http/websocket.messages, (routes): 'routes] {
  // The nav arm below spreads `req`, so bind the field locally.
  req = $req
  $messages ~> {
    | =Nil => Go
    | =Cons[Text[t], rest] => {
      {
        // The three-element event envelope first — events dominate, so the common path
        // parses once (a two-element nav message can't match it).
        | env_of t ~> =[v, payload, ev]
          route_of [$routes, v] ~> =RFound[p] => { %proc.send [p, Event[payload, ev]]; Ok }
        // A live-navigation message re-derives the root: build the request for the new
        // target (keeping the initial request's method/headers/cookies) and hand it to
        // the root view, which folds it through `nav`.
        | nav_of t ~> =Str[tb]; route_of [$routes, "0"] ~> =RFound[p] => {
          %http.split_target Str[tb] ~> =[path, query]
          %proc.send [p, Nav[req[..., target: Str[tb], path: path, query: query]]]
          Ok
        }
        | Ok
      }
      ^ [req, rest, $routes]
    }
    | =Cons[Close[code: _, reason: _], _] => Halt
    | =Cons[Binary[_], rest] => ^ [req, rest, $routes]
  }
}

// The app's whole life: one tail-recursive loop over its mode. `buf` holds frames
// (newest first) that arrived while parked. On attach: flush the buffer oldest-first,
// wake the views, and pump any whole messages the join already buffered on the conn —
// the token recv can read past the first frame, and the socket select only fires on
// NEW bytes, so without the pump a pipelined event stalls until the client's next
// bytes. The attached select receives frames and route changes from the mailbox (an
// `Attach` cannot arrive while attached — the registry claim is one-shot — and would
// wait queued regardless).
alife = #[
  (req): '%http,
  (mode): 'amode,
  (buffer): 'strs,
  (token): ('%str | []),
  (registry): @'reg_msg,
  (routes): 'routes,
] {
  // The pid is taken by reference (a bare access would send), so bind it locally.
  reg = $registry
  $mode ~> {
    | =Parked => ![#'app_msg, park_ms] ~> {
      | =Attach[conn] => {
        flush_frames [%list.reverse $buffer, conn]
        tell_views [$routes, Wake]
        %http/websocket.on_data [conn, <>] ~> =[msgs, c2]
        route_events [$req, msgs, $routes] ~> {
          | =Go => ^ [$req, Attached[c2], Nil, $token, reg, $routes]
          | Ok
        }
      }
      | =Frame[s] => ^ [$req, Parked, Cons[s, $buffer], $token, reg, $routes]
      | =Route[v, p] => ^ [
          $req,
          Parked,
          $buffer,
          $token,
          reg,
          Cons[[vid: v, pid: p], del_route [$routes, v]],
        ]
      | =Unroute[v] => ^ [$req, Parked, $buffer, $token, reg, del_route [$routes, v]]
      | Ok
    }
    | =Attached[conn] => {
      ![conn.sock, #(Frame['%str] | Route['%str, @'view_msg] | Unroute['%str])]
      ~> {
        | =Data[sock: _, data: d] => {
          %http/websocket.on_data [conn, d] ~> =[msgs, c2]
          route_events [$req, msgs, $routes] ~> {
            | =Go => ^ [$req, Attached[c2], Nil, $token, reg, $routes]
            | Ok
          }
        }
        | =Frame[s] => {
          %http/websocket.send_text [conn, s]; ^ [$req, Attached[conn], Nil, $token, reg, $routes]
        }
        | =Route[v, p] => ^ [
            $req,
            Attached[conn],
            Nil,
            $token,
            reg,
            Cons[[vid: v, pid: p], del_route [$routes, v]],
          ]
        | =Unroute[v] => ^ [$req, Attached[conn], Nil, $token, reg, del_route [$routes, v]]
        // A clean `Closed`, or the nil of a failed read — a reset is how a browser tab
        // usually vanishes. Either way the socket is gone, and gone means park: the
        // recovery is deliberate, so the clean/failed difference is dropped with the nil.
        | $token ~> {
          | =Str[tb] => {
            tell_views [$routes, Park]
            %proc.send [reg, Register[Str[tb], @]]
            ^ [$req, Parked, Nil, Str[tb], reg, $routes]
          }
          | Ok
        }
      }
    }
  }
}

// === Dead-render composition ============================================================
// At a GET, the app assembles the COMPLETE page before answering: the root's
// settled region arrives as `Region`, and each placed view's settled first frame —
// a single root-replacing "h" patch under its vid — is spliced into its (empty)
// `<!--v:vid-->` markers instead of buffered. The page's own text says when it is
// done: while any empty marker pair remains, a placed view's content is still
// coming (a parent's markup always precedes its children's frames, so markers are
// always in the page before the content that fills them). Ordinary patch frames
// (a store stepping after a view announced) buffer as usual and apply at attach.

// Classify an encoded frame: is it a view's first frame?
'fclass = FirstFrame[vid: '%str, html: '%str] | OtherFrame

classify_frame = #'%str -> 'fclass {
  fs = $
  {
    | {
      %json.parse fs ~> =('%json)env
      env ~> =Array[es]
      es ~> =Cons[_, r1]
      r1 ~> =Cons[vidj, r2]
      vidj ~> jval ~ ~> =Str[vb]
      r2 ~> =Cons[patchesj, Nil]
      patchesj ~> jval ~ ~> =Array[Cons[pj, Nil]]

      pj ~> jval ~ ~> =Array[Cons[tagj, Cons[pathj, Cons[htmlj, Nil]]]]

      tagj ~> jval ~ ~> ="h"
      pathj ~> jval ~ ~> =Array[Nil]
      htmlj ~> jval ~ ~> =Str[hb]
      FirstFrame[vid: Str[vb], html: Str[hb]]
    }
    | OtherFrame
  }
}

// Insert a view's HTML between its empty boundary markers; a page without the
// markers (a raced unroute) passes through unchanged.
// `index_of` and `slice` both count characters, so every length paired with them must too:
// a page with any character outside ASCII makes a byte length the wrong cut.
splice = #[(page): '%str, (vid): '%str, (html): '%str] {
  open = %str.concat ["<!--v:", %str.concat [$vid, "-->"]]
  {
    | %str.index_of [$page, open] ~> =('int)i => {
      cut = %num.add [i, %str.length open]
      pre = %str.slice [$page, 0, cut]
      post = %str.slice [$page, cut, %str.length $page]
      %str.concat [pre, %str.concat [$html, post]]
    }
    | $page
  }
}

// Whether the page still holds an EMPTY boundary marker pair — `<!--v:ID-->`
// immediately followed by `<!--/v:ID-->` — i.e. a placed view whose first frame
// hasn't arrived. Walks every open marker.
unfilled_from = #[(page): '%str, (from): 'int] {
  plen = %str.length $page
  rest = %str.slice [$page, $from, plen]
  {
    | %str.index_of [rest, "<!--v:"] ~> =('int)i => {
      idstart = %num.add [$from, %num.add [i, 6]]
      tail1 = %str.slice [$page, idstart, plen]
      {
        | %str.index_of [tail1, "-->"] ~> =('int)j => {
          id = %str.slice [$page, idstart, %num.add [idstart, j]]
          closepos = %num.add [idstart, %num.add [j, 3]]
          needle = %str.concat ["<!--/v:", %str.concat [id, "-->"]]
          nend = %num.add [closepos, %str.length needle]
          {
            | %num.lt? [plen, nend] => ^ [$page, closepos]
            | {
              seg = %str.slice [$page, closepos, nend]
              {
                | seg ~> =&needle => Ok
                | ^ [$page, closepos]
              }
            }
          }
        }
        | []
      }
    }
    | []
  }
}

unfilled? = #'%str { unfilled_from [$, 0] }

// Whether the composed page is complete: the root announced, and no empty
// boundary pair remains.
composed? = #('%str | []) {
  | =Str[pb]; { unfilled? Str[pb] => [] | Ok } => Ok
  | []
}

// Reclassify frames that raced ahead of the root's `Region` (cross-process
// delivery order is not guaranteed): walk the pending frames oldest-first,
// splicing first frames into the page and keeping the rest buffered.
reprocess = #[(page): '%str, (pending): 'strs, (keep): 'strs] -> ['%str, 'strs] {
  $pending ~> {
    | =Nil => [$page, $keep]
    | =Cons[fs, t] => classify_frame fs ~> {
      | =FirstFrame[vid: Str[vb], html: Str[hb]] => ^ [splice [$page, Str[vb], Str[hb]], t, $keep]
      | ^ [$page, t, Cons[fs, $keep]]
    }
  }
}

// The composition loop: collect the root's `Region` and the views' first frames
// (splicing as they arrive), buffer everything else, and answer the handler the
// complete page — or whatever assembled by the deadline. Then park.
compose = #[
  (handler): @'%str,
  (page): ('%str | []),
  (buffer): 'strs,
  (token): ('%str | []),
  (registry): @'reg_msg,
  (routes): 'routes,
  (end): 'int,
  (req): '%http,
] {
  // The loop closes over these, so bind them locally.
  handler = $handler
  reg = $registry
  {
    | composed? $page => {
      $page ~> =Str[pb]
      %proc.send [handler, Str[pb]]
      alife [$req, Parked, $buffer, $token, reg, $routes]
    }
    | %num.lt? [%time.monotonic [], $end] => ![#'app_msg, settle_quiet] ~> {
      | =Region[h] => {
        r = reprocess [h, %list.reverse $buffer, Nil]
        ^ [handler, r.0, r.1, $token, reg, $routes, $end, $req]
      }
      | =Frame[s] => $page ~> {
        | =Str[pb] => classify_frame s ~> {
          | =FirstFrame[vid: Str[vb], html: Str[hb]] => ^ [
              handler,
              splice [Str[pb], Str[vb], Str[hb]],
              $buffer,
              $token,
              reg,
              $routes,
              $end,
              $req,
            ]
          | ^ [handler, Str[pb], Cons[s, $buffer], $token, reg, $routes, $end, $req]
        }
        | ^ [handler, [], Cons[s, $buffer], $token, reg, $routes, $end, $req]
      }
      | =Route[v, p] => ^ [
          handler,
          $page,
          $buffer,
          $token,
          reg,
          Cons[[vid: v, pid: p], del_route [$routes, v]],
          $end,
          $req,
        ]
      | =Unroute[v] => ^ [handler, $page, $buffer, $token, reg, del_route [$routes, v], $end, $req]
      // An Attach cannot arrive before the page (the token is in it); dropping the
      // impossible conn closes it and the client retries cold.
      | =Attach[_] => ^ [handler, $page, $buffer, $token, reg, $routes, $end, $req]
      | ^ [handler, $page, $buffer, $token, reg, $routes, $end, $req]
    }
    // Deadline: answer with what assembled (a stuck view's boundary stays empty).
    | {
      $page ~> {
        | =Str[pb] => %proc.send [handler, Str[pb]]
        | Ok
      }
      alife [$req, Parked, $buffer, $token, reg, $routes]
    }
  }
}

// An app: register (when it has a token — the cold path has none and terminates on
// disconnect instead of parking), spawn-and-link its root view, and run. Linking
// makes a root-view crash kill the app — closing the socket, exactly as a crash of
// the old fused loop did — while the app's own (normal) park-timeout death still
// tears the view tree down by ownership.
'aboot = Dead[@'%str] | Cold

app_run = #['%http, 'root_view, @'reg_msg, ('%str | []), 'aboot] {
  =[req, root, reg, token, boot]
  {
    | token ~> =Str[tb] => { %proc.send [reg, Register[Str[tb], @]]; Ok }
    | Ok
  }
  me = @
  // The root is consumed through the boundary door: place it against the request,
  // take the spawn thunk off the node, and run it as vid "0" with the app's boot.
  // (A root that didn't come from `view` carries no :boundary — the retrieval
  // fails and the app ends, so the GET times out. Fail fast.)
  node = root [init: req, key: "root"]
  node:('bnd)boundary ~> =(start: st)
  boot ~> {
    | =Dead[handler] => {
      v = st ["0", me, Reply[me]]
      %proc.link v
      end = %num.add [%time.monotonic [], settle_deadline]
      compose [handler, [], Nil, token, reg, Cons[[vid: "0", pid: v], Nil], end, req]
    }
    | =Cold => {
      v = st ["0", me, Replace]
      %proc.link v
      alife [req, Parked, Nil, token, reg, Cons[[vid: "0", pid: v], Nil]]
    }
  }
}

// The COLD path: an unknown or expired token gets a fresh app and view (a fresh
// mount) whose first frame replaces the live region. The app is spawned tokenless,
// so it terminates on disconnect instead of parking, and detached, so it survives
// this connection process ending.
run_cold = #[(conn): '%http/websocket, (req): '%http, (root): 'root_view, (registry): @'reg_msg] {
  a = [$req, $root, $registry, [], Cold] ~> @app_run ~
  %proc.detach a
  %proc.send [a, Attach[$conn]]
  Ok
}

// The upgrade side: the client's first frame is its token. A claimed app is sent
// the connection — socket ownership rides the message, and this connection process
// then ends owning nothing. Anything else falls back to the cold path.
join = #[(conn): '%http/websocket, (req): '%http, (root): 'root_view, (registry): @'reg_msg] {
  // The pid is taken by reference (a bare access would send), so bind it locally.
  reg = $registry
  %http/websocket.recv $conn ~> =[first, c2]
  first ~> {
    | =Text[tok] => {
      %proc.send [reg, Claim[tok, @]]
      !'claim ~> {
        | =Found[p] => { %proc.send [p, Attach[c2]]; Ok }
        | run_cold [c2, $req, $root, reg]
      }
    }
    | Ok
  }
}

// === The test harness ===================================================================
// Drive a component with no socket and no browser. `sim` mounts it (request → state →
// frame 0); each step answers `[sim2, patches]` — the patch list a connected client
// would have been sent (`Nil` where the view sends nothing: an empty diff, or a
// dropped event). The steps run the same seams the view process runs, minus the
// wire: `sim_text` feeds one wire envelope exactly as a socket Text frame carries it
// (parse → decode → update → render → diff); `sim_event` feeds an already-decoded
// event straight to `update`; `sim_changed` is the wakeup path — re-render and diff,
// as the view does when a sampled store steps. Tracked renders subscribe the *calling*
// process, so after stepping a store a test receives the wakeup itself
// (`!'%proc.changed`) and then applies `sim_changed`, mirroring the view's select.

'sim<'i, 's, 'e> = Sim[comp: 'component<'i, 's, 'e>, state: 's, frame: 'frame]

sim = #<'e, 'i, 's>[(init): 'i, (cfg): ('component_base<'i, 's, 'e> | 'component<'i, 's, 'e>)] {
  :doc "Mounts a component with no socket, for tests: answers a sim holding the mounted state and frame 0. Step it with `sim_text` / `sim_event` / `sim_changed`; read its region HTML with `sim_html`. Pin the wire-event type — `sim<'ev> [...]` — to compile-check the view's `on:*` payloads."
  comp = with_nav $cfg
  state = comp.mount $init
  Sim[comp: comp, state: state, frame: render_view [state, comp]]
}

sim_text = #<'i, 's, 'e>[(s): 'sim<'i, 's, 'e>, (text): '%str] {
  :doc "Feeds a sim one wire envelope — the JSON a socket Text frame carries, `[vid, payload, metadata]` — through the session's own parse → decode → update seam. Answers `[sim2, patches]`; a malformed envelope drops silently (the sim unchanged, `Nil` patches) and a decode answering nil leaves the state untouched, exactly as the live path drops them."
  $s ~> =Sim(comp: comp, state: state, frame: prev)
  {
    | env_of $text ~> =[_, payload, ev] => {
      s2 = fold_event [state, comp, payload, ev]
      f2 = render_view [s2, comp]
      [Sim[comp: comp, state: s2, frame: f2], diff [prev, f2]]
    }
    | [$s, Nil]
  }
}

sim_event = #<'i, 's, 'e>[(s): 'sim<'i, 's, 'e>, (ev): 'e] {
  :doc "Feeds a sim one already-decoded event, straight to `update` — the app-level step, for asserting `update`/`view` behavior without wire shapes. Answers `[sim2, patches]` (`Nil` when the render's diff is empty — the empty-frame suppression seam)."
  $s ~> =Sim(comp: comp, state: state, frame: prev)
  s2 = comp.update [state: state, event: $ev]
  f2 = render_view [s2, comp]
  [Sim[comp: comp, state: s2, frame: f2], diff [prev, f2]]
}

sim_changed = #<'i, 's, 'e>'sim<'i, 's, 'e> {
  :doc "The wakeup path: re-render and diff against the sim's frame, as the loop does after a `'%proc.changed` wakeup from a sampled store. Answers `[sim2, patches]`. The wakeup itself is the caller's to receive (`!'%proc.changed`) — the sim's tracked renders subscribed the calling process."
  =Sim(comp: comp, state: state, frame: prev)
  f2 = render_view [state, comp]
  [Sim[comp: comp, state: state, frame: f2], diff [prev, f2]]
}

sim_html = #<'i, 's, 'e>'sim<'i, 's, 'e> {
  :doc "The sim's current region HTML (instrumented, as a live client's DOM shows it)."
  =Sim(frame: f); render f
}

// The generic client: resolves marker paths, applies patch frames, echoes event
// payloads (vid 0 — one region, one view, until boundaries), reconnects with backoff
// (a token the server still holds re-attaches silently; otherwise the cold join
// replaces the region). (`\{` is a literal brace in a Quiver string.)
client_js = """
<script>
(() => \{
  const root = document.getElementById('q-root');
  const token = root.getAttribute('data-q-token') || '';
  const nextNode = (n) => \{
    if (n.firstChild) return n.firstChild;
    while (n && n !== root) \{
      if (n.nextSibling) return n.nextSibling;
      n = n.parentNode;
    }
    return null;
  };
  const scan = (a, b, visit) => \{
    let n = a ? nextNode(a) : root.firstChild;
    while (n && n !== b) \{
      if (visit(n)) return;
      n = nextNode(n);
    }
  };
  const mopen = (n) => \{
    if (n.nodeType !== 8) return null;
    if (n.data.startsWith('q:')) return \{ slot: parseInt(n.data.slice(2)) };
    if (n.data === 'r') return \{ row: true };
    if (n.data.startsWith('v:')) return \{ bnd: n.data.slice(2) };
    return null;
  };
  const mclose = (n) =>
    n.nodeType === 8 &&
    (n.data.startsWith('/q:') || n.data === '/r' || n.data.startsWith('/v:'));
  // A view's boundary range: the root view (\"0\") is the whole region; a child's is
  // its v: marker pair (ids are unique, so no depth counting is needed).
  const boundary = (vid) => \{
    if (vid === '0') return \{ open: null, close: null };
    let open = null, close = null;
    scan(null, null, (n) => \{
      if (n.nodeType !== 8) return false;
      if (n.data === 'v:' + vid) open = n;
      else if (n.data === '/v:' + vid) \{ close = n; return true; }
      return false;
    });
    return open && close ? \{ open: open, close: close } : null;
  };
  const resolve = (path, from) => \{
    let open = from.open, close = from.close;
    for (const idx of path) \{
      // A segment indexes whatever the range holds: numbered slot markers (q:idx) or
      // anonymous row markers (the idx-th r) — the two never mix at one level.
      let found = null, depth = 0, rows = 0;
      scan(open, close, (n) => \{
        const o = mopen(n);
        if (o) \{
          if (depth === 0) \{
            if (o.row) \{
              if (rows === idx) \{ found = n; return true; }
              rows++;
            } else if (o.slot === idx) \{ found = n; return true; }
          }
          depth++;
        } else if (mclose(n)) depth--;
        return false;
      });
      if (!found) return null;
      let end = null, d = 0;
      scan(found, close, (n) => \{
        if (mopen(n)) d++;
        else if (mclose(n)) \{
          if (d === 0) \{ end = n; return true; }
          d--;
        }
        return false;
      });
      if (!end) return null;
      open = found;
      close = end;
    }
    return \{ open: open, close: close };
  };
  const setNodes = (r, frag) => \{
    if (!r.open) \{ root.replaceChildren(frag); return; }
    while (r.open.nextSibling && r.open.nextSibling !== r.close) r.open.nextSibling.remove();
    r.close.parentNode.insertBefore(frag, r.close);
  };
  // Patch markup is parsed **in the context of the element it lands in**, so a fragment
  // going into an <svg> is parsed as SVG. A detached <template> would parse everything as
  // HTML, which puts a patched-in <circle> in the wrong namespace — present in the DOM,
  // and invisible.
  const parseHtml = (h, ctx) => \{
    const range = document.createRange();
    range.selectNodeContents(ctx && ctx.nodeType === 1 ? ctx : root);
    return range.createContextualFragment(h);
  };
  const apply = (b, p) => \{
    if (p[0] === 'a') \{
      const r = resolve(p[1].slice(0, -1), b);
      if (!r) return;
      const elem = String(p[2]), name = p[3], v = p[4];
      let target = null, depth = 0;
      scan(r.open, r.close, (n) => \{
        if (mopen(n)) depth++;
        else if (mclose(n)) depth--;
        else if (n.nodeType === 1 && depth === 0 && n.getAttribute('data-q') === elem) \{
          target = n;
          return true;
        }
        return false;
      });
      if (!target) return;
      if (v === null) target.removeAttribute(name);
      else if (v === true) target.setAttribute(name, '');
      else target.setAttribute(name, v);
      if (name === 'value' && 'value' in target) target.value = v === null ? '' : v;
      if (name === 'checked' && 'checked' in target) target.checked = v !== null;
    } else if (p[0] === 'r-') \{
      const r = resolve(p[1].concat([p[2]]), b);
      if (!r || !r.open) return;
      while (r.open.nextSibling && r.open.nextSibling !== r.close) r.open.nextSibling.remove();
      r.close.remove();
      r.open.remove();
    } else if (p[0] === 'r>') \{
      const src = resolve(p[1].concat([p[2]]), b);
      if (!src || !src.open) return;
      const frag = document.createDocumentFragment();
      const stop = src.close.nextSibling;
      let n = src.open;
      while (n && n !== stop) \{
        const nx = n.nextSibling;
        frag.appendChild(n);
        n = nx;
      }
      const dst = resolve(p[1].concat([p[3]]), b);
      if (dst && dst.open) dst.open.parentNode.insertBefore(frag, dst.open);
      else \{
        const r = resolve(p[1], b);
        if (r && r.close) r.close.parentNode.insertBefore(frag, r.close);
        else root.appendChild(frag);
      }
    } else if (p[0] === 'r+') \{
      const r = resolve(p[1], b);
      if (!r) return;
      let before = null, depth = 0, rows = 0;
      scan(r.open, r.close, (n) => \{
        const o = mopen(n);
        if (o) \{
          if (depth === 0 && o.row) \{
            if (rows === p[2]) \{ before = n; return true; }
            rows++;
          }
          depth++;
        } else if (mclose(n)) depth--;
        return false;
      });
      const frag = parseHtml(p[3], (before || r.close || root).parentNode);
      if (before) before.parentNode.insertBefore(frag, before);
      else if (r.close) r.close.parentNode.insertBefore(frag, r.close);
      else root.appendChild(frag);
    } else \{
      const r = resolve(p[1], b);
      if (!r) return;
      const ctx = r.close ? r.close.parentNode : root;
      setNodes(r, p[0] === 't' ? document.createTextNode(p[2]) : parseHtml(p[2], ctx));
    }
  };
  let ws = null, delay = 500;
  const connect = () => \{
    const proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
    ws = new WebSocket(proto + location.host + location.pathname + location.search);
    ws.onopen = () => \{
      delay = 500;
      ws.send(token);
    };
    ws.onmessage = (e) => \{
      const m = JSON.parse(e.data);
      // A `[2, path]` frame is a server-initiated URL change: sync the address bar to
      // match the view the server already patched, without a full navigation.
      if (m[0] === 2) \{ history.pushState(\{}, '', new URL(m[1], location.href).href); return; }
      if (m[0] !== 1) \{ location.reload(); return; }
      // m[1] is the frame's view id; a vid whose markers are gone (a just-removed
      // child) drops the whole frame.
      const b = boundary(m[1]);
      if (b) for (const p of m[2]) apply(b, p);
    };
    ws.onclose = () => \{
      setTimeout(connect, delay);
      delay = Math.min(delay * 2, 15000);
    };
  };
  connect();
  // On navigation the browser may keep this document alive (back/forward cache) —
  // WITH its socket, leaving a zombie connection attached server-side. Close it on
  // pagehide (which also makes the page bfcache-eligible), without triggering the
  // reconnect; a restore from the cache reconnects, and the server treats the join
  // as any other (a fresh mount — a clean close ends the server-side app).
  addEventListener('pagehide', () => \{
    if (ws) \{
      ws.onclose = null;
      ws.close();
    }
  });
  addEventListener('pageshow', (e) => \{
    if (e.persisted) connect();
  });
  // The live element for an event, or null.
  const live = (e, attr) => \{
    const el = e.target.closest && e.target.closest('[' + attr + ']');
    if (!el || !root.contains(el)) return null;
    return ws && ws.readyState === 1 ? el : null;
  };
  // The event's view: the nearest enclosing v: boundary, or the root (\"0\").
  const vidOf = (el) => \{
    let stack = [], found = '0';
    scan(null, null, (n) => \{
      if (n.nodeType === 8) \{
        if (n.data.startsWith('v:')) stack.push(n.data.slice(2));
        else if (n.data.startsWith('/v:')) stack.pop();
      }
      if (n === el) \{
        if (stack.length) found = stack[stack.length - 1];
        return true;
      }
      return false;
    });
    return found;
  };
  // One event envelope: the view id, the payload (the attribute text echoed verbatim —
  // %data notation, not JSON, so it rides as a JSON string), and this event's metadata,
  // a tagged array the server reads as its `'event` union. The payload is what the
  // server rendered; the metadata is everything only the browser knows. Built at event
  // time, so a rate-limited send still carries what the DOM held when it fired.
  const envelope = (el, attr, meta) =>
    '[' + JSON.stringify(vidOf(el)) + ',' + JSON.stringify(el.getAttribute(attr)) + ',' + JSON.stringify(meta) + ']';
  const mods = (e) => [!!e.altKey, !!e.ctrlKey, !!e.shiftKey, !!e.metaKey];
  // A mouse event's position in the BOUND element's box, not the viewport: a surface
  // reads coordinates in its own space wherever it sits on the page.
  const pointer = (e, el) => \{
    const r = el.getBoundingClientRect();
    return [Math.round(e.clientX - r.left), Math.round(e.clientY - r.top), e.button | 0, mods(e)];
  };
  // Read from the control that actually changed, not the bound element — a binding on a
  // <form> reports the field the user touched.
  const fieldOf = (t) => [
    String(t.value == null ? '' : t.value),
    !!(t.type === 'checkbox' || t.type === 'radio') && !!t.checked,
  ];
  const formPairs = (el) => \{
    const pairs = [];
    new FormData(el).forEach((v, k) => \{
      if (typeof v === 'string') pairs.push([k, v]);
    });
    return pairs;
  };
  // The event table: DOM event name, whether to suppress the browser's default, and this
  // event's metadata. `cancel` is the policy question each entry answers — a navigation
  // or form submission is ours to take over, while typing, selecting and key presses are
  // the user's own and must go through untouched.
  const EVENTS = [
    ['click', true, (e, el) => ['click'].concat(pointer(e, el))],
    ['mousedown', false, (e, el) => ['mousedown'].concat(pointer(e, el))],
    ['mouseup', false, (e, el) => ['mouseup'].concat(pointer(e, el))],
    ['mousemove', false, (e, el) => ['mousemove'].concat(pointer(e, el))],
    ['submit', true, (e, el) => ['submit', formPairs(el)]],
    ['input', false, (e, el) => ['input'].concat(fieldOf(e.target))],
    ['change', false, (e, el) => ['change'].concat(fieldOf(e.target))],
    ['keydown', false, (e, el) => ['keydown', String(e.key == null ? '' : e.key), mods(e)]],
  ];
  // Per-element, per-event rate-limit state. Keyed weakly: a patch that replaces the
  // element drops its pending timer with it, which is what we want — a debounce for a
  // node that no longer exists has nothing to report.
  const limits = new WeakMap();
  const limitState = (el, name) => \{
    let m = limits.get(el);
    if (!m) \{
      m = \{};
      limits.set(el, m);
    }
    if (!m[name]) m[name] = \{ timer: 0, last: 0 };
    return m[name];
  };
  // A binding's options, from the `data-q-NAME-opts` its `[ … ]` bracket emitted:
  // [debounce, throttle, keys]. A binding without a bracket carries no attribute, and
  // takes the defaults — no rate limit, any key.
  const NO_OPTS = [0, 0, []];
  const optsOf = (el, name) => \{
    const raw = el.getAttribute('data-q-' + name + '-opts');
    return raw ? JSON.parse(raw) : NO_OPTS;
  };
  // Deliver, or not, per the binding's rate limits (ms). Debounce waits for the events to
  // stop and sends the newest envelope; throttle sends the first of each window and drops
  // the rest. Neither is visible to the server.
  const deliver = (el, name, opts, text) => \{
    const st = limitState(el, name);
    if (opts[0] > 0) \{
      clearTimeout(st.timer);
      st.timer = setTimeout(() => ws.send(text), opts[0]);
      return;
    }
    if (opts[1] > 0) \{
      const now = Date.now();
      if (now - st.last < opts[1]) return;
      st.last = now;
    }
    ws.send(text);
  };
  // A key filter drops the other keys client-side: they never reach the server at all.
  const keyAllowed = (e, keys) =>
    keys.length === 0 || e.key == null || keys.indexOf(e.key) >= 0;
  EVENTS.forEach((entry) => \{
    const name = entry[0], cancel = entry[1], meta = entry[2];
    const attr = 'data-q-' + name;
    document.addEventListener(name, (e) => \{
      const el = live(e, attr);
      if (!el) return;
      const opts = optsOf(el, name);
      if (!keyAllowed(e, opts[2])) return;
      if (cancel) e.preventDefault();
      const text = envelope(el, attr, meta(e, el));
      deliver(el, name, opts, text);
      if (name === 'submit') el.reset();
    });
  });
  // Live navigation: a plain left-click on a `data-q-nav` link is sent as a nav
  // message and the URL is updated in place, instead of a full page load. Modified
  // clicks, cross-origin links, and (as a fallback) a closed socket keep the
  // browser's default navigation, so a live link degrades to an ordinary one.
  const navTo = (href, push) => \{
    const url = new URL(href, location.href);
    if (url.origin !== location.origin || !(ws && ws.readyState === 1)) return false;
    if (push) history.pushState(\{}, '', url.href);
    ws.send('[\"nav\",' + JSON.stringify(url.pathname + url.search) + ']');
    return true;
  };
  document.addEventListener('click', (e) => \{
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = e.target.closest && e.target.closest('a[data-q-nav]');
    if (!a || !root.contains(a) || a.target || a.hasAttribute('download')) return;
    const href = a.getAttribute('href');
    if (href && navTo(href, true)) e.preventDefault();
  });
  // Back/forward: replay the URL the browser restored to the server (no pushState —
  // the history entry already exists). Unlike a link click there is no default
  // navigation to fall through to — the browser has already moved the URL — so a
  // dead socket reloads, keeping the page and the address bar in step.
  addEventListener('popstate', () => \{
    if (!navTo(location.pathname + location.search, false)) location.reload();
  });
})();
</script>
"""

// The dead render's page shell: the instrumented region in a container the client owns,
// plus the client script. Whole-page concerns (title, head) are the caller's, later.
page_shell = #[(region): '%str, (token): '%str] {
  "<!doctype html><html><head><meta charset=\"utf-8\"></head><body><div id=\"q-root\" data-q-token=\""
  ~> %str.concat [~, $token]
  ~> %str.concat [~, "\">"]
  ~> %str.concat [~, $region]
  ~> %str.concat [~, "</div>"]
  ~> %str.concat [~, client_js]
  ~> %str.concat [~, "</body></html>"]
}

handle = #[(req): '%http, (app): 'app] {
  :doc "The app's HTTP handler body. A plain GET spawns a detached app process whose root view mounts once; the view answers the region HTML and the app parks behind the page's claim token. A websocket-upgrade request reads the token from the client's first frame and hands the claimed app the socket (an unknown token falls back to a cold fresh mount). Wire it as `#'%http \{ %html/live.handle [$, app] }` with an `%html/live.app [root: comp]` created once at startup."
  // The upgrade handler closes over `req` (an inner `$` would be its own
  // parameter), so bind the field locally.
  req = $req
  $app ~> =(root: rt, reg: rg)
  {
    | %http.header [req.headers, "sec-websocket-key"] => Upgrade[
        handler: #'%http/websocket { join [$, req, rt, rg] },
      ]
    | {
      token = %random.hex 16
      me = @
      ap = [req, rt, rg, token, Dead[me]] ~> @app_run ~
      %proc.detach ap
      ![#'%str, 5000] ~> {
        | =Str[region] => {
          page_shell [Str[region], token] ~> =Str[b]
          Response[
            status: 200,
            headers: Cons[["content-type", "text/html; charset=utf-8"], Nil],
            body: b,
          ]
        }
        | []
      }
    }
  }
}

{
  :dialect live_dialect
  (
    frame,
    render,
    diff,
    encode,
    app,
    component,
    redirect,
    handle,
    sim,
    sim_text,
    sim_event,
    sim_changed,
    sim_html,
    // Reached by the dialect's emitted calls, not usually by name.
    event_value,
    rate_opts,
    key_opts,
  )
}
