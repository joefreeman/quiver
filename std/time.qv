// Clocks and calendar arithmetic. Two host clocks: `now` — wall
// time as milliseconds since the Unix epoch (UTC) — and `monotonic` — milliseconds
// from an arbitrary per-run origin, steady, for measuring durations. Everything else
// is pure: `parts` breaks an epoch timestamp into UTC calendar components (proleptic
// Gregorian, exact for negative timestamps too), and the formatters render HTTP and
// ISO 8601 date strings. No timezones: UTC only.

'weekday = Mon | Tue | Wed | Thu | Fri | Sat | Sun

' = [year: 'int, month: 'int, day: 'int, hour: 'int, minute: 'int, second: 'int, millisecond: 'int, weekday: 'weekday]

// Floored division and modulo (the builtins truncate, which misplaces negative
// timestamps by a day/second).
fmod = #['int, 'int] {
  =[a, b]
  __integer_modulo__ [__integer_add__ [__integer_modulo__ [a, b], b], b]
}

fdiv = #['int, 'int] {
  =[a, b]
  __integer_divide__ [__integer_subtract__ [a, fmod [a, b]], b]
}

parts = #'int {
  :doc "The UTC calendar components of an epoch-milliseconds timestamp: [year, month, day, hour, minute, second, millisecond, weekday]."
  =total
  millisecond = fmod [total, 1000]
  secs = fdiv [total, 1000]
  sod = fmod [secs, 86400]
  days = fdiv [secs, 86400]

  hour = __integer_divide__ [sod, 3600]

  minute = __integer_divide__ [__integer_modulo__ [sod, 3600], 60]

  second = __integer_modulo__ [sod, 60]

  weekday = fmod [__integer_add__ [days, 4], 7] ~> {
    | =0 => Sun
    | =1 => Mon
    | =2 => Tue
    | =3 => Wed
    | =4 => Thu
    | =5 => Fri
    | Sat
  }

  // Civil-from-days (Howard Hinnant's algorithm), proleptic Gregorian.
  z = __integer_add__ [days, 719468]
  era = fdiv [z, 146097]

  doe = __integer_subtract__ [z, __integer_multiply__ [era, 146097]]

  yoe = __integer_subtract__ [doe, __integer_divide__ [doe, 1460]] ~> __integer_add__ [~, __integer_divide__ [doe, 36524]] ~> __integer_subtract__ [~, __integer_divide__ [doe, 146096]] ~> __integer_divide__ [
    ~,
    365,
  ]

  y = __integer_add__ [yoe, __integer_multiply__ [era, 400]]

  doy = __integer_add__ [__integer_multiply__ [365, yoe], __integer_divide__ [yoe, 4]] ~> __integer_subtract__ [~, __integer_divide__ [yoe, 100]] ~> __integer_subtract__ [
    doe,
    ~,
  ]

  mp = __integer_divide__ [__integer_add__ [__integer_multiply__ [5, doy], 2], 153]

  day = __integer_divide__ [
    __integer_add__ [__integer_multiply__ [153, mp], 2],
    5,
  ] ~> __integer_subtract__ [doy, ~] ~> __integer_add__ [~, 1]

  month = {
    | __integer_compare__ [mp, 10] ~> =-1 => __integer_add__ [mp, 3]
    | __integer_subtract__ [mp, 9]
  }
  year = {
    | __integer_compare__ [month, 2] ~> =(-1 | 0) => __integer_add__ [y, 1]
    | y
  }

  [
    year: year,
    month: month,
    day: day,
    hour: hour,
    minute: minute,
    second: second,
    millisecond: millisecond,
    weekday: weekday,
  ]
}

pad2 = #'int {
  | __integer_compare__ [$, 10] ~> =-1 => "0{%str.from_int $}"
  | %str.from_int $
}

pad3 = #'int {
  | __integer_compare__ [$, 10] ~> =-1 => "00{%str.from_int $}"
  | __integer_compare__ [$, 100] ~> =-1 => "0{%str.from_int $}"
  | %str.from_int $
}

day_name = #'weekday {
  | =Mon => "Mon"
  | =Tue => "Tue"
  | =Wed => "Wed"
  | =Thu => "Thu"
  | =Fri => "Fri"
  | =Sat => "Sat"
  | "Sun"
}

month_name = #'int {
  | =1 => "Jan"
  | =2 => "Feb"
  | =3 => "Mar"
  | =4 => "Apr"
  | =5 => "May"
  | =6 => "Jun"
  | =7 => "Jul"
  | =8 => "Aug"
  | =9 => "Sep"
  | =10 => "Oct"
  | =11 => "Nov"
  | "Dec"
}

http_date = #'int {
  :doc "An epoch-milliseconds timestamp as an HTTP date (IMF-fixdate), e.g. \"Sun, 06 Nov 1994 08:49:37 GMT\"."
  p = parts $
  "{day_name p.weekday}, {pad2 p.day} {month_name p.month} {%str.from_int p.year} {pad2 p.hour}:{pad2 p.minute}:{pad2 p.second} GMT"
}

iso8601 = #'int {
  :doc "An epoch-milliseconds timestamp as UTC ISO 8601, e.g. \"2024-01-01T00:00:00.123Z\"."
  p = parts $
  "{%str.from_int p.year}-{pad2 p.month}-{pad2 p.day}T{pad2 p.hour}:{pad2 p.minute}:{pad2 p.second}.{pad3 p.millisecond}Z"
}

[
  now: &__time_now__ ~> {
    :doc "The wall-clock time as milliseconds since the Unix epoch (UTC)."
  },
  monotonic: &__time_monotonic__ ~> {
    :doc "Milliseconds since an arbitrary per-run origin: steady, for measuring durations; unrelated to the wall clock."
  },
  parts: &parts,
  http_date: &http_date,
  iso8601: &iso8601,
]
