// The failure vocabulary every io operation shares.
//
// An io builtin whose failure depends on the world — a refused connection, a missing file
// — answers nil rather than terminating the process, because no caller-side guard could
// have avoided it. The reason travels with that nil as an `:error` annotation, so it
// survives short-circuiting and a caller several frames up can still read why:
//
//     sock = %tcp.connect [ip, port]        // nil short-circuits the sequence
//     ...
//     result ~> :error<'%io> ~> =IoError(kind: ConnectionRefused) => retry
//
// The kind is a tag to branch on. The message is the host's description: useful in a log,
// but it varies by platform, so don't make logic depend on it.
//
// An ordinary nil — an exhausted iterator, a legitimate absence — carries no `:error`, so
// a checked retrieval answers nil for it. That is how a consumer tells "nothing left" from
// "it broke".
//
// It is also the byte protocol every byte resource shares. A readable resource is a select
// source whose events are always `Data[source, data]` for a chunk and `Closed[source]` for
// the clean end, whatever its kind, so one consumer reads them all:
//
//     ![sock] ~> {
//       | =Data[source: _, data: d] => ...   // a chunk (up to 8 KiB)
//       | =Closed[source: _] => ...          // the whole stream has arrived
//     }
//
// A *failed* read answers nil carrying `:error` in place of an event, so `Closed` alone
// means everything arrived. Writing is `write`, for every writable kind, and `close`
// closes any resource at all.

'kind =
  | NotFound
  | PermissionDenied
  | AlreadyExists
  | ConnectionRefused
  | WouldBlock
  | Interrupted
  | NotADirectory
  | IsADirectory
  | DirectoryNotEmpty
  | CrossesDevices
  | Other

' = IoError[kind: 'kind, message: '%str]

// The byte resources a select reads chunks from.
'readable = +TcpSocket | +ByteSource

// The byte resources `write` sends to.
'writable = +TcpSocket | +ByteSink

// What a select on a readable `'r` yields, besides the failure nil.
'event<'r> = Data[source: 'r, data: 'bin] | Closed[source: 'r]

// The select-and-accumulate loop. A failed read answers nil carrying `:error`, and the
// binding gates on it — the failure propagates rather than passing off a truncated stream
// as the whole one.
read_rest = #<'r: 'readable>[(source): 'r, (acc): 'bin] {
  event = !$source
  event ~> {
    | =Data[source: _, data: d] => ^ [$source, %bin.concat [$acc, d]]
    | =Closed[source: _] => $acc
  }
}

// Two sources read together, so neither stalls behind the other: whichever has a chunk
// ready is read, and once one ends the other is read on alone.
read_both_rest = #<'r: 'readable>[(first): 'r, (second): 'r, (a): 'bin, (b): 'bin] {
  event = ![$first, $second]
  event ~> {
    | =Data[source: ^$first, data: d] => ^ [$first, $second, %bin.concat [$a, d], $b]
    | =Data[source: _, data: d] => ^ [$first, $second, $a, %bin.concat [$b, d]]
    | =Closed[source: ^$first] => { read_rest [$second, $b] ~> =('bin & rest); [$a, rest] }
    | =Closed[source: _] => { read_rest [$first, $a] ~> =('bin & rest); [rest, $b] }
  }
}

[
  write: __io_write__ ~> {
    :doc "Writes [writable, 'bin], answering Ok once every byte is written."
  },
  close: __io_close__ ~> {
    :doc "Closes any resource. An upgraded socket sends its close_notify first."
  },
  read_all: #<'r: 'readable>'r {
    :doc "Reads a readable resource to its clean end, answering every byte. A failed read answers nil carrying :error, never a truncated result."
    read_rest [$, <>]
  },
  read_both: #<'r: 'readable>[(first): 'r, (second): 'r] {
    :doc "Reads two readable resources to their clean ends at once, answering [first's bytes, second's bytes]. Reading them one after the other can deadlock — a writer blocked on the full second while the first is awaited — which this cannot. A failed read of either answers nil carrying :error."
    read_both_rest [$first, $second, <>, <>]
  },
  describe: #' {
    :doc "An io failure rendered for a log, e.g. \"ConnectionRefused: connection refused to 127.0.0.1:9\"."
    =IoError(kind: k, message: m)
    name = k ~> {
      | =NotFound => "NotFound"
      | =PermissionDenied => "PermissionDenied"
      | =AlreadyExists => "AlreadyExists"
      | =ConnectionRefused => "ConnectionRefused"
      | =WouldBlock => "WouldBlock"
      | =Interrupted => "Interrupted"
      | =NotADirectory => "NotADirectory"
      | =IsADirectory => "IsADirectory"
      | =DirectoryNotEmpty => "DirectoryNotEmpty"
      | =CrossesDevices => "CrossesDevices"
      | "Other"
    }
    "{name}: {m}"
  },
]
