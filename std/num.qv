// Unified numeric arithmetic over integers, exact rationals, and single-radical surds.
//
// A *number* is one of:
//
//   - a bare integer (`'int`)
//   - an exact rational `Rational['int, 'int]` in canonical form (denominator positive,
//     gcd 1)
//   - a single-radical surd `Surd[a, b, n]` denoting `a + b·√n`, where `a` and `b` are
//     int-or-rational coefficients (`b ≠ 0`) and `n` is a square-free integer `> 1`.
//
// This is the field ℚ(√n) for one radical at a time — enough for √2, the golden ratio
// φ = (1 + √5)/2, and the quadratic formula. **Different radicals are not mixed**: an
// operation whose operands carry incompatible radicals (e.g. `√2 · √3`, or comparing
// `√2` with `√3`) fails to nil. (Lifting that restriction — the full q₀ + Σqᵢ√nᵢ field —
// is a later rung; it needs multi-radical normalization, numeric-refinement ordering, and
// 2ᵏ-conjugate division.)
//
// Kind is a property of representation, mirroring rung 0: integers stay integers under
// `add`/`sub`/`mul`, and a rational is never silently lowered to an integer by the rational
// fast paths. Operations that involve a surd, however, collapse their result to the simplest
// exact form — `√2 · √2` is the integer `2`, and a surd whose `b` cancels to zero becomes a
// plain rational/integer.
'rational = Rational['int, 'int]
'coeff = 'int | 'rational
'surd = Surd['coeff, 'coeff, 'int]
' = 'coeff | 'surd

// A number that may be absent. The public arithmetic accepts `'opt` in every operand
// position and propagates nil: any operation with a nil operand evaluates to nil, so a nil
// produced upstream (e.g. division by zero, or `sqrt` of a negative) flows through a
// pipeline rather than crashing. The case tables keep this precise — an operation on
// operands that are statically non-nil infers a non-nil result, so nil only appears in the
// result type when it appears in an argument type.
'opt = ' | []

// --- Rational kernel (operands assumed int/rational, never surd) ---

// Reduce a rational to canonical form: denominator positive, gcd 1 (denominator non-zero).
reduce = #'rational {
  // The caller must supply a non-zero denominator; the result is always canonical form,
  // whose denominator is positive.
  :pre #{ $ ~> =Rational[_, ('int)d]; __integer_compare__ [d, 0] ~> { =0 => [] | Ok } }
  :post #{ $ ~> =(out: Rational[_, ('int)d]); __integer_compare__ [d, 0] ~> =1 }
  =Rational[n, d]
  {
    | __integer_compare__ [d, 0] ~> =-1 => ^ Rational[
      __integer_multiply__ [n, -1],
      __integer_multiply__ [d, -1],
    ]
    | {
      g = __integer_gcd__ [n, d]
      Rational[__integer_divide__ [n, g], __integer_divide__ [d, g]]
    }
  }
}

// Lower a coefficient to its simplest form: an integral rational becomes a bare integer.
// Used for surd coefficients and for surd results that collapse to a pure rational/integer.
lower = #'coeff { =Rational[n, 1] => n | =x => x }

// Lift an int/rational to a rational; pass a rational through unchanged.
to_rational = #'coeff {
  | =Rational[n, d] => Rational[n, d]
  | =n => Rational[n, 1]
}

// Sign of a canonical rational (-1/0/1); the denominator is positive by invariant.
rsign = #'rational { =Rational[n, _] => __integer_compare__ [n, 0] }

// Negate a rational.
rneg = #'rational { =Rational[n, d] => reduce Rational[__integer_multiply__ [n, -1], d] }

// Rational arithmetic on two canonical rationals, each returning a reduced rational.
radd = #['rational, 'rational] {
  =[Rational[a, b], Rational[c, d]]
  reduce Rational[
    __integer_add__ [__integer_multiply__ [a, d], __integer_multiply__ [c, b]],
    __integer_multiply__ [b, d],
  ]
}
rsub = #['rational, 'rational] {
  =[Rational[a, b], Rational[c, d]]
  reduce Rational[
    __integer_subtract__ [__integer_multiply__ [a, d], __integer_multiply__ [c, b]],
    __integer_multiply__ [b, d],
  ]
}
rmul = #['rational, 'rational] {
  =[Rational[a, b], Rational[c, d]]
  reduce Rational[__integer_multiply__ [a, c], __integer_multiply__ [b, d]]
}
// Rational quotient assuming a non-zero divisor (the caller guarantees it).
rquot = #['rational, 'rational] {
  =[Rational[a, b], Rational[c, d]]
  reduce Rational[__integer_multiply__ [a, d], __integer_multiply__ [b, c]]
}

// Compare two canonical rationals, returning -1, 0, or 1 (cross-multiplied; denominators
// positive by invariant, so the sign of the comparison is preserved).
rcompare = #['rational, 'rational] {
  =[Rational[a, b], Rational[c, d]]
  __integer_compare__ [__integer_multiply__ [a, d], __integer_multiply__ [c, b]]
}

// --- Surd kernel ---

// Largest square divisor: `n = k²·m` with `m` square-free. Called as `[1, n, 2] sqfree`
// for `n > 0`; pure trial division (O(√n)).
sqfree = #['int, 'int, 'int] {
  =[k, m, d]
  {
    | __integer_compare__ [__integer_multiply__ [d, d], m] ~> =1 => [k, m]
    | __integer_modulo__ [m, __integer_multiply__ [d, d]] ~> =0 => ^ [
        __integer_multiply__ [k, d],
        __integer_divide__ [m, __integer_multiply__ [d, d]],
        d,
      ]
    | ^ [k, m, __integer_add__ [d, 1]]
  }
}

// Expand a number to `[a, b, n]` (rational a, rational b, radical n); a pure rational is
// `[a, 0, 1]`. The inverse of `build`.
explode = #' {
  | =Surd[a, b, n] => [to_rational a, to_rational b, n]
  | =r => [to_rational r, Rational[0, 1], 1]
}

// The radical shared by two operands, or nil if they carry different (incompatible) radicals.
// An operand with a zero surd coefficient (a pure rational) defers to the other's radical.
radical = #['rational, 'int, 'rational, 'int] {
  =[b1, n1, b2, n2]
  {
    | rsign b1 ~> =0 => n2
    | rsign b2 ~> =0 => n1
    | __integer_compare__ [n1, n2] ~> =0 => n1
    | []
  }
}

// Build a canonical number from `[a, b, n]`, collapsing to the simplest representation:
// `√1` folds into the rational part, a zero `b` yields a plain rational/integer, and
// integral coefficients are lowered.
build = #['rational, 'rational, 'int] {
  =[a, b, n]
  {
    | __integer_compare__ [n, 1] ~> =0 => radd [a, b] ~> lower
    | rsign b ~> =0 => lower a
    | Surd[lower a, lower b, n]
  }
}

// Sign (-1/0/1) of `a + b·√n` for rational a, b and square-free `n > 1`. When the rational
// and surd parts have opposing signs the decision reduces to comparing `a²` with `b²·n`.
ssign = #['rational, 'rational, 'int] {
  =[a, b, n]
  sb = rsign b
  {
    | __integer_compare__ [sb, 0] ~> =0 => rsign a
    | {
      a2 = rmul [a, a]
      b2n = rmul [rmul [b, b], Rational[n, 1]]
      dsign = rcompare [a2, b2n]
      sa = rsign a
      {
        | __integer_compare__ [sb, 0] ~> =1 => {
          | __integer_compare__ [sa, 0] ~> =-1 => __integer_multiply__ [dsign, -1]
          | 1
        }
        | {
          | __integer_compare__ [sa, 0] ~> =1 => dsign
          | -1
        }
      }
    }
  }
}

// Surd-aware binary operations. At least one operand is a surd; mixed radicals fail to nil
// (`[...] radical` returns nil and the re-emitted `n` short-circuits the whole chain).
surd_add = #[', '] {
  =[x, y]
  explode x ~> =[a1, b1, n1]
  explode y ~> =[a2, b2, n2]
  radical [b1, n1, b2, n2] ~> =('int)n
  build [radd [a1, a2], radd [b1, b2], n]
}
surd_sub = #[', '] {
  =[x, y]
  explode x ~> =[a1, b1, n1]
  explode y ~> =[a2, b2, n2]
  radical [b1, n1, b2, n2] ~> =('int)n
  build [rsub [a1, a2], rsub [b1, b2], n]
}
// (a₁ + b₁√n)(a₂ + b₂√n) = (a₁a₂ + b₁b₂·n) + (a₁b₂ + a₂b₁)√n.
surd_mul = #[', '] {
  =[x, y]
  explode x ~> =[a1, b1, n1]
  explode y ~> =[a2, b2, n2]
  radical [b1, n1, b2, n2] ~> =('int)n
  build [
    radd [rmul [a1, a2], rmul [rmul [b1, b2], Rational[n, 1]]],
    radd [rmul [a1, b2], rmul [a2, b1]],
    n,
  ]
}
// Multiply by the conjugate: divide by `a₂ + b₂√n` via the rational denominator a₂² − b₂²·n.
surd_div = #[', '] {
  =[x, y]
  explode x ~> =[a1, b1, n1]
  explode y ~> =[a2, b2, n2]
  radical [b1, n1, b2, n2] ~> =('int)n

  dd = rsub [rmul [a2, a2], rmul [rmul [b2, b2], Rational[n, 1]]]

  {
    | rsign dd ~> =0 => []
    | build [
      rquot [
        rsub [rmul [a1, a2], rmul [rmul [b1, b2], Rational[n, 1]]],
        dd,
      ],
      rquot [rsub [rmul [b1, a2], rmul [a1, b2]], dd],
      n,
    ]
  }
}
surd_compare = #[', '] {
  =[x, y]
  explode x ~> =[a1, b1, n1]
  explode y ~> =[a2, b2, n2]
  radical [b1, n1, b2, n2] ~> =('int)n
  ssign [rsub [a1, a2], rsub [b1, b2], n]
}

// Compare two numbers, returning -1/0/1 (or nil for incomparable mixed radicals). Integers
// and rationals keep the bare-`__integer_compare__` fast paths (no allocation), as in hot-loop use.
compare = #['opt, 'opt] {
  | =[[], _] => []
  | =[_, []] => []
  | =[Surd[a, b, n], y] => surd_compare [Surd[a, b, n], y]
  | =[x, Surd[a, b, n]] => surd_compare [x, Surd[a, b, n]]
  | =[Rational[a, b], y] => rcompare [Rational[a, b], to_rational y]
  | =[x, Rational[c, d]] => rcompare [to_rational x, Rational[c, d]]
  | =[x, y] => __integer_compare__ [x, y]
}

// Truncate toward zero to a bare integer. For a surd `a + b√n`, work with `|v|` (so the
// floor is non-negative): clear denominators to `(P + Q√n)/D` with `D > 0`, bound the
// (irrational) numerator between consecutive integers using the exact integer √ of `Q²·n`,
// and floor-divide that bound by `D` — then reapply the sign. Exact, with one integer √. Lives
// at the top level (rather than only in the record) so `floor`/`ceil`/`round` can reuse it.
to_int = #'opt {
  :doc "Truncates a number toward zero to an integer; nil for a nil operand."
  | =Surd[a, b, n] => {
    ar = to_rational a
    br = to_rational b
    ssign [ar, br, n] ~> =sgn
    {
      | __integer_compare__ [sgn, 0] ~> =-1 => [rneg ar, rneg br]
      | [ar, br]
    } ~> =[Rational[pa, qa], Rational[pb, qb]]
    p = __integer_multiply__ [pa, qb]
    q = __integer_multiply__ [pb, qa]
    d = __integer_multiply__ [qa, qb]

    s =
      __integer_multiply__ [__integer_multiply__ [q, q], n] ~> __integer_sqrt__

    nlo = {
      | __integer_compare__ [q, 0] ~> =1 => __integer_add__ [p, s]
      | __integer_subtract__ [p, __integer_add__ [s, 1]]
    }
    __integer_multiply__ [sgn, __integer_divide__ [nlo, d]]
  }
  | ='coeff => { to_rational $ ~> =Rational[m, d]; __integer_divide__ [m, d] }
}

// Sign of a number: -1, 0, or 1 (nil for a nil operand).
sign = #'opt {
  :doc "The sign of a number: -1, 0, or 1; nil for a nil operand."
  compare [$, 0]
}

// Smaller / larger of two numbers (nil if either operand is nil).
min = #['opt, 'opt] {
  :doc "The smaller of two numbers; nil when either operand is nil."
  | =([[], _] | [_, []]) => []
  | compare ~> =1 => $1
  | $0
}
max = #['opt, 'opt] {
  :doc "The larger of two numbers; nil when either operand is nil."
  | =([[], _] | [_, []]) => []
  | compare ~> =-1 => $1
  | $0
}

// Clamp x to the range [lo, hi] (nil if any operand is nil).
clamp = #['opt, 'opt, 'opt] {
  :doc "Clamps a number to the range from lo to hi; nil when any operand is nil."
  // The caller must give a non-empty range (`lo ≤ hi`); the result then lies within it.
  // Comparisons that are nil (a nil operand, or incompatible surds) can't witness a
  // breach, so they pass — the checks only fire on a definite ordering violation.
  :pre #{ $ ~> =[_, lo, hi]; compare [lo, hi] ~> { =1 => [] | Ok } }
  :post #{
    $ ~> =[in: [_, lo, hi], out: o]
    o ~> {
      | =[] => Ok
      | =v => { compare [lo, v] ~> { =1 => [] | Ok }; compare [v, hi] ~> { =1 => [] | Ok } }
    }
  }
  | =([[], _, _] | [_, [], _] | [_, _, []]) => []
  | =[x, lo, hi] => {
    | compare [x, lo] ~> =-1 => lo
    | compare [x, hi] ~> =1 => hi
    | x
  }
}

// Floor / ceil to a bare integer (nil for a nil operand). Built on the toward-zero `to_int`,
// nudging by one when the truncation sits on the wrong side of x. The nudge is only reached
// for a non-nil operand, so nil flows straight through.
floor = #'opt {
  :doc "The largest integer not greater than the number; nil for a nil operand."
  to_int $ ~> =('int)t
  {
    | compare [$, t] ~> =-1 => __integer_subtract__ [t, 1]
    | t
  }
}
ceil = #'opt {
  :doc "The smallest integer not less than the number; nil for a nil operand."
  to_int $ ~> =('int)t
  {
    | compare [$, t] ~> =1 => __integer_add__ [t, 1]
    | t
  }
}

// Round to the nearest integer, halves away from zero (nil for a nil operand). Compares x with
// the midpoint `floor(x) + 1/2` (an exact rational), so no tower arithmetic is needed; a tie
// (only possible for a rational x) breaks away from zero by the sign of the floor.
round = #'opt {
  :doc "Rounds to the nearest integer, halves away from zero; nil for a nil operand."
  | =[] => []
  | floor ~> =('int)f => {
    mid = f ~> __integer_multiply__ [~, 2] ~> __integer_add__ [~, 1] ~> Rational[~, 2]
    {
      | compare [$, mid] ~> =1 => __integer_add__ [f, 1]
      | compare [$, mid] ~> =-1 => f
      | __integer_compare__ [f, 0] ~> =-1 => f
      | __integer_add__ [f, 1]
    }
  }
}

// --- the `%num{ … }` dialect -------------------------------------------------------
// Infix arithmetic over this module's own exports: `%num{ x + (y / 2) * ~ }`. Operands
// are integers, parenthesized groups, and host *terms* — a variable, `~`, a field
// access… — located by the host's `term` prefix-parser and spliced as an `Unquote`,
// evaluated in the caller's scope with the dialect term's flowing value as input. A
// term rather than a chain, so ` - 1` after an operand stays an operator, not a further
// term. `+ - * /` map to `add`/`sub`/`mul`/`div` and unary `-` to `neg`, with the usual
// precedence. Built from `%parse` combinators (`chainl` per precedence level) and the
// `%meta` constructors.

'dexpr = '%meta.expr

d_add = #['dexpr, 'dexpr] { %meta.call2 ["add", $0, $1] }
d_sub = #['dexpr, 'dexpr] { %meta.call2 ["sub", $0, $1] }
d_mul = #['dexpr, 'dexpr] { %meta.call2 ["mul", $0, $1] }
d_div = #['dexpr, 'dexpr] { %meta.call2 ["div", $0, $1] }

// Operator parsers: leading whitespace, the symbol, yielding the combining function.
d_add_op = {
  plus = %parse.map [%parse.byte [43, "'+'"], #{ &d_add }]

  minus = %parse.map [%parse.byte [45, "'-'"], #{ &d_sub }]

  ops = %parse.alt2 [&plus, &minus]
  %parse.right [&%parse.ws, &ops]
}

d_mul_op = {
  times = %parse.map [%parse.byte [42, "'*'"], #{ &d_mul }]

  divide = %parse.map [%parse.byte [47, "'/'"], #{ &d_div }]

  ops = %parse.alt2 [&times, &divide]
  %parse.right [&%parse.ws, &ops]
}

// One host term as an operand: the host prefix-parser answers the exclusive end offset
// of the term starting exactly at the state's position, and its span is spliced.
d_term = #'%meta.cb {
  =cb
  #'%parse {
    =st
    cb [st.data, st.pos] ~> {
      | =('int)end => [
        Unquote[offset: st.pos, length: __integer_subtract__ [end, st.pos]],
        st ~> ~[..., pos: end],
      ]
      | %parse.fail [st.pos, "an expression"]
    }
  }
}

// The two precedence levels over a factor parser.
d_expr_of = #'%parse.p<'dexpr> {
  =factor; term = %parse.chainl [&factor, &d_mul_op]; %parse.chainl [&term, &d_add_op]
}

// The factor grammar, self-passed (together with the host-term operand parser) to tie
// the factor↔parenthesized-expression recursion. Alternative order matters: the
// dialect's own parens and number literals first, the host term last.
d_factor_step = #[#^ -> (['dexpr, '%parse] | []), '%parse.p<'dexpr>, '%parse] {
  =[self, term, st]
  factor = #'%parse { self [&self, &term, $] }
  expr = d_expr_of &factor

  n1 = %parse.right [%parse.byte [45, "'-'"], &factor]

  neg = %parse.map [&n1, #{ Call[member: "neg", arg: $] }]

  close = %parse.right [&%parse.ws, %parse.byte [41, "')'"]]

  p1 = %parse.right [%parse.byte [40, "'('"], &expr]

  paren = %parse.left [&p1, &close]

  core = %parse.alt4 [&paren, &%parse.int, &neg, &term]

  core_ws = %parse.right [&%parse.ws, &core]
  core_ws st
}

num_dialect = #(content: Str['bin], term: '%meta.cb) {
  $ ~> =(content, term: cb)
  host_term = d_term &cb
  factor = #'%parse { d_factor_step [&d_factor_step, &host_term, $] }
  expr = d_expr_of &factor
  full = %parse.left [&expr, &%parse.ws]
  %parse.run [content, &full]
}

[
  numer: #'opt {
    :doc "The numerator of a rational, or the integer itself; nil for a surd or nil operand."
    | =Surd[a, b, n] => []
    | =Rational[n, _] => n
    | ='int => $
  },
  denom: #'opt {
    :doc "The denominator of a rational, or 1 for an integer; nil for a surd or nil operand."
    | =Surd[a, b, n] => []
    | =Rational[_, d] => d
    | ='int => 1
  },

  // Exact non-negative square root of an int/rational, producing a rational (perfect square)
  // or a surd. Negative input and surd input fail to nil (surd denesting is out of scope).
  sqrt: #'opt {
    :doc "The exact square root, as a rational or surd; nil on negative or surd input."
    | =Surd[a, b, n] => []
    | ='coeff => {
      to_rational $ ~> =Rational[p, q]
      {
        | __integer_compare__ [p, 0] ~> =-1 => []
        | __integer_compare__ [p, 0] ~> =0 => 0
        | {
          sqfree [1, __integer_multiply__ [p, q], 2] ~> =[k, m]

          build [Rational[0, 1], reduce Rational[k, q], m]
        }
      }
    }
  },

  // add/sub/mul dispatch inline so the integer/rational fast paths keep their case tables
  // (`[int, int]` infers `'int`, a rational operand infers `Rational`); surd operands route
  // to the surd kernel and infer the full `'%num` union.
  add: #['opt, 'opt] {
    :doc "Adds two numbers exactly; nil on a nil operand or mixed radicals."
    | =([[], _] | [_, []]) => []
    | =[Surd[a, b, n], y] => surd_add [Surd[a, b, n], y]
    | =[x, Surd[a, b, n]] => surd_add [x, Surd[a, b, n]]
    | =[Rational[a, b], y] => radd [Rational[a, b], to_rational y]
    | =[x, Rational[c, d]] => radd [to_rational x, Rational[c, d]]
    | =[a, b] => __integer_add__ [a, b]
  },
  sub: #['opt, 'opt] {
    :doc "Subtracts the second number from the first exactly; nil on a nil operand or mixed radicals."
    | =([[], _] | [_, []]) => []
    | =[Surd[a, b, n], y] => surd_sub [Surd[a, b, n], y]
    | =[x, Surd[a, b, n]] => surd_sub [x, Surd[a, b, n]]
    | =[Rational[a, b], y] => rsub [Rational[a, b], to_rational y]
    | =[x, Rational[c, d]] => rsub [to_rational x, Rational[c, d]]
    | =[a, b] => __integer_subtract__ [a, b]
  },
  mul: #['opt, 'opt] {
    :doc "Multiplies two numbers exactly; nil on a nil operand or mixed radicals."
    | =([[], _] | [_, []]) => []
    | =[Surd[a, b, n], y] => surd_mul [Surd[a, b, n], y]
    | =[x, Surd[a, b, n]] => surd_mul [x, Surd[a, b, n]]
    | =[Rational[a, b], y] => rmul [Rational[a, b], to_rational y]
    | =[x, Rational[c, d]] => rmul [to_rational x, Rational[c, d]]
    | =[a, b] => __integer_multiply__ [a, b]
  },

  // Division. With surd operands, rationalize; otherwise exact rational division (always a
  // rational, nil on divide-by-zero).
  div: #['opt, 'opt] {
    :doc "Divides exactly; nil on a zero divisor, nil operand, or mixed radicals."
    | =([[], _] | [_, []]) => []
    | =[Surd[a, b, n], y] => surd_div [Surd[a, b, n], y]
    | =[x, Surd[a, b, n]] => surd_div [x, Surd[a, b, n]]
    | =[x, y] => {
      to_rational x ~> =Rational[a, b]
      to_rational y ~> =Rational[c, d]
      {
        | c ~> =0 => []
        | reduce Rational[__integer_multiply__ [a, d], __integer_multiply__ [b, c]]
      }
    }
  },

  // Negation preserves kind: integer stays integer, rational stays rational, surd stays surd.
  neg: #'opt {
    :doc "Negates a number, preserving its kind; nil for a nil operand."
    | =Surd[a, b, n] => build [to_rational a ~> rneg, to_rational b ~> rneg, n]
    | =Rational[m, d] => reduce Rational[__integer_multiply__ [m, -1], d]
    | ='int => __integer_multiply__ [$, -1]
  },

  // Absolute value, preserving kind.
  abs: #'opt {
    :doc "The absolute value of a number, preserving its kind; nil for a nil operand."
    // The result is never negative (nil passes through).
    :post #{ $ ~> =(out: o); o ~> { =[] => Ok | sign ~> { =-1 => [] | Ok } } }
    | =Surd[a, b, n] => {
      ar = to_rational a
      br = to_rational b
      {
        | ssign [ar, br, n] ~> =-1 => build [rneg ar, rneg br, n]
        | Surd[a, b, n]
      }
    }
    | =Rational[m, d] => Rational[__integer_abs__ m, d]
    | ='int => __integer_abs__ $
  },

  // Truncate toward zero / round toward ∓∞ / round to nearest, each to a bare integer. See the
  // top-level bindings of the same names.
  to_int: &to_int,
  floor: &floor,
  ceil: &ceil,
  round: &round,

  // Sign (-1/0/1), and the smaller/larger/clamped of numbers.
  sign: &sign,
  min: &min,
  max: &max,
  clamp: &clamp,

  eq?: #['opt, 'opt] {
    :doc "Whether two numbers are equal."
    compare ~> =0; Ok
  },
  lt?: #['opt, 'opt] {
    :doc "Whether the first number is less than the second."
    compare ~> =-1; Ok
  },
  le?: #['opt, 'opt] {
    :doc "Whether the first number is at most the second."
    compare ~> { =-1 | =0 }; Ok
  },
  gt?: #['opt, 'opt] {
    :doc "Whether the first number is greater than the second."
    compare ~> =1; Ok
  },
  ge?: #['opt, 'opt] {
    :doc "Whether the first number is at least the second."
    compare ~> { =0 | =1 }; Ok
  },
] ~> { :dialect &num_dialect }
