' = Range['int, ('int | None), 'int]

[
  to: #'int {
    :doc "A range from 0 up to the given stop (exclusive), stepping by 1."
    Range[0, ~, 1]
  },

  from: #'int {
    :doc "A range from the given start, unbounded above, stepping by 1."
    Range[~, None, 1]
  },

  between: #['int, 'int] {
    :doc "A range from the first integer up to the second (exclusive), stepping by 1."
    Range[..., 1]
  },

  new: #['int, ('int | None), 'int] {
    :doc "A range with the given start, stop (an integer, or None for unbounded), and step."
    Range[...]
  },

  // A `Range` is entirely integer-valued, so this generator runs once per yielded element
  // over the integer builtins directly (`__integer_compare__`/`__integer_add__`) rather than the polymorphic
  // `%num` dispatch — the same internal fast path `%num` itself takes for integer operands.
  iter: #' {
    :doc "An iterator over the range's integers, from start toward stop (exclusive) by step."
    %iter.unfold [
      ~,
      #' {
        =Range[value, stop, step]
        {
          | stop ~> =None
          | __integer_compare__ [step, 0] ~> =1; __integer_compare__ [value, stop] ~> =-1
          | __integer_compare__ [step, 0] ~> =-1; __integer_compare__ [value, stop] ~> =1
          | step ~> =0
        }
        [value, Range[__integer_add__ [value, step], stop, step]]
      },
    ]
  },
]
