// The browser HTTP transport: `%http/client`'s way onto the network when there are no
// sockets.
//
// A browser cannot open a TCP connection, so the whole exchange is one primitive —
// `__fetch__` — and this file has none of `transport.native.qv`'s machinery: no DNS step, no
// connect, no incremental parse. The browser has already done all of that by the time it
// answers.
//
// What it *does* have to do is put the answer back into the shared shape, so that
// `%http/client` above and `'%http.response` around it are the same on both hosts. Headers
// cross the builtin boundary as a raw CRLF block precisely so `%http`'s own parser can do it.
//
// Two asymmetries no code here can paper over, both the browser's rules rather than ours:
// CORS decides which response headers are readable at all, and the browser follows redirects
// itself — so the client's own redirect loop simply never fires.

// Drain the response body stream. It is the same `Data`/`Closed` shape a socket yields, so
// this is the ordinary select-and-accumulate loop.
drain = #[(body): \HttpBody, (acc): 'bin] {
  ![$body] ~> {
    | =Data[body: _, data: d] => ^ [$body, %bin.concat [$acc, d]]
    | =Closed[body: _] => $acc
  }
}

exchange = #[(url): '%url, (request): '%http] {
  =[url: u, request: r]
  __fetch__ [
    method: %http.method_name r.method ~> .0,
    url: %url.format u ~> .0,
    // The request's own Host header is dropped: the browser sets it from the URL and forbids
    // overriding it, so sending ours would be a silent no-op at best.
    headers: %http.headers_to_bytes r.headers,
    body: r.body,
  ] ~> =(status: status, headers: headers, body: body)

  // `%http` parses the header block, exactly as it would off a socket. The narrowing step is
  // load-bearing: without it a malformed block would put a nil *into* the response's headers
  // rather than failing the exchange.
  %http.headers_of headers ~> {
    | =('%http.pairs)pairs => pairs
    | [] ~> {
      :error IoError[kind: Other, message: "malformed response headers"]
    }
  } ~> =('%http.pairs)hs

  Response[status: status, headers: hs, body: drain [body, 0x]]
}

[
  request: &exchange ~> {
    :doc "Performs one HTTP exchange through the browser's fetch. Nil (carrying :error) on failure. Redirects are followed by the browser, and CORS decides which response headers are visible."
  },
]
