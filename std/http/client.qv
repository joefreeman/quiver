// The HTTP client, over the host's mediated exchange.
//
//   %http/client.get "https://example.com/thing" ~> =('%http.response & r)
//
// `__http_request__` performs one whole HTTP exchange, mediated by the host: a browser
// backs it with its `fetch` (which follows redirects itself and decides which response
// headers are visible), a native host backs it over its own sockets. Its signature is
// universal, so this module is one code path on every host; it owns what is the same
// either way — URL handling, the request process, timeouts, redirect following where the
// mediator surfaces redirects, and the response's shared shape. A caller that needs
// socket-level control (custom trust anchors, proxies, the request line itself) goes
// through `%http/tcp` instead.
//
// **Every request runs in its own process**, redirects included. That is not ceremony:
//
//   - it is the only way to bound a request, since a parked effect cannot be raced against
//     a clock, but a process can be given a deadline (`%proc.expire`) — one deadline for
//     the whole request, however many redirects it follows;
//   - the response body stream is created *inside* that process, so a mid-request failure
//     that short-circuits still releases it — process teardown closes what the process
//     owned;
//   - and the handle never escapes, so there is no ownership question to answer.
//
// A failed request answers nil, carrying the reason: `:error` from the exchange
// (connection refused, DNS, a truncated body), `:timeout` when the deadline won, or
// `:crash` if the exchange itself died.

// Whether a status redirects, and whether the method survives it. 303 always becomes GET;
// 301 and 302 do too for anything but GET/HEAD, which is what every client does in practice
// whatever the RFC once said; 307 and 308 exist precisely to preserve the method.
'follow = Keep | ToGet

redirect_of = #[(status): 'int, (method): '%http.method] {
  | $status ~> =303 => ToGet
  | $status ~> =(301 | 302) => {
    | $method ~> =(GET | HEAD) => Keep
    | ToGet
  }
  | $status ~> =(307 | 308) => Keep
  | NoFollow
}

// Drain the response body: the ordinary select-and-accumulate loop over a `+ByteStream`.
// A failed read answers nil carrying `:error`, and the binding gates on it — the failure
// propagates out of the exchange rather than passing off a truncated body as the whole
// one. Only a clean `Closed` means the accumulator holds everything.
drain = #[(stream): +ByteStream, (acc): 'bin] {
  event = !$stream
  event ~> {
    | =Data[stream: _, data: d] => ^ [$stream, %bin.concat [$acc, d]]
    | =Closed[stream: _] => $acc
  }
}

// One exchange, put back into the shared shape. The Host header is the mediator's: native
// adds the URL's authority when the caller supplied none, and a browser sets its own and
// forbids overriding it.
exchange = #[(url): '%url, (method): '%http.method, (headers): '%http.pairs, (body): 'bin] {
  __http_request__ [
    method: %http.method_name $method ~> .0,
    url: %url.format $url ~> .0,
    headers: %http.headers_to_bytes $headers,
    body: $body,
  ]
  ~> =(status: status, headers: headers, body: body)

  // `%http` parses the header block, exactly as it would off a socket. The narrowing step
  // is load-bearing: without it a malformed block would put a nil *into* the response's
  // headers rather than failing the exchange.
  %http.headers_of headers ~> {
    | =('%http.pairs & pairs) => pairs
    | [] ~> { :error IoError[kind: Other, message: "malformed response headers"] }
  }
  ~> =('%http.pairs & hs)

  drain [body, <>] ~> =('bin & content)
  Response[status: status, headers: hs, body: content]
}

// The redirect loop — which only turns where the mediator surfaces redirects (native); a
// browser has already followed them by the time it answers, so this simply never fires
// there. `left` bounds it; exhausting it answers the redirect itself rather than failing,
// so a caller can see what it was pointed at.
follow_loop = #[
  (url): '%url,
  (method): '%http.method,
  (headers): '%http.pairs,
  (body): 'bin,
  (left): 'int,
] {
  exchange [$url, $method, $headers, $body] ~> =('%http.response & resp)

  {
    | __integer_compare__ [$left, 0] ~> =1
      redirect_of [resp.status, $method] ~> =('follow & kind)
      %http.header [resp.headers, "location"] ~> =('%str & location)
      %url.resolve [$url, location] ~> =('%url & next) => {
        // A method-changing redirect drops the body with the method: a GET with a payload is
        // meaningless, and forwarding it would resend a POST's data to a new target.
        method = { kind ~> =ToGet => GET | $method }
        body = { kind ~> =ToGet => <> | $body }
        ^ [next, method, $headers, body, __integer_subtract__ [$left, 1]]
      }
    | resp
  }
}

// The whole request in its own process, under one deadline. An expiry is reported as
// `:timeout`, as a select's timeout is, rather than as the kill that enforced it.
bounded = #[
  (url): '%url,
  (method): '%http.method,
  (headers): '%http.pairs,
  (body): 'bin,
  (timeout): 'int,
  (redirects): 'int,
] {
  u = $url
  m = $method
  hs = $headers
  b = $body
  left = $redirects
  p = @[] { follow_loop [u, m, hs, b, left] } []
  %proc.expire [p, $timeout]
  r = !p
  {
    | r:crash<'%proc.crash> ~> =Killed[reason: Timeout[ms]] => [] ~> { :timeout ms }
    | r ~> =_
  }
}

[
  request: #[
    (url): '%str,
    method: '%http.method = GET,
    headers: '%http.pairs = Nil,
    body: 'bin = <>,
    timeout: 'int = 30000,
    redirects: 'int = 5,
  ] {
    :doc "Performs a request, following redirects. The timeout is a deadline for the whole request, redirects included. Nil on failure, carrying :error (exchange), :timeout (deadline) or :crash (the exchange died)."
    %url.parse $url ~> =('%url & u); bounded [u, $method, $headers, $body, $timeout, $redirects]
  },

  get: #'%str {
    :doc "A GET for the URL, with default headers and timeout."
    %url.parse $ ~> =('%url & u); bounded [u, GET, Nil, <>, 30000, 5]
  },

  head: #'%str {
    :doc "A HEAD for the URL, with default headers and timeout."
    %url.parse $ ~> =('%url & u); bounded [u, HEAD, Nil, <>, 30000, 5]
  },

  post: #[(url): '%str, (body): 'bin, headers: '%http.pairs = Nil] {
    :doc "A POST of the body to the URL, with the default timeout."
    %url.parse $url ~> =('%url & u); bounded [u, POST, $headers, $body, 30000, 5]
  },
]
