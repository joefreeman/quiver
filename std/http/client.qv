// The HTTP client: everything above the transport.
//
//   http = %http/client.with %http/transport
//   http.get "https://example.com/thing" ~> =('%http.response)r
//
// The transport is injected rather than imported, because *which* one exists depends on the
// host — native builds HTTP over TCP, a browser can only go through `fetch` — and this
// module must name neither primitive. It owns the parts that are the same either way: the
// Host header, the request process, timeouts, and redirect following.
//
// **Every request runs in its own process.** That is not ceremony:
//
//   - it is the only way to bound a request, since a parked effect is not a select source,
//     so `![p, timeout]` is the sole route to a timeout;
//   - a socket opened by the transport is created *inside* that process, so a mid-request
//     failure that short-circuits still releases it — process teardown closes what the
//     process owned;
//   - and the handle never escapes, so there is no ownership question to answer.
//
// A failed request answers nil, carrying the reason: `:error` from the transport (connection
// refused, DNS), `:timeout` when the deadline won, or `:crash` if the transport itself died.

// Whether a status redirects, and whether the method survives it. 303 always becomes GET;
// 301 and 302 do too for anything but GET/HEAD, which is what every client does in practice
// whatever the RFC once said; 307 and 308 exist precisely to preserve the method.
'follow = Keep | ToGet

redirect_of = #[(status): 'int, (method): '%http.method] {
  | $status ~> =303 => ToGet
  | $status ~> =(301 | 302) => {
    | $method ~> =(GET | HEAD) => Keep
    | ToGet
  }
  | $status ~> =(307 | 308) => Keep
  | NoFollow
}

// One request/response exchange, in its own process, bounded by `timeout`.
attempt = #[(transport): '%http.transport, (url): '%url, (method): '%http.method, (headers): '%http.pairs, (body): 'bin, (timeout): 'int] {
  // Host is the client's to add: the request line carries only the target, and `%http` never
  // sees the authority. A caller that supplied its own wins, since lookup takes the first.
  hs = %list.prepend [$headers, ["host", %url.authority $url]]
  req = %http.request [method: $method, target: %url.target $url, headers: hs, body: $body]
  t = $transport
  u = $url
  ![@{ t.request [url: u, request: req] }, $timeout]
}

// The redirect loop. `left` bounds it; exhausting it answers the redirect itself rather than
// failing, so a caller can see what it was pointed at.
follow_loop = #[(transport): '%http.transport, (url): '%url, (method): '%http.method, (headers): '%http.pairs, (body): 'bin, (timeout): 'int, (left): 'int] {
  attempt [$transport, $url, $method, $headers, $body, $timeout] ~> =('%http.response)resp
  {
    | __integer_compare__ [$left, 0] ~> =1
      redirect_of [resp.status, $method] ~> =('follow)kind
      %http.header [resp.headers, "location"] ~> =('%str)location
      %url.resolve [$url, location] ~> =('%url)next => {
      // A method-changing redirect drops the body with the method: a GET with a payload is
      // meaningless, and forwarding it would resend a POST's data to a new target.
      method = { kind ~> =ToGet => GET | $method }
      body = { kind ~> =ToGet => 0x | $body }
      ^ [$transport, next, method, $headers, body, $timeout, __integer_subtract__ [$left, 1]]
    }
    | resp
  }
}

// A client over a given transport. Only ever applied to the host's own, just below — the
// indirection is what keeps this module from naming a primitive, not a seam for callers.
bind = #'%http.transport {
  transport = $
  [
    request: #[(url): '%str, method: '%http.method = GET, headers: '%http.pairs = Nil, body: 'bin = 0x, timeout: 'int = 30000, redirects: 'int = 5] {
      :doc "Performs a request, following redirects. Nil on failure, carrying :error (transport), :timeout (deadline) or :crash (the transport died)."
      %url.parse $url ~> =('%url)u
      follow_loop [transport, u, $method, $headers, $body, $timeout, $redirects]
    },

    get: #'%str {
      :doc "A GET for the URL, with default headers and timeout."
      %url.parse $ ~> =('%url)u; follow_loop [transport, u, GET, Nil, 0x, 30000, 5]
    },

    head: #'%str {
      :doc "A HEAD for the URL, with default headers and timeout."
      %url.parse $ ~> =('%url)u
      follow_loop [transport, u, HEAD, Nil, 0x, 30000, 5]
    },

    post: #[(url): '%str, (body): 'bin, headers: '%http.pairs = Nil] {
      :doc "A POST of the body to the URL, with the default timeout."
      %url.parse $url ~> =('%url)u
      follow_loop [transport, u, POST, $headers, $body, 30000, 5]
    },
  ]
}

// The host's transport, resolved by the import: native builds HTTP over TCP, a browser will
// supply one over `fetch`. This module names neither, which is the whole point.
host = bind %http/transport

(host.request, host.get, host.head, host.post)
