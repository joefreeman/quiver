// One HTTP/1.1 exchange over a TCP socket, in Quiver all the way down: resolve, connect,
// upgrade to TLS for `https://`, serialize, read until the response parses, close.
//
// `%http/client` does not run over this — the host's mediated `__http_request__` performs
// its exchanges — but socket-level control has uses the mediated door cannot serve: trust
// anchors of your own (via `%tls` directly), proxies, the request line itself. It is also
// the vocabulary's proof: the same `%http` codecs this speaks are what `%http/server`
// answers with.
//
// It expects to run inside a caller's own process, so the socket it opens is owned there
// and released by teardown even when a failure short-circuits past the explicit close.

// Read until the buffer holds a whole response. An empty read is end-of-connection, which is
// what terminates a response framed by neither Content-Length nor chunking — and, if the
// response is still incomplete at that point, what makes it a truncation rather than a wait.
read_loop = #[(sock): \TcpSocket, (buf): 'bin] {
  %tcp.read [$sock, 8192] ~> =('bin)chunk
  eof = { %bin.length chunk ~> =0 => Ok | [] }
  buffer = %bin.concat [$buf, chunk]
  %http.parse_response [buffer, eof] ~> {
    | =[response, _] => response
    | =Bad[reason: r] => [] ~> { :error IoError[kind: Other, message: r] }
    | =Incomplete => {
      | eof ~> =Ok => [] ~> {
        :error IoError[kind: Other, message: "connection closed mid-response"]
      }
      | ^ [$sock, buffer]
    }
  }
}

// Open a connection of the kind the scheme calls for. TLS verifies against the host's default
// anchors; a caller needing its own would go through `%tls` directly.
open = #'%url {
  %tcp.connect [$host, $port] ~> =(\TcpSocket)sock
  $scheme ~> {
    | ="http" => sock
    | ="https" => %tls.attach [socket: sock, hostname: $host]
    | [] ~> { :error IoError[kind: Other, message: "unsupported scheme: {$scheme}"] }
  }
}

exchange = #[(url): '%url, (request): '%http] {
  // A request without a Host header gains the URL's authority — an HTTP/1.1 request
  // without one is rejected by most servers; a caller's own wins, since lookup takes the
  // first.
  hs = {
    | %http.header [$request.headers, "host"] ~> ='%str => $request.headers
    | %list.prepend [$request.headers, ["host", %url.authority $url]]
  }
  open $url ~> =(\TcpSocket)sock
  %tcp.write [sock, %http.serialize_request $request[..., headers: hs]]

  // Bound with a bare binder rather than a narrowing one: a failed read must still reach the
  // close below, and the annotated nil is what this answers.
  response = read_loop [sock, <>]
  // Discard the close's own result — a close failure must not lose a response we already
  // have, and teardown is the backstop either way.
  { %tcp.close sock; Ok | Ok }
  response
}

[
  request: exchange ~> {
    :doc "Performs one HTTP/1.1 exchange over TCP: resolve, connect, send, read the response, close. https:// upgrades the socket via %tls, verifying against the host's default anchors. A request lacking a Host header gains the URL's authority. Nil (carrying :error) on any failure."
  },
]
