// The HTTP server: a connection pump over the TCP builtins and a handler contract.
// A handler is a pure function from a request to a response —
// values in, values out, never the socket — so handlers are testable without a
// server and middleware is ordinary function composition.
//
//   handler = #'%http { ... routes ... }
//   [port: 4000, handler: &handler] %http/server.serve
//
// One process per connection, and one per request: the handler runs in its own
// process and is awaited, so a handler that *crashes* answers the same plain 500 as
// one that *fails* (returns nil) — `!` is never lethal (the crash arrives as a
// `:crash`-stamped nil), and the connection with its
// keep-alive survives both. Keep-alive is HTTP/1.1's default (`Connection: close`
// honored); responses are always Content-Length framed. `HEAD` answers like `GET`
// with the body bytes dropped.
//
// A handler may instead answer `Upgrade[handler: …]` — "switch this connection":
// the pump validates the WebSocket handshake, answers 101, and hands the socket to
// the upgrade handler as a `'%http/websocket` connection, in the connection's own
// process. The connection ends with that handler (a socket it leaves open is closed
// with the process); a request with no Sec-WebSocket-Key answers 400.
//
// HTTPS is the same server with a `tls:` option — a certificate chain and key, DER
// bytes as `%tls` takes them. Each accepted socket is upgraded in place in its own
// connection process (a slow handshake never stalls the accept loop), and the pump,
// websockets and live views run over it unchanged, since an upgraded socket reads,
// writes and selects in plaintext.

'request = '%http
'response = '%http.response
'upgrade = Upgrade[handler: #'%http/websocket -> (Ok | [])]
'handler = #'request -> ('response | 'upgrade | [])

// A plain-text response with the given status.
plain = #[(status): 'int, (body): '%str] {
  Response[
    status: $status,
    headers: %list{ ["content-type", "text/plain; charset=utf-8"] },
    body: $body.0,
  ]
}

// Whether the connection should be kept open after answering the request.
keep_alive? = #'request {
  | %http.header [$headers, "connection"] ~> =Str[cb]; %http.lower Str[cb] ~> ="close" => []
  | $version ~> ="HTTP/1.1" => Ok
  | []
}

// The connection pump: serve every complete request in the buffer, reading more only
// when the parse is incomplete; close on end-of-input, a malformed request, or a
// non-keep-alive exchange.
conn_loop = #[(sock): \TcpSocket, (handler): 'handler, (buf): 'bin] {
  %http.parse_request $buf ~> {
    | =Incomplete => {
      // A read failure ends the connection: the nil short-circuits out of the pump, the
      // connection process finishes, and teardown closes the socket it still owns.
      __tcp_socket_read__ [$sock, 8192] ~> =('bin)chunk
      {
        | %bin.length chunk ~> =0 => __tcp_socket_close__ $sock
        | ^ [$sock, &$handler, %bin.concat [$buf, chunk]]
      }
    }
    | =Bad[status: s, reason: r] => {
      out = plain [s, r] ~> %http.serialize_response
      __tcp_socket_write__ [$sock, out]
      __tcp_socket_close__ $sock
    }
    | =[req, rest] => {
      // Run the handler in its own process: a crash surfaces here as a stamped nil,
      // degrading to the 500 below exactly like a plain failed handler.
      hp = req ~> @$handler
      r = !hp
      {
        | r ~> =Upgrade[handler: wh] => {
          // "Switch this connection": answer the WebSocket handshake and hand the
          // socket over. The pump's job ends here — the connection process ends
          // with the upgrade handler, auto-closing a socket it leaves open. Any
          // bytes already read past the request seed the connection's buffer.
          | %http.header [req.headers, "sec-websocket-key"] ~> =Str[k] => {
              __tcp_socket_write__ [$sock, %http/websocket.handshake_response Str[k]]
              %http/websocket.conn [$sock, rest] ~> wh
            }
          | {
            out =
              plain [400, "Bad Request"] ~> %http.serialize_response

            __tcp_socket_write__ [$sock, out]
            __tcp_socket_close__ $sock
          }
        }
        | {
          resp = {
            | r ~> =('%http.response)ok => ok
            | plain [500, "Internal Server Error"]
          }
          resp2 = {
            | req.method ~> =HEAD => resp[
              ...,
              headers: %list.prepend [
                resp.headers,
                ["content-length", %bin.length resp.body ~> %str.from_int],
              ],
              body: 0x,
            ]
            | resp
          }
          __tcp_socket_write__ [$sock, %http.serialize_response resp2]
          {
            | keep_alive? req => ^ [$sock, &$handler, rest]
            | __tcp_socket_close__ $sock
          }
        }
      }
    }
  }
}

// The TLS material `serve` takes: the certificate chain (concatenated DER, leaf first) and
// its PKCS#8 DER private key, exactly as `%tls.accept` wants them.
'tls = [cert: 'bin, key: 'bin]

// A connection's whole life. With TLS material the socket is upgraded first, here in the
// connection's own process — a handshake that fails (or stalls until teardown) takes only
// this connection with it, and the socket is closed by the process ending either way.
conn = #[\TcpSocket, 'handler, ('tls | [])] {
  =[sock, h, t]
  {
    | t ~> =[cert: c, key: k] => %tls.accept [socket: sock, cert: c, key: k]
    | Ok
  }
  conn_loop [sock, &h, 0x]
}

// A failed accept ends the loop rather than spinning on a broken listener; the nil carries
// its `:error` out to `serve`'s caller.
accept_loop = #[(listener): \TcpListener, (handler): 'handler, (tls): ('tls | [])] {
  __tcp_listener_accept__ $listener ~> =(\TcpSocket)sock
  [sock, &$handler, $tls] ~> @conn
  ^ [$listener, &$handler, $tls]
}

serve = #[port: 'int, handler: 'handler, tls: ('tls | []) = []] {
  :doc "Serves HTTP on the port, one process per connection, each request answered by the handler (a nil result becomes a 500). With `tls:` ([cert, key] as %tls.accept takes them) each connection is upgraded first, serving HTTPS. Blocks forever; nil (with :error) if the listen or an accept failed."
  =[port: p, handler: h, tls: t]

  p
  ~> __tcp_listen__ [~, 128] ~> =(\TcpListener)listener

  accept_loop [listener, &h, t]
}

html = #<'e>'%html<'e> {
  :doc "A 200 text/html response of the rendered tree (no doctype — see `page`)."
  %html.render $ ~> =Str[b]
  Response[
    status: 200,
    headers: %list{ ["content-type", "text/html; charset=utf-8"] },
    body: b,
  ]
}

page = #<'e>'%html<'e> {
  :doc "A 200 text/html response of the doctype-prefixed rendered tree — a whole page."
  %html.page $ ~> =Str[b]
  Response[
    status: 200,
    headers: %list{ ["content-type", "text/html; charset=utf-8"] },
    body: b,
  ]
}

text = #'%str {
  :doc "A 200 text/plain response."
  plain [200, $]
}

json = #'%json {
  :doc "A 200 application/json response of the serialized value."
  %json.stringify $ ~> =Str[b]
  Response[status: 200, headers: %list{ ["content-type", "application/json"] }, body: b]
}

redirect = #'%str {
  :doc "A 303 See Other redirect to the location — the POST-then-redirect-to-GET idiom."
  Response[status: 303, headers: %list{ ["location", $] }, body: 0x]
}

not_found = #{
  :doc "A plain 404 response."
  plain [404, "Not Found"]
}

(serve, html, page, text, json, redirect, not_found)
