// The shared HTTP vocabulary: message types and codecs, pure data, no IO.
// `%http/server` builds the connection pump on these; a client and
// tests use the same records and parsers.
//
// The request parser is incremental — reads arrive in arbitrary chunks — answering
// `Incomplete` (read more), `Bad[status, reason]` (answer that status and close), or
// the parsed request plus the leftover bytes (the start of the next request on a
// keep-alive connection). Hardening is size limits, not timeouts: callers pass head
// and body caps and the parser fails fast.
//
// Headers, query parameters, and form fields all share one shape — an ordered list of
// `[name, value]` string pairs, duplicates preserved (`Set-Cookie` twice is two
// cookies; a repeated form field is a list). `header` looks up case-insensitively,
// `get` exactly.

'method = GET | HEAD | POST | PUT | DELETE | PATCH | OPTIONS | Other['%str]

'pairs = '%list<['%str, '%str]>
'segments = '%list<'%str>

' = Request[
  method: 'method,
  target: '%str,
  path: 'segments,
  query: 'pairs,
  version: '%str,
  headers: 'pairs,
  body: 'bin,
]

'response = Response[status: 'int, headers: 'pairs, body: 'bin]

'parsed = Incomplete | Bad[status: 'int, reason: '%str] | [', 'bin]

// ASCII-lowercased bytes (for case-insensitive names).
lower_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
    | {
      b = %bin.get_byte [$data, $pos]
      b2 = {
        | __integer_compare__ [b, 65] ~> =(0 | 1)
          __integer_compare__ [b, 90] ~> =(-1 | 0) => __integer_add__ [b, 32]
        | b
      }
      ^ [$data, __integer_add__ [$pos, 1], $len, %bin.append [$acc, b2, 1]]
    }
  }
}

lower = #'%str {
  :doc "The string with ASCII letters lowercased."
  =Str[b]; lower_loop [b, 0, %bin.length b, <>] ~> Str[~]
}

// The first value whose name matches case-insensitively, or nil.
header_find = #[(pairs): 'pairs, (target): 'bin] {
  %list.find [$pairs, #{ lower $0 ~> =Str[^$$target] }] ~> =[_, v]

  v
}

header = #[(pairs): 'pairs, (name): '%str] {
  :doc "The first value of a header by case-insensitive name, or nil when absent."
  lower $name ~> =Str[target]; header_find [$pairs, target]
}

get = #[(pairs): 'pairs, (name): '%str] {
  :doc "The first value for an exact name (query or form pairs), or nil when absent."
  %list.find [$pairs, #{ =[^$$name, _] }] ~> =[_, v]; v
}

// The numeric value of an ASCII hex digit, or nil.
hex_val = #'int {
  | __integer_compare__ [$, 48] ~> =(0 | 1)
    __integer_compare__ [$, 57] ~> =(-1 | 0) => __integer_subtract__ [$, 48]
  | __integer_compare__ [$, 97] ~> =(0 | 1)
    __integer_compare__ [$, 102] ~> =(-1 | 0) => __integer_add__ [__integer_subtract__ [$, 97], 10]
  | __integer_compare__ [$, 65] ~> =(0 | 1)
    __integer_compare__ [$, 70] ~> =(-1 | 0) => __integer_add__ [__integer_subtract__ [$, 65], 10]
}

// Percent-decode; `plus?` = 1 also turns `+` into a space (the urlencoded rule).
// An invalid escape passes through verbatim (lenient).
pct_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (plus?): 'int, (acc): 'bin] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
    | {
      b = %bin.get_byte [$data, $pos]
      {
        | b ~> =37

          __integer_compare__ [__integer_add__ [$pos, 2], $len] ~> =-1

          [$data, __integer_add__ [$pos, 1]]
          ~> %bin.get_byte ~
          ~> hex_val ~
          ~> =('int)h1

          [$data, __integer_add__ [$pos, 2]]
          ~> %bin.get_byte ~
          ~> hex_val ~
          ~> =('int)h2 => {
            decoded = __integer_add__ [__integer_multiply__ [h1, 16], h2]

            ^ [$data, __integer_add__ [$pos, 3], $len, $plus?, %bin.append [$acc, decoded, 1]]
          }
        | b ~> =43; $plus? ~> =1 => ^ [
            $data,
            __integer_add__ [$pos, 1],
            $len,
            $plus?,
            %bin.append [$acc, 32, 1],
          ]
        | ^ [$data, __integer_add__ [$pos, 1], $len, $plus?, %bin.append [$acc, b, 1]]
      }
    }
  }
}

pct_decode = #['bin, 'int] { pct_loop [$0, 0, %bin.length $0, $1, <>] }

// --- request-target decomposition -------------------------------------------------------

// Path segments, in order: one leading `/` stripped, one empty trailing segment dropped
// (`/posts/` ≡ `/posts`), interior empties preserved, each segment percent-decoded.
segs_loop = #[(data): 'bin, (start): 'int, (pos): 'int, (len): 'int, (acc): 'segments] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => Cons[
        pct_decode [%bin.slice [$data, $start, $pos], 0] ~> Str[~],
        $acc,
      ]
    | %bin.get_byte [$data, $pos] ~> =47 => {
      seg = pct_decode [%bin.slice [$data, $start, $pos], 0] ~> Str[~]
      ^ [$data, __integer_add__ [$pos, 1], __integer_add__ [$pos, 1], $len, Cons[seg, $acc]]
    }
    | ^ [$data, $start, __integer_add__ [$pos, 1], $len, $acc]
  }
}

path_segments = #'bin {
  =raw
  data = {
    | %bin.length raw ~> =0 => <>
    | %bin.get_byte [raw, 0] ~> =47 => %bin.slice [raw, 1, %bin.length raw]
    | raw
  }
  {
    | %bin.length data ~> =0 => Nil
    | {
      revd = segs_loop [data, 0, 0, %bin.length data, Nil]

      trimmed = {
        | revd ~> =Cons[Str[last], rest]; %bin.length last ~> =0 => rest
        | revd
      }
      %list.reverse trimmed
    }
  }
}

// One `k=v` (or bare `k`) part of a query/form body, percent-decoded with `+` as space.
part_pair = #'bin {
  =part
  ei = %bin.index [part, 61, 0]
  {
    | ei ~> =('int)e => [
        pct_decode [%bin.slice [part, 0, e], 1] ~> Str[~],
        pct_decode [%bin.slice [part, __integer_add__ [e, 1], %bin.length part], 1]
        ~> Str[~],
      ]
    | [pct_decode [part, 1] ~> Str[~], ""]
  }
}

qp_loop = #[(data): 'bin, (start): 'int, (pos): 'int, (len): 'int, (acc): 'pairs] {
  next = {
    | __integer_compare__ [$start, $pos] ~> =-1 => Cons[
        [$data, $start, $pos] ~> %bin.slice ~ ~> part_pair ~,
        $acc,
      ]
    | $acc
  }
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => %list.reverse next
    | %bin.get_byte [$data, $pos] ~> =38 => ^ [
        $data,
        __integer_add__ [$pos, 1],
        __integer_add__ [$pos, 1],
        $len,
        next,
      ]
    | ^ [$data, $start, __integer_add__ [$pos, 1], $len, $acc]
  }
}

form_decode = #'bin {
  :doc "Decodes an application/x-www-form-urlencoded body (or query string) into ordered [name, value] pairs."
  qp_loop [$, 0, 0, %bin.length $, Nil]
}

form = #' {
  :doc "The request body decoded as an application/x-www-form-urlencoded form, as ordered [name, value] pairs."
  form_decode $body
}

// --- the wire codec ----------------------------------------------------------------------

// The index of the first `\r\n\r\n`, or nil.
head_end = #[(data): 'bin, (pos): 'int, (len): 'int] {
  {
    | __integer_compare__ [__integer_add__ [$pos, 4], $len] ~> =1 => []
    | %bin.get_byte [$data, $pos] ~> =13

      %bin.get_byte [$data, __integer_add__ [$pos, 1]] ~> =10

      %bin.get_byte [$data, __integer_add__ [$pos, 2]] ~> =13

      %bin.get_byte [$data, __integer_add__ [$pos, 3]] ~> =10 => $pos
    | ^ [$data, __integer_add__ [$pos, 1], $len]
  }
}

// The index of the next `\r\n` before `end`, or `end` when the last line is unterminated.
line_end = #[(data): 'bin, (pos): 'int, (end): 'int] {
  {
    | __integer_compare__ [__integer_add__ [$pos, 1], $end] ~> =(0 | 1) => $end
    | %bin.get_byte [$data, $pos] ~> =13

      %bin.get_byte [$data, __integer_add__ [$pos, 1]] ~> =10 => $pos
    | ^ [$data, __integer_add__ [$pos, 1], $end]
  }
}

ows? = #'int { $ ~> =(32 | 9); $ }

trim_start = #[(data): 'bin, (pos): 'int, (end): 'int] {
  {
    | __integer_compare__ [$pos, $end] ~> =(0 | 1) => $pos
    | [$data, $pos] ~> %bin.get_byte ~ ~> ows? ~ => ^ [$data, __integer_add__ [$pos, 1], $end]
    | $pos
  }
}

trim_end = #[(data): 'bin, (pos): 'int, (end): 'int] {
  {
    | __integer_compare__ [$end, $pos] ~> =(0 | -1) => $end
    | [$data, __integer_subtract__ [$end, 1]] ~> %bin.get_byte ~ ~> ows? ~ => ^ [
        $data,
        $pos,
        __integer_subtract__ [$end, 1],
      ]
    | $end
  }
}

// A `Name: value` header line as a pair (value trimmed of optional whitespace), or nil.
parse_header_line = #'bin {
  =line
  %bin.index [line, 58, 0] ~> =('int)c
  c ~> =\0

  vs = trim_start [line, __integer_add__ [c, 1], %bin.length line]

  ve = trim_end [line, vs, %bin.length line]
  [Str[%bin.slice [line, 0, c]], Str[%bin.slice [line, vs, ve]]]
}

parse_headers = #[(data): 'bin, (pos): 'int, (end): 'int, (acc): 'pairs] {
  {
    | __integer_compare__ [$pos, $end] ~> =(0 | 1) => %list.reverse $acc
    | {
      le = line_end [$data, $pos, $end]
      {
        | [$data, $pos, le] ~> %bin.slice ~ ~> parse_header_line ~ ~> =[n, v] => ^ [
            $data,
            __integer_add__ [le, 2],
            $end,
            Cons[[n, v], $acc],
          ]
        | Bad[status: 400, reason: "malformed header"]
      }
    }
  }
}

method_of = #'%str {
  | ="GET" => GET
  | ="HEAD" => HEAD
  | ="POST" => POST
  | ="PUT" => PUT
  | ="DELETE" => DELETE
  | ="PATCH" => PATCH
  | ="OPTIONS" => OPTIONS
  | =m => Other[m]
}

// `METHOD SP target SP version`, or nil.
parse_request_line = #'bin {
  =line
  %bin.index [line, 32, 0] ~> =('int)a
  a ~> =\0

  %bin.index [line, 32, __integer_add__ [a, 1]] ~> =('int)b

  target = %bin.slice [line, __integer_add__ [a, 1], b]
  %bin.length target ~> =\0
  [
    method: %bin.slice [line, 0, a] ~> method_of Str[~],
    target: Str[target],
    version: Str[%bin.slice [line, __integer_add__ [b, 1], %bin.length line]],
  ]
}

// The request-target split into decoded path segments and query pairs.
split_target = #'%str {
  :doc "Splits a request target into `[path segments, query pairs]` — the same split `parse_request` applies, exposed for deriving a request from a new URL (live navigation)."
  =Str[t]
  qi = %bin.index [t, 63, 0]
  {
    | qi ~> =('int)q => [
        [t, 0, q] ~> %bin.slice ~ ~> path_segments ~,
        qp_loop [
          %bin.slice [t, __integer_add__ [q, 1], %bin.length t],
          0,
          0,
          __integer_subtract__ [%bin.length t, __integer_add__ [q, 1]],
          Nil,
        ],
      ]
    | [path_segments t, Nil]
  }
}

// Content-Length as a non-negative int: absent → 0, present-but-invalid → nil.
content_length = #'pairs {
  =hs
  {
    | header [hs, "content-length"] ~> =Str[v] => {
      %str.parse_int Str[v] ~> =('int)n; __integer_compare__ [n, 0] ~> =(0 | 1); n
    }
    | 0
  }
}

parse_request_with = #[(data): 'bin, (max_head): 'int, (max_body): 'int] {
  :doc "Parses one request from a byte buffer with explicit head/body size caps: Incomplete (read more), Bad[status, reason], or the request plus the leftover bytes."
  len = %bin.length $data
  he = head_end [$data, 0, len]
  {
    | he ~> =('int)h => {
      | __integer_compare__ [h, $max_head] ~> =1 => Bad[
          status: 431,
          reason: "request head too large",
        ]
      | {
        rle = line_end [$data, 0, h]
        {
          | [$data, 0, rle]
            ~> %bin.slice ~
            ~> parse_request_line ~
            ~> =(method: m, target, version) => {
              hstart = {
                | __integer_compare__ [rle, h] ~> =-1 => __integer_add__ [rle, 2]
                | h
              }
              parse_headers [$data, hstart, h, Nil] ~> {
                | =Bad[status: bs, reason: br] => Bad[status: bs, reason: br]
                | =hs => {
                  | header [hs, "transfer-encoding"] ~> =Str[_] => Bad[
                      status: 501,
                      reason: "transfer encodings are not supported",
                    ]
                  | content_length hs ~> =('int)cl => {
                    | __integer_compare__ [cl, $max_body] ~> =1 => Bad[
                        status: 413,
                        reason: "request body too large",
                      ]
                    | {
                      bstart = __integer_add__ [h, 4]
                      bend = __integer_add__ [bstart, cl]
                      {
                        | __integer_compare__ [bend, len] ~> =(-1 | 0) => {
                          split_target target ~> =[path, query]
                          [
                            Request[
                              method: m,
                              target: target,
                              path: path,
                              query: query,
                              version: version,
                              headers: hs,
                              body: %bin.slice [$data, bstart, bend],
                            ],
                            %bin.slice [$data, bend, len],
                          ]
                        }
                        | Incomplete
                      }
                    }
                  }
                  | Bad[status: 400, reason: "invalid content-length"]
                }
              }
            }
          | Bad[status: 400, reason: "malformed request line"]
        }
      }
    }
    | {
      | __integer_compare__ [len, $max_head] ~> =1 => Bad[
          status: 431,
          reason: "request head too large",
        ]
      | Incomplete
    }
  }
}

parse_request = #'bin {
  :doc "Parses one request from a byte buffer with default size caps (8 KiB head, 1 MiB body): Incomplete, Bad[status, reason], or the request plus the leftover bytes."
  parse_request_with [$, 8192, 1048576]
}

// --- the response side (what a client parses) -------------------------------------------
// The mirror of `parse_request`, and a bigger job: a *server* may reject a chunked request
// body (this module does), but a client cannot dictate how the server frames its answer, and
// HTTP/1.1 servers chunk routinely. A response with neither framing header runs to
// end-of-connection, which no buffer can detect on its own — hence the `eof` argument.
//
// `'response` carries no version or reason phrase, so both are dropped: the phrase is
// decoration, and a client that must know the version can read it off the wire itself.

'parsed_response = Incomplete | Bad[reason: '%str] | ['response, 'bin]

// A hex digit's value, or nil.
hex_value = #'int {
  | __integer_compare__ [$, 48] ~> =(0 | 1)
    __integer_compare__ [$, 57] ~> =(-1 | 0) => __integer_subtract__ [$, 48]
  | __integer_compare__ [$, 97] ~> =(0 | 1)
    __integer_compare__ [$, 102] ~> =(-1 | 0) => __integer_subtract__ [$, 87]
  | __integer_compare__ [$, 65] ~> =(0 | 1)
    __integer_compare__ [$, 70] ~> =(-1 | 0) => __integer_subtract__ [$, 55]
}

parse_hex = #[(data): 'bin, (pos): 'int, (end): 'int, (acc): 'int] {
  {
    | __integer_compare__ [$pos, $end] ~> =(0 | 1) => $acc
    | %bin.get_byte [$data, $pos] ~> hex_value ~ ~> =('int)v => ^ [
        $data,
        __integer_add__ [$pos, 1],
        $end,
        __integer_add__ [__integer_multiply__ [$acc, 16], v],
      ]
    | $acc
  }
}

// The position just past a chunked body's trailer section (zero or more header lines then a
// blank one), or nil when the buffer does not reach it yet.
trailer_end = #[(data): 'bin, (pos): 'int, (len): 'int] {
  le = line_end [$data, $pos, $len]
  {
    | __integer_compare__ [le, $len] ~> =0 => []
    | __integer_compare__ [le, $pos] ~> =0 => __integer_add__ [le, 2]
    | ^ [$data, __integer_add__ [le, 2], $len]
  }
}

// One pass of the chunked decoder: `[body, position-after]`, Incomplete, or Bad.
chunk_step = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  le = line_end [$data, $pos, $len]
  {
    | __integer_compare__ [le, $len] ~> =0 => Incomplete
    | {
      // The size line ends at a chunk extension's `;` if there is one.
      size_end = {
        | %bin.index [$data, 59, $pos] ~> =('int)s
          __integer_compare__ [s, le] ~> =-1 => s
        | le
      }
      {
        | __integer_compare__ [$pos, size_end] ~> =(0 | 1) => Bad[reason: "empty chunk size"]
        | %bin.get_byte [$data, $pos] ~> hex_value ~ ~> =[] => Bad[reason: "malformed chunk size"]
        | {
          n = parse_hex [$data, $pos, size_end, 0]
          dstart = __integer_add__ [le, 2]
          {
            | n ~> =0 => {
              | trailer_end [$data, dstart, $len] ~> =('int)e => [$acc, e]
              | Incomplete
            }
            | {
              dend = __integer_add__ [dstart, n]
              {
                | __integer_compare__ [__integer_add__ [dend, 2], $len] ~> =(-1 | 0) => {
                    | %bin.get_byte [$data, dend] ~> =13
                      %bin.get_byte [$data, __integer_add__ [dend, 1]] ~> =10 => ^ [
                        $data,
                        __integer_add__ [dend, 2],
                        $len,
                        %bin.concat [$acc, %bin.slice [$data, dstart, dend]],
                      ]
                    | Bad[reason: "chunk not terminated by CRLF"]
                  }
                | Incomplete
              }
            }
          }
        }
      }
    }
  }
}

// `HTTP/1.1 200 OK` — the reason phrase is optional.
parse_status_line = #'bin {
  =line
  len = %bin.length line
  %bin.index [line, 32, 0] ~> =('int)a
  __integer_compare__ [a, 0] ~> =1
  b = %bin.index [line, 32, __integer_add__ [a, 1]]
  code_end = { b ~> =('int)i => i | len }

  %bin.slice [line, __integer_add__ [a, 1], code_end]
  ~> Str[~]
  ~> %str.parse_int ~
  ~> =('int)status

  __integer_compare__ [status, 100] ~> =(0 | 1)
  __integer_compare__ [status, 599] ~> =(-1 | 0)
  status
}

// Statuses that carry no body however they are framed (RFC 9110 §6.4.1).
bodyless? = #'int {
  | =(204 | 304) => Ok
  | __integer_compare__ [$, 100] ~> =(0 | 1)
    __integer_compare__ [$, 199] ~> =(-1 | 0) => Ok
}

parse_response_with = #[(data): 'bin, (eof): (Ok | []), (max_head): 'int, (max_body): 'int] {
  :doc "Parses one response from a byte buffer with explicit head/body caps. `eof` says the connection has closed, which is what terminates a response framed by neither Content-Length nor chunked encoding."
  len = %bin.length $data
  head_end [$data, 0, len] ~> {
    | =('int)h => {
      | __integer_compare__ [h, $max_head] ~> =1 => Bad[reason: "response head too large"]
      | {
        sle = line_end [$data, 0, h]
        {
          | [$data, 0, sle]
            ~> %bin.slice ~
            ~> parse_status_line ~
            ~> =('int)status => {
              hstart = {
                | __integer_compare__ [sle, h] ~> =-1 => __integer_add__ [sle, 2]
                | h
              }
              parse_headers [$data, hstart, h, Nil] ~> {
                | =Bad[status: _, reason: br] => Bad[reason: br]
                | =hs => {
                  bstart = __integer_add__ [h, 4]
                  done = #[(body): 'bin, (rest): 'bin] {
                    [Response[status: status, headers: hs, body: $body], $rest]
                  }
                  {
                    | bodyless? status => done [<>, %bin.slice [$data, bstart, len]]
                    | header [hs, "transfer-encoding"] ~> =Str[te]
                      lower Str[te] ~> ="chunked" => chunk_step [$data, bstart, len, <>] ~> {
                        | =Incomplete => Incomplete
                        | =Bad[reason: r] => Bad[reason: r]
                        | =[body, e] => {
                          | %bin.length body ~> __integer_compare__ [~, $max_body] ~> =1 => Bad[
                              reason: "response body too large",
                            ]
                          | done [body, %bin.slice [$data, e, len]]
                        }
                      }
                    | header [hs, "transfer-encoding"] ~> =Str[_] => Bad[
                        reason: "unsupported transfer encoding",
                      ]
                    | header [hs, "content-length"] ~> =Str[_] => {
                      | content_length hs ~> =('int)cl => {
                        | __integer_compare__ [cl, $max_body] ~> =1 => Bad[
                            reason: "response body too large",
                          ]
                        | {
                          bend = __integer_add__ [bstart, cl]
                          {
                            | __integer_compare__ [bend, len] ~> =(-1 | 0) => done [
                                %bin.slice [$data, bstart, bend],
                                %bin.slice [$data, bend, len],
                              ]
                            | Incomplete
                          }
                        }
                      }
                      | Bad[reason: "invalid content-length"]
                    }
                    // Neither header: the body is whatever arrives before the peer hangs up.
                    | $eof ~> =Ok => {
                      | __integer_compare__ [__integer_subtract__ [len, bstart], $max_body]
                        ~> =1 => Bad[reason: "response body too large"]
                      | done [%bin.slice [$data, bstart, len], <>]
                    }
                    | Incomplete
                  }
                }
              }
            }
          | Bad[reason: "malformed status line"]
        }
      }
    }
    | {
      | __integer_compare__ [len, $max_head] ~> =1 => Bad[reason: "response head too large"]
      | Incomplete
    }
  }
}

parse_response = #[(data): 'bin, (eof): (Ok | [])] {
  :doc "Parses one response from a byte buffer with default caps (8 KiB head, 8 MiB body): Incomplete (read more), Bad[reason], or the response plus the leftover bytes."
  parse_response_with [$data, $eof, 8192, 8388608]
}

reason = #'int {
  :doc "The conventional reason phrase for a status code (empty for unlisted codes)."
  | =200 => "OK"
  | =201 => "Created"
  | =204 => "No Content"
  | =301 => "Moved Permanently"
  | =302 => "Found"
  | =303 => "See Other"
  | =304 => "Not Modified"
  | =400 => "Bad Request"
  | =403 => "Forbidden"
  | =404 => "Not Found"
  | =405 => "Method Not Allowed"
  | =411 => "Length Required"
  | =413 => "Content Too Large"
  | =431 => "Request Header Fields Too Large"
  | =500 => "Internal Server Error"
  | =501 => "Not Implemented"
  | ""
}

serialize_headers = #[(hs): 'pairs, (acc): '%str] {
  %list.fold [$hs, $acc, #{ "{$0}{$1.0}: {$1.1}\r\n" }]
}

serialize_response = #'response {
  :doc "The response as HTTP/1.1 bytes; a Content-Length header is added when absent."
  =Response[status: s, headers: hs, body: b]
  status_line = "HTTP/1.1 {%str.from_int s} {reason s}\r\n"
  hs2 = {
    | header [hs, "content-length"] ~> =Str[_] => hs
    | %list.prepend [hs, ["content-length", %bin.length b ~> %str.from_int ~]]
  }
  head = serialize_headers [hs2, status_line]
  %bin.concat ["{head}\r\n" ~> .0, b]
}

method_name = #'method {
  | =GET => "GET"
  | =HEAD => "HEAD"
  | =POST => "POST"
  | =PUT => "PUT"
  | =DELETE => "DELETE"
  | =PATCH => "PATCH"
  | =OPTIONS => "OPTIONS"
  | =Other[m] => m
}

serialize_request = #' {
  :doc "The request as HTTP/1.1 bytes; a Content-Length header is added when a body is present and none is stated. Host is the caller's to supply — this module never sees the authority."
  =Request(method: m, target: t, version: v, headers: hs, body: b)
  request_line = "{method_name m} {t} {v}\r\n"
  hs2 = {
    | header [hs, "content-length"] ~> =Str[_] => hs
    | %bin.length b ~> =0 => hs
    | %list.prepend [hs, ["content-length", %bin.length b ~> %str.from_int ~]]
  }
  head = serialize_headers [hs2, request_line]
  %bin.concat ["{head}\r\n" ~> .0, b]
}

request = #[(method): 'method, (target): '%str, headers: 'pairs = Nil, body: 'bin = <>] {
  :doc "Builds an HTTP/1.1 request, deriving `path` and `query` from the target the way the server's parser would — so a client-built request and a parsed one are the same value."
  [path, query] = split_target $target
  Request[
    method: $method,
    target: $target,
    path: path,
    query: query,
    version: "HTTP/1.1",
    headers: $headers,
    body: $body,
  ]
}

// --- cookies and form encoding ---------------------------------------------------------

// Whether a byte is unreserved under percent-encoding (ALPHA / DIGIT / - . _ ~).
enc_plain? = #'int {
  | __integer_compare__ [$, 48] ~> =(0 | 1)
    __integer_compare__ [$, 57] ~> =(-1 | 0) => $
  | __integer_compare__ [$, 65] ~> =(0 | 1)
    __integer_compare__ [$, 90] ~> =(-1 | 0) => $
  | __integer_compare__ [$, 97] ~> =(0 | 1)
    __integer_compare__ [$, 122] ~> =(-1 | 0) => $
  | $ ~> =(45 | 46 | 95 | 126) => $
}

// An uppercase hex digit.
hex_upper = #'int {
  | __integer_compare__ [$, 10] ~> =-1 => __integer_add__ [$, 48]
  | __integer_add__ [$, 55]
}

pct_enc_loop = #[(data): 'bin, (pos): 'int, (len): 'int, (acc): 'bin] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => $acc
    | {
      b = %bin.get_byte [$data, $pos]
      acc2 = {
        | enc_plain? b => %bin.append [$acc, b, 1]
        | b ~> =32 => %bin.append [$acc, 43, 1]
        | {
          %bin.append [$acc, 37, 1]
          ~> %bin.append [~, __integer_divide__ [b, 16] ~> hex_upper ~, 1]
          ~> %bin.append [~, __integer_modulo__ [b, 16] ~> hex_upper ~, 1]
        }
      }
      ^ [$data, __integer_add__ [$pos, 1], $len, acc2]
    }
  }
}

pct_encode = #'bin { pct_enc_loop [$, 0, %bin.length $, <>] }

form_encode = #'pairs {
  :doc "Ordered [name, value] pairs as an application/x-www-form-urlencoded body — the inverse of form_decode."
  %list.iter ~
  ~> %iter.map [
    ~,
    #{ =[Str[n], Str[v]]; pct_encode n ~> %bin.append [~, 61, 1] ~> %bin.concat [~, pct_encode v] },
  ]
  ~> %iter.intersperse [~, <26>]
  ~> %iter.fold [~, <>, %bin.concat]
}

// One `k=v` cookie segment (edges trimmed, value verbatim) prepended to the accumulator;
// segments without an `=` or with an empty name are skipped.
cookie_seg = #[(data): 'bin, (s0): 'int, (e0): 'int, (acc): 'pairs] {
  s = trim_start [$data, $s0, $e0]
  e = trim_end [$data, s, $e0]
  {
    | %bin.index [$data, 61, s] ~> =('int)eq
      __integer_compare__ [eq, e] ~> =-1
      __integer_compare__ [eq, s] ~> =1 => Cons[
        [Str[%bin.slice [$data, s, eq]], Str[%bin.slice [$data, __integer_add__ [eq, 1], e]]],
        $acc,
      ]
    | $acc
  }
}

cookies_loop = #[(data): 'bin, (start): 'int, (pos): 'int, (len): 'int, (acc): 'pairs] {
  {
    | __integer_compare__ [$pos, $len] ~> =(0 | 1) => cookie_seg [$data, $start, $pos, $acc]
    | %bin.get_byte [$data, $pos] ~> =59 => {
      acc2 = cookie_seg [$data, $start, $pos, $acc]
      ^ [$data, __integer_add__ [$pos, 1], __integer_add__ [$pos, 1], $len, acc2]
    }
    | ^ [$data, $start, __integer_add__ [$pos, 1], $len, $acc]
  }
}

cookies = #' {
  :doc "The cookies sent with the request (its Cookie headers), as ordered [name, value] pairs; values are verbatim bytes."
  %list.fold [
    $headers,
    Nil,
    #{
      $1 ~> =[n, Str[vb]]
      {
        | lower n ~> ="cookie" => cookies_loop [vb, 0, 0, %bin.length vb, $0]
        | $0
      }
    },
  ]
  ~> %list.reverse ~
}

'attrs = '%list<'%str>

attrs_join = #[(attrs): 'attrs, (acc): '%str] { %list.fold [$attrs, $acc, #{ "{$0}; {$1}" }] }

set_cookie = #[(name): '%str, (value): '%str, (attrs): 'attrs = Nil] {
  :doc "A Set-Cookie header pair for the name and value, with the given attribute strings (e.g. \"Path=/\", \"HttpOnly\"); none by default."
  ["set-cookie", attrs_join [$attrs, "{$name}={$value}"]]
}

// A header block is the unit a host hands over when it has already done the framing: the
// browser's fetch answers parsed headers, which the web transport re-emits as CRLF text so
// this module — the one place that knows the grammar — turns it back into pairs.
headers_of = #'bin {
  :doc "Parses a CRLF-separated header block into ordered [name, value] pairs, or Bad on a malformed line."
  parse_headers [$, 0, %bin.length $, Nil]
}

headers_to_bytes = #'pairs {
  :doc "Ordered [name, value] pairs as a CRLF-separated block, each line terminated (no blank line follows)."
  serialize_headers [$, ""] ~> .0
}

(
  header,
  get,
  lower,
  form,
  form_decode,
  form_encode,
  cookies,
  set_cookie,
  parse_request,
  parse_request_with,
  parse_response,
  parse_response_with,
  request,
  serialize_request,
  method_name,
  split_target,
  serialize_response,
  headers_of,
  headers_to_bytes,
  reason,
)
