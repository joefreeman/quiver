// TLS over a TCP socket, as an in-place upgrade.
//
// `attach` (client side) and `accept` (server side) install TLS on a *connected* socket and
// answer that same socket: from then on the ordinary `%tcp` operations speak plaintext
// through it — reads decrypt, writes encrypt, `close` sends a close_notify first, and a
// select yields decrypted `Data` events. Encryption is a property of the socket (the kTLS
// model), so everything built over sockets — `%http/server`, websockets, live views — runs
// over TLS unchanged.
//
// Neither function connects or accepts: they take a socket somebody else made, which is what
// leaves room for STARTTLS and proxy `CONNECT`. `connect` composes the ordinary client case.
//
// Certificate material is DER bytes. Trust anchors (`roots`) are concatenated DER
// certificates, and **empty means the host's defaults** (the compiled-in Mozilla set);
// supplying a set replaces them, which is how a locally-issued certificate is trusted — and
// therefore how this is testable at all. A server's `cert` is its presented chain (leaf
// first) and `key` its PKCS#8 private key.

[
  attach: #[(socket): \TcpSocket, (hostname): '%str, roots: 'bin = 0x] {
    :doc "Upgrades a connected socket to TLS (client side), verifying the peer against the given DER trust anchors (empty for the host's defaults). Answers the same socket; a failed handshake closes it."
    __tls_attach__ [socket: $socket, hostname: $hostname.0, roots: $roots]
  },

  accept: #[(socket): \TcpSocket, (cert): 'bin, (key): 'bin] {
    :doc "Upgrades an accepted socket to TLS (server side), presenting the certificate chain (concatenated DER, leaf first) with its PKCS#8 DER key. Answers the same socket; a failed handshake closes it."
    __tls_accept__ [socket: $socket, cert: $cert, key: $key]
  },

  connect: #[(host): '%str, (port): 'int, roots: 'bin = 0x] {
    :doc "Resolves, connects and upgrades in one step: a TLS connection to host:port, trying each resolved address until one accepts. Nil (with :error) if any stage fails."
    %tcp.connect [$host, $port] ~> =(\TcpSocket)socket
    __tls_attach__ [socket: socket, hostname: $host.0, roots: $roots]
  },
]
