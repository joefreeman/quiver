// Quiver data notation: the language's literal syntax restricted to data — integers,
// binaries (`<…>`), and tuples (with names and field labels), plus the `"…"` string
// sugar for `Str` values. Strings never interpolate here (data, not code), and encoded
// text reads back as literal code unchanged (`{` is escaped).
//
// `decode` is *type-consuming*: the expected type drives the parse — tuple names
// resolve only against its members, so text can never produce a shape the program
// doesn't already know — and it must be instantiated explicitly where the type is
// concrete: `%data.decode<'event> text`. Anything that doesn't fit answers nil, like a
// failed match.

// The default type, `'%data`, is the data values themselves: integers, binaries, and tuples
// whose fields are data — every value without identity (refs, pids, functions and resources
// have none of this notation). Bound a type parameter by it (`#<'k: '%data>…`) to accept
// any data.
' = 'int | 'bin | (*^)

// Why a decode failed: the text has the wrong shape somewhere (a `Mismatch`), or text is left
// over after the value (`Trailing`).
'kind = Mismatch | Trailing

// What a failed decode's nil carries under `:error`. The path leads from the decoded value to
// where it failed — a field's label, or its position when it has none. Of all the attempts a
// decode makes, the failure reported is the one that got furthest into the text. The message is
// for a person to read, so don't make logic depend on it. (The path is a `'%list<('%str | 'int)>`,
// spelled out because `%list` imports this module.)
'error = DecodeError[path: (Nil | Cons[(Str['bin] | 'int), ^]), kind: 'kind, message: Str['bin]]

[
  encode: #' {
    :doc """
      Encodes a data value (integers, binaries, and tuples of data — `'%data`) as Quiver data
      notation. `decode` reads it back.
      """
    __data_encode__ $ ~> Str[~]
  },
  decode: __data_decode__ ~> {
    :doc """
      Decodes Quiver data notation as the explicitly-given expected type —
      `%data.decode<'event> text` answers `'event | []`, nil for anything malformed, mismatched, or
      trailing — carrying a `'%data.error` under `:error`. The expected type must be concrete at
      the naming site.
      """
  },
]
