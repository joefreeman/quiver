// TCP stream events: the values a selected socket or listener yields. A stream
// resource is a select source — `![sock, recv, 1000]` races the socket's next
// event against messages and timeouts; `![sock]` alone is a plain blocking read.
//
// The aliases here are content-addressed twins of the runtime-delivered tuples
// (like `'%proc.changed`), so pattern-matching a select's result works:
//
//   ![sock, handle] ~> {
//     | =Data[sock: s, data: d] => ...      // bytes arrived (up to 8 KiB per event)
//     | =Closed[sock: s] => ...             // clean end of stream: nothing more is coming
//     | ...                                  // a mailbox message
//   }
//
// Selecting on a stream is fallible, like every other I/O operation: a *failed* read (a
// reset, a truncation) answers nil carrying `:error IoError[...]` rather than an event,
// so `Closed` alone means "you saw the whole stream". An unhandled failure simply ends
// the sequence; a consumer that recovers on purpose catches the nil.
//
// Events are chunks, not protocol messages — framing belongs above (e.g.
// `%http/websocket`'s codec). At most one event is read ahead per resource: while
// unconsumed, the kernel buffers and TCP flow control throttles the sender.
//
// A socket upgraded with `%tls` reads, writes and selects the same way, in plaintext:
// `Data` events carry decrypted bytes, a close_notify ends the stream as `Closed`, and a
// peer that vanished without one fails it — the same distinction the blocking read draws.

'data = Data[sock: +TcpSocket, data: 'bin]
'closed = Closed[sock: +TcpSocket]
'event = 'data | 'closed

'accepted = Accepted[listener: +TcpListener, sock: +TcpSocket]
'listener_closed = Closed[listener: +TcpListener]
'listener_event = 'accepted | 'listener_closed

// Where a connection goes: a raw IP address (4 or 16 bytes), or a hostname to resolve.
'address = 'bin | '%str

// Try each address in turn: resolvers order their answers however they like (`::1` before
// `127.0.0.1` for localhost is the classic), and the first family offered may be one the
// server never bound. `last` carries the most recent refusal, answered — `:error` intact —
// when the list runs out.
try_each = #[(addrs): '%list<'%dns.ip>, (port): 'int, (last): []] {
  $addrs ~> {
    | =Nil => $last
    | =Cons[addr, rest] => {
      ip = addr ~> { =IPv4[b] => b | =IPv6[b] => b }

      outcome = __tcp_connect__ [ip, $port]
      outcome ~> {
        | =(+TcpSocket & s) => s
        | =([] & failure) => ^ [rest, $port, failure]
      }
    }
  }
}

[
  connect: #[(to): 'address, (port): 'int] {
    :doc "Connects to [to, port], yielding a +TcpSocket. A raw IP ('bin, 4 or 16 bytes) is connected in one step; a hostname ('%str) is resolved and each address tried until one accepts. Nil (carrying :error) on failure — for a hostname, also when resolution fails or the name has no addresses."
    $to ~> {
      | =('bin & ip) => __tcp_connect__ [ip, $port]
      | =('%str & host) => {
        %dns.resolve host
        ~> %list.try_collect ~
        ~> =('%list<'%dns.ip> & addrs)

        addrs ~> {
          | =Nil => [] ~> { :error IoError[kind: NotFound, message: "no addresses for {host}"] }
          | try_each [addrs, $port, []]
        }
      }
    }
  },
  listen: __tcp_listen__ ~> {
    :doc "Listens on [port: 'int, backlog: 'int], yielding a +TcpListener."
  },
  read: __tcp_socket_read__ ~> {
    :doc "Reads up to [sock, n] bytes, blocking until some arrive; empty at EOF. For racing a read against messages or a timeout, select on the socket instead."
  },
  write: __tcp_socket_write__ ~> { :doc "Writes [sock, 'bin], yielding the byte count." },
  close: __tcp_socket_close__ ~> { :doc "Closes a socket." },
  accept: __tcp_listener_accept__ ~> {
    :doc "Accepts one connection, blocking. For racing an accept against messages, select on the listener instead."
  },
  close_listener: __tcp_listener_close__ ~> { :doc "Closes a listener." },
]
