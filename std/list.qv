'<'t> = Nil | Cons['t, ^]

reverse = #<'t>['<'t>, '<'t>] {
  | =[Nil, xs] => xs
  | =[Cons[head, tail], xs] => Cons[head, xs] ~> ^ [tail, ~]
}

// --- the `%list{ … }` dialect --------------------------------------------------------
// `%list{ 1, "two", x, ~, [3, 4] }` builds a list at compile time. Each element is an
// ordinary host expression (one chain), located by the host's `chain` prefix-parser and
// spliced as an `Unquote` — so variables, `~`, `&f`, tuples, and full call chains all
// mean exactly what they'd mean inline, evaluated with the dialect's flowing value as
// input. The dialect owns only the commas.

d_comma = %parse.right [&%parse.ws, %parse.byte [44, "','"]]

// One element: skip whitespace, then hand the host prefix-parser the exact start of the
// expression and splice the span it reports.
d_elem = #'%meta.cb {
  =cb
  #'%parse {
    =st
    cb [st.data, st.pos] ~> {
      | =('int)end => [
        Unquote[offset: st.pos, length: __integer_subtract__ [end, st.pos]],
        st ~> ~[..., pos: end],
      ]
      | %parse.fail [st.pos, "an expression"]
    }
  }
}

list_dialect = #(content: Str['bin], chain: '%meta.cb) {
  $ ~> =(content, chain: cb)
  elem = d_elem &cb
  elem_ws = %parse.right [&%parse.ws, &elem]
  elems = %parse.sep_by [&elem_ws, &d_comma]
  e2 = %parse.left [&elems, %parse.opt &d_comma]
  e3 = %parse.left [&e2, &%parse.ws]
  full = %parse.map [&e3, #{ %meta.list_expr $ }]
  %parse.run [content, &full]
}

[
  new: #{
    :doc "Creates an empty list."
    Nil
  },

  head: #<'t>'<'t> {
    :doc "The first element of a list, or nil when it is empty."
    =Cons[head, _] => head
  },

  tail: #<'t>'<'t> {
    :doc "The list without its first element, or nil when it is empty."
    =Cons[_, tail] => tail
  },

  empty?: #<'t>'<'t> {
    :doc "Whether the list is empty."
    =Nil => Ok
  },

  prepend: #<'t>['<'t>, 't] {
    :doc "The list with an element added at the front."
    Cons[$1, $0]
  },

  append: #<'t>['<'t>, 't] {
    :doc "The list with an element added at the end."
    reverse [$0, Nil] ~> reverse [Cons[$1, ~], Nil]
  },

  reverse: #<'t>'<'t> {
    :doc "The list with its elements in reverse order."
    reverse [~, Nil]
  },

  iter: #<'t>'<'t> {
    :doc "A lazy iterator over the elements of a list."
    %iter.unfold [
      ~,
      #<'t>'<'t> {
        | =Cons[head, tail] => [head, tail]
        | =Nil => []
      },
    ]
  },

  collect: #<'t>'%iter<'t> {
    :doc "Collects the elements of an iterator into a list."
    %iter.fold [~, Nil, #<'t>['<'t>, 't] { Cons[$1, $0] }] ~> reverse [~, Nil]
  },
] ~> { :dialect &list_dialect }
