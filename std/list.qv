'<'t> = Nil | Cons['t, ^]

reverse = #<'t>['<'t>, '<'t>] {
  | =[Nil, xs] => xs
  | =[Cons[head, tail], xs] => Cons[head, xs] ~> ^ [tail, ~]
}

// The iterable/collectable pair, shared by the exported `iter`/`collect` and the eager
// sequence functions below (which compose them around the lazy `%iter` operations).
to_iter = #<'t>'<'t> {
  %iter.unfold [
    ~,
    #<'t>'<'t> {
      | =Cons[head, tail] => [head, tail]
      | =Nil => []
    },
  ]
}

from_iter = #<'t>'%iter<'t> {
  %iter.fold [~, Nil, #<'t>['<'t>, 't] { Cons[$1, $0] }] ~> reverse [~, Nil]
}

// --- the `%list{ … }` dialect --------------------------------------------------------
// `%list{ 1, "two", x, ~, [3, 4] }` builds a list at compile time. Each element is an
// ordinary host expression (one chain), located by the host's `chain` prefix-parser and
// spliced as an `Unquote` — so variables, `~`, function names, tuples, and full call chains all
// mean exactly what they'd mean inline, evaluated with the dialect's flowing value as
// input. The dialect owns only the commas.

d_comma = %parse.right [%parse.ws, %parse.byte [44, "','"]]

// One element: skip whitespace, then hand the host prefix-parser the exact start of the
// expression and splice the span it reports.
d_elem = #'%meta.cb {
  =cb
  #'%parse {
    =st
    cb [st.data, st.pos] ~> {
      | =('int)end => [
          Unquote[offset: st.pos, length: __integer_subtract__ [end, st.pos]],
          st[..., pos: end],
        ]
      | %parse.fail [st.pos, "an expression"]
    }
  }
}

list_dialect = #(content: '%str, chain: '%meta.cb) {
  $ ~> =(content, chain: cb)
  elem = d_elem cb
  elem_ws = %parse.right [%parse.ws, elem]
  elems = %parse.sep_by [elem_ws, d_comma]
  e2 = %parse.left [elems, %parse.opt d_comma]
  e3 = %parse.left [e2, %parse.ws]
  full = %parse.map [e3, #{ %meta.list_expr $ }]
  %parse.run [content, full]
}

[
  new: #[] {
    :doc "Creates an empty list."
    Nil
  },

  head: #<'t>'<'t> {
    :doc "The first element of a list, or nil when it is empty."
    =Cons[head, _] => head
  },

  tail: #<'t>'<'t> {
    :doc "The list without its first element, or nil when it is empty."
    =Cons[_, tail] => tail
  },

  empty?: #<'t>'<'t> {
    :doc "Whether the list is empty."
    =Nil => Ok
  },

  prepend: #<'t>[(list): '<'t>, (item): 't] {
    :doc "The list with an element added at the front."
    Cons[$item, $list]
  },

  append: #<'t>[(list): '<'t>, (item): 't] {
    :doc "The list with an element added at the end."
    reverse [$list, Nil] ~> reverse [Cons[$item, ~], Nil]
  },

  reverse: #<'t>'<'t> {
    :doc "The list with its elements in reverse order."
    reverse [~, Nil]
  },

  iter: #<'t>'<'t> {
    :doc "A lazy iterator over the elements of a list."
    to_iter ~
  },

  collect: #<'t>'%iter<'t> {
    :doc "Collects the elements of an iterator into a list."
    from_iter ~
  },

  // The counterpart for a source that can fail (`%fs.list`, `%dns.resolve`): `collect` cannot
  // tell a broken walk from a finished one, so it would answer a short list; this answers nil
  // carrying the failure's `:error`, short-circuiting the caller's sequence like any other
  // failure. Over a pure source it is `collect` with a wider result type.
  try_collect: #<'t>'%iter<'t> {
    :doc "Collects an iterator that may fail into a list, or nil (carrying :error) if the source broke part-way."
    %iter.try_fold [$, Nil, #<'t>['<'t>, 't] { Cons[$1, $0] }]
    ~> =('<'t>)xs

    reverse [xs, Nil]
  },

  map: #<'t, 'u>[(list): '<'t>, (f): #'t -> 'u] {
    :doc "The list with each element transformed by a function."
    to_iter $list ~> %iter.map [~, $f] ~> from_iter ~
  },

  filter: #<'t>[(list): '<'t>, (pred): #'t -> ('t | [])] {
    :doc "The elements for which the predicate is non-nil."
    to_iter $list ~> %iter.filter [~, $pred] ~> from_iter ~
  },

  take: #<'t>[(list): '<'t>, (n): 'int] {
    :doc "The first n elements, or the whole list when it is shorter."
    to_iter $list ~> %iter.take [~, $n] ~> from_iter ~
  },

  drop: #<'t>[(list): '<'t>, (n): 'int] {
    :doc "The list without its first n elements."
    to_iter $list ~> %iter.drop [~, $n] ~> from_iter ~
  },

  take_while: #<'t>[(list): '<'t>, (pred): #'t -> ('t | [])] {
    :doc "The leading elements for which the predicate is non-nil."
    to_iter $list ~> %iter.take_while [~, $pred] ~> from_iter ~
  },

  drop_while: #<'t>[(list): '<'t>, (pred): #'t -> ('t | [])] {
    :doc "The list without its leading elements for which the predicate is non-nil."
    to_iter $list ~> %iter.drop_while [~, $pred] ~> from_iter ~
  },

  flat_map: #<'t, 'u>[(list): '<'t>, (f): #'t -> '<'u>] {
    :doc "Maps each element to a list and concatenates the results."
    // The nested literal closes over `f` (an inner `$` would be its own parameter), so
    // bind the field locally — by reference, as a bare `$f` term would call it.
    f = $f

    to_iter $list
    ~> %iter.flat_map [~, #{ f $ ~> to_iter ~ }]
    ~> from_iter ~
  },

  chain: #<'t>[(list): '<'t>, (with): '<'t>] {
    :doc "The first list's elements followed by the second's."
    %iter.chain [to_iter $list, to_iter $with] ~> from_iter ~
  },

  zip: #<'t, 'u>[(list): '<'t>, (with): '<'u>] {
    :doc "Pairs up elements from two lists, ending when either runs out."
    %iter.zip [to_iter $list, to_iter $with] ~> from_iter ~
  },

  enumerate: #<'t>'<'t> {
    :doc "The list with each element paired with its zero-based index."
    to_iter ~ ~> %iter.enumerate ~ ~> from_iter ~
  },

  intersperse: #<'t>[(list): '<'t>, (sep): 't] {
    :doc "The list with the separator inserted between consecutive elements."
    to_iter $list ~> %iter.intersperse [~, $sep] ~> from_iter ~
  },

  fold: #<'t, 'acc>[(list): '<'t>, (init): 'acc, (f): #['acc, 't] -> 'acc] {
    :doc "Reduces a list by folding each element into an accumulator."
    to_iter $list ~> %iter.fold [~, $init, $f]
  },

  count: #<'t>'<'t> {
    :doc "The number of elements in the list."
    to_iter ~ ~> %iter.count ~
  },

  nth: #<'t>[(list): '<'t>, (n): 'int] {
    :doc "The element at the given zero-based index, or nil when the list is too short."
    to_iter $list ~> %iter.nth [~, $n]
  },

  find: #<'t>[(list): '<'t>, (pred): #'t -> ('t | [])] {
    :doc "The first element for which the predicate is non-nil, or nil when none matches."
    to_iter $list ~> %iter.find [~, $pred]
  },

  find_index: #<'t>[(list): '<'t>, (pred): #'t -> ('t | [])] {
    :doc "The zero-based index of the first matching element, or nil when none matches."
    to_iter $list ~> %iter.find_index [~, $pred]
  },

  any?: #<'t>[(list): '<'t>, (pred): #'t -> ('t | [])] {
    :doc "Whether any element satisfies the predicate."
    to_iter $list ~> %iter.any? [~, $pred]
  },

  all?: #<'t>[(list): '<'t>, (pred): #'t -> ('t | [])] {
    :doc "Whether every element satisfies the predicate."
    to_iter $list ~> %iter.all? [~, $pred]
  },
]
~> { :dialect list_dialect }
