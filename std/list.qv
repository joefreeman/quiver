'<'t> = Nil | Cons['t, ^]

reverse = #<'t>['<'t>, '<'t>] {
  | =[Nil, xs] => xs
  | =[Cons[head, tail], xs] => Cons[head, xs] [tail, ~] ^
}

// --- the `%list{ … }` dialect --------------------------------------------------------
// `%list{ 1, "two", x, ~, [3, 4] }` builds a list at compile time: elements are
// integers, strings, caller-scope variables, `~` (the flowing value), or nested
// bracketed lists. Built from `%parse` combinators and the `%meta` constructors.

'dexpr = '%meta.expr

d_ripple = [[126, "'~'"] %parse.byte, #{ Ripple }] %parse.map
d_var = [&%parse.ident, #{ Var[$] }] %parse.map
d_comma = [&%parse.ws, [44, "','"] %parse.byte] %parse.right

// The element grammar, self-passed to tie the element↔nested-list recursion.
d_value_step = #[#^ -> (['dexpr, '%parse] | []), '%parse] {
  =[self, st]
  value = #'%parse { [&self, $] self }

  elems = [&value, &d_comma] %parse.sep_by
  n1 = [[91, "'['"] %parse.byte, &elems] %parse.right
  n2 = [&n1, &d_comma %parse.opt] %parse.left
  close = [&%parse.ws, [93, "']'"] %parse.byte] %parse.right
  n3 = [&n2, &close] %parse.left
  nested = [&n3, #{ $ %meta.list_expr }] %parse.map

  core =
    [
      [&nested, &%parse.quoted, &%parse.int] %parse.alt3,
      [&d_ripple, &d_var] %parse.alt2,
    ] %parse.alt2

  core_ws = [&%parse.ws, &core] %parse.right
  st core_ws
}

d_value = #'%parse { [&d_value_step, $] d_value_step }

list_dialect = #Str['bin] {
  elems = [&d_value, &d_comma] %parse.sep_by
  e2 = [&elems, &d_comma %parse.opt] %parse.left
  e3 = [&e2, &%parse.ws] %parse.left
  full = [&e3, #{ $ %meta.list_expr }] %parse.map
  [$, &full] %parse.run
}

[
  new: #{
    :doc "Creates an empty list."
    Nil
  },

  head: #<'t>'<'t> {
    :doc "The first element of a list, or nil when it is empty."
    =Cons[head, _] => head
  },

  tail: #<'t>'<'t> {
    :doc "The list without its first element, or nil when it is empty."
    =Cons[_, tail] => tail
  },

  empty?: #<'t>'<'t> {
    :doc "Whether the list is empty."
    =Nil => Ok
  },

  prepend: #<'t>['<'t>, 't] {
    :doc "The list with an element added at the front."
    Cons[$1, $0]
  },

  append: #<'t>['<'t>, 't] {
    :doc "The list with an element added at the end."
    [$0, Nil] reverse [Cons[$1, ~], Nil] reverse
  },

  reverse: #<'t>'<'t> {
    :doc "The list with its elements in reverse order."
    [~, Nil] reverse
  },

  iter: #<'t>'<'t> {
    :doc "A lazy iterator over the elements of a list."
    [
      ~,
      #<'t>'<'t> {
        | =Cons[head, tail] => [head, tail]
        | =Nil => []
      },
    ] %iter.unfold
  },

  collect: #<'t>'%iter<'t> {
    :doc "Collects the elements of an iterator into a list."
    [~, Nil, #<'t>['<'t>, 't] { Cons[$1, $0] }] %iter.fold
    ~> [~, Nil] reverse
  },
] { :dialect &list_dialect }
