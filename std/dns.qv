'ip = IPv4['bin] | IPv6['bin]

[
  resolve: #Str['bin] {
    :doc "Resolves a hostname, lazily yielding its addresses as IPv4 or IPv6 values."
    .0 ~> __dns_resolve__ ~> %iter.unfold [
      ~,
      #\DnsResolver {
        __dns_next__ $ ~> {
          | =[] => { __dns_close__ $; [] }
          | =b; __binary_length__ b ~> { =4 => IPv4[b] | =16 => IPv6[b] } ~> [~, $]
        }
      },
    ]
  },
]
