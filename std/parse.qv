// Parser combinators over binary input, with position-tracked failures.
//
// A *parser* is a function from a parse state to `[value, state]`, failing to nil with
// an `:error Expected[offset: 'int, message: Str['bin]]` payload — the same contract a
// dialect function reports to the compiler, so a dialect built on this module gets
// positioned compile errors for free.
//
// Failures report the position that got *furthest* through the input, even across
// backtracking: whenever a combinator converts a failure into a success (alternatives,
// repetition stops, `sep_by`/`opt` backtracking), the discarded failure is stashed in
// the state's `err` field, and every fresh failure merges itself against the stash
// (`fail_in`), so the deepest failure on the whole path is the one that surfaces. On a
// tie the fresher, more local message wins.
//
// Parsers are values: combinators take them by reference (`&p`) and return new parser
// closures. `alt2`/`alt3`/`alt4` keep the failure that got furthest through the input.
//
// A recursive grammar ties its knot with `rec`: the builder receives the grammar's own
// parser (to reference wherever it nests) and the state to parse from:
//
//   value = #['%parse.p<'json>, '%parse] {
//     =[value_p, st]
//     st (... combinators over &value_p ...)
//   } rec

'perr = Expected[offset: 'int, message: Str['bin]]

// The parse state: `err` stashes the furthest failure discarded on this path so far.
' = P[data: 'bin, pos: 'int, len: 'int, err: ('perr | [])]

'p<'t> = #' -> (['t, '] | [])

// A byte predicate: a value for the byte (kept by `satisfy`), or nil to reject it.
'pred<'t> = #'int -> ('t | [])

'items<'t> = Nil | Cons['t, ^]

// A recursive grammar's builder (see `rec`): the grammar's own parser, and the state to
// parse from.
'builder<'t> = #['p<'t>, '] -> (['t, '] | [])

// A failure at a position: nil carrying the standard payload.
fail = #['int, Str['bin]] {
  :doc "A failure at a position: nil carrying `Expected[offset, message]` as its `:error` payload."
  [] { :error Expected[offset: $0, message: $1] }
}

// The byte at the state's position, or nil at end of input.
peek = #' { [$pos, $len] __integer_compare__ =-1, [$data, $pos] %bin.get_byte }

advance = #[', 'int] { $0 ~[..., pos: [$0.pos, $1] __integer_add__] }

rev = #<'t>['items<'t>, 'items<'t>] {
  =[items, acc]
  items {
    | =Nil => acc
    | =Cons[h, t] => [t, Cons[h, acc]] ^
  }
}

// The failure payload that got further through the input (the first on a tie).
further = #[('perr | []), ('perr | [])] {
  =[a, b]
  {
    | a =Expected(offset: ao), b =Expected(offset: bo), [ao, bo] __integer_compare__ =(0 | 1) => a
    | b =('perr)x => x
    | a
  }
}

// A failure at the state's position, merged against the state's stashed failure — the
// deeper of the two surfaces (the fresh one on a tie).
fail_in = #[', Str['bin]] {
  :doc "A failure at the state's position, merged against the state's stashed (backtracked-over) failure; the deeper one surfaces."
  =[st, msg]

  e =
    [Expected[offset: st.pos, message: msg], st.err] further

  [] { :error e }
}

// --- primitive parsers ---------------------------------------------------------------

// The exact byte `b`, described as `what` in failures.
byte = #['int, Str['bin]] {
  :doc "A parser for the exact byte, described as `what` in failures."
  =[b, what]
  #' {
    | $ peek =&b => [b, [$, 1] advance]
    | [$, what] fail_in
  }
}

// A byte satisfying `pred` (which yields a value for the byte, or nil) — e.g. a digit's
// numeric value.
satisfy = #['pred<'int>, Str['bin]] {
  :doc "A parser for one byte satisfying the predicate, yielding the predicate's value for it."
  =[pred, what]
  #' {
    | $ peek =('int)b, b pred =('int)v => [v, [$, 1] advance]
    | [$, what] fail_in
  }
}

// Zero or more whitespace bytes (space, tab, newline, carriage return); always succeeds.
ws = #' {
  :doc "Zero or more whitespace bytes (space, tab, newline, carriage return); always succeeds."
  {
    | $ peek =(32 | 9 | 10 | 13) => [$, 1] advance ^
    | [Ok, $]
  }
}

tw_end = #<'t>['bin, 'int, 'int, 'pred<'t>] {
  =[data, pos, len, pred]
  {
    | [pos, len] __integer_compare__ =-1, [data, pos] %bin.get_byte pred => [
      data,
      [pos, 1] __integer_add__,
      len,
      &pred,
    ] ^
    | pos
  }
}

// The longest (possibly empty) run of bytes satisfying `pred`, as a slice.
take_while = #<'t>'pred<'t> {
  :doc "A parser for the longest (possibly empty) run of bytes satisfying the predicate, as a slice."
  =pred
  #' {
    end = [$data, $pos, $len, &pred] tw_end
    [[$data, $pos, end] %bin.slice, $ ~[..., pos: end]]
  }
}

digit_val = #'int {
  [$, 48] __integer_compare__ =(0 | 1)
  [$, 57] __integer_compare__ =(-1 | 0)
  [$, 48] __integer_subtract__
}

int_digits = #[', 'int] {
  =[st, acc]
  {
    | st peek =('int)b, b digit_val =('int)d => {
      [
        [st, 1] advance,
        [[acc, 10] __integer_multiply__, d] __integer_add__,
      ] ^
    }
    | [acc, st]
  }
}

// An optionally signed decimal integer.
int = #' {
  :doc "An optionally signed decimal integer."
  =st0
  st = { st0 peek =45, [st0, 1] advance | st0 }
  {
    | st peek =('int)b, b digit_val => {
      [st, 0] int_digits
      =[n, st2]
      {
        | st0 peek =45 => [[0, n] __integer_subtract__, st2]
        | [n, st2]
      }
    }
    | [st0, "a number"] fail_in
  }
}

ident_char? = #'int {
  | $ =95 => Ok
  | [$, 48] __integer_compare__ =(0 | 1), [$, 57] __integer_compare__ =(-1 | 0) => Ok
  | [$, 65] __integer_compare__ =(0 | 1), [$, 90] __integer_compare__ =(-1 | 0) => Ok
  | [$, 97] __integer_compare__ =(0 | 1), [$, 122] __integer_compare__ =(-1 | 0) => Ok
}

// The position after an optional single byte `b` at `pos` (unchanged when absent).
opt_byte_end = #['bin, 'int, 'int, 'int] {
  =[data, pos, len, b]
  {
    | [pos, len] __integer_compare__ =-1, [data, pos] %bin.get_byte =&b => [pos, 1] __integer_add__
    | pos
  }
}

// An identifier (lowercase start, then letters, digits, or underscores, with optional
// `?` then `!` suffixes — the host language's identifier grammar), as a Str.
ident = #' {
  :doc "An identifier (lowercase start; letters, digits, underscores; optional `?` then `!` suffixes), as a Str."
  | $ peek =('int)b, [b, 97] __integer_compare__ =(0 | 1), [b, 122] __integer_compare__ =(-1 | 0) => {
    end =
      [$data, [$pos, 1] __integer_add__, $len, &ident_char?] tw_end
      ~> [$data, ~, $len, 63] opt_byte_end
      ~> [$data, ~, $len, 33] opt_byte_end

    [[$data, $pos, end] %bin.slice Str[~], $ ~[..., pos: end]]
  }
  | [$, "a name"] fail_in
}

qstr_loop = #['bin, 'int, 'int, 'bin] {
  =[data, pos, len, acc]
  {
    | [pos, len] __integer_compare__ =(0 | 1) => [] {
      :error Expected[offset: pos, message: "'\"' (unterminated string)"]
    }
    | b = [data, pos] %bin.get_byte
      {
        | b =34 => [acc, [pos, 1] __integer_add__]
        | b =92 => {
          p1 = [pos, 1] __integer_add__
          {
            | [p1, len] __integer_compare__ =-1

              [data, p1] %bin.get_byte
              ~> {
                | =34 => 34
                | =92 => 92
                | =47 => 47
                | =98 => 8
                | =102 => 12
                | =110 => 10
                | =116 => 9
                | =114 => 13
              } =('int)r => {
              [data, [p1, 1] __integer_add__, len, [acc, r, 1] %bin.append] ^
            }
            | [] {
              :error Expected[offset: p1, message: "an escape character"]
            }
          }
        }
        | {
          [data, [pos, 1] __integer_add__, len, [acc, b, 1] %bin.append] ^
        }
      }
  }
}

// A double-quoted string with `\" \\ \/ \b \f \n \t \r` escapes, as a Str.
quoted = #' {
  :doc "A double-quoted string with `\\\" \\\\ \\/ \\b \\f \\n \\t \\r` escapes, as a Str."
  | $ peek =34 => {
    [$data, [$pos, 1] __integer_add__, $len, 0x] qstr_loop
    =[bytes, p2]
    [Str[bytes], $ ~[..., pos: p2]]
  }
  | [$, "a string"] fail_in
}

// The exact bytes of `s`, described as `what` in failures.
literal = #[Str['bin], Str['bin]] {
  :doc "A parser for the exact bytes of a string, described as `what` in failures."
  =[Str[expected], what]
  n = expected %bin.length
  #' {
    | end = [$pos, n] __integer_add__, [end, $len] __integer_compare__ =(-1 | 0), [$data, $pos, end] %bin.slice =&expected => [
      Ok,
      [$, n] advance,
    ]
    | [$, what] fail_in
  }
}

// --- combinators -----------------------------------------------------------------------

// Apply `f` to a parser's value.
map = #<'t, 'u>['p<'t>, #'t -> 'u] {
  :doc "Applies a function to a parser's value."
  =[p, f], #' { $ p, =[v, st], [v f, st] }
}

// Both in sequence, as a pair.
then = #<'t, 'u>['p<'t>, 'p<'u>] {
  :doc "Both in sequence, as a pair."
  =[p, q]
  #' { $ p, =[v, st], st q, =[w, st2], [[v, w], st2] }
}

// Both in sequence, keeping only the first / only the second value.
// (Implemented directly rather than as `then`+`map` with an inferred `#{ $0 }`: inside a
// generic body the literal's parameter inference has no concrete pin and misbehaves.)
left = #<'t, 'u>['p<'t>, 'p<'u>] {
  :doc "Both in sequence, keeping only the first value."
  =[p, q], #' { $ p, =[v, st], st q, =[_, st2], [v, st2] }
}
right = #<'t, 'u>['p<'t>, 'p<'u>] {
  :doc "Both in sequence, keeping only the second value."
  =[p, q], #' { $ p, =[_, st], st q, =[w, st2], [w, st2] }
}

// `p` between `open` and `close`, keeping `p`'s value.
between = #<'o, 't, 'c>['p<'o>, 'p<'t>, 'p<'c>] {
  :doc "The middle parser between the other two, keeping its value."
  =[open, p, close], inner = [&open, &p] right, [&inner, &close] left
}

// The first alternative to succeed; on failure, the error that got furthest.
alt2 = #<'t>['p<'t>, 'p<'t>] {
  :doc "The first alternative to succeed; on failure, the error that got furthest."
  =[p, q]
  #' {
    r = $ p
    {
      | r =[v, st] => [v, st]
      | {
        r2 = $ q
        {
          | r2 =[v, st] => [v, st ~[..., err: [r:('perr)error, st.err] further]]
          | e = [r:('perr)error, r2:('perr)error] further
            {
              | e =('perr)x => [] { :error x }
              | [$, "no alternative matched"] fail_in
            }
        }
      }
    }
  }
}

alt3 = #<'t>['p<'t>, 'p<'t>, 'p<'t>] {
  :doc "The first of three alternatives to succeed; on failure, the error that got furthest."
  =[p, q, r], pq = [&p, &q] alt2, [&pq, &r] alt2
}

alt4 = #<'t>['p<'t>, 'p<'t>, 'p<'t>, 'p<'t>] {
  :doc "The first of four alternatives to succeed; on failure, the error that got furthest."
  =[p, q, r, s], pq = [&p, &q] alt2, rs = [&r, &s] alt2, [&pq, &rs] alt2
}

many_run = #<'t>['p<'t>, ', 'items<'t>] {
  =[p, st, acc]
  r = st p
  {
    | r =[v, st2] => {
      // Stop when the parser succeeds without consuming, or repetition would never end.
      // The zero-width value is discarded: it matched nothing.
      | [st2.pos, st.pos] __integer_compare__ =1 => [&p, st2, Cons[v, acc]] ^
      | [[acc, Nil] rev, st2]
    }
    | [[acc, Nil] rev, st ~[..., err: [r:('perr)error, st.err] further]]
  }
}

// Zero or more of `p`, as a list of values.
many0 = #<'t>'p<'t> {
  :doc "Zero or more of a parser, as a list of its values."
  =p, #' { [&p, $, Nil] many_run }
}

sep_run = #<'t, 's>['p<'t>, 'p<'s>, ', 'items<'t>] {
  =[p, sep, st, acc]
  r = st sep
  {
    | r =[_, st1] => {
      r2 = st1 p
      {
        // Recurse only on progress: a separator and element that both matched empty
        // would repeat forever. The zero-width element is discarded: it matched nothing.
        | r2 =[v, st2] => {
          | [st2.pos, st.pos] __integer_compare__ =1 => [&p, &sep, st2, Cons[v, acc]] ^
          | [[acc, Nil] rev, st2]
        }
        // Backtracking over the separator: stash the element's failure — it's the
        // furthest this path got.
        | [[acc, Nil] rev, st ~[..., err: [r2:('perr)error, st.err] further]]
      }
    }
    | [[acc, Nil] rev, st ~[..., err: [r:('perr)error, st.err] further]]
  }
}

// Zero or more of `p` separated by `sep`, as a list of `p`'s values. Backtracking: a
// `sep` not followed by a `p` is left unconsumed (so a trailing separator can be handled
// with `opt` afterwards).
sep_by = #<'t, 's>['p<'t>, 'p<'s>] {
  :doc "Zero or more of a parser separated by another, as a list of values; a trailing separator is left unconsumed."
  =[p, sep]
  #' {
    r = $ p
    {
      | r =[v, st1] => [&p, &sep, st1, Cons[v, Nil]] sep_run
      | [Nil, $ ~[..., err: [r:('perr)error, $err] further]]
    }
  }
}

// `p`, or `None` without consuming input.
opt = #<'t>'p<'t> {
  :doc "The parser's value as Some, or None without consuming input."
  =p
  #' {
    r = $ p
    {
      | r =[v, st] => [Some[v], st]
      | [None, $ ~[..., err: [r:('perr)error, $err] further]]
    }
  }
}

// Replace `p`'s failure with `msg` at the position where `p` started.
label = #<'t>['p<'t>, Str['bin]] {
  :doc "Replaces the parser's failure with a message at the position where it started."
  =[p, msg]
  #' {
    r = $ p
    {
      | r =[v, st] => [v, st]
      | [$, msg] fail_in
    }
  }
}

chain_run = #<'t>['p<'t>, 'p<#['t, 't] -> 't>, ', 't] {
  =[p, op, st, lhs]
  r = st op
  {
    | r =[f, st1] => {
      st1 p
      =[rhs, st2]
      {
        // Recurse only on progress: an operator and operand that both matched empty
        // would repeat forever.
        | [st2.pos, st.pos] __integer_compare__ =1 => [&p, &op, st2, [lhs, rhs] f] ^
        | [lhs, st]
      }
    }
    | [lhs, st ~[..., err: [r:('perr)error, st.err] further]]
  }
}

// One or more of `p` separated by `op`, folded left-associatively: `op` yields the
// combining function for each pair — the classic precedence-level combinator.
chainl = #<'t>['p<'t>, 'p<#['t, 't] -> 't>] {
  :doc "One or more of a parser separated by an operator parser yielding combining functions, folded left-associatively."
  =[p, op], #' { $ p, =[v, st], [&p, &op, st, v] chain_run }
}

rec_run = #<'t>[#^ -> (['t, '] | []), 'builder<'t>, '] {
  =[self, builder, st], me = #' { [&self, &builder, $] self }, [&me, st] builder
}

// Tie a recursive grammar's knot: `rec` turns a builder into the parser it describes.
rec = #<'t>'builder<'t> {
  :doc "Ties a recursive grammar's knot: turns a builder (which receives the grammar's own parser and the state) into the parser it describes."
  =builder, #' { [&rec_run, &builder, $] rec_run }
}

// Apply a parser to a whole string: the value, or nil with a positioned `:error` — the
// dialect contract, so a `:dialect` function can be `#Str['bin] { [~, &grammar] %parse.run }`.
run = #<'t>[Str['bin], 'p<'t>] {
  :doc "Applies a parser to a whole string: the value, or nil with a positioned `:error` payload — the dialect failure contract."
  =[Str[data], p]
  P[data: data, pos: 0, len: data %bin.length, err: []] p
  =[v, st]
  {
    | [st.pos, st.len] __integer_compare__ =(0 | 1) => v
    | [st, "end of input"] fail_in
  }
}

[
  run: &run,
  fail: &fail,
  fail_in: &fail_in,
  byte: &byte,
  satisfy: &satisfy,
  ws: &ws,
  take_while: &take_while,
  int: &int,
  ident: &ident,
  quoted: &quoted,
  literal: &literal,
  map: &map,
  then: &then,
  left: &left,
  right: &right,
  between: &between,
  alt2: &alt2,
  alt3: &alt3,
  alt4: &alt4,
  many0: &many0,
  sep_by: &sep_by,
  opt: &opt,
  label: &label,
  chainl: &chainl,
  rec: &rec,
]
