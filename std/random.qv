// Randomness over the host's cryptographically secure entropy source (the
// `__random_bytes__` builtin). Everything here is
// crypto-quality: suitable for session ids and CSRF tokens, not just dice. A seeded,
// reproducible PRNG (games, property tests) would be a separate, pure module.

// A big-endian binary read as an unsigned integer.
int_loop = #['bin, 'int, 'int, 'int] {
  =[data, pos, len, acc]
  {
    | __integer_compare__ [pos, len] ~> =(0 | 1) => acc
    | {
      b = %bin.get_byte [data, pos]
      ^ [
        data,
        __integer_add__ [pos, 1],
        len,
        __integer_add__ [__integer_multiply__ [acc, 256], b],
      ]
    }
  }
}

bin_int = #'bin { int_loop [$, 0, %bin.length $, 0] }

// The smallest `k` (and `256^k`) such that `256^k >= n`, starting from k = 1.
klen_loop = #['int, 'int, 'int] {
  =[n, k, p]
  {
    | __integer_compare__ [p, n] ~> =(0 | 1) => [k, p]
    | ^ [n, __integer_add__ [k, 1], __integer_multiply__ [p, 256]]
  }
}

// Draw k bytes as an integer until it falls below `limit` (a multiple of n), then take
// the remainder — uniform in [0, n) with no modulo bias.
draw_loop = #['int, 'int, 'int] {
  =[n, k, limit]
  v = __random_bytes__ k ~> bin_int
  {
    | __integer_compare__ [v, limit] ~> =-1 => __integer_modulo__ [v, n]
    | ^ [n, k, limit]
  }
}

below = #'int {
  :doc "A uniform random integer in [0, n) — cryptographically sourced, unbiased (rejection sampling); nil when n < 1."
  =n
  __integer_compare__ [n, 0] ~> =1
  klen_loop [n, 1, 256]
  =[k, p]

  limit = __integer_subtract__ [p, __integer_modulo__ [p, n]]

  draw_loop [n, k, limit]
}

between = #['int, 'int] {
  :doc "A uniform random integer from lo to hi inclusive; nil when lo > hi."
  =[lo, hi]
  __integer_compare__ [lo, hi] ~> =(-1 | 0)

  __integer_add__ [__integer_subtract__ [hi, lo], 1] ~> below
  ~> =('int)r

  __integer_add__ [lo, r]
}

// A nibble as a lowercase hex character code.
hex_digit = #'int {
  | __integer_compare__ [$, 10] ~> =-1 => __integer_add__ [$, 48]
  | __integer_add__ [$, 87]
}

hex_loop = #['bin, 'int, 'int, 'bin] {
  =[data, pos, len, acc]
  {
    | __integer_compare__ [pos, len] ~> =(0 | 1) => acc
    | {
      b = %bin.get_byte [data, pos]

      acc2 = %bin.append [acc, __integer_divide__ [b, 16] ~> hex_digit, 1] ~> %bin.append [
        ~,
        __integer_modulo__ [b, 16] ~> hex_digit,
        1,
      ]

      ^ [data, __integer_add__ [pos, 1], len, acc2]
    }
  }
}

hex = #'int {
  :doc "A random token: n cryptographically secure bytes as 2n lowercase hex characters."
  b = __random_bytes__ $; hex_loop [b, 0, %bin.length b, 0x] ~> Str[~]
}

[
  bytes: &__random_bytes__ ~> {
    :doc "The given number of cryptographically secure random bytes from the host's entropy source."
  },
  below: &below,
  between: &between,
  hex: &hex,
]
